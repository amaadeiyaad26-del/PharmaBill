<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.AccessSimulatorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/Icons/app.ico" Title="Access simulator - Debug" Width="480" Height="320" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <StackPanel Margin="24">
    <TextBlock Text="Debug-only access simulator" FontSize="21" FontWeight="SemiBold" />
    <TextBlock Text="Preview access states without changing the stored licence or subscription." Margin="0,8,0,20" TextWrapping="Wrap" />
    <ComboBox Name="StatusPicker" SelectedIndex="0" Padding="8" ItemsSource="{Binding Statuses}" SelectionChanged="StatusPicker_OnSelectionChanged" />
    <TextBlock Name="ResultText" Margin="0,20,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <Button Content="Close" IsCancel="True" HorizontalAlignment="Right" Padding="16,7" Margin="0,20,0,0" />
  </StackPanel>
</Window>