<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.PaymentQrWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Payment QR" MinWidth="440" MinHeight="640" Width="460" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource CanvasBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <Border Margin="18" Padding="22,22,22,16" CornerRadius="16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
    <UIElement.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.12" Color="#FF0F172A" />
    </UIElement.Effect>
    <DockPanel LastChildFill="True">
      <Grid DockPanel.Dock="Bottom" Margin="0,20,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="Cancel / Change Mode" Style="{StaticResource SecondaryButton}" MinHeight="44" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsCancel="True" Margin="0,0,8,0" Padding="12,8" Click="Cancel_Click" />
        <Grid Column="1" Margin="8,0,0,0">
          <Button Name="ConfirmButton" Style="{StaticResource PrimaryButton}" MinHeight="44" HorizontalAlignment="Stretch" IsDefault="True" Background="#FF2563EB" BorderBrush="#FF2563EB" Padding="10,8" ToolTip="Confirm payment received and continue to print" Click="Confirm_Click">
            <TextBlock Text="Payment Received / Confirm &amp; Print" TextWrapping="Wrap" TextAlignment="Center" />
          </Button>
          <Button Name="ConfigureButton" Content="Open Settings" Style="{StaticResource PrimaryButton}" MinHeight="44" HorizontalAlignment="Stretch" Visibility="Collapsed" Background="#FF2563EB" BorderBrush="#FF2563EB" Foreground="#FFFFFFFF" Padding="12,8" ToolTip="Close this dialog and open UPI &amp; Digital Payment Settings" Click="Configure_Click" />
        </Grid>
      </Grid>
      <StackPanel>
        <TextBlock Text="Scan to pay" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Name="PharmacyNameText" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" />
        <Border Margin="0,16,0,0" Padding="16" CornerRadius="12" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" HorizontalAlignment="Center">
          <Image Name="QrImage" Width="240" Height="240" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>
        <TextBlock Name="AmountText" Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="32" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="#FF0F172A" TextWrapping="NoWrap" TextTrimming="None" />
        <TextBlock Name="InvoiceText" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" />
        <DockPanel Margin="0,14,0,0" LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Copy" MinWidth="72" Height="34" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" ToolTip="Copy UPI ID" Click="CopyUpi_Click" />
          <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <TextBlock Name="UpiIdText" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          </Border>
        </DockPanel>
        <TextBlock Name="MissingUpiText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFB42318" Visibility="Collapsed" Text="UPI ID is not configured. Open Settings → UPI &amp; Digital Payment Settings and save your store VPA (e.g. store@upi)." />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>