<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.RecoveryCodeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/Icons/app.ico" Title="Save your recovery code" Width="520" SizeToContent="Height" MinHeight="300" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Save your owner recovery code" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Grid.Row="1" Text="This code is shown only once. Keep it somewhere safe and separate from this computer. Anyone with the code can reset the owner PIN." TextWrapping="Wrap" Margin="0,12,0,16" />
    <Border Grid.Row="2" Background="#FFF2F4F7" Padding="14" CornerRadius="6">
      <TextBlock Name="RecoveryCodeText" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" />
    </Border>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Save code" MinWidth="100" Height="40" Margin="0,0,8,0" Click="Save_Click" />
      <Button Content="Print code" MinWidth="100" Height="40" Margin="0,0,8,0" Click="Print_Click" />
      <Button Content="Done" IsDefault="True" IsCancel="True" MinWidth="90" Height="40" />
    </WrapPanel>
  </Grid>
</Window>