<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.PrescriptionReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/Icons/app.ico" Title="Matched medicines" Height="560" Width="980" MinHeight="420" MinWidth="760" WindowStartupLocation="CenterOwner" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="Matched medicines" FontSize="22" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF475467" Text="{Binding Summary}" />
      <Border Background="#FFFFFAEB" BorderBrush="#FFF79009" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" Visibility="{Binding ApiKeyMissing, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Configure Gemini API Key in Settings" Padding="10,4" Margin="12,0,0,0" Click="ConfigureGemini_Click" />
          <TextBlock Text="Read offline. Add a Gemini API key for higher-accuracy reading of handwriting." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#FF93370D" />
        </DockPanel>
      </Border>
      <TextBlock Text="Medicines are mapped to the oldest-expiry in-stock batch (FEFO). Untick anything the pharmacist does not approve." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF475467" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock Name="ErrorText" Foreground="#FFB42318" VerticalAlignment="Center" Margin="0,0,16,0" />
      <Button Content="Cancel" IsCancel="True" Padding="18,8" Margin="0,0,8,0" />
      <Button Content="Add to Bill" IsDefault="True" Padding="22,8" FontWeight="SemiBold" Background="#FF2563EB" Foreground="#FFFFFFFF" BorderBrush="#FF1D4ED8" Click="AddToBill_Click" />
    </StackPanel>
    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" ItemsSource="{Binding Rows}">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Add" Width="52" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" />
        <DataGridTextColumn Header="Prescribed" IsReadOnly="True" Width="1.3*" Binding="{Binding PrescribedName}" />
        <DataGridTextColumn Header="Dose / duration" IsReadOnly="True" Width="1*" Binding="{Binding DoseText}" />
        <DataGridTextColumn Header="Matched product" IsReadOnly="True" Width="1.4*" Binding="{Binding MatchText}" />
        <DataGridTextColumn Header="Match" IsReadOnly="True" Width="64" Binding="{Binding ConfidenceText}" />
        <DataGridTextColumn Header="FEFO batch" IsReadOnly="True" Width="1.6*" Binding="{Binding BatchText}" />
        <DataGridTextColumn Header="Qty" Width="64" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>