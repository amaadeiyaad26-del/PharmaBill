<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.InvoiceDetailWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/Icons/app.ico" Title="Invoice details" Height="640" Width="940" MinHeight="480" MinWidth="720" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock FontSize="22" FontWeight="SemiBold">
        <Run Text="{Binding DocumentType, Mode=OneWay}" />
        <Run Text=" " />
        <Run Text="{Binding InvoiceNo, Mode=OneWay}" />
      </TextBlock>
      <TextBlock Margin="0,4,0,0" Text="{Binding AtLocal, StringFormat=yyyy-MM-dd HH:mm, Mode=OneWay}" />
      <TextBlock Margin="0,8,0,0" FontWeight="SemiBold">
        <Run Text="Patient / buyer: " />
        <Run Text="{Binding Party, Mode=OneWay}" />
      </TextBlock>
      <TextBlock Text="{Binding Phone, StringFormat=Phone: {0}, Mode=OneWay}" />
      <TextBlock TextWrapping="Wrap" Text="{Binding Address, StringFormat=Address: {0}, Mode=OneWay}" />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
        <Run Text="Prescriber: " />
        <Run Text="{Binding PrescriberName, Mode=OneWay}" /> <Run Text="  Reg. no.: " /><Run Text="{Binding PrescriberRegistrationNumber, Mode=OneWay}" /> <Run Text="  Prescription ref.: " /><Run Text="{Binding PrescriptionReference, Mode=OneWay}" /></TextBlock>
    </StackPanel>
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
        <TextBlock Text="{Binding PaymentStatus, StringFormat=Payment: {0}, Mode=OneWay}" />
        <TextBlock TextWrapping="Wrap" Text="{Binding Notes, StringFormat=Notes: {0}, Mode=OneWay}" />
        <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="18,6" />
      </StackPanel>
      <Grid Column="1" MinWidth="260">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Subtotal" />
        <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Subtotal, StringFormat=₹{0:N2}, Mode=OneWay}" />
        <TextBlock Grid.Row="1" Text="Discount" />
        <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DiscountAmount, StringFormat=₹{0:N2}, Mode=OneWay}" />
        <TextBlock Grid.Row="2" Text="GST" />
        <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding TaxAmount, StringFormat=₹{0:N2}, Mode=OneWay}" />
        <TextBlock Grid.Row="3" Text="Total" FontWeight="Bold" FontSize="16" />
        <TextBlock Grid.Row="3" Grid.Column="1" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" Text="{Binding TotalAmount, StringFormat=₹{0:N2}, Mode=OneWay}" />
        <TextBlock Grid.Row="4" Text="Paid" />
        <TextBlock Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding PaidAmount, StringFormat=₹{0:N2}, Mode=OneWay}" />
      </Grid>
    </Grid>
    <DataGrid Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding Lines, Mode=OneWay}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Item" Width="2*" Binding="{Binding Item, Mode=OneWay}" />
        <DataGridTextColumn Header="Composition" Width="1.5*" Binding="{Binding Composition, Mode=OneWay}" />
        <DataGridTextColumn Header="Batch No" Width="*" Binding="{Binding BatchNo, Mode=OneWay}" />
        <DataGridTextColumn Header="Expiry (MM/YY)" Width="Auto" Binding="{Binding Expiry, Mode=OneWay}" />
        <DataGridTextColumn Header="Qty" Width="Auto" Binding="{Binding Quantity, Mode=OneWay}" />
        <DataGridTextColumn Header="Unit price" Width="Auto" Binding="{Binding UnitPrice, StringFormat=N2, Mode=OneWay}" />
        <DataGridTextColumn Header="GST %" Width="Auto" Binding="{Binding TaxRate, StringFormat=0.##, Mode=OneWay}" />
        <DataGridTextColumn Header="Discount" Width="Auto" Binding="{Binding DiscountAmount, StringFormat=N2, Mode=OneWay}" />
        <DataGridTextColumn Header="Total" Width="Auto" Binding="{Binding LineTotal, StringFormat=N2, Mode=OneWay}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>