<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.PinPromptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/Icons/app.ico" Title="Sensitive records access" SizeToContent="WidthAndHeight" MinWidth="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <StackPanel Margin="24">
    <TextBlock FontSize="16" TextWrapping="Wrap" Margin="0,0,0,16" Text="{Binding Prompt}" />
    <StackPanel Name="UsernamePanel" Visibility="Collapsed" Margin="0,0,0,10">
      <TextBlock Text="Admin username" Margin="0,0,0,6" />
      <TextBox Name="UsernameBox" MinWidth="300" Padding="8" />
    </StackPanel>
    <TextBlock Text="PIN / password" Margin="0,0,0,6" />
    <PasswordBox Name="PinBox" MinWidth="300" Padding="8" />
    <TextBlock Foreground="#FFB42318" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
    <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
      <Button Content="Continue" IsDefault="True" Padding="14,7" Click="Continue_Click" />
    </WrapPanel>
  </StackPanel>
</Window>