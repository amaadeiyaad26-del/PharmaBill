<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.AuthenticationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/Icons/app.ico" Title="PharmaBill - Unlock" Width="440" SizeToContent="Height" MinHeight="440" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#F1F5F9" Foreground="#0F172A" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Style x:Key="LoginFieldStyle" TargetType="{x:Type Control}">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Control}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8">
                <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="#3B82F6" />
                  <Setter TargetName="Chrome" Property="Border.BorderThickness" Value="2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LoginTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource LoginFieldStyle}" />
      <Style x:Key="LoginPasswordStyle" TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource LoginFieldStyle}" />
      <Style x:Key="LoginLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#334155" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="PrimaryUnlockButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" CornerRadius="8">
                <UIElement.Effect>
                  <DropShadowEffect Color="#2563EB" Opacity="0.3" BlurRadius="10" ShadowDepth="2" />
                </UIElement.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#93C5FD" />
                  <Setter TargetName="Chrome" Property="UIElement.Effect" Value="{x:Null}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LoginLinkButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#2563EB" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <TextBlock Name="Label" Text="{TemplateBinding ContentControl.Content}" Foreground="{TemplateBinding Control.Foreground}" Padding="{TemplateBinding Control.Padding}" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Label" Property="TextBlock.TextDecorations" Value="Underline" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Label" Property="TextBlock.TextDecorations" Value="Underline" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LoginIconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#475569" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#F1F5F9" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="#3B82F6" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <Border Margin="24" Padding="28" Background="#FFFFFF" CornerRadius="16" VerticalAlignment="Center">
      <UIElement.Effect>
        <DropShadowEffect Color="#0F172A" Opacity="0.12" BlurRadius="24" ShadowDepth="4" />
      </UIElement.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Top">
          <Border CornerRadius="18" Height="88" Width="88" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Border.Background>
              <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#EF4444" Offset="0.0" />
                <GradientStop Color="#DC2626" Offset="0.4" />
                <GradientStop Color="#991B1B" Offset="1.0" />
              </LinearGradientBrush>
            </Border.Background>
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="16" Color="#000000" Direction="270" Opacity="0.30" ShadowDepth="4" />
            </UIElement.Effect>
            <Grid>
              <Border BorderThickness="1.5" CornerRadius="17">
                <Border.BorderBrush>
                  <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                    <GradientStop Color="#FFFFFF" Offset="0.0" />
                    <GradientStop Color="#00FFFFFF" Offset="0.45" />
                    <GradientStop Color="#000000" Offset="1.0" />
                  </LinearGradientBrush>
                </Border.BorderBrush>
              </Border>
              <Viewbox Stretch="Fill" Margin="6,0,6,10" VerticalAlignment="Bottom" Height="18">
                <Path Data="M2,14 C22,4 42,18 70,8" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" Width="72" Height="18">
                  <Shape.Stroke>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                      <GradientStop Color="#22D3EE" Offset="0.0" />
                      <GradientStop Color="#34D399" Offset="1.0" />
                    </LinearGradientBrush>
                  </Shape.Stroke>
                </Path>
              </Viewbox>
              <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Panel.ZIndex="0" FontFamily="Segoe UI Black, Arial Black" FontSize="38" FontWeight="Black" Foreground="#450A0A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" Opacity="0.55" Text="PB" />
                <TextBlock Panel.ZIndex="1" FontFamily="Segoe UI Black, Arial Black" FontSize="38" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Text="PB">
                  <TextBlock.Foreground>
                    <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                      <GradientStop Color="#FFFFFF" Offset="0.0" />
                      <GradientStop Color="#F8FAFC" Offset="0.55" />
                      <GradientStop Color="#CBD5E1" Offset="1.0" />
                    </LinearGradientBrush>
                  </TextBlock.Foreground>
                </TextBlock>
                <Viewbox Panel.ZIndex="2" Width="16" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0">
                  <Canvas Width="24" Height="48">
                    <Rectangle Canvas.Left="11" Canvas.Top="8" Width="2" Height="36" RadiusX="1" RadiusY="1">
                      <Shape.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#FBBF24" Offset="0" />
                          <GradientStop Color="#D97706" Offset="1" />
                        </LinearGradientBrush>
                      </Shape.Fill>
                    </Rectangle>
                    <Ellipse Canvas.Left="8.5" Canvas.Top="2" Width="7" Height="7">
                      <Shape.Fill>
                        <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.5,0.5">
                          <GradientStop Color="#FDE68A" Offset="0" />
                          <GradientStop Color="#F59E0B" Offset="0.55" />
                          <GradientStop Color="#B45309" Offset="1" />
                        </RadialGradientBrush>
                      </Shape.Fill>
                    </Ellipse>
                    <Path Data="M12,9 C7,7.2 3.5,8.2 2.2,10.2 C5.5,9.4 8.8,10.4 12,12.2 C15.2,10.4 18.5,9.4 21.8,10.2 C20.5,8.2 17,7.2 12,9" Fill="#F59E0B" />
                    <Path Data="M12,9.6 C8.2,8.2 5,9 4,10.4 C6.8,9.8 9.4,10.6 12,12 C14.6,10.6 17.2,9.8 20,10.4 C19,9 15.8,8.2 12,9.6" Fill="#FDE68A" Opacity="0.85" />
                    <Path StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,13 C7.5,13.5 6,16 7.5,18 C9,20 12,20.5 12,20.5 C12,20.5 15,21 16.5,23 C18,25 16.5,27.5 12,28 C7.5,28.5 6,31 7.5,33 C9,35 12,35.5 12,35.5">
                      <Shape.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#F59E0B" Offset="0" />
                          <GradientStop Color="#D97706" Offset="1" />
                        </LinearGradientBrush>
                      </Shape.Stroke>
                    </Path>
                    <Path StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,13 C16.5,13.5 18,16 16.5,18 C15,20 12,20.5 12,20.5 C12,20.5 9,21 7.5,23 C6,25 7.5,27.5 12,28 C16.5,28.5 18,31 16.5,33 C15,35 12,35.5 12,35.5">
                      <Shape.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#FBBF24" Offset="0" />
                          <GradientStop Color="#B45309" Offset="1" />
                        </LinearGradientBrush>
                      </Shape.Stroke>
                    </Path>
                  </Canvas>
                  <UIElement.Effect>
                    <DropShadowEffect BlurRadius="5" Color="#000000" Direction="270" Opacity="0.45" ShadowDepth="1.5" />
                  </UIElement.Effect>
                </Viewbox>
              </Grid>
            </Grid>
          </Border>
          <TextBlock Text="PharmaBill" FontSize="30" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
          <TextBlock Text="Sign in to continue" Margin="0,4,0,16" HorizontalAlignment="Center" FontSize="14" Foreground="#64748B" />
        </StackPanel>
        <TextBlock Grid.Row="3" Text="Username" Style="{StaticResource LoginLabelStyle}" />
        <TextBox Name="UsernameBox" Style="{StaticResource LoginTextBoxStyle}" Grid.Row="4" Margin="0,5,0,12" Padding="8" MinHeight="38" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="5" Text="PIN or password" Style="{StaticResource LoginLabelStyle}" />
        <Grid Row="6" Margin="0,5,0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <PasswordBox Name="SecretBox" Style="{StaticResource LoginPasswordStyle}" Padding="8" MinHeight="38" PasswordChanged="SecretBox_OnPasswordChanged" />
          <TextBox Name="VisibleSecretBox" Style="{StaticResource LoginTextBoxStyle}" Grid.Column="0" Visibility="Collapsed" Padding="8" MinHeight="38" TextChanged="VisibleSecretBox_OnTextChanged" />
          <Button Name="ShowSecretButton" Style="{StaticResource LoginIconButtonStyle}" Grid.Column="1" Content="◉" ToolTip="Show or hide PIN/password" AutomationProperties.Name="Show or hide PIN or password" MinWidth="42" Margin="6,0,0,0" Click="ShowSecret_Click" />
        </Grid>
        <TextBlock Grid.Row="7" Text="Caps Lock is on" Foreground="#FFB54708" Margin="0,2,0,3" Visibility="{Binding IsCapsLockOn, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <TextBlock Name="ErrorText" Grid.Row="8" Foreground="#FFB42318" TextWrapping="Wrap" MinHeight="24" Margin="0,0,0,8" Text="{Binding ErrorMessage}" />
        <Grid Row="9">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Button Grid.Row="0" Style="{StaticResource PrimaryUnlockButtonStyle}" Content="Unlock / Sign In" IsDefault="True" Height="48" MinHeight="44" Command="{Binding AuthenticateCommand}" IsEnabled="{Binding CanUnlock}" />
          <Button Grid.Row="1" Style="{StaticResource LoginLinkButtonStyle}" Content="Forgot PIN?" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="10,4" Click="ForgotPin_Click" />
          <Button Grid.Row="2" Style="{StaticResource LoginLinkButtonStyle}" Content="Set up new pharmacy or admin account" HorizontalAlignment="Center" Margin="0,4,0,0" Padding="10,4" ToolTip="Run the initial setup wizard for a new pharmacy install" Click="CreateAccount_Click" />
          <TextBlock Grid.Row="3" Text="─── OR CONTINUE WITH ───" HorizontalAlignment="Center" Foreground="#94A3B8" FontSize="11" Margin="0,14,0,10" />
          <Button Grid.Row="4" Style="{StaticResource GoogleSignInButton}" Content="Continue with Google" HorizontalAlignment="Stretch" Margin="0,0,0,4" Command="{Binding SignInWithGoogleCommand}" IsEnabled="{Binding CanUseSocialSignIn}" />
          <TextBlock Grid.Row="5" HorizontalAlignment="Center" Foreground="#94A3B8" Margin="0,8,0,0" Text="{Binding VersionText}" />
          <TextBlock Grid.Row="6" Margin="0,14,0,0" FontSize="11" LineHeight="16" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="#94A3B8" Text="Designed and developed by S.A.E.R. to serve pharma professionals." />
          <TextBlock Grid.Row="7" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="#94A3B8">
            <Run Text="For any query: email at " /> <Hyperlink NavigateUri="mailto:pharma.bill26@gmail.com" Foreground="#2563EB" RequestNavigate="SupportEmail_RequestNavigate">pharma.bill26@gmail.com</Hyperlink></TextBlock>
        </Grid>
      </Grid>
    </Border>
  </ScrollViewer>
</Window>