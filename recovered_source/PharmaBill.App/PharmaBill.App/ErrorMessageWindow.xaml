<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.ErrorMessageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/Icons/app.ico" Title="PharmaBill - Error" Width="620" SizeToContent="Height" MinHeight="280" MaxHeight="760" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="True" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Name="FriendlyMessage" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Grid.Row="1" Margin="0,10,0,8" TextWrapping="Wrap" Foreground="#FF475569" Text="{Binding LogPath, StringFormat=Log folder: {0}}" />
    <TextBox Name="ErrorDetails" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="80" MaxHeight="420" Padding="8" />
    <Border Grid.Row="3" Margin="0,14,0,0" Padding="12" CornerRadius="8" Background="#FFF0F9FF" BorderBrush="#FFBAE6FD" BorderThickness="1">
      <DockPanel>
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="18" Foreground="#FF0284C7" Margin="0,0,10,0" VerticalAlignment="Top" />
        <StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#FF334155" Text="Encountering an issue? Contact developer support at pharma.bill26@gmail.com with your log folder details." />
          <TextBlock Margin="0,6,0,0">
            <Hyperlink Foreground="#FF0284C7" FontWeight="SemiBold" Click="SupportEmail_Click">
              <Run Text="pharma.bill26@gmail.com" />
            </Hyperlink> <Run Text="  " /> <Run Name="CopiedToastRun" Text="" Foreground="#FF027A48" FontWeight="SemiBold" /></TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>
    <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Copy Error Details" MinWidth="150" Height="40" Margin="0,0,8,0" Click="CopyErrorDetails_Click" />
        <Button Content="Open log folder" MinWidth="130" Height="40" Margin="0,0,8,0" Click="OpenLogFolder_Click" />
        <Button Content="Close" IsDefault="True" IsCancel="True" MinWidth="90" Height="40" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>