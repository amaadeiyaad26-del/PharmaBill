<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PharmaBill.App.Controls.LiveHighlightTile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PharmaBill.App.Controls;assembly=PharmaBill.App">
  <Border Name="CarouselCard" CornerRadius="12" Margin="16,8" Height="80" ClipToBounds="True" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
    <UIElement.RenderTransform>
      <ScaleTransform ScaleX="1" ScaleY="1" />
    </UIElement.RenderTransform>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0F766E" Offset="0" />
        <GradientStop Color="#FF0D9488" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Border}">
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="UIElement.Effect">
              <Setter.Value>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.35" Color="#FF0F766E" />
              </Setter.Value>
            </Setter>
            <TriggerBase.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.15" />
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.15" />
                </Storyboard>
              </BeginStoryboard>
            </TriggerBase.EnterActions>
            <TriggerBase.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                </Storyboard>
              </BeginStoryboard>
            </TriggerBase.ExitActions>
          </Trigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
    <Grid VerticalAlignment="Center" Margin="20,0">
      <StackPanel Name="CarouselContent" RenderTransformOrigin="0.5,0.5">
        <UIElement.RenderTransform>
          <TranslateTransform x:Name="SlideOffset" Y="0" />
        </UIElement.RenderTransform>
        <TextBlock Name="TxtInfoHeadline" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" Text="Today: —" />
        <TextBlock Name="TxtInfoSub" FontSize="12" Foreground="#FFD1FAE5" Text="Loading live highlights…" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>