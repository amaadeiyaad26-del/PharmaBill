<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PharmaBill.App.Views.DunningDashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:PharmaBill.App.Views;assembly=PharmaBill.App">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="Collections &amp; Smart Dunning" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Margin="0,4,0,8" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Open wholesale receivables ranked by risk. Tiers: T1 pre-due (-2d), T2 due, T3 overdue (+7d), T4 critical &amp; credit-lock (+15d)." />
      <WrapPanel>
        <Button Content="Refresh" Padding="12,7" Command="{Binding RefreshCommand}" />
        <TextBox Width="360" Margin="8,0,0,0" Padding="8,6" ToolTip="Payment details included in WhatsApp reminders" Text="{Binding PaymentDetails, UpdateSourceTrigger=PropertyChanged}" />
        <Button Content="Send WhatsApp Dunning Reminders" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding SendWhatsAppRemindersCommand}" />
      </WrapPanel>
      <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
      <TextBlock Margin="0,2,0,0" Foreground="#FFB42318" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
    </StackPanel>
    <TabControl>
      <TabItem Header="Overdue chemists">
        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding Receivables}" SelectedItem="{Binding SelectedReceivable}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Chemist" Width="160" Binding="{Binding CustomerName}" />
            <DataGridTextColumn Header="Invoice" Width="110" Binding="{Binding InvoiceNo}" />
            <DataGridTextColumn Header="Due" Width="90" Binding="{Binding DueDate, StringFormat=dd-MMM-yyyy}" />
            <DataGridTextColumn Header="Outstanding" Width="100" Binding="{Binding OutstandingAmount, StringFormat=₹{0:0.00}}" />
            <DataGridTextColumn Header="Days past due" Width="90" Binding="{Binding DaysPastDue}" />
            <DataGridTextColumn Header="Tier" Width="90" Binding="{Binding Tier}" />
            <DataGridTextColumn Header="Risk" Width="80" Binding="{Binding RiskScore}" />
            <DataGridTextColumn Header="Avg delay (d)" Width="90" Binding="{Binding AveragePaymentDelayDays}" />
            <DataGridTextColumn Header="Remind on" Width="100" Binding="{Binding OptimalReminderDate, StringFormat=dd-MMM-yyyy}" />
            <DataGridTextColumn Header="Credit limit" Width="100" Binding="{Binding CreditLimit, StringFormat=₹{0:0.00}}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Credit profiles">
        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding Profiles}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Chemist" Width="180" Binding="{Binding CustomerName}" />
            <DataGridTextColumn Header="Risk" Width="80" Binding="{Binding DefaultRiskScore}" />
            <DataGridTextColumn Header="Avg delay (d)" Width="100" Binding="{Binding AveragePaymentDelayDays}" />
            <DataGridTextColumn Header="Credit days" Width="90" Binding="{Binding CreditDays}" />
            <DataGridTextColumn Header="Credit limit" Width="110" Binding="{Binding CreditLimit, StringFormat=₹{0:0.00}}" />
            <DataGridTextColumn Header="Outstanding" Width="110" Binding="{Binding OutstandingAmount, StringFormat=₹{0:0.00}}" />
            <DataGridTextColumn Header="Overdue" Width="100" Binding="{Binding OverdueAmount, StringFormat=₹{0:0.00}}" />
            <DataGridCheckBoxColumn Header="T4 lock" Width="70" Binding="{Binding HasActiveT4}" />
            <DataGridCheckBoxColumn Header="Over limit" Width="80" Binding="{Binding ExceedsCreditLimit}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>