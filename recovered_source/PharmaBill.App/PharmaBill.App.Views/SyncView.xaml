<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PharmaBill.App.Views.SyncView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PharmaBill.App.Controls" xmlns:views="clr-namespace:PharmaBill.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border CornerRadius="12" Padding="16" BorderThickness="1" Margin="0,0,0,8" BorderBrush="{DynamicResource FieldBorderBrush}" Background="{DynamicResource CardBackgroundBrush}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="Android pairing station" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          <controls:InfoHelper Title="LAN pairing &amp; firewall (port 5055)" Body="1) Download PharmaBill on Android from Google Play. 2) Connect phone and PC to the same Wi-Fi. 3) Ensure Listener shows Listening. 4) Scan QR or wait for mDNS discovery. 5) If Android cannot connect: allow PharmaBill through Private networks, or run scripts/allow-firewall-port5055.ps1 as Administrator. Cloud fallback keeps syncing via Google Drive when LAN is blocked." />
        </StackPanel>
        <Border Background="#FFF0FDF4" BorderBrush="#FF86EFAC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0" Background="#FFDCFCE7" VerticalAlignment="Top">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="18" Foreground="#FF15803D" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Android / Google Play" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13.5" Foreground="#FF14532D" Text="Step 1: Download the Android version of PharmaBill App from Google Play Store first." />
              <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5" Foreground="#FF334155" Text="Install the app on your mobile device, ensure both devices are connected to the same Wi-Fi network, and use the mobile scanner to scan the QR code below." />
              <TextBlock Name="PlayStoreCopiedToast" Margin="0,6,0,0" FontSize="11.5" Foreground="#FF027A48" FontWeight="SemiBold" Text="Play Store link copied!" Visibility="Collapsed" />
            </StackPanel>
            <Button Grid.Column="2" Margin="12,0,0,0" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" ToolTip="Open Google Play listing (also copies the link)" Click="OpenPlayStore_Click">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Background="#FF15803D" CornerRadius="6" Padding="{TemplateBinding Control.Padding}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="13" Foreground="#FFFFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                      <TextBlock Text="Get it on Google Play" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </ControlTemplate>
              </Control.Template>
            </Button>
          </Grid>
        </Border>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="220" Height="220" Background="#FFFFFFFF" CornerRadius="8" Padding="10" VerticalAlignment="Top">
            <Image Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="LAN pairing QR code" Source="{Binding PairingQrCode}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource SecondaryTextBrush}" Text="Zero-config: this PC advertises _pharmabill-sync._tcp on Wi-Fi (port 5055). Scan the QR code, or let Android discover the station. If the firewall blocks LAN, encrypted change logs go to Google Drive PharmaBill_Sync automatically." />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold" AutomationProperties.Name="LAN discovery status" Text="{Binding DiscoveryStatus}" />
            <WrapPanel>
              <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="This PC Wi-Fi IP:" />
              <TextBox IsReadOnly="True" MinWidth="160" Margin="8,0,12,0" Padding="6" FontFamily="Consolas" FontSize="16" AutomationProperties.Name="This PC Wi-Fi IP address" Text="{Binding WifiIpAddress, Mode=OneWay}" />
              <TextBlock VerticalAlignment="Center" Text="{Binding LanPort, StringFormat=Port {0}}" />
              <controls:InfoHelper Title="Port 5055" Body="Default LAN sync port. Android must reach this PC’s Wi-Fi IP on TCP 5055. Blocked firewall rules are the most common cause of pairing failure." />
              <Border Margin="12,0,0,0" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="#FFECFDF3" />
                    <Style.Triggers>
                      <DataTrigger Value="Listening" Binding="{Binding LanSyncState}">
                        <Setter Property="Background" Value="#FFD1FAE5" />
                      </DataTrigger>
                      <DataTrigger Value="DeviceConnected" Binding="{Binding LanSyncState}">
                        <Setter Property="Background" Value="#FFA7F3D0" />
                      </DataTrigger>
                      <DataTrigger Value="Unavailable" Binding="{Binding LanSyncState}">
                        <Setter Property="Background" Value="#FFFEF3C7" />
                      </DataTrigger>
                      <DataTrigger Value="Stopped" Binding="{Binding LanSyncState}">
                        <Setter Property="Background" Value="#FFE2E8F0" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock FontWeight="SemiBold" AutomationProperties.Name="LAN listener status badge" Text="{Binding LanSyncState, StringFormat=Listener: {0}}" />
              </Border>
            </WrapPanel>
            <Border Margin="0,10,0,0" CornerRadius="8" Padding="8,6" HorizontalAlignment="Left">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Border}">
                  <Setter Property="Background" Value="#FFECFDF3" />
                  <Style.Triggers>
                    <DataTrigger Value="DeviceConnected" Binding="{Binding LanSyncState}">
                      <Setter Property="Background" Value="#FFD1FAE5" />
                    </DataTrigger>
                    <DataTrigger Value="Unavailable" Binding="{Binding LanSyncState}">
                      <Setter Property="Background" Value="#FFFEF3C7" />
                    </DataTrigger>
                    <DataTrigger Value="Stopped" Binding="{Binding LanSyncState}">
                      <Setter Property="Background" Value="#FFF1F5F9" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <StackPanel>
                <TextBlock FontWeight="SemiBold" AutomationProperties.Name="LAN sync status" Text="{Binding LanStatusMessage}" />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="640" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding LanStatusDetail}" />
              </StackPanel>
            </Border>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Refresh IP &amp; QR" Padding="12,6" Command="{Binding RefreshLanStationCommand}" />
              <Button Content="New pairing secret" Padding="12,6" Margin="8,0,0,0" ToolTip="Creates a new QR token. The phone must scan again." Command="{Binding RotateLanPairingSecretCommand}" />
              <Button Content="Check / Allow Firewall Rule" Padding="12,6" Margin="8,0,0,0" ToolTip="Checks Windows Firewall for TCP 5055 and offers to add an inbound allow rule (UAC)." Command="{Binding CheckAllowFirewallRuleCommand}" />
            </WrapPanel>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="640" Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.Name="Firewall rule status" Text="{Binding FirewallRuleStatus}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>