<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>PharmaBill.Sync</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="PharmaBill.Sync.Embedded.google-oauth-client.json" />
    <EmbeddedResource Include="PharmaBill.Sync.Embedded.google-oauth-client.json" LogicalName="PharmaBill.Sync.Embedded.google-oauth-client.json" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PharmaBill.Data">
      <HintPath>artifacts/publish/win-x64-appxprobe/PharmaBill.Data.dll</HintPath>
    </Reference>
    <Reference Include="PharmaBill.Core">
      <HintPath>artifacts/publish/win-x64-appxprobe/PharmaBill.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore">
      <HintPath>artifacts/publish/win-x64-appxprobe/Microsoft.EntityFrameworkCore.dll</HintPath>
    </Reference>
    <Reference Include="Google.Apis.Drive.v3">
      <HintPath>artifacts/publish/win-x64-appxprobe/Google.Apis.Drive.v3.dll</HintPath>
    </Reference>
    <Reference Include="Google.Apis.Auth">
      <HintPath>artifacts/publish/win-x64-appxprobe/Google.Apis.Auth.dll</HintPath>
    </Reference>
    <Reference Include="Google.Apis.Core">
      <HintPath>artifacts/publish/win-x64-appxprobe/Google.Apis.Core.dll</HintPath>
    </Reference>
    <Reference Include="Google.Apis">
      <HintPath>artifacts/publish/win-x64-appxprobe/Google.Apis.dll</HintPath>
    </Reference>
    <Reference Include="Makaretu.Dns.Multicast.New">
      <HintPath>artifacts/publish/win-x64-appxprobe/Makaretu.Dns.Multicast.New.dll</HintPath>
    </Reference>
    <Reference Include="System.Security.Cryptography.ProtectedData">
      <HintPath>artifacts/publish/win-x64-appxprobe/System.Security.Cryptography.ProtectedData.dll</HintPath>
    </Reference>
    <Reference Include="Makaretu.Dns">
      <HintPath>artifacts/publish/win-x64-appxprobe/Makaretu.Dns.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>