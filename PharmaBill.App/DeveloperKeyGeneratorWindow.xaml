<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.DeveloperKeyGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/Icons/app.ico"
        Title="Admin License Key Generator"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <StackPanel Margin="28">
    <TextBlock Text="Admin License Key Generator"
               FontSize="22"
               FontWeight="SemiBold"
               Margin="0,0,0,4" />
    <TextBlock Text="Ctrl+Shift+K — RSA-2048 signed key (PBILL2.payload.signature). Private key only in MASTER_ADMIN_BUILD; never ships in Release."
               Foreground="{DynamicResource SecondaryTextBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,20" />

    <TextBlock Text="Client Machine ID"
               FontWeight="SemiBold"
               Margin="0,0,0,6" />
    <TextBox x:Name="MachineIdBox"
             Padding="10,8"
             Margin="0,0,0,16"
             BorderBrush="{DynamicResource FieldBorderBrush}" />

    <TextBlock Text="Validity period"
               FontWeight="SemiBold"
               Margin="0,0,0,6" />
    <ComboBox x:Name="DurationBox"
              Margin="0,0,0,16"
              MinHeight="36"
              Padding="8,6"
              SelectedIndex="1">
      <ComboBoxItem Content="1 Month (30 days)" Tag="OneMonth" />
      <ComboBoxItem Content="1 Year (365 days)" Tag="OneYear" />
      <ComboBoxItem Content="Lifetime" Tag="Lifetime" />
    </ComboBox>

    <Button Content="Generate Activation Key"
            HorizontalAlignment="Left"
            MinHeight="40"
            Padding="16,8"
            Margin="0,0,0,20"
            Style="{StaticResource PrimaryButton}"
            Click="Generate_Click" />

    <TextBlock Text="Generated key"
               FontWeight="SemiBold"
               Margin="0,0,0,6" />
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="GeneratedKeyBox"
               Grid.Column="0"
               IsReadOnly="True"
               Padding="10,8"
               FontFamily="Consolas"
               VerticalContentAlignment="Center"
               Background="{DynamicResource FieldReadOnlyBrush}"
               BorderBrush="{DynamicResource FieldBorderBrush}" />
      <Button Grid.Column="1"
              Content="Copy Key"
              Margin="8,0,0,0"
              MinWidth="100"
              Padding="12,8"
              Style="{StaticResource SecondaryButton}"
              Click="CopyKey_Click" />
    </Grid>

    <TextBlock x:Name="ExpiryHintText"
               Foreground="{DynamicResource SecondaryTextBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />

    <TextBlock x:Name="StatusText"
               TextWrapping="Wrap"
               MinHeight="20"
               Foreground="#FFB42318" />
  </StackPanel>
</Window>
