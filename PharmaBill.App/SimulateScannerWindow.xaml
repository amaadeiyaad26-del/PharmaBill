<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.SimulateScannerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Simulate Scanner Input" Icon="/Assets/Icons/app.ico" Height="320" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="Simulate Scanner Input" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12" Text="Enter a barcode or pick a sample. Simulate Scan dispatches the same HID path as a physical scanner (burst + Enter)." />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Simulate Scan" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,0,8,0" Click="Simulate_Click" />
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Barcode" Margin="0,0,0,6" />
      <TextBox Name="BarcodeBox" Padding="8" Margin="0,0,0,10" />
      <TextBlock Text="Sample barcodes (catalog-style test codes)" Margin="0,0,0,6" />
      <ListBox Name="SampleList" Height="120" DisplayMemberPath="Display" MouseDoubleClick="SampleList_MouseDoubleClick" SelectionChanged="SampleList_SelectionChanged" />
    </StackPanel>
  </DockPanel>
</Window>