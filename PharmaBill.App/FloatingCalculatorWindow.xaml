<Window x:Class="PharmaBill.App.FloatingCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator" Height="360" Width="280"
        Icon="/Assets/Icons/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#DDEEE2" Topmost="True">
  <DockPanel Margin="12">
    <TextBox x:Name="Display" DockPanel.Dock="Top" Height="48" FontSize="22" FontWeight="SemiBold"
             Foreground="#0D4A2B" Background="White" Padding="8" IsReadOnly="True" Text="0" />
    <UniformGrid Rows="5" Columns="4" Margin="0,12,0,0">
      <Button Content="C" Click="Clear_Click" Margin="3" Style="{StaticResource FrostedMintPillButton}" />
      <Button Content="⌫" Click="Back_Click" Margin="3" Style="{StaticResource FrostedMintPillButton}" />
      <Button Content="÷" Click="Op_Click" Tag="/" Margin="3" Style="{StaticResource FrostedMintPillButton}" />
      <Button Content="×" Click="Op_Click" Tag="*" Margin="3" Style="{StaticResource FrostedMintPillButton}" />
      <Button Content="7" Click="Digit_Click" Margin="3" Style="{StaticResource SecondaryButton}" />
      <Button Content="8" Click="Digit_Click" Margin="3" Style="{StaticResource SecondaryButton}" />
      <Button Content="9" Click="Digit_Click" Margin="3" Style="{StaticResource SecondaryButton}" />
      <Button Content="−" Click="Op_Click" Tag="-" Margin="3" Style="{StaticResource FrostedMintPillButton}" />
      <Button Content="4" Click="Digit_Click" Margin="3" Style="{StaticResource SecondaryButton}" />
      <Button Content="5" Click="Digit_Click" Margin="3" Style="{StaticResource SecondaryButton}" />
      <Button Content="6" Click="Digit_Click" Margin="3" Style="{StaticResource SecondaryButton}" />
      <Button Content="+" Click="Op_Click" Tag="+" Margin="3" Style="{StaticResource FrostedMintPillButton}" />
      <Button Content="1" Click="Digit_Click" Margin="3" Style="{StaticResource SecondaryButton}" />
      <Button Content="2" Click="Digit_Click" Margin="3" Style="{StaticResource SecondaryButton}" />
      <Button Content="3" Click="Digit_Click" Margin="3" Style="{StaticResource SecondaryButton}" />
      <Button Content="=" Click="Equals_Click" Margin="3" Style="{StaticResource PrimaryButton}" />
      <Button Content="0" Click="Digit_Click" Margin="3" Style="{StaticResource SecondaryButton}" />
      <Button Content="." Click="Digit_Click" Margin="3" Style="{StaticResource SecondaryButton}" />
      <Button Content="%" Click="Percent_Click" Margin="3" Style="{StaticResource FrostedMintPillButton}" />
      <Button Content="±" Click="Sign_Click" Margin="3" Style="{StaticResource FrostedMintPillButton}" />
    </UniformGrid>
  </DockPanel>
</Window>
