<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.PrescriptionLinkStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/Icons/app.ico"
        Title="Link to stock / brand"
        Height="480"
        Width="560"
        MinHeight="360"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="Link to stock / brand" FontSize="18" FontWeight="SemiBold" />
      <DockPanel Margin="0,8,0,0">
        <Button DockPanel.Dock="Right" Content="Search" Height="32" MinWidth="80" Margin="8,0,0,0" Padding="10,4" Click="Search_Click" />
        <TextBox x:Name="QueryBox" Height="32" Padding="8,4" BorderBrush="#CBD5E1" KeyDown="QueryBox_KeyDown" />
      </DockPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" Foreground="#FFB42318" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Content="Cancel" IsCancel="True" Height="34" MinWidth="90" Margin="0,0,8,0" Padding="10,4" />
      <Button Content="Use selected" Height="34" MinWidth="110" Padding="10,4" IsDefault="True" Click="Use_Click" />
    </StackPanel>
    <ListBox x:Name="ResultsList" DisplayMemberPath="Title">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail}" Foreground="#FF475467" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
