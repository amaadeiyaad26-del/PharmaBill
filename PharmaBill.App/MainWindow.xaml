                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Value="True" Binding="{Binding GoogleDriveConnected}">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                            </Button>
                            <Button Content="Test connection" Height="36" Margin="0,0,6,4" Style="{StaticResource SecondaryButton}" Command="{Binding TestGoogleDriveConnectionCommand}" IsEnabled="{Binding GoogleDriveConnected}" />
                            <Button Content="Upload backup" Height="36" Margin="0,0,6,4" Style="{StaticResource SecondaryButton}" Command="{Binding UploadGoogleDriveBackupCommand}" IsEnabled="{Binding GoogleDriveConnected}" />
                            <Button Content="Restore" Height="36" Margin="0,0,6,4" Style="{StaticResource SecondaryButton}" Command="{Binding DownloadGoogleDriveBackupCommand}" IsEnabled="{Binding GoogleDriveConnected}" />
