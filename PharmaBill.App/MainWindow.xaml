                <DataGridTextColumn Header="SGST" Width="80" Binding="{Binding Sgst, StringFormat=N2}" />
                <DataGridTextColumn Header="IGST" Width="80" Binding="{Binding Igst, StringFormat=N2}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock FontWeight="SemiBold" FontSize="16" Text="GSTR-1 Table 7 (B2C by slab)" Margin="0,0,0,8" Foreground="#0D4A2B" />
            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="140" Margin="0,0,0,12" ItemsSource="{Binding Gstr1B2cRows}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Slab %" Width="80" Binding="{Binding TaxRate, StringFormat=0.##}" />
                <DataGridTextColumn Header="Taxable" Width="100" Binding="{Binding TaxableValue, StringFormat=N2}" />
                <DataGridTextColumn Header="CGST" Width="90" Binding="{Binding Cgst, StringFormat=N2}" />
                <DataGridTextColumn Header="SGST" Width="90" Binding="{Binding Sgst, StringFormat=N2}" />
                <DataGridTextColumn Header="IGST" Width="90" Binding="{Binding Igst, StringFormat=N2}" />
                <DataGridTextColumn Header="Invoices" Width="80" Binding="{Binding InvoiceCount}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock FontWeight="SemiBold" FontSize="16" Text="GSTR-1 Table 12 (HSN)" Margin="0,0,0,8" Foreground="#0D4A2B" />
            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="160" Margin="0,0,0,12" ItemsSource="{Binding Gstr1HsnRows}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="HSN" Width="100" Binding="{Binding HsnCode}" />
                <DataGridTextColumn Header="Qty" Width="80" Binding="{Binding Quantity, StringFormat=0.##}" />
                <DataGridTextColumn Header="Taxable" Width="100" Binding="{Binding TaxableValue, StringFormat=N2}" />
                <DataGridTextColumn Header="CGST" Width="90" Binding="{Binding Cgst, StringFormat=N2}" />
                <DataGridTextColumn Header="SGST" Width="90" Binding="{Binding Sgst, StringFormat=N2}" />
                <DataGridTextColumn Header="IGST" Width="90" Binding="{Binding Igst, StringFormat=N2}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock FontWeight="SemiBold" FontSize="16" Text="GSTR-2B reconciliation" Margin="0,0,0,8" Foreground="#0D4A2B" />
            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180" Margin="0,0,0,12" ItemsSource="{Binding Gstr2bReconRows}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Invoice" Width="120" Binding="{Binding InvoiceNo}" />
                <DataGridTextColumn Header="Status" Width="100" Binding="{Binding MatchStatus}" />
                <DataGridTextColumn Header="Books taxable" Width="100" Binding="{Binding BooksTaxable, StringFormat=N2}" />
                <DataGridTextColumn Header="Portal taxable" Width="100" Binding="{Binding PortalTaxable, StringFormat=N2}" />
                <DataGridTextColumn Header="Books ITC" Width="90" Binding="{Binding BooksItc, StringFormat=N2}" />
                <DataGridTextColumn Header="Portal ITC" Width="90" Binding="{Binding PortalItc, StringFormat=N2}" />
                <DataGridTextColumn Header="Notes" Width="*" Binding="{Binding Notes}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock FontWeight="SemiBold" FontSize="16" Text="GSTR-3B worksheet preview" Margin="0,0,0,8" Foreground="#0D4A2B" />
            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="280" ItemsSource="{Binding Gstr3bRows}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Section" Width="80" Binding="{Binding Section}" />
                <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}" />
                <DataGridTextColumn Header="Taxable" Width="100" Binding="{Binding TaxableValue, StringFormat=N2}" />
                <DataGridTextColumn Header="IGST" Width="90" Binding="{Binding IntegratedTax, StringFormat=N2}" />
                <DataGridTextColumn Header="CGST" Width="90" Binding="{Binding CentralTax, StringFormat=N2}" />
                <DataGridTextColumn Header="SGST" Width="90" Binding="{Binding StateTax, StringFormat=N2}" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:WholesaleBillingPageViewModel}}" DataType="{x:Type vm:WholesaleBillingPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <controls:BindingProxy x:Key="WholesaleBillingProxy" Data="{Binding}" />
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <Grid behaviors:KeyNavigationBehavior.Enabled="True">
            <Grid.InputBindings>
              <KeyBinding Key="F2" Command="{Binding NewBillCommand}" />
              <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NewBillCommand}" />
              <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding NewBillCommand}" />
              <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewBillCommand}" />
              <KeyBinding Key="F3" Command="{Binding FocusPatientCommand}" />
              <KeyBinding Key="D3" Modifiers="Control" Command="{Binding FocusPatientCommand}" />
              <KeyBinding Key="P" Modifiers="Control" Command="{Binding FocusPatientCommand}" />
              <KeyBinding Key="F4" Command="{Binding FocusMedicineSearchCommand}" />
              <KeyBinding Key="D4" Modifiers="Control" Command="{Binding FocusMedicineSearchCommand}" />
              <KeyBinding Key="M" Modifiers="Control" Command="{Binding FocusMedicineSearchCommand}" />
              <KeyBinding Key="F5" Command="{Binding ShowSubstitutesCommand}" />
              <KeyBinding Key="D5" Modifiers="Control" Command="{Binding ShowSubstitutesCommand}" />
              <KeyBinding Key="F7" Command="{Binding ExtractOrderDocumentsCommand}" />
              <KeyBinding Key="D7" Modifiers="Control" Command="{Binding ExtractOrderDocumentsCommand}" />
              <KeyBinding Key="D" Modifiers="Control" Command="{Binding ExtractOrderDocumentsCommand}" />
              <KeyBinding Key="F8" Command="{Binding HoldBillCommand}" />
              <KeyBinding Key="H" Modifiers="Control" Command="{Binding HoldBillCommand}" />
              <KeyBinding Key="F9" Command="{Binding FocusPaymentCommand}" />
              <KeyBinding Key="D9" Modifiers="Control" Command="{Binding FocusPaymentCommand}" />
              <KeyBinding Key="T" Modifiers="Control" Command="{Binding FocusPaymentCommand}" />
              <KeyBinding Key="F10" Command="{Binding SaveAndPrintCommand}" />
              <KeyBinding Key="Return" Modifiers="Control" Command="{Binding SaveAndPrintCommand}" />
              <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SaveAndPrintCommand}" />
              <KeyBinding Key="D0" Modifiers="Control" Command="{Binding SaveAndPrintCommand}" />
              <KeyBinding Key="F11" Command="{Binding ShowPaymentQrCommand}" />
              <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ShowPaymentQrCommand}" />
              <KeyBinding Key="F12" Command="{Binding DataContext.ShortcutOpenCalculatorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <KeyBinding Key="K" Modifiers="Control" Command="{Binding DataContext.ShortcutOpenCalculatorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <KeyBinding Key="Escape" Command="{Binding CancelBillCommand}" />
              <KeyBinding Key="W" Modifiers="Control" Command="{Binding CancelBillCommand}" />
            </Grid.InputBindings>
          <StackPanel Margin="18">
            <Border Background="#FFFFFAEB" BorderBrush="#FFFEC84B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                    Visibility="{Binding DataContext.ShowAnnualLicenseWarning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock TextWrapping="Wrap" Foreground="#FFB54708" FontWeight="SemiBold"
                         Text="{Binding DataContext.AnnualLicenseWarningText, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Border>
            <DockPanel Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Wholesale Invoice / B2B Sale" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="B2B tax invoice to retailers / hospitals / pharmacies — not patient retail billing" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                <WrapPanel Margin="0,6,0,0">
                  <Border Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF1D4ED8" Text="F2/Ctrl+N New" />
                  </Border>
                  <Border Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF1D4ED8" Text="F3/Ctrl+P Retailer" />
                  </Border>
                  <Border Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF1D4ED8" Text="F4/Ctrl+M Medicine" />
                  </Border>
                  <Border Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF1D4ED8" Text="F9/Ctrl+T Payment" />
                  </Border>
                  <Border Background="#FFECFDF5" BorderBrush="#FFA7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF047857" Text="F10/Ctrl+↵ Save" />
                  </Border>
                </WrapPanel>
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Margin="0,0,8,0" MinHeight="36" Padding="12,6" Style="{StaticResource SecondaryButton}" Command="{Binding NewBillCommand}" ToolTip="Clear form and start a new invoice (F2)">
                  <TextBlock FontWeight="SemiBold" Text="F2 New Invoice" />
                </Button>
                <Button Margin="0,0,8,0" MinHeight="36" Padding="12,6" Style="{StaticResource PrimaryButton}" Command="{Binding ExtractOrderDocumentsCommand}" ToolTip="Read a patient or customer order PDF or image and add matching in-stock lines to this wholesale bill.">
                  <TextBlock FontWeight="SemiBold" Text="📄 Extract from Invoice (PDF / Images)" />
                </Button>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding InvoiceNoPreview, StringFormat=Invoice no: {0}}" />
              </StackPanel>
            </DockPanel>
            <Border Padding="14" Margin="0,0,0,12" CornerRadius="8" Background="{DynamicResource ContentBackgroundBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Buyer / Retailer (B2B) — F3" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Retailer / Pharmacy Business Name *" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="Select from Saved Customer list — Enter moves to medicine search" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}" />
                <DockPanel Margin="0,0,0,6" LastChildFill="True">
                  <Button DockPanel.Dock="Right"
                          Margin="8,0,0,0"
                          MinHeight="36"
                          Padding="12,6"
                          VerticalAlignment="Top"
                          Style="{StaticResource SecondaryButton}"
                          Visibility="{Binding ShowAddNewRetailerOption, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Content="{Binding AddNewRetailerCaption}"
                          ToolTip="Save this typed name as a new retailer in Customers master"
                          Command="{Binding AddNewRetailerCommand}" />
                  <Grid MaxWidth="520" HorizontalAlignment="Left">
                    <ComboBox x:Name="WholesaleRetailerSearchBox"
                              MinHeight="36"
                              Padding="8,6"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              MaxDropDownHeight="240"
                              ToolTip="Type to search saved retailers by name, GSTIN, or phone (F3). Enter advances to medicine."
                              PreviewKeyDown="WholesaleRetailerSearchBox_PreviewKeyDown"
                              ItemsSource="{Binding FilteredCustomers}"
                              SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                              Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                              IsDropDownOpen="{Binding IsCustomerDropDownOpen, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="2,1">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock FontSize="11" Foreground="#FF64748B">
                              <Run Text="{Binding Gstin, TargetNullValue=No GSTIN}" />
                              <Run Text=" · " />
                              <Run Text="{Binding Phone, TargetNullValue=No phone}" />
                            </TextBlock>
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Margin="12,0,28,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="#FF64748B"
                               Text="Search or select saved retailer / pharmacy..."
                               Visibility="{Binding ShowRetailerSearchPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                </DockPanel>
                <TextBlock Margin="0,0,0,8"
                           FontSize="12"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowAddNewRetailerOption, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Text="No exact match in Customers master. Use + Add as New Retailer to save DL / GSTIN / address for autofill." />
                <UniformGrid Columns="2" Margin="0,4,0,0">
                  <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Drug License (DL) Number *" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox IsReadOnly="True" Padding="8,6" Text="{Binding BuyerDrugLicence, Mode=OneWay}"
                             ToolTip="Auto-filled from party master (Form 20B / 21B)."
                             Background="{DynamicResource FieldReadOnlyBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="GSTIN (15 chars, optional if unregistered)" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox IsReadOnly="True" Padding="8,6" Text="{Binding BuyerGstin, Mode=OneWay}"
                             Background="{DynamicResource FieldReadOnlyBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Phone Number" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox IsReadOnly="True" Padding="8,6" Text="{Binding BuyerPhone, Mode=OneWay}"
                             Background="{DynamicResource FieldReadOnlyBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Credit Period / Due Date" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox IsReadOnly="True" Padding="8,6" Text="{Binding BuyerDueDateDisplay, Mode=OneWay}"
                             Background="{DynamicResource FieldReadOnlyBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" />
                  </StackPanel>
                </UniformGrid>
                <TextBlock Text="Billing Address" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox IsReadOnly="True" Padding="8,6" TextWrapping="Wrap" MinHeight="40" Text="{Binding BuyerAddress, Mode=OneWay}"
                         Background="{DynamicResource FieldReadOnlyBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
              <TextBlock Text="Medicine / batch (F4)" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
              <controls:InfoHelper Title="Unified medicine search" Body="Type a brand or molecule. In-stock batches appear first (FEFO with PTR/MRP). Catalogue / out-of-stock hits open Quick Inward so you can add a batch before billing — zero-stock lines cannot be billed. Enter selects and focuses Qty; Ctrl+Enter also adds the line." />
            </StackPanel>
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="+ New Medicine" MinWidth="150" Padding="14,8" Margin="8,0,0,0" MinHeight="36" Style="{StaticResource SecondaryButton}" Command="{Binding QuickAddMedicineCommand}" ToolTip="Create a medicine. Text already typed in the search box is filled in as the brand name." />
              <Button DockPanel.Dock="Right" Content="Add line" Padding="14,8" Margin="8,0,0,0" MinHeight="36" Style="{StaticResource PrimaryButton}" Command="{Binding AddLineCommand}" ToolTip="Add the highlighted medicine to this wholesale invoice and focus Qty. F4 jumps to search. Ctrl+Enter also adds the line." />
              <Grid>
                <ComboBox x:Name="WholesaleMedicineSearchBox"
                          MinHeight="36"
                          Padding="8,6"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          MaxDropDownHeight="320"
                          ToolTip="F4 jumps here. Type a brand or molecule. Arrows highlight a result. Enter adds that line and focuses Qty. Out-of-stock names open Quick Inward before they can be billed."
                          PreviewKeyDown="WholesaleMedicineSearchBox_PreviewKeyDown"
                          ItemsSource="{Binding MedicinePickerItems}"
                          SelectedItem="{Binding SelectedMedicineItem, UpdateSourceTrigger=PropertyChanged}"
                          Text="{Binding MedicineSearchText, UpdateSourceTrigger=PropertyChanged}"
                          IsDropDownOpen="{Binding IsMedicineDropDownOpen, Mode=TwoWay}">
                  <ComboBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                      <EventSetter Event="PreviewMouseLeftButtonUp" Handler="WholesaleMedicineItem_Click" />
                    </Style>
                  </ComboBox.ItemContainerStyle>
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="2,3">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF64748B" Text="{Binding GroupKey}" />
                        <TextBlock FontWeight="SemiBold" Foreground="#FF0F172A" Text="{Binding DisplayTitle}" />
                        <TextBlock FontSize="11" Foreground="#FF334155" TextWrapping="Wrap" Text="{Binding DisplayDetail}" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Margin="12,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#FF64748B" Text="{Binding StockPickerPlaceholder}" Visibility="{Binding ShowStockPickerPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </Grid>
            </DockPanel>
            <Button Margin="0,4,0,4" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButton}" Command="{Binding SearchOnlineCommand}" Visibility="{Binding ShowOnlineLookup, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{Binding OnlineLookupCaption}" TextWrapping="Wrap" />
            </Button>
            <Button Margin="0,0,0,4" HorizontalAlignment="Left" Padding="14,8" Style="{StaticResource SecondaryButton}" Command="{Binding QuickAddMedicineCommand}" Visibility="{Binding ShowCreateUnlisted, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Save this search text as a new medicine and add it to the invoice">
              <TextBlock Text="{Binding CreateUnlistedCaption}" TextWrapping="Wrap" />
            </Button>
            <Border Margin="0,8,0,4" Padding="12,8" CornerRadius="8" Background="#FFFFF1F0" BorderBrush="#FFFDA29B" BorderThickness="1" Visibility="{Binding HasCreditLockAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Foreground="#FFB42318" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CreditLockAlert}" />
            </Border>
            <DataGrid x:Name="WholesaleBillGrid"
                      Style="{StaticResource BillingLineDataGrid}"
                      behaviors:RowFlash.Enabled="True"
                      behaviors:BillingInlineEdit.SearchElementName="WholesaleMedicineSearchBox"
                      behaviors:BillingInlineEdit.FocusQtyRequest="{Binding FocusQtyRequest}"
                      behaviors:BillingInlineEdit.FocusTargetField="{Binding LineFocusField}"
                      AutoGenerateColumns="False"
                      MinHeight="180"
                      Margin="0,10,0,6"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedLine}">
              <UIElement.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding RemoveSelectedLineCommand}" />
              </UIElement.InputBindings>
              <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Setter Property="Focusable" Value="False" />
                  <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                  <Setter Property="Padding" Value="4,2" />
                </Style>
              </DataGrid.Resources>
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="3*" IsReadOnly="True">
                  <DataGridColumn.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Drug / batch / expiry / stock" VerticalAlignment="Center" />
                      <controls:InfoHelper Title="Drug / batch / expiry / stock" Body="Select the selling batch. FEFO prefers nearer expiry. Stock shows units left on that batch. Price defaults to the batch MRP; change rate only if trade rate ≤ MRP." />
                    </StackPanel>
                  </DataGridColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox Style="{StaticResource StockPickerComboBox}"
                                IsTabStop="False"
                                IsEnabled="True"
                                ItemsSource="{Binding BatchOptions}"
                                SelectedItem="{Binding StockChoice, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Oldest valid batch is selected when you press Enter on the medicine. Open this list to bill a different batch.">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:Key="{DataTemplateKey {x:Type vm:WholesaleStockChoice}}" DataType="{x:Type vm:WholesaleStockChoice}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock FontWeight="SemiBold" Foreground="#FF1E293B" Text="{Binding DrugName}" />
                              <TextBlock Foreground="#FF334155" Text="{Binding BatchNo, StringFormat=·  Batch {0}}" />
                              <TextBlock Foreground="#FF475569" Text="{Binding ExpiryDate, StringFormat=·  Exp {0:MM/yyyy}}" />
                              <TextBlock Foreground="#FF047857" FontWeight="SemiBold" Text="{Binding Available, StringFormat=·  Stock {0:0.##}}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ComboBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Unit" Width="86">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox Style="{StaticResource BillingInlineComboBox}"
                                behaviors:BillingInlineEdit.Field="Unit"
                                ItemsSource="{Binding Data.SaleUnits, Source={StaticResource WholesaleBillingProxy}}"
                                SelectedItem="{Binding SaleUnit, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Qty" Width="72">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox Style="{StaticResource BillingInlineEditBox}"
                               behaviors:BillingInlineEdit.Field="Qty"
                               Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="64">
                  <DataGridColumn.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Free" VerticalAlignment="Center" />
                      <controls:InfoHelper Title="Free quantity (bonus / scheme)" Body="Scheme/free units in the selected sale unit. Inventory deduction uses Qty × pack conversion. GST applies only to billed Qty × Rate." />
                    </StackPanel>
                  </DataGridColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox Style="{StaticResource BillingInlineEditBox}"
                               behaviors:BillingInlineEdit.Field="Free"
                               Text="{Binding FreeQuantity, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="MRP" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox behaviors:BillingInlineEdit.Field="Mrp" Text="{Binding MrpText, UpdateSourceTrigger=LostFocus}" ToolTip="Enter MRP for this batch. It is saved on the batch so the next bill remembers it.">
                        <TextBox.Style>
                          <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BillingInlineEditBox}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding RequiresMrp}" Value="True">
                                <Setter Property="Background" Value="#FFFEF3C7" />
                                <Setter Property="Foreground" Value="#FFB45309" />
                                <Setter Property="ToolTip" Value="MRP Required / ₹0.00" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="88">
                  <DataGridColumn.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Rate / PTR" VerticalAlignment="Center" />
                      <controls:InfoHelper Title="Wholesale rate (PTR)" Body="Defaults to Price to Retailer (PTR). Must not exceed MRP. Amount = (Rate × base qty after pack conversion) − Discount %, then GST." />
                    </StackPanel>
                  </DataGridColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox Style="{StaticResource BillingInlineEditBox}"
                               behaviors:BillingInlineEdit.Field="Rate"
                               Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Disc %" Width="68">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox Style="{StaticResource BillingInlineEditBox}"
                               behaviors:BillingInlineEdit.Field="Discount"
                               Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Amount" Width="92" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource BillingInlineReadonlyText}"
                                 FontWeight="SemiBold"
                                 Text="{Binding LineAmount, Mode=OneWay, StringFormat=₹{0:N2}}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Pack" Width="70" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource BillingInlineReadonlyText}" Text="{Binding PackLabel, Mode=OneWay}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
