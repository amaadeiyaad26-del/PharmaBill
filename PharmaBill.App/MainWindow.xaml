                      <TextBlock Margin="16,0,0,0" Text="{Binding ExpiryDate, StringFormat=Expiry {0:d}}" />
                      <TextBlock Margin="16,0,0,0" Text="{Binding Mrp, StringFormat=MRP ₹{0:N2}}" />
                      <TextBlock Margin="16,0,0,0" Text="{Binding AvailableQuantity, StringFormat=Stock {0}}" />
