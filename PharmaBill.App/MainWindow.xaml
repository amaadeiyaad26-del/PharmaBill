                            </Decorator.Child>
                          </Border>
                          <Border Background="#FFFFEDD5" CornerRadius="7" Padding="5,1" Margin="5,0,0,0" Visibility="{Binding IsHabitForming, Converter={StaticResource BooleanToVisibilityConverter}}">
