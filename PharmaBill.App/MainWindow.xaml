              <TextBlock Text="Pharmacist must confirm suitability and prescription rules" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,4" Visibility="{Binding HasSubstitutes, Converter={StaticResource BooleanToVisibilityConverter}}" />
