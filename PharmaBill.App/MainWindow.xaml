                    <TextBox Name="PaymentAmountBox" Text="{Binding Path=PaymentAmount, UpdateSourceTrigger=PropertyChanged}" />
                  </controls:FloatingField>
                  <controls:FloatingField Grid.Row="1" Grid.Column="0" Label="Cash handed over (₹)" ToolTip="Cash tendered for change calculation" Visibility="{Binding IsCashPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox Text="{Binding Path=CashTendered, UpdateSourceTrigger=PropertyChanged}" />
                  </controls:FloatingField>
                  <controls:FloatingField Grid.Row="1" Grid.Column="1" Label="Change due (₹)" Visibility="{Binding IsCashPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox IsReadOnly="True" IsTabStop="False" Text="{Binding Path=ChangeDueValue, Mode=OneWay}" />
