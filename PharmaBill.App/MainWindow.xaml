                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Expiry" Width="90" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource BillingInlineReadonlyText}" Text="{Binding ExpiryDate, StringFormat=d, Mode=OneWay}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="MRP" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBox behaviors:BillingInlineEdit.Field="Mrp" Text="{Binding MrpText, UpdateSourceTrigger=LostFocus}" ToolTip="Enter MRP for this batch. It is saved on the batch so the next bill remembers it.">
                          <TextBox.Style>
                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BillingInlineEditBox}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding RequiresMrp}" Value="True">
                                  <Setter Property="Background" Value="#FFFEF3C7" />
                                  <Setter Property="Foreground" Value="#FFB45309" />
                                  <Setter Property="ToolTip" Value="MRP Required / ₹0.00" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBox.Style>
                        </TextBox>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Qty" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBox Style="{StaticResource BillingInlineEditBox}"
                                 behaviors:BillingInlineEdit.Field="Qty"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Stock" Width="70" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource BillingInlineReadonlyText}" Text="{Binding StockQuantity, Mode=OneWay}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Rate" Width="80">
