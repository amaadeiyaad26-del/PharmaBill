<Window x:Class="PharmaBill.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PharmaBill.App.ViewModels"
        xmlns:controls="clr-namespace:PharmaBill.App.Controls"
        Title="PharmaBill"
        Height="780"
        Width="1280"
        MinHeight="650"
        MinWidth="1000"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FlowDirection="{Binding FlowDirection}">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PharmaBill dashboard" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastUpdated, StringFormat='Updated {0:dd-MMM-yyyy HH:mm}'}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="14,7" Margin="20,4" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="#FFB42318"
                           TextWrapping="Wrap" Margin="0,0,0,10" />
                <UniformGrid Columns="3" Rows="2" VerticalAlignment="Top">
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="5">
                        <StackPanel><TextBlock Text="Today's sales" /><TextBlock Text="{Binding Snapshot.TodaySales, StringFormat='&#8377;{0:N2}'}" FontSize="25" FontWeight="Bold" /></StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="5">
                        <StackPanel><TextBlock Text="This month's sales" /><TextBlock Text="{Binding Snapshot.MonthSales, StringFormat='&#8377;{0:N2}'}" FontSize="25" FontWeight="Bold" /></StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="5">
                        <StackPanel><TextBlock Text="Expiring within 90 days" /><TextBlock Text="{Binding Snapshot.ExpiringSoonBatches}" FontSize="25" FontWeight="Bold" /></StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="5">
                        <StackPanel><TextBlock Text="Low-stock medicines" /><TextBlock Text="{Binding Snapshot.LowStockDrugs}" FontSize="25" FontWeight="Bold" /></StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="5">
                        <StackPanel><TextBlock Text="Wholesale outstanding" /><TextBlock Text="{Binding Snapshot.WholesaleOutstanding, StringFormat='&#8377;{0:N2}'}" FontSize="25" FontWeight="Bold" /></StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="5">
                        <StackPanel><TextBlock Text="Register entries today" /><TextBlock Text="{Binding Snapshot.RegisterAlerts}" FontSize="25" FontWeight="Bold" /></StackPanel>
                    </Border>
                </UniformGrid>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsPageViewModel}">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Reports" FontSize="24" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,8">
                        <ComboBox Width="190" ItemsSource="{Binding ReportChoices}" SelectedItem="{Binding SelectedReport}"
                                  DisplayMemberPath="Name" Padding="6" />
                        <ComboBox Width="140" ItemsSource="{Binding Months}" SelectedValue="{Binding SelectedMonth}"
                                  SelectedValuePath="Number" DisplayMemberPath="Name" Padding="6" Margin="6,0" />
                        <ComboBox Width="100" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}"
                                  Padding="6" />
                        <Button Content="â† Previous" Command="{Binding PreviousMonthCommand}" Padding="10,6" Margin="6,0" />
                        <Button Content="Next â†’" Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanNavigateNext}" Padding="10,6" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,6" Margin="6,0" />
                        <Button Content="PDF" Command="{Binding ExportPdfCommand}" Padding="10,6" />
                        <Button Content="Excel" Command="{Binding ExportExcelCommand}" Padding="10,6" Margin="6,0" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Today" Command="{Binding SelectQuickPeriodCommand}" CommandParameter="Today" Padding="10,5" />
                        <Button Content="This month" Command="{Binding SelectQuickPeriodCommand}" CommandParameter="This month" Padding="10,5" Margin="5,0" />
                        <Button Content="Last month" Command="{Binding SelectQuickPeriodCommand}" CommandParameter="Last month" Padding="10,5" />
                        <Button Content="Last 3 months" Command="{Binding SelectQuickPeriodCommand}" CommandParameter="Last 3 months" Padding="10,5" Margin="5,0" />
                        <Button Content="This year" Command="{Binding SelectQuickPeriodCommand}" CommandParameter="This year" Padding="10,5" />
                        <TextBlock Text="Custom:" VerticalAlignment="Center" Margin="12,0,5,0" />
                        <DatePicker SelectedDate="{Binding FromDate}" />
                        <TextBlock Text="to" VerticalAlignment="Center" Margin="5,0" />
                        <DatePicker SelectedDate="{Binding ToDate}" />
                        <Button Content="Run custom period" Command="{Binding RefreshCommand}" Padding="10,5" Margin="5,0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding PeriodLabel}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Table}" AutoGenerateColumns="True" IsReadOnly="True"
                          CanUserAddRows="False" FrozenColumnCount="1" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="Encrypted backup and move to a new PC" FontSize="24" FontWeight="SemiBold" />
                    <Border Background="#FFFFF4E5" CornerRadius="8" Padding="10" Margin="0,10">
                        <TextBlock Text="Keep your backup password separately. It is required to restore or move the encrypted data to another PC. A backup older than 7 days needs attention."
                                   TextWrapping="Wrap" Foreground="#FF93370D" />
                    </Border>
                    <TextBlock Text="{Binding IsBackupOlderThanSevenDays, StringFormat='Backup older than 7 days (or none): {0}'}"
                               FontWeight="Bold" Foreground="#FFB42318" />
                    <TextBlock Text="{Binding LastBackupAtUtc, StringFormat='Last successful backup (UTC): {0:yyyy-MM-dd HH:mm}'}" Margin="0,4,0,8" />
                    <TextBlock Text="Backup password (at least 10 characters)" />
                    <PasswordBox controls:PasswordBoxBinding.Password="{Binding BackupPassword, Mode=TwoWay}"
                                 Padding="7" Margin="0,3,0,9" />
                    <TextBlock Text="Automatic daily backup folder" />
                    <DockPanel Margin="0,3,0,8">
                        <Button DockPanel.Dock="Right" Content="Choose folder" Command="{Binding ChoosePrimaryFolderCommand}" Padding="10,6" Margin="6,0" />
                        <TextBox Text="{Binding PrimaryFolder}" Padding="7" />
                    </DockPanel>
                    <TextBlock Text="Optional second copy (USB drive or OneDrive / Google Drive sync folder)" />
                    <DockPanel Margin="0,3,0,8">
                        <Button DockPanel.Dock="Right" Content="Choose folder" Command="{Binding ChooseSecondaryFolderCommand}" Padding="10,6" Margin="6,0" />
                        <TextBox Text="{Binding SecondaryFolder}" Padding="7" />
                    </DockPanel>
                    <CheckBox Content="Enable automatic daily encrypted backup while PharmaBill is running"
                              IsChecked="{Binding AutomaticEnabled}" Margin="0,4,0,10" />
                    <WrapPanel>
                        <Button Content="Save backup settings" Command="{Binding SaveSettingsCommand}" Padding="12,7" />
                        <Button Content="Back up now" Command="{Binding CreateBackupCommand}" Padding="12,7" Margin="7,0" />
                        <Button Content="Restore backup" Command="{Binding RestoreBackupCommand}" Padding="12,7" />
                    </WrapPanel>
                    <TextBlock Text="Move to a new PC" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,5" />
                    <TextBlock Text="Export everything creates the same encrypted package, including the database and stored attachments. On the new PC, install PharmaBill and choose Import on new PC, then enter the backup password."
                               TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8">
                        <Button Content="Export everything" Command="{Binding ExportEverythingCommand}" Padding="12,7" />
                        <Button Content="Import on new PC" Command="{Binding ImportOnNewPcCommand}" Padding="12,7" Margin="7,0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,8" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SyncSettingsPageViewModel}">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Offline device sync" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Packages move only by file, USB or a folder you choose. No network sync is enabled."
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,8" />
                    <WrapPanel>
                        <TextBlock Text="This device ID:" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Text="{Binding LocalDeviceId, Mode=OneWay}" IsReadOnly="True" Width="300" Margin="5,0,10,0" Padding="5" />
                        <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="This device's display name" Padding="5" />
                        <TextBlock Text="{Binding PendingChangeCount, StringFormat='Pending changes: {0}'}" VerticalAlignment="Center" Margin="12,0" />
                        <TextBlock Text="{Binding UnresolvedConflictCount, StringFormat='Unresolved conflicts: {0}'}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Text="{Binding LastExchangeAtUtc, StringFormat='Last device exchange (UTC): {0:yyyy-MM-dd HH:mm}'}"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PackageStatus}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                    <GroupBox Header="Google Drive / Cloud Folder Sync" Margin="0,8,0,8" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Text="{Binding SyncFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True" Padding="6" VerticalAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="1" Content="Choose folder"
                                    Command="{Binding ChooseSyncFolderCommand}" Padding="10,6" Margin="6,0,0,0" />
                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                <Button Content="Sync Now" Command="{Binding SyncNowCommand}" Padding="12,6" />
                                <CheckBox Content="Background auto-sync" IsChecked="{Binding AutoSyncEnabled}"
                                          VerticalAlignment="Center" Margin="12,0" />
                                <Border CornerRadius="10" Padding="8,3" Margin="6,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFECFDF3" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FolderSyncStatus}" Value="Syncing">
                                                    <Setter Property="Background" Value="#FFEFF8FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FolderSyncStatus}" Value="Error">
                                                    <Setter Property="Background" Value="#FFFFF1F0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding FolderSyncStatus}" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding LastFolderSyncAtUtc, StringFormat='Last sync: {0:dd-MMM-yyyy HH:mm} UTC'}"
                                           VerticalAlignment="Center" Margin="8,0" />
                                <TextBlock Text="{Binding LastOutgoingPackages, StringFormat='Outgoing packages: {0}'}"
                                           VerticalAlignment="Center" Margin="8,0" />
                                <TextBlock Text="{Binding LastIncomingPackages, StringFormat='Incoming: {0}'}"
                                           VerticalAlignment="Center" Margin="8,0" />
                                <TextBlock Text="{Binding LastAppliedChanges, StringFormat='Changes applied: {0}'}"
                                           VerticalAlignment="Center" Margin="8,0" />
                            </WrapPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Cloud Sync (optional, self-hosted server)" Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Server URL (https://...)" />
                            <TextBox Text="{Binding CloudServerUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,3,0,8" />
                            <TextBlock Text="Branch API key" />
                            <PasswordBox controls:PasswordBoxBinding.Password="{Binding CloudApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6" Margin="0,3,0,8" />
                            <WrapPanel>
                                <CheckBox Content="Enable cloud sync (every 5 minutes)" IsChecked="{Binding CloudSyncEnabled}"
                                          VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="Save" Command="{Binding SaveCloudSettingsCommand}" Padding="12,6" Margin="0,0,6,0" />
                                <Button Content="Sync Now" Command="{Binding CloudSyncNowCommand}" Padding="12,6" />
                                <TextBlock Text="{Binding CloudSyncStatus, StringFormat='Status: {0}'}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0" />
                                <TextBlock Text="{Binding LastCloudSyncAtUtc, StringFormat='Last sync: {0:dd-MMM-yyyy HH:mm} UTC'}"
                                           VerticalAlignment="Center" Margin="8,0" />
                                <TextBlock Text="{Binding LastCloudPushed, StringFormat='Sent: {0}'}" VerticalAlignment="Center" Margin="8,0" />
                                <TextBlock Text="{Binding LastCloudPulled, StringFormat='Received: {0}'}" VerticalAlignment="Center" Margin="8,0" />
                            </WrapPanel>
                            <TextBlock Text="{Binding CloudSyncWarning}" Foreground="#FFB54708" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </GroupBox>
                    <TextBlock Text="{Binding FolderSyncWarning}" Foreground="#FFB54708"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                </StackPanel>
                <TabControl>
                    <TabItem Header="Devices / package exchange">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6">
                                    <Button Content="Revoke selected" Command="{Binding RevokeDeviceCommand}" Padding="10,6" />
                                    <Button Content="Import sync package" Command="{Binding ImportPackageCommand}" Padding="10,6" Margin="6,0" />
                                    <Button Content="Export to selected" Command="{Binding ExportPackageCommand}" Padding="10,6" />
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*" />
                                        <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="90" />
                                        <DataGridCheckBoxColumn Header="This PC" Binding="{Binding IsCurrentDevice}" Width="70" />
                                        <DataGridTextColumn Header="Last exchange (UTC)" Binding="{Binding LastSyncAtUtc}" Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Pair devices offline" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="On either device, generate a one-time code. Enter that same code and the other device ID on both PCs within ten minutes."
                                               TextWrapping="Wrap" Margin="0,3,0,6" />
                                    <WrapPanel>
                                        <Button Content="Generate one-time code" Command="{Binding GeneratePairingCodeCommand}" Padding="10,6" />
                                        <TextBox Text="{Binding GeneratedPairingCode}" IsReadOnly="True" Width="300" Margin="6,0" Padding="6" />
                                    </WrapPanel>
                                    <TextBox Text="{Binding PeerDeviceId}" ToolTip="Peer device ID" Margin="0,6,0,0" Padding="6" />
                                    <WrapPanel Margin="0,5">
                                        <TextBox Text="{Binding PeerName}" ToolTip="Peer device name" Width="180" Padding="6" />
                                        <ComboBox SelectedValue="{Binding PeerPlatform}" SelectedValuePath="Content" Width="120" Margin="6,0" Padding="6">
                                            <ComboBoxItem Content="Windows" IsSelected="True" />
                                            <ComboBoxItem Content="Android" />
                                        </ComboBox>
                                        <TextBox Text="{Binding PairingCode}" ToolTip="One-time pairing code" Width="300" Padding="6" />
                                    </WrapPanel>
                                    <Button Content="Pair device" Command="{Binding PairDeviceCommand}" HorizontalAlignment="Left" Padding="10,6" />
                                    <TextBlock Text="Pairing code material is used only to derive the random peer key; the key is DPAPI-protected and is never included in packages."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Review conflicts">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>
                            <DataGrid Grid.Column="0" ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Entity" Binding="{Binding EntityName}" Width="130" />
                                    <DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="*" />
                                    <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAtUtc}" Width="145" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Column="1" Margin="10,0,0,0">
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8">
                                    <TextBox Text="{Binding ConflictReason}" ToolTip="Required resolution reason" Padding="6" />
                                    <TextBlock Text="Stock conflicts are resolved only by posting a stock adjustment with a reason."
                                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4" />
                                    <WrapPanel Margin="0,6">
                                        <Button Content="Keep local" Command="{Binding KeepLocalCommand}" IsEnabled="{Binding CanResolveConflict}" Padding="10,6" />
                                        <Button Content="Accept remote" Command="{Binding AcceptRemoteCommand}" IsEnabled="{Binding CanAcceptRemote}" Padding="10,6" Margin="6,0" />
                                    </WrapPanel>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Local version" FontWeight="Bold" />
                                        <TextBox Text="{Binding SelectedConflict.LocalPayload}" IsReadOnly="True" TextWrapping="Wrap"
                                                 AcceptsReturn="True" MinHeight="100" Margin="0,3,0,8" />
                                        <TextBlock Text="Remote version / stock alert" FontWeight="Bold" />
                                        <TextBox Text="{Binding SelectedConflict.RemotePayload}" IsReadOnly="True" TextWrapping="Wrap"
                                                 AcceptsReturn="True" MinHeight="120" Margin="0,3,0,8" />
                                        <TextBlock Text="{Binding SelectedConflict.Resolution, StringFormat='Resolution: {0}'}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="File transfer queue">
                        <DataGrid ItemsSource="{Binding FileTransfers}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" />
                                <DataGridTextColumn Header="Owner entity" Binding="{Binding Entity}" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Length}" />
                                <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" />
                                <DataGridTextColumn Header="Retries" Binding="{Binding RetryCount}" />
                                <DataGridTextColumn Header="Last error" Binding="{Binding LastError}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WholesalePricingPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <TextBlock Text="Pack levels, batch rates and wholesale pricing" FontSize="23" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,10">
                        <ComboBox Width="360" ItemsSource="{Binding Drugs}" SelectedItem="{Binding SelectedDrug}"
                                  DisplayMemberPath="Name" Padding="6" />
                        <ComboBox Width="220" ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                                  DisplayMemberPath="BatchNo" Margin="8,0,0,0" Padding="6" />
                    </WrapPanel>
                    <TextBlock Text="Batch-specific purchase rate, PTR, PTS and MRP" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <WrapPanel>
                        <TextBox Width="145" Text="{Binding PurchaseRate}" ToolTip="Purchase rate" Padding="6" />
                        <TextBox Width="120" Text="{Binding Ptr}" ToolTip="PTR" Padding="6" Margin="6,0" />
                        <TextBox Width="120" Text="{Binding Pts}" ToolTip="PTS" Padding="6" />
                        <TextBox Width="120" Text="{Binding Mrp}" ToolTip="MRP" Padding="6" Margin="6,0" />
                        <Button Content="Save batch rates" Command="{Binding SaveBatchRatesCommand}" Padding="10,6" />
                    </WrapPanel>
                    <TextBlock Text="Pack conversions (all quantities convert to the medicine's base unit)" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <DataGrid ItemsSource="{Binding PackLevels}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Units per pack" Binding="{Binding UnitsPerPack}" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,6">
                        <ComboBox Width="120" ItemsSource="{Binding PackLevelOptions}" Text="{Binding NewPackLevelName}"
                                  IsEditable="True" Padding="5" />
                        <TextBox Width="160" Text="{Binding NewPackLabel}" ToolTip="Display label" Padding="6" Margin="6,0" />
                        <TextBox Width="140" Text="{Binding NewPackUnits}" ToolTip="Base units per pack" Padding="6" />
                        <Button Content="Save pack conversion" Command="{Binding AddPackLevelCommand}" Padding="10,6" Margin="6,0" />
                    </WrapPanel>
                    <TextBlock Text="Customer-category price lists, discounts and dated schemes" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <WrapPanel>
                        <TextBox Width="145" Text="{Binding PriceCategory}" ToolTip="Category" Padding="6" />
                        <TextBox Width="145" Text="{Binding CategoryPrice}" ToolTip="Category base rate" Padding="6" Margin="6,0" />
                        <TextBox Width="130" Text="{Binding TradeDiscountPercent}" ToolTip="Trade discount percent" Padding="6" />
                        <DatePicker SelectedDate="{Binding EffectiveFrom}" Margin="6,0" />
                        <DatePicker SelectedDate="{Binding EffectiveTo}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,6">
                        <Button Content="Save category price" Command="{Binding SaveCategoryPriceCommand}" Padding="10,6" />
                        <Button Content="Save trade discount" Command="{Binding SaveTradeDiscountCommand}" Padding="10,6" Margin="6,0" />
                        <TextBox Width="120" Text="{Binding BuyQuantity}" ToolTip="Scheme buy quantity, e.g. 10" Padding="6" />
                        <TextBox Width="120" Text="{Binding FreeQuantity}" ToolTip="Scheme free quantity, e.g. 1" Padding="6" Margin="6,0" />
                        <Button Content="Save scheme" Command="{Binding SaveSchemeCommand}" Padding="10,6" />
                    </WrapPanel>
                    <TextBlock Text="Last five rates for a customer and item" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <WrapPanel>
                        <TextBox Width="280" Text="{Binding SelectedCustomerId}" ToolTip="Customer GUID" Padding="6" />
                        <Button Content="Load recent rates" Command="{Binding LoadRateHistoryCommand}" Padding="10,6" Margin="6,0" />
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding RecentRates}" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="130" />
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AccentBrush}" Margin="0,8" />
