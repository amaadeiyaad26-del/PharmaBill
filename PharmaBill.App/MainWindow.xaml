                              <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding GoogleDriveBytesLabel}" />
                              <TextBlock FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Text="{Binding GoogleDriveUploadStatus}" />
