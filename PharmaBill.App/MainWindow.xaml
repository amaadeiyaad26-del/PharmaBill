                  <TextBox Padding="6" Text="{Binding Path=StateDrugControlPortalUrl, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
              </StackPanel>
              <TextBlock Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="3,8,3,0" Text="{Binding StatusMessage}" />
              <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Margin="3,4,3,0" Text="{Binding ErrorMessage}" />
              <Button HorizontalAlignment="Left" Margin="3,12,0,16" MinWidth="200" AutomationProperties.Name="Save Customer" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCustomerCommand}" Content="{Binding SaveButtonLabel}" ToolTip="Save this customer / patient profile" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:RetailBillingViewModel}}" DataType="{x:Type vm:RetailBillingViewModel}">
          <Grid behaviors:KeyNavigationBehavior.Enabled="True">
