                        <DataGridTextColumn Header="Patient / supplier" Binding="{Binding PatientName}" Width="150" />
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="150" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="105" />
