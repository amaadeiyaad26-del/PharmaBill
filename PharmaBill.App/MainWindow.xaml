                              <TextBlock Text="Habit-forming (reference)" Foreground="#FFC2410C" />
                            </Decorator.Child>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Batch" Width="130">
