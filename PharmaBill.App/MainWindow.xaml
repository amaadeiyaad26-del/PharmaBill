<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.MainWindow" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:vm="clr-namespace:PharmaBill.App.ViewModels" xmlns:controls="clr-namespace:PharmaBill.App.Controls" xmlns:behaviors="clr-namespace:PharmaBill.App.Behaviors" xmlns:views="clr-namespace:PharmaBill.App.Views" Icon="pack://application:,,,/PharmaBill.App;component/Assets/Icons/app.ico" Title="PharmaBill" Height="780" Width="1280" MinHeight="650" MinWidth="1000" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" xmlns:app="clr-namespace:PharmaBill.App" FlowDirection="{Binding FlowDirection}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:DashboardPageViewModel}}" DataType="{x:Type vm:DashboardPageViewModel}">
        <DockPanel Margin="20">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="PharmaBill dashboard" FontSize="26" FontWeight="Bold" />
              <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding LastUpdated, StringFormat=Updated {0:dd-MMM-yyyy HH:mm}}" />
            </StackPanel>
            <Button Content="Refresh" Padding="14,7" Margin="20,4" behaviors:HoverTickSound.Enabled="True" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
            <Button Content="Sync Station" Height="40" Margin="4,4,0,4" ToolTip="Open Android LAN sync station (QR + listener)" behaviors:HoverTickSound.Enabled="True" CommandParameter="Sync" Style="{StaticResource PulsingButtonStyle}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,0,0,10" Text="{Binding ErrorMessage}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <controls:LiveHighlightTile Margin="0,0,0,6" behaviors:HoverTickSound.Enabled="True" Headline1="{Binding HighlightSalesHeadline}" Sub1="{Binding HighlightSalesSub}" Headline2="{Binding HighlightStockHeadline}" Sub2="{Binding HighlightStockSub}" Headline3="{Binding HighlightSyncHeadline}" Sub3="{Binding HighlightSyncSub}" />
              <UniformGrid Columns="3" Rows="2" VerticalAlignment="Top">
                <Button BorderBrush="#FF10B981" CommandParameter="SalesToday" AutomationProperties.Name="Today's sales" ToolTip="Open Today's sales details" Style="{StaticResource KpiCardButton}" Command="{Binding DrillDownCommand}">
                  <Grid>
                    <TextBlock Text="" Foreground="#FF10B981" Style="{StaticResource KpiIcon}" />
                    <StackPanel>
                      <TextBlock Text="Today's sales" Style="{StaticResource KpiLabel}" />
                      <TextBlock Foreground="#FF059669" Style="{StaticResource KpiValue}" Text="{Binding Snapshot.TodaySales, StringFormat=₹{0:N2}}" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button BorderBrush="#FF10B981" CommandParameter="SalesMonth" AutomationProperties.Name="This month's sales" ToolTip="Open This month's sales details" Style="{StaticResource KpiCardButton}" Command="{Binding DrillDownCommand}">
                  <Grid>
                    <TextBlock Text="" Foreground="#FF10B981" Style="{StaticResource KpiIcon}" />
                    <StackPanel>
                      <TextBlock Text="This month's sales" Style="{StaticResource KpiLabel}" />
                      <TextBlock Foreground="#FF059669" Style="{StaticResource KpiValue}" Text="{Binding Snapshot.MonthSales, StringFormat=₹{0:N2}}" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button BorderBrush="#FFF59E0B" CommandParameter="ExpiringStock" AutomationProperties.Name="Expiring within 90 days" ToolTip="Open Expiring within 90 days details" Style="{StaticResource KpiCardButton}" Command="{Binding DrillDownCommand}">
                  <Grid>
                    <TextBlock Text="" Foreground="#FFF59E0B" Style="{StaticResource KpiIcon}" />
                    <StackPanel>
                      <TextBlock Text="Expiring within 90 days" Style="{StaticResource KpiLabel}" />
                      <TextBlock Foreground="#FFD97706" Style="{StaticResource KpiValue}" Text="{Binding Snapshot.ExpiringSoonBatches}" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button BorderBrush="#FFEF4444" CommandParameter="LowStock" AutomationProperties.Name="Low-stock medicines" ToolTip="Open Low-stock medicines details" Style="{StaticResource KpiCardButton}" Command="{Binding DrillDownCommand}">
                  <Grid>
                    <TextBlock Text="" Foreground="#FFEF4444" Style="{StaticResource KpiIcon}" />
                    <StackPanel>
                      <TextBlock Text="Low-stock medicines" Style="{StaticResource KpiLabel}" />
                      <TextBlock Foreground="#FFDC2626" Style="{StaticResource KpiValue}" Text="{Binding Snapshot.LowStockDrugs}" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button BorderBrush="#FF6366F1" CommandParameter="WholesaleOutstanding" AutomationProperties.Name="Wholesale outstanding" ToolTip="Open Wholesale outstanding details" Style="{StaticResource KpiCardButton}" Command="{Binding DrillDownCommand}">
                  <Grid>
                    <TextBlock Text="" Foreground="#FF6366F1" Style="{StaticResource KpiIcon}" />
                    <StackPanel>
                      <TextBlock Text="Wholesale outstanding" Style="{StaticResource KpiLabel}" />
                      <TextBlock Foreground="#FF4F46E5" Style="{StaticResource KpiValue}" Text="{Binding Snapshot.WholesaleOutstanding, StringFormat=₹{0:N2}}" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button BorderBrush="#FF8B5CF6" CommandParameter="RegisterEntries" AutomationProperties.Name="Register entries today" ToolTip="Open Register entries today details" Style="{StaticResource KpiCardButton}" Command="{Binding DrillDownCommand}">
                  <Grid>
                    <TextBlock Text="" Foreground="#FF8B5CF6" Style="{StaticResource KpiIcon}" />
                    <StackPanel>
                      <TextBlock Text="Register entries today" Style="{StaticResource KpiLabel}" />
                      <TextBlock Foreground="#FF7C3AED" Style="{StaticResource KpiValue}" Text="{Binding Snapshot.RegisterAlerts}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </UniformGrid>
              <Grid Margin="0,16,0,8">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <Style x:Key="DashboardTileStyle" TargetType="{x:Type Border}">
                      <Setter Property="Background" Value="#FF1E293B" />
                      <Setter Property="BorderBrush" Value="#FF334155" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="Border.CornerRadius" Value="12" />
                      <Setter Property="Border.Padding" Value="16" />
                      <Setter Property="Margin" Value="6" />
                      <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                      <EventSetter Event="MouseEnter" Handler="DashboardTile_MouseEnter" />
                      <Style.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="Background" Value="#FF0F766E" />
                          <Setter Property="BorderBrush" Value="#FF14B8A6" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                    <Style x:Key="AnalyticsCard" TargetType="{x:Type Border}" BasedOn="{StaticResource DashboardTileStyle}" />
                    <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}">
                      <Setter Property="TextElement.FontSize" Value="15" />
                      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                      <Setter Property="TextElement.Foreground" Value="#FFF8FAFC" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="CardIcon" TargetType="{x:Type TextBlock}">
                      <Setter Property="TextElement.FontFamily" Value="Segoe MDL2 Assets" />
                      <Setter Property="TextElement.FontSize" Value="18" />
                      <Setter Property="TextElement.Foreground" Value="#FF5EEAD4" />
                      <Setter Property="Margin" Value="0,0,8,0" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="RangeTag" TargetType="{x:Type Border}">
                      <Setter Property="Panel.Background" Value="#332DD4BF" />
                      <Setter Property="Border.CornerRadius" Value="10" />
                      <Setter Property="Border.Padding" Value="8,2" />
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="EmptyState" TargetType="{x:Type StackPanel}">
                      <Setter Property="HorizontalAlignment" Value="Center" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" x:Key="TrendBarBrush">
                      <GradientStop Color="#10B981" Offset="0" />
                      <GradientStop Color="#2563EB" Offset="1" />
                    </LinearGradientBrush>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AnalyticsCard}">
                  <Decorator.Child>
                    <StackPanel>
                      <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Right" Style="{StaticResource RangeTag}">
                          <Decorator.Child>
                            <TextBlock Text="Last 7 Days" FontSize="11" Foreground="#FF5EEAD4" />
                          </Decorator.Child>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="" Style="{StaticResource CardIcon}" />
                          <TextBlock Text="Sales trend" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                      </DockPanel>
                      <Grid Height="200">
                        <Grid>
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type Grid}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding HasDailySales}">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Grid Row="0" Column="0" Margin="0,0,6,0">
                            <TextBlock FontSize="10" Foreground="#FF64748B" VerticalAlignment="Top" HorizontalAlignment="Right" Text="{Binding DailyAxisMax}" />
                            <TextBlock FontSize="10" Foreground="#FF64748B" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding DailyAxisMid}" />
                            <TextBlock Text="₹0" FontSize="10" Foreground="#FF64748B" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                          </Grid>
                          <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DailySales}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid VerticalAlignment="Bottom" ToolTip="{Binding Value, StringFormat=₹{0:N2}}">
                                  <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock FontSize="10" Foreground="#FF475569" HorizontalAlignment="Center" Text="{Binding ValueText}" />
                                    <Border Width="26" CornerRadius="6,6,0,0" HorizontalAlignment="Center" Background="{StaticResource TrendBarBrush}" Height="{Binding BarHeight}" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" ItemsSource="{Binding DailySales}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock FontSize="10" Foreground="#FF64748B" HorizontalAlignment="Center" Text="{Binding Label}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                        <StackPanel>
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type StackPanel}" BasedOn="{StaticResource EmptyState}">
                              <Style.Triggers>
                                <DataTrigger Value="False" Binding="{Binding HasDailySales}">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                          <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="36" Text="" Foreground="#FFCBD5E1" HorizontalAlignment="Center" />
                          <TextBlock Text="No sales recorded for this period yet" Foreground="#FF64748B" Margin="0,6,0,0" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Decorator.Child>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AnalyticsCard}">
                  <Decorator.Child>
                    <StackPanel>
                      <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Right" Style="{StaticResource RangeTag}">
                          <Decorator.Child>
                            <TextBlock Text="Last 30 Days" FontSize="11" Foreground="#FF5EEAD4" />
                          </Decorator.Child>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="" Style="{StaticResource CardIcon}" />
                          <TextBlock Text="Peak billing hours" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                      </DockPanel>
                      <Grid Height="200">
                        <Grid>
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type Grid}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding HasHourlyBills}">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <ItemsControl ItemsSource="{Binding HourlyBills}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel VerticalAlignment="Bottom" ToolTip="{Binding Value, StringFormat='{}{0:N0} bill(s)'}">
                                  <TextBlock FontSize="10" Foreground="#FF475569" HorizontalAlignment="Center" Text="{Binding ValueText}" />
                                  <Border Width="14" Background="#FF2563EB" CornerRadius="4,4,0,0" HorizontalAlignment="Center" Height="{Binding BarHeight}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl Grid.Row="1" Margin="0,4,0,0" ItemsSource="{Binding HourlyBills}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock FontSize="9" Foreground="#FF64748B" HorizontalAlignment="Center" Text="{Binding Label}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                        <StackPanel>
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type StackPanel}" BasedOn="{StaticResource EmptyState}">
                              <Style.Triggers>
                                <DataTrigger Value="False" Binding="{Binding HasHourlyBills}">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                          <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="36" Text="" Foreground="#FFCBD5E1" HorizontalAlignment="Center" />
                          <TextBlock Text="No sales recorded for this period yet" Foreground="#FF64748B" Margin="0,6,0,0" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Decorator.Child>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AnalyticsCard}">
                  <Decorator.Child>
                    <StackPanel>
                      <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Right" Style="{StaticResource RangeTag}">
                          <Decorator.Child>
                            <TextBlock Text="This Month" FontSize="11" Foreground="#FF5EEAD4" />
                          </Decorator.Child>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="" Style="{StaticResource CardIcon}" />
                          <TextBlock Text="Top 5 selling medicines" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                      </DockPanel>
                      <Grid MinHeight="200">
                        <ItemsControl ItemsSource="{Binding TopMedicines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="22" CornerRadius="11" Background="#FF2563EB" VerticalAlignment="Top" Margin="0,0,10,0">
                                  <Decorator.Child>
                                    <TextBlock Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding RankText}" />
                                  </Decorator.Child>
                                </Border>
                                <StackPanel Grid.Column="1">
                                  <TextBlock FontWeight="SemiBold" Foreground="#FFF1F5F9" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                  <ProgressBar Maximum="100" Height="8" Margin="0,4,0,0" Foreground="#FF10B981" Background="#FFE2E8F0" BorderThickness="0" Value="{Binding Percent, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                                  <TextBlock FontWeight="SemiBold" Foreground="#FFF1F5F9" HorizontalAlignment="Right" Text="{Binding UnitsText}" />
                                  <TextBlock FontSize="11" Foreground="#FF94A3B8" HorizontalAlignment="Right" Text="{Binding PercentText}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel>
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type StackPanel}" BasedOn="{StaticResource EmptyState}">
                              <Style.Triggers>
                                <DataTrigger Value="False" Binding="{Binding HasTopMedicines}">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                          <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="36" Text="" Foreground="#FFCBD5E1" HorizontalAlignment="Center" />
                          <TextBlock Text="No sales recorded for this period yet" Foreground="#FF64748B" Margin="0,6,0,0" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Decorator.Child>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AnalyticsCard}">
                  <Decorator.Child>
                    <StackPanel>
                      <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Right" Style="{StaticResource RangeTag}">
                          <Decorator.Child>
                            <TextBlock Text="This Month" FontSize="11" Foreground="#FF5EEAD4" />
                          </Decorator.Child>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="" Style="{StaticResource CardIcon}" />
                          <TextBlock Text="Schedule &amp; category mix" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                      </DockPanel>
                      <Grid MinHeight="200">
                        <ItemsControl ItemsSource="{Binding Categories}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="140" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Border}">
                                      <Setter Property="Panel.Background" Value="#FF64748B" />
                                      <Style.Triggers>
                                        <DataTrigger Value="OTC" Binding="{Binding Name}">
                                          <Setter Property="Panel.Background" Value="#FF10B981" />
                                        </DataTrigger>
                                        <DataTrigger Value="Schedule H / H1" Binding="{Binding Name}">
                                          <Setter Property="Panel.Background" Value="#FFF59E0B" />
                                        </DataTrigger>
                                        <DataTrigger Value="Schedule X / NDPS" Binding="{Binding Name}">
                                          <Setter Property="Panel.Background" Value="#FFEF4444" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                  <Decorator.Child>
                                    <TextBlock Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" Text="{Binding Name}" />
                                  </Decorator.Child>
                                </Border>
                                <ProgressBar Grid.Column="1" Maximum="100" Height="8" Margin="8,0" Foreground="#FF14B8A6" Background="#FF334155" BorderThickness="0" VerticalAlignment="Center" Value="{Binding Percent, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="#FFF1F5F9" MinWidth="48" TextAlignment="Right" Text="{Binding PercentText}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel>
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type StackPanel}" BasedOn="{StaticResource EmptyState}">
                              <Style.Triggers>
                                <DataTrigger Value="False" Binding="{Binding HasCategories}">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                          <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="36" Text="" Foreground="#FFCBD5E1" HorizontalAlignment="Center" />
                          <TextBlock Text="No sales recorded for this period yet" Foreground="#FF64748B" Margin="0,6,0,0" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Decorator.Child>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:ReportsPageViewModel}}" DataType="{x:Type vm:ReportsPageViewModel}">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Reports" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Border Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="#FF000000" />
              </UIElement.Effect>
              <StackPanel>
                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,8">
                    <Button Margin="0,0,8,0" ToolTip="Reload report data" AutomationProperties.Name="Refresh report" Style="{StaticResource ReportRefreshButton}" Command="{Binding RefreshCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,0" ToolTip="Export PDF" AutomationProperties.Name="PDF" Style="{StaticResource ReportPdfButton}" Command="{Binding ExportPdfCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="PDF" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button ToolTip="Excel" AutomationProperties.Name="Excel" Style="{StaticResource ReportExcelButton}" Command="{Binding ExportExcelCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Excel" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <WrapPanel>
                    <ComboBox Width="280" Margin="0,0,8,8" DisplayMemberPath="Name" ToolTip="Report type and grouping dimension" Style="{StaticResource ReportToolbarComboBox}" ItemsSource="{Binding ReportChoices}" SelectedItem="{Binding SelectedReport}" />
                    <ComboBox Width="200" Margin="0,0,8,8" DisplayMemberPath="DisplayName" ToolTip="Current branch only, or consolidated network summary when peer snapshots exist" Style="{StaticResource ReportToolbarComboBox}" ItemsSource="{Binding BranchFilterChoices}" SelectedItem="{Binding SelectedBranchFilter}" />
                    <ComboBox Width="130" Margin="0,0,8,8" SelectedValuePath="Number" DisplayMemberPath="Name" Style="{StaticResource ReportToolbarComboBox}" ItemsSource="{Binding Months}" SelectedValue="{Binding SelectedMonth}" />
                    <ComboBox Width="90" Margin="0,0,8,8" Style="{StaticResource ReportToolbarComboBox}" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" />
                    <Button Margin="0,0,8,8" ToolTip="Previous month" AutomationProperties.Name="Previous month" Style="{StaticResource ReportNavOutlineButton}" Command="{Binding PreviousMonthCommand}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Previous" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,8" ToolTip="Next month" AutomationProperties.Name="Next month" Style="{StaticResource ReportNavOutlineButton}" Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanNavigateNext}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Next" VerticalAlignment="Center" />
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="6,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
