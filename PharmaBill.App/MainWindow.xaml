                                 Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Disc %" Width="68">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBox Style="{StaticResource BillingInlineEditBox}"
                                 behaviors:BillingInlineEdit.Field="Discount"
                                 Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="GST %" Width="64" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource BillingInlineReadonlyText}" Text="{Binding GstRate, StringFormat=F2, Mode=OneWay}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="GST" Width="72" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource BillingInlineReadonlyText}" Text="{Binding TaxAmount, StringFormat=₹{0:N2}, Mode=OneWay}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Amount" Width="88" IsReadOnly="True">
