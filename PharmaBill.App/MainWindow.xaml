              </DockPanel>
              <Button Margin="0,0,0,6" Padding="10,6" MinWidth="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButton}" Command="{Binding SearchOnlineCommand}" Visibility="{Binding ShowOnlineLookup, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Medicine not in local stock. Click to add manually or search online">
                <TextBlock Text="{Binding OnlineLookupCaption}" TextWrapping="Wrap" />
