                    </UniformGrid>
                    <WrapPanel>
                      <Button Content="Test Cloud Sync Now" Height="40" Style="{StaticResource PrimaryButton}" Command="{Binding TestCloudSyncNowCommand}" />
                      <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="640" Text="{Binding CloudTestStatus}" />
                    </WrapPanel>
                  </StackPanel>
                </ScrollViewer>
              </GroupBox>
              <GroupBox Header="Multi-branch network" Margin="0,0,0,8" Padding="10">
                <StackPanel>
                  <TextBlock Text="Publishes PharmaBill_Sync/Branches/{BranchCode}/snapshot.db.enc plus stock-index.json. Head office can pull peer indexes into a local read-only cache for consolidated reports without overwriting this store's transactions." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                  <WrapPanel>
                    <Button Content="Publish this branch snapshot" Height="36" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Command="{Binding PublishBranchSnapshotCommand}" />
                    <Button Content="Aggregate peer branches (HO)" Height="36" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Command="{Binding AggregatePeerBranchesCommand}" />
                  </WrapPanel>
                  <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding BranchNetworkStatus}" />
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Google Drive / Cloud Folder Sync (local synced folder)" Margin="0,0,0,8" Padding="8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBox Grid.Row="0" IsReadOnly="True" Padding="6" VerticalAlignment="Center" Text="{Binding Path=SyncFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Row="0" Grid.Column="1" Content="Choose folder" Padding="10,6" Margin="6,0,0,0" Command="{Binding ChooseSyncFolderCommand}" />
                  <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Button Content="Sync Now" Padding="12,6" Command="{Binding SyncNowCommand}" />
                    <CheckBox Content="Background auto-sync" VerticalAlignment="Center" Margin="12,0" IsChecked="{Binding AutoSyncEnabled}" />
                    <Border CornerRadius="10" Padding="8,3" Margin="6,0" VerticalAlignment="Center">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Border}">
                          <Setter Property="Panel.Background" Value="#FFECFDF3" />
                          <Style.Triggers>
                            <DataTrigger Value="Syncing" Binding="{Binding FolderSyncStatus}">
                              <Setter Property="Panel.Background" Value="#FFEFF8FF" />
                            </DataTrigger>
                            <DataTrigger Value="Error" Binding="{Binding FolderSyncStatus}">
                              <Setter Property="Panel.Background" Value="#FFFFF1F0" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <Decorator.Child>
                        <TextBlock FontWeight="SemiBold" Text="{Binding FolderSyncStatus}" />
                      </Decorator.Child>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding LastFolderSyncAtUtc, StringFormat=Last sync: {0:dd-MMM-yyyy HH:mm} UTC}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding LastOutgoingPackages, StringFormat=Outgoing packages: {0}}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding LastIncomingPackages, StringFormat=Incoming: {0}}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding LastAppliedChanges, StringFormat=Changes applied: {0}}" />
                  </WrapPanel>
                </Grid>
              </GroupBox>
              <GroupBox Header="Cloud Sync (optional, self-hosted server)" Margin="0,0,0,8" Padding="8">
                <StackPanel>
                  <TextBlock Text="Server URL (https://...)" />
                  <TextBox Padding="6" Margin="0,3,0,8" Text="{Binding Path=CloudServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Text="Branch API key" />
                  <PasswordBox Padding="6" Margin="0,3,0,8" controls:PasswordBoxBinding.Password="{Binding CloudApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <WrapPanel>
                    <CheckBox Content="Enable cloud sync (every 5 minutes)" VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding CloudSyncEnabled}" />
                    <Button Content="Save" Padding="12,6" Margin="0,0,6,0" Command="{Binding SaveCloudSettingsCommand}" />
                    <Button Content="Sync Now" Padding="12,6" Command="{Binding CloudSyncNowCommand}" />
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" Text="{Binding CloudSyncStatus, StringFormat=Status: {0}}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding LastCloudSyncAtUtc, StringFormat=Last sync: {0:dd-MMM-yyyy HH:mm} UTC}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding LastCloudPushed, StringFormat=Sent: {0}}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding LastCloudPulled, StringFormat=Received: {0}}" />
                  </WrapPanel>
                  <TextBlock Foreground="#FFB54708" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding CloudSyncWarning}" />
                </StackPanel>
              </GroupBox>
              <TextBlock Foreground="#FFB54708" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding FolderSyncWarning}" />
            </StackPanel>
            <TabControl>
              <ItemsControl.Items>
                <TabItem Header="Devices / package exchange">
                  <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.1*" />
                      <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,8,0">
                      <WrapPanel DockPanel.Dock="Bottom" Margin="0,6">
                        <Button Content="Revoke selected" Padding="10,6" Command="{Binding RevokeDeviceCommand}" />
                        <Button Content="Import sync package" Padding="10,6" Margin="6,0" Command="{Binding ImportPackageCommand}" />
                        <Button Content="Export to selected" Padding="10,6" Command="{Binding ExportPackageCommand}" />
                      </WrapPanel>
                      <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Device" Width="*" Binding="{Binding DeviceName}" />
                          <DataGridTextColumn Header="Platform" Width="90" Binding="{Binding Platform}" />
                          <DataGridCheckBoxColumn Header="This PC" Width="70" Binding="{Binding IsCurrentDevice}" />
                          <DataGridTextColumn Header="Last exchange (UTC)" Width="150" Binding="{Binding LastSyncAtUtc}" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </DockPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <TextBlock Text="Pair devices offline" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="On either device, generate a one-time code. Enter that same code and the other device ID on both PCs within ten minutes." TextWrapping="Wrap" Margin="0,3,0,6" />
                        <WrapPanel>
                          <Button Content="Generate one-time code" Padding="10,6" Command="{Binding GeneratePairingCodeCommand}" />
                          <TextBox IsReadOnly="True" Width="300" Margin="6,0" Padding="6" Text="{Binding Path=GeneratedPairingCode}" />
                        </WrapPanel>
                        <TextBox ToolTip="Peer device ID" Margin="0,6,0,0" Padding="6" Text="{Binding Path=PeerDeviceId}" />
                        <WrapPanel Margin="0,5">
                          <TextBox ToolTip="Peer device name" Width="180" Padding="6" Text="{Binding Path=PeerName}" />
                          <ComboBox SelectedValuePath="Content" Width="120" Margin="6,0" Padding="6" SelectedValue="{Binding PeerPlatform}">
                            <ItemsControl.Items>
                              <ComboBoxItem Content="Windows" IsSelected="True" />
                              <ComboBoxItem Content="Android" />
                            </ItemsControl.Items>
                          </ComboBox>
                          <TextBox ToolTip="One-time pairing code" Width="300" Padding="6" Text="{Binding Path=PairingCode}" />
                        </WrapPanel>
                        <Button Content="Pair device" HorizontalAlignment="Left" Padding="10,6" Command="{Binding PairDeviceCommand}" />
                        <TextBlock Text="Pairing code material is used only to derive the random peer key; the key is DPAPI-protected and is never included in packages." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8" />
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </TabItem>
                <TabItem Header="Review conflicts">
                  <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1*" />
                      <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Entity" Width="130" Binding="{Binding EntityName}" />
                        <DataGridTextColumn Header="Entity ID" Width="*" Binding="{Binding EntityId}" />
                        <DataGridTextColumn Header="Updated" Width="145" Binding="{Binding UpdatedAtUtc}" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Column="1" Margin="10,0,0,0">
                      <StackPanel DockPanel.Dock="Bottom" Margin="0,8">
                        <TextBox ToolTip="Required resolution reason" Padding="6" Text="{Binding Path=ConflictReason}" />
                        <TextBlock Text="Stock conflicts are resolved only by posting a stock adjustment with a reason." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4" />
                        <WrapPanel Margin="0,6">
                          <Button Content="Keep local" Padding="10,6" Command="{Binding KeepLocalCommand}" IsEnabled="{Binding CanResolveConflict}" />
                          <Button Content="Accept remote" Padding="10,6" Margin="6,0" Command="{Binding AcceptRemoteCommand}" IsEnabled="{Binding CanAcceptRemote}" />
                        </WrapPanel>
                      </StackPanel>
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                          <TextBlock Text="Local version" FontWeight="Bold" />
                          <TextBox IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" Margin="0,3,0,8" Text="{Binding Path=SelectedConflict.LocalPayload}" />
                          <TextBlock Text="Remote version / stock alert" FontWeight="Bold" />
                          <TextBox IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" Margin="0,3,0,8" Text="{Binding Path=SelectedConflict.RemotePayload}" />
                          <TextBlock TextWrapping="Wrap" Text="{Binding SelectedConflict.Resolution, StringFormat=Resolution: {0}}" />
                        </StackPanel>
                      </ScrollViewer>
                    </DockPanel>
                  </Grid>
                </TabItem>
                <TabItem Header="File transfer queue">
                  <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding FileTransfers}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Category" Binding="{Binding Category}" />
                      <DataGridTextColumn Header="Owner entity" Binding="{Binding Entity}" />
                      <DataGridTextColumn Header="Size" Binding="{Binding Length}" />
                      <DataGridTextColumn Header="SHA-256" Width="2*" Binding="{Binding Sha256}" />
                      <DataGridTextColumn Header="State" Binding="{Binding State}" />
                      <DataGridTextColumn Header="Retries" Binding="{Binding RetryCount}" />
                      <DataGridTextColumn Header="Last error" Width="*" Binding="{Binding LastError}" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
              </ItemsControl.Items>
            </TabControl>
          </DockPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:WholesalePricingPageViewModel}}" DataType="{x:Type vm:WholesalePricingPageViewModel}">
        <ScrollViewer Name="WholesalePricingRoot" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <TextBlock Text="Pack levels, batch rates and wholesale pricing" FontSize="23" FontWeight="SemiBold" />
            <WrapPanel Margin="0,10">
              <ComboBox Width="360" DisplayMemberPath="Name" Padding="6" ItemsSource="{Binding Drugs}" SelectedItem="{Binding SelectedDrug}" />
              <ComboBox Width="220" DisplayMemberPath="BatchNo" Margin="8,0,0,0" Padding="6" ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" />
            </WrapPanel>
            <TextBlock Text="Batch-specific purchase rate, PTR, PTS and MRP" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,4" />
            <WrapPanel>
              <TextBox Width="145" ToolTip="Purchase rate" Padding="6" Visibility="{Binding CanViewPurchaseMargins, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{Binding Path=PurchaseRate}" />
              <TextBox Width="120" ToolTip="PTR" Padding="6" Margin="6,0" Text="{Binding Path=Ptr}" />
              <TextBox Width="120" ToolTip="PTS" Padding="6" Text="{Binding Path=Pts}" />
              <TextBox Width="120" ToolTip="MRP" Padding="6" Margin="6,0" Text="{Binding Path=Mrp}" />
              <Button Content="Save batch rates" Padding="10,6" Command="{Binding SaveBatchRatesCommand}" />
            </WrapPanel>
            <TextBlock Text="Pack conversions (all quantities convert to the medicine's base unit)" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,4" />
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="150" ItemsSource="{Binding PackLevels}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Level" IsReadOnly="True" Binding="{Binding Level}" />
                <DataGridTextColumn Header="Label" IsReadOnly="True" Binding="{Binding Label}" />
                <DataGridTextColumn Header="Units per pack" IsReadOnly="True" Binding="{Binding UnitsPerPack}" />
              </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,6">
              <ComboBox Width="120" IsEditable="True" Padding="5" ItemsSource="{Binding PackLevelOptions}" Text="{Binding NewPackLevelName}" />
              <TextBox Width="160" ToolTip="Display label" Padding="6" Margin="6,0" Text="{Binding Path=NewPackLabel}" />
              <TextBox Width="140" ToolTip="Base units per pack" Padding="6" Text="{Binding Path=NewPackUnits}" />
              <Button Content="Save pack conversion" Padding="10,6" Margin="6,0" Command="{Binding AddPackLevelCommand}" />
            </WrapPanel>
            <TextBlock Text="Customer-category price lists, discounts and dated schemes" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,4" />
            <WrapPanel>
              <TextBox Width="145" ToolTip="Category" Padding="6" Text="{Binding Path=PriceCategory}" />
              <TextBox Width="145" ToolTip="Category base rate" Padding="6" Margin="6,0" Text="{Binding Path=CategoryPrice}" />
              <TextBox Width="130" ToolTip="Trade discount percent" Padding="6" Text="{Binding Path=TradeDiscountPercent}" />
              <DatePicker Margin="6,0" SelectedDate="{Binding EffectiveFrom}" />
              <DatePicker SelectedDate="{Binding EffectiveTo}" />
            </WrapPanel>
            <WrapPanel Margin="0,6">
              <Button Content="Save category price" Padding="10,6" Command="{Binding SaveCategoryPriceCommand}" />
              <Button Content="Save trade discount" Padding="10,6" Margin="6,0" Command="{Binding SaveTradeDiscountCommand}" />
              <TextBox Width="120" ToolTip="Scheme buy quantity, e.g. 10" Padding="6" Text="{Binding Path=BuyQuantity}" />
              <TextBox Width="120" ToolTip="Scheme free quantity, e.g. 1" Padding="6" Margin="6,0" Text="{Binding Path=FreeQuantity}" />
              <Button Content="Save scheme" Padding="10,6" Command="{Binding SaveSchemeCommand}" />
            </WrapPanel>
            <TextBlock Text="Last five rates for a customer and item" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,4" />
            <WrapPanel>
              <TextBox Width="280" ToolTip="Customer GUID" Padding="6" Text="{Binding Path=SelectedCustomerId}" />
              <Button Content="Load recent rates" Padding="10,6" Margin="6,0" Command="{Binding LoadRateHistoryCommand}" />
            </WrapPanel>
            <DataGrid AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="130" ItemsSource="{Binding RecentRates}" />
            <TextBlock Foreground="{DynamicResource AccentBrush}" Margin="0,8" Text="{Binding Message}" />
            <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:WholesaleAccountsPageViewModel}}" DataType="{x:Type vm:WholesaleAccountsPageViewModel}">
        <DockPanel Margin="14,10">
          <DockPanel.InputBindings>
            <KeyBinding Key="F5" Command="{Binding RecordSupplierPaymentCommand}" />
          </DockPanel.InputBindings>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PageSubtitle}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5" Text="{Binding ErrorMessage}" />
            <TextBlock Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" FontSize="12.5" Text="{Binding StatusMessage}" />
          </StackPanel>
          <TabControl>
            <TabItem Header="🏢 Supplier Ledgers &amp; Payables">
              <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" MinHeight="220" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- KPI summary strip -->
                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
                  <Border Margin="0,0,8,0" Padding="14,12" CornerRadius="8" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="#FF0F172A" />
                    </Border.Effect>
                    <StackPanel>
                      <TextBlock Text="Total Payables (Outward Due)" FontSize="12" Foreground="{StaticResource TextMuted}" />
                      <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource MoneyCredit}" Text="{Binding TotalPayablesAmount}" />
                      <Border Margin="0,8,0,0" Padding="8,3" CornerRadius="10" Background="{StaticResource MoneyWarningBg}" HorizontalAlignment="Left"
                              Visibility="{Binding HasOverduePayables, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MoneyWarning}"
                                   Text="{Binding OverduePayablesText, StringFormat=Overdue 60+: {0}}" />
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border Margin="0,0,8,0" Padding="14,12" CornerRadius="8" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="#FF0F172A" />
                    </Border.Effect>
                    <StackPanel>
                      <TextBlock Text="Paid This Month" FontSize="12" Foreground="{StaticResource TextMuted}" />
                      <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource MoneyDebit}" Text="{Binding PaidThisMonthAmount}" />
                      <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextMuted}" Text="Supplier payment vouchers (debits)" />
                    </StackPanel>
                  </Border>
                  <Border Padding="14,12" CornerRadius="8" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="#FF0F172A" />
                    </Border.Effect>
                    <StackPanel>
                      <TextBlock Text="Active Distributors" FontSize="12" Foreground="{StaticResource TextMuted}" />
                      <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandDarkTeal}" Text="{Binding ActiveDistributorsCount}" />
                      <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextMuted}" Text="With outstanding credit balance" />
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <!-- Master-detail: voucher | ledger (no outer scroll) -->
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="320" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Margin="0,0,12,0" Padding="14,12" CornerRadius="8" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                          VerticalAlignment="Stretch">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="#FF0F172A" />
                    </Border.Effect>
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Quick Payment Voucher Entry" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Outward payment to distributors. Reduces payable balance." TextWrapping="Wrap" Margin="0,4,0,10" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="Supplier" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,3" Foreground="{StaticResource TextPrimary}" />
                        <ComboBox DisplayMemberPath="Name" Padding="6,4" MinHeight="32" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" />
                        <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="14" Background="{StaticResource MoneyCreditBg}" BorderThickness="0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding HasSupplierOutstanding, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MoneyCredit}" Text="{Binding CurrentSupplierOutstandingText}" />
                        </Border>
                        <TextBlock Text="Payment Mode" FontSize="11.5" FontWeight="SemiBold" Margin="0,10,0,3" Foreground="{StaticResource TextPrimary}" />
                        <ComboBox Padding="5,4" MinHeight="32" ItemsSource="{Binding SupplierPaymentMethods}" SelectedItem="{Binding SupplierPaymentMethod}" />
                        <TextBlock Text="Amount Paid (₹)" FontSize="11.5" FontWeight="SemiBold" Margin="0,10,0,3" Foreground="{StaticResource TextPrimary}" />
                        <DockPanel LastChildFill="True">
                          <Button DockPanel.Dock="Right" Content="Full Settle" Height="32" Margin="8,0,0,0" Padding="10,4" Style="{StaticResource SecondaryButton}"
                                  Command="{Binding AutoFillOutstandingCommand}" ToolTip="Fill amount with the supplier's current outstanding balance." />
                          <TextBox Padding="6,4" MinHeight="32" VerticalContentAlignment="Center"
                                   Text="{Binding Path=SupplierPaymentAmount, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="UTR / Reference No." FontSize="11.5" FontWeight="SemiBold" Margin="0,10,0,3" Foreground="{StaticResource TextPrimary}" />
                        <TextBox Padding="6,4" MinHeight="32" Text="{Binding Path=SupplierPaymentReference, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Payment Date" FontSize="11.5" FontWeight="SemiBold" Margin="0,10,0,3" Foreground="{StaticResource TextPrimary}" />
                        <DatePicker SelectedDate="{Binding SupplierPaymentDate}" />
                        <TextBlock Text="Bank / Cheque details" FontSize="11.5" FontWeight="SemiBold" Margin="0,10,0,3" Foreground="{StaticResource TextPrimary}" />
                        <TextBox Padding="6,4" MinHeight="32" ToolTip="Bank name or cheque number" Text="{Binding Path=BankName, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                      <Button DockPanel.Dock="Bottom" Content="Save Payment (F5)" Height="42" Margin="0,14,0,0" Padding="14,6"
                              Background="{StaticResource MoneyDebit}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                              Command="{Binding RecordSupplierPaymentCommand}"
                              ToolTip="Post supplier payment voucher and update ledger. Shortcut: F5" />
                    </DockPanel>
                  </Border>

                  <Border Grid.Column="1" Padding="12,10" CornerRadius="8" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.10" Color="#FF0F172A" />
                    </Border.Effect>
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock DockPanel.Dock="Left" Text="Supplier Ledger &amp; Statement" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Export PDF" Height="30" Margin="0,0,6,0" Padding="10,3" Style="{StaticResource SecondaryButton}" Command="{Binding ExportSupplierPdfCommand}" />
                            <Button Content="Export Excel" Height="30" Margin="0,0,6,0" Padding="10,3" Style="{StaticResource SecondaryButton}" Command="{Binding ExportSupplierExcelCommand}" />
                            <Button Content="Print Statement" Height="30" Padding="10,3" Style="{StaticResource SecondaryButton}" Command="{Binding PrintSupplierStatementCommand}" />
                          </StackPanel>
                        </DockPanel>
                        <WrapPanel>
                          <StackPanel Width="130" Margin="0,0,8,6">
                            <TextBlock Text="From" FontSize="11" Margin="0,0,0,2" Foreground="{StaticResource TextMuted}" />
                            <DatePicker SelectedDate="{Binding LedgerFromDate}" />
                          </StackPanel>
                          <StackPanel Width="130" Margin="0,0,8,6">
                            <TextBlock Text="To" FontSize="11" Margin="0,0,0,2" Foreground="{StaticResource TextMuted}" />
                            <DatePicker SelectedDate="{Binding LedgerToDate}" />
                          </StackPanel>
                          <Button Content="All" Height="28" Margin="0,16,6,6" Padding="10,2" Style="{StaticResource SecondaryButton}" Command="{Binding SetLedgerQuickFilterCommand}" CommandParameter="All" />
                          <Button Content="Today" Height="28" Margin="0,16,6,6" Padding="10,2" Style="{StaticResource SecondaryButton}" Command="{Binding SetLedgerQuickFilterCommand}" CommandParameter="Today" />
                          <Button Content="This Month" Height="28" Margin="0,16,6,6" Padding="10,2" Style="{StaticResource SecondaryButton}" Command="{Binding SetLedgerQuickFilterCommand}" CommandParameter="This Month" />
                          <Button Content="Last 30 Days" Height="28" Margin="0,16,6,6" Padding="10,2" Style="{StaticResource SecondaryButton}" Command="{Binding SetLedgerQuickFilterCommand}" CommandParameter="Last 30 Days" />
                          <TextBox Width="200" Height="28" Margin="8,16,6,6" Padding="8,4" VerticalContentAlignment="Center"
                                   ToolTip="Search reference or notes"
                                   Text="{Binding LedgerSearchText, UpdateSourceTrigger=PropertyChanged}" />
