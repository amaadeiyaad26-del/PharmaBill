                  <controls:FloatingField Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Label="Card / POS auth code" Visibility="{Binding IsCardPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox Text="{Binding CardAuthCode, UpdateSourceTrigger=PropertyChanged}" />
