                <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                  <TextBlock Text="Licence type rules for buyer types" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <controls:InfoHelper Title="Licence type rules (Form 20 / 21)" Body="Retail chemists typically need Form 20/21 (or state equivalents); wholesale buyers need wholesale/distributor DL types. Configure which licence types each buyer type must hold. Sales are blocked until a matching unexpired licence exists." />
