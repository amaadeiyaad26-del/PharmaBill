                    </controls:FloatingField>
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,0,0,2">
                      <Button Content="📎 Attach Prescrip." Height="36" Padding="10,5" TabIndex="6" Command="{Binding AttachPrescriptionCommand}" ToolTip="Save a PDF, JPG, or PNG of the prescription into the compliance archive. Required for Schedule H, H1, X, and habit-forming medicines.">
                        <Button.Style>
                          <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
                            <Style.Triggers>
