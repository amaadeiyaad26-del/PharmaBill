                        <Button Content="This month" Command="{Binding SetPeriodCommand}" CommandParameter="ThisMonth" Padding="10,5" Margin="0,0,5,0" />
                        <Button Content="Last month" Command="{Binding SetPeriodCommand}" CommandParameter="LastMonth" Padding="10,5" Margin="0,0,5,0" />
                        <Button Content="Last 3 months" Command="{Binding SetPeriodCommand}" CommandParameter="LastThreeMonths" Padding="10,5" Margin="0,0,5,0" />
                        <Button Content="This year" Command="{Binding SetPeriodCommand}" CommandParameter="ThisYear" Padding="10,5" Margin="0,0,5,0" />
                        <Button Content="Custom" Command="{Binding SetPeriodCommand}" CommandParameter="Custom" Padding="10,5" />
