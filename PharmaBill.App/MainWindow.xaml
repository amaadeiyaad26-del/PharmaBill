  <UIElement.InputBindings>
    <KeyBinding Key="F1" Command="{Binding OpenUserManualCommand}" />

    <!-- F2 / Ctrl+2 / Ctrl+N: New Bill / Inward -->
    <KeyBinding Key="F2" Command="{Binding ShortcutNewBillCommand}" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShortcutNewBillCommand}" />
    <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding ShortcutNewBillCommand}" />
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding ShortcutNewBillCommand}" />

    <!-- F3 / Ctrl+3 / Ctrl+P: Focus Patient / Retailer / MRD -->
    <KeyBinding Key="F3" Command="{Binding ShortcutFocusCustomerCommand}" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShortcutFocusCustomerCommand}" />
    <KeyBinding Key="NumPad3" Modifiers="Control" Command="{Binding ShortcutFocusCustomerCommand}" />
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding ShortcutFocusCustomerCommand}" />

    <!-- F4 / Ctrl+4 / Ctrl+M: Focus Medicine Search -->
    <KeyBinding Key="F4" Command="{Binding ShortcutFocusMedicineCommand}" />
    <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ShortcutFocusMedicineCommand}" />
    <KeyBinding Key="NumPad4" Modifiers="Control" Command="{Binding ShortcutFocusMedicineCommand}" />
    <KeyBinding Key="M" Modifiers="Control" Command="{Binding ShortcutFocusMedicineCommand}" />

    <!-- F5 / Ctrl+5 / Ctrl+Alt+S: Salt Substitutes -->
    <KeyBinding Key="F5" Command="{Binding ShortcutShowSubstitutesCommand}" />
    <KeyBinding Key="D5" Modifiers="Control" Command="{Binding ShortcutShowSubstitutesCommand}" />
    <KeyBinding Key="NumPad5" Modifiers="Control" Command="{Binding ShortcutShowSubstitutesCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Alt" Command="{Binding ShortcutShowSubstitutesCommand}" />

    <!-- F7 / Ctrl+7 / Ctrl+D: Scan Document / Invoice / Camera -->
    <KeyBinding Key="F7" Command="{Binding ShortcutScanDocumentCommand}" />
    <KeyBinding Key="D7" Modifiers="Control" Command="{Binding ShortcutScanDocumentCommand}" />
    <KeyBinding Key="NumPad7" Modifiers="Control" Command="{Binding ShortcutScanDocumentCommand}" />
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding ShortcutScanDocumentCommand}" />

    <!-- F8 / Ctrl+8 / Ctrl+H: Hold Bill -->
    <KeyBinding Key="F8" Command="{Binding ShortcutHoldBillCommand}" />
    <KeyBinding Key="D8" Modifiers="Control" Command="{Binding ShortcutHoldBillCommand}" />
    <KeyBinding Key="NumPad8" Modifiers="Control" Command="{Binding ShortcutHoldBillCommand}" />
    <KeyBinding Key="H" Modifiers="Control" Command="{Binding ShortcutHoldBillCommand}" />

    <!-- F9 / Ctrl+9 / Ctrl+T: Payment Mode -->
    <KeyBinding Key="F9" Command="{Binding ShortcutFocusPaymentCommand}" />
    <KeyBinding Key="D9" Modifiers="Control" Command="{Binding ShortcutFocusPaymentCommand}" />
    <KeyBinding Key="NumPad9" Modifiers="Control" Command="{Binding ShortcutFocusPaymentCommand}" />
    <KeyBinding Key="T" Modifiers="Control" Command="{Binding ShortcutFocusPaymentCommand}" />

    <!-- F10 / Ctrl+Enter / Ctrl+0: Save & Print / Commit Inward -->
    <KeyBinding Key="F10" Command="{Binding ShortcutSaveAndPrintCommand}" />
    <KeyBinding Key="Return" Modifiers="Control" Command="{Binding ShortcutSaveAndPrintCommand}" />
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ShortcutSaveAndPrintCommand}" />
    <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ShortcutSaveAndPrintCommand}" />
    <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ShortcutSaveAndPrintCommand}" />

    <!-- F11 / Ctrl+Q: Payment QR -->
    <KeyBinding Key="F11" Command="{Binding ShortcutShowPaymentQrCommand}" />
    <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ShortcutShowPaymentQrCommand}" />

    <!-- F12 / Ctrl+K / Alt+C: Windows Calculator -->
    <KeyBinding Key="F12" Command="{Binding ShortcutOpenCalculatorCommand}" />
    <KeyBinding Key="K" Modifiers="Control" Command="{Binding ShortcutOpenCalculatorCommand}" />
    <KeyBinding Key="C" Modifiers="Alt" Command="{Binding ShortcutOpenCalculatorCommand}" />

    <!-- Esc / Ctrl+W: Cancel / Clear -->
    <KeyBinding Key="Escape" Command="{Binding ShortcutCancelCommand}" />
    <KeyBinding Key="W" Modifiers="Control" Command="{Binding ShortcutCancelCommand}" />

    <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSettingsSearchCommand}" />
  </UIElement.InputBindings>
  <Grid>
