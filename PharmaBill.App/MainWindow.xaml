                      <DataGridTextColumn Header="Debit" Width="Auto" MinWidth="90" Binding="{Binding Debit, StringFormat=N2}" />
                      <DataGridTextColumn Header="Credit" Width="Auto" MinWidth="90" Binding="{Binding Credit, StringFormat=N2}" />
                      <DataGridTextColumn Header="Balance" Width="Auto" MinWidth="100" Binding="{Binding Balance, StringFormat=N2}" />
                      <DataGridTextColumn Header="Notes" Width="*" MinWidth="120" Binding="{Binding Notes}" />
