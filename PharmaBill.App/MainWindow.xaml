                        <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" Padding="14,7" Margin="0,0,8,0" />
                        <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" Padding="14,7" Margin="0,0,8,0" />
                        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Padding="14,7" Margin="0,0,8,0" />
                    </WrapPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Table}" AutoGenerateColumns="True"
                          CanUserAddRows="False" IsReadOnly="True" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36" MaxWidth="700" HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource SettingsTitle}"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource SettingsPlaceholderMessage}"
                           Margin="0,12,0,28"
                           FontSize="15"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Text="{DynamicResource ThemeLabel}" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme}"
                          Margin="0,0,0,20"
                          Padding="8" />
                <TextBlock Text="{DynamicResource AccentLabel}" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding AccentOptions}"
                          SelectedItem="{Binding SelectedAccent}"
                          Margin="0,0,0,20"
                          Padding="8" />
                <TextBlock Text="{DynamicResource LanguageLabel}" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage}"
                          Padding="8" />
                <TextBlock Text="Business mode" Margin="0,22,0,8" />
                <ComboBox ItemsSource="{Binding BusinessModes}"
                          SelectedItem="{Binding SelectedBusinessMode}"
                          Padding="8" />
                <Button Content="Change business mode"
                        Command="{Binding ChangeBusinessModeCommand}"
                        HorizontalAlignment="Left"
                        Padding="14,8"
                        Margin="0,10,0,0"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0" />
                <TextBlock Text="{Binding ModeError}"
                           Foreground="#FFB42318"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
                <TextBlock Text="Gemini API key (optional purchase-document extraction)" Margin="0,24,0,8" />
                <TextBox Text="{Binding GeminiApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8" />
                <WrapPanel Margin="0,8,0,0">
                <Button Content="Save key securely"
                        Command="{Binding SaveGeminiApiKeyCommand}"
                        Padding="14,8"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0" />
                <Button Content="Remove saved key"
                        Command="{Binding RemoveGeminiApiKeyCommand}"
                        Padding="14,8"
                        Margin="8,0,0,0" />
                </WrapPanel>
                <TextBlock Text="{Binding GeminiApiKeyStatus}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="Document output" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,10" />
                <TextBlock Text="Retail cash memo paper size" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding PaperSizeOptions}" SelectedItem="{Binding RetailMemoPaperSize}" Padding="8" />
                <TextBlock Text="Cash memo printer (80 mm uses raw ESC/POS)" Margin="0,12,0,6" />
                <ComboBox ItemsSource="{Binding PrinterOptions}" SelectedItem="{Binding RetailMemoPrinter}" Padding="8" />
                <TextBlock Text="Retail invoice paper size" Margin="0,12,0,6" />
                <ComboBox ItemsSource="{Binding PaperSizeOptions}" SelectedItem="{Binding RetailInvoicePaperSize}" Padding="8" />
                <TextBlock Text="Invoice printer" Margin="0,12,0,6" />
                <ComboBox ItemsSource="{Binding PrinterOptions}" SelectedItem="{Binding RetailInvoicePrinter}" Padding="8" />
                <CheckBox Content="Pulse cash drawer after thermal receipt"
                          IsChecked="{Binding CashDrawerPulse}" Margin="0,12" />
                <TextBlock Text="Pharmacy logo" Margin="0,8,0,6" />
                <DockPanel>
                    <Button Content="Choose logo" Command="{Binding PickLogoCommand}" Padding="12,6" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBox Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" Padding="7" />
                </DockPanel>
                <TextBlock Text="Invoice / memo footer" Margin="0,12,0,6" />
                <TextBox Text="{Binding FooterText, UpdateSourceTrigger=PropertyChanged}" Padding="7" />
                <TextBlock Text="WhatsApp phone number (country code included)" Margin="0,12,0,6" />
                <TextBox Text="{Binding WhatsAppNumber, UpdateSourceTrigger=PropertyChanged}" Padding="7" />
                <TextBlock Text="Optional SMTP settings (leave host empty to use the default mail app)" FontWeight="SemiBold" Margin="0,24,0,8" />
                <TextBox Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" ToolTip="SMTP host" Padding="7" />
                <WrapPanel Margin="0,6,0,0">
                    <TextBox Text="{Binding SmtpPort}" Width="90" Padding="7" ToolTip="SMTP port" />
                    <TextBox Text="{Binding SmtpFromAddress}" Width="220" Margin="8,0,0,0" Padding="7" ToolTip="From email address" />
                    <TextBox Text="{Binding SmtpUserName}" Width="180" Margin="8,0,0,0" Padding="7" ToolTip="SMTP username" />
                </WrapPanel>
                <PasswordBox x:Name="SmtpPasswordBox" PasswordChanged="SmtpPasswordBox_PasswordChanged"
                             Margin="0,6,0,0" Padding="7" ToolTip="SMTP password (protected with Windows DPAPI)" />
                <CheckBox Content="Use SSL/TLS" IsChecked="{Binding SmtpEnableSsl}" Margin="0,8" />
                <WrapPanel Margin="0,8,0,0">
                <Button Content="Save document output settings"
                        Click="SaveDocumentOutputSettings_Click"
                        HorizontalAlignment="Left" Padding="14,8" Margin="0,8,0,0"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" />
                <Button Content="Remove saved SMTP password"
                        Command="{Binding RemoveSmtpPasswordCommand}"
                        Padding="14,8" Margin="8,8,0,0" />
                </WrapPanel>
                <TextBlock Text="{Binding DocumentOutputStatus}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock Text="Separate inspector PIN (owner only; read-only view access)"
                           FontWeight="SemiBold" Margin="0,24,0,8" />
                <PasswordBox x:Name="InspectorPinBox" PasswordChanged="InspectorPinBox_PasswordChanged"
                             Padding="7" ToolTip="New inspector PIN (minimum 4 characters)" />
                <PasswordBox x:Name="InspectorPinConfirmationBox" PasswordChanged="InspectorPinConfirmationBox_PasswordChanged"
                             Margin="0,6,0,0" Padding="7" ToolTip="Confirm inspector PIN" />
                <Button Content="Save inspector PIN" Click="SaveInspectorPin_Click"
                        Padding="14,8" Margin="0,8,0,0" HorizontalAlignment="Left" />
                <TextBlock Text="About PharmaBill" FontWeight="SemiBold" Margin="0,24,0,8" />
                <TextBlock Text="{Binding VersionText}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Padding="14,8" />
                    <Button Content="Release notes" Command="{Binding ToggleReleaseNotesCommand}" Padding="14,8" Margin="8,0,0,0" />
                </WrapPanel>
                <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBox Text="{Binding ReleaseNotesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         MaxHeight="220" VerticalScrollBarVisibility="Auto" Padding="7" Margin="0,8,0,0"
                         Visibility="{Binding IsReleaseNotesVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />            </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding CurrentPage.NewBillCommand}" />
        <KeyBinding Key="F3" Command="{Binding CurrentPage.FocusSearchCommand}" />
        <KeyBinding Key="F4" Command="{Binding CurrentPage.FocusPatientCommand}" />
        <KeyBinding Key="F8" Command="{Binding CurrentPage.HoldBillCommand}" />
        <KeyBinding Key="F9" Command="{Binding CurrentPage.FocusPaymentCommand}" />
        <KeyBinding Key="F10" Command="{Binding CurrentPage.SaveAndPrintCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CurrentPage.CancelBillCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="6,10,6,28">
                    <TextBlock Text="PharmaBill"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{DynamicResource PharmacyBilling}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,4">
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Content="Access simulator (debug)"
                            Visibility="{Binding IsDebugBuild, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OpenAccessSimulator_Click" />
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Content="{DynamicResource NavSettings}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings" />
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Content="Diagnostics"
                            Click="OpenDiagnostics_Click" />
                    <Button Style="{StaticResource MenuButtonStyle}"
                            Content="Import medicine data"
                            Click="OpenCatalogImport_Click" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MenuButtonStyle}"
                                    Content="{Binding Title}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding SectionKey}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PharmacyName}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LocalDateTime}"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="12"
                                Padding="10,5"
                                Margin="0,0,16,0">
                            <TextBlock Text="{Binding ModeStatus}" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding TrialStatus}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0" />
                        <TextBlock Text="{Binding LoggedInUser}"
                                   VerticalAlignment="Center"
                                   FontWeight="Medium" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#FFFFF1F0"
                        BorderBrush="#FFFDA29B"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                    <TextBlock Text="{Binding ReadOnlyBanner}" Foreground="#FFB42318" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
                <Border Grid.Row="1"
                        Background="{DynamicResource ContentBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <ContentControl Content="{Binding CurrentPage}" />
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="#FFFFFAEB" BorderBrush="#FFFEC84B"
                    BorderThickness="0,1,0,0" Padding="10,5"
                    Visibility="{Binding HasFolderSyncWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding FolderSyncWarning}" Foreground="#FFB54708"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
</Window>


