                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="3" Visibility="{Binding IsRetailMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="Credit days (optional)" />
                  <TextBox Padding="6" TabIndex="8" Text="{Binding Path=CreditDays, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="3">
                  <TextBlock Text="{Binding BalanceFieldLabel}" />
                  <TextBox Padding="6" TabIndex="9" Text="{Binding Path=OpeningBalance, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="3" Visibility="{Binding IsWholesaleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="Price category" />
                  <TextBox Padding="6" TabIndex="10" Text="{Binding Path=PriceCategory, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="3" Visibility="{Binding IsWholesaleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="Route" />
                  <TextBox Padding="6" TabIndex="11" Text="{Binding Path=Route, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="3" Visibility="{Binding IsWholesaleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="Salesman" />
                  <TextBox Padding="6" TabIndex="12" Text="{Binding Path=Salesman, UpdateSourceTrigger=PropertyChanged}" />
