            <KeyBinding Key="F2" Command="{Binding NewBillCommand}" />
            <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NewBillCommand}" />
            <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding NewBillCommand}" />
            <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewBillCommand}" />
            <KeyBinding Key="F3" Command="{Binding FocusPatientCommand}" />
            <KeyBinding Key="D3" Modifiers="Control" Command="{Binding FocusPatientCommand}" />
            <KeyBinding Key="NumPad3" Modifiers="Control" Command="{Binding FocusPatientCommand}" />
            <KeyBinding Key="P" Modifiers="Control" Command="{Binding FocusPatientCommand}" />
            <KeyBinding Key="F4" Command="{Binding FocusMedicineSearchCommand}" />
            <KeyBinding Key="D4" Modifiers="Control" Command="{Binding FocusMedicineSearchCommand}" />
            <KeyBinding Key="NumPad4" Modifiers="Control" Command="{Binding FocusMedicineSearchCommand}" />
            <KeyBinding Key="M" Modifiers="Control" Command="{Binding FocusMedicineSearchCommand}" />
            <KeyBinding Key="F5" Command="{Binding ShowSubstitutesCommand}" />
            <KeyBinding Key="D5" Modifiers="Control" Command="{Binding ShowSubstitutesCommand}" />
            <KeyBinding Key="NumPad5" Modifiers="Control" Command="{Binding ShowSubstitutesCommand}" />
            <KeyBinding Key="S" Modifiers="Control+Alt" Command="{Binding ShowSubstitutesCommand}" />
            <KeyBinding Key="F7" Command="{Binding ExtractPrescriptionFromWebcamCommand}" />
            <KeyBinding Key="D7" Modifiers="Control" Command="{Binding ExtractPrescriptionFromWebcamCommand}" />
            <KeyBinding Key="D" Modifiers="Control" Command="{Binding ExtractPrescriptionFromWebcamCommand}" />
            <KeyBinding Key="F8" Command="{Binding HoldBillCommand}" />
            <KeyBinding Key="D8" Modifiers="Control" Command="{Binding HoldBillCommand}" />
            <KeyBinding Key="NumPad8" Modifiers="Control" Command="{Binding HoldBillCommand}" />
            <KeyBinding Key="H" Modifiers="Control" Command="{Binding HoldBillCommand}" />
            <KeyBinding Key="F9" Command="{Binding FocusPaymentCommand}" />
            <KeyBinding Key="D9" Modifiers="Control" Command="{Binding FocusPaymentCommand}" />
            <KeyBinding Key="T" Modifiers="Control" Command="{Binding FocusPaymentCommand}" />
            <KeyBinding Key="F10" Command="{Binding SaveAndPrintCommand}" />
            <KeyBinding Key="Return" Modifiers="Control" Command="{Binding SaveAndPrintCommand}" />
            <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SaveAndPrintCommand}" />
            <KeyBinding Key="D0" Modifiers="Control" Command="{Binding SaveAndPrintCommand}" />
            <KeyBinding Key="F11" Command="{Binding ShowPaymentQrCommand}" />
            <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ShowPaymentQrCommand}" />
