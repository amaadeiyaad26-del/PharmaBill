                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Drug Records" FontSize="26" FontWeight="SemiBold" />
                    <DockPanel Margin="0,8">
                        <Button Content="Find brand or salt" Command="{Binding SearchDrugsCommand}" DockPanel.Dock="Right" Padding="14,7" Margin="8,0,0,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8"
                                 ToolTip="Search a brand or composition/salt; enter at least 2 letters">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchDrugsCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding SearchResults}" MaxHeight="130"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
