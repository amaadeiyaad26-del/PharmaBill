                        <TextBlock Text="{Binding ClosingBalance, StringFormat='Closing: {0:N2}'}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding CurrentStock, StringFormat='Current stock: {0:N2}'}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding UniquePatients, StringFormat='Unique patients: {0}'}" />
