                                <DataGridTextColumn Header="Licence number" Binding="{Binding LicenceNumber, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Issued (yyyy-mm-dd)" Binding="{Binding IssuedOn, StringFormat={}{0:yyyy-MM-dd}, UpdateSourceTrigger=PropertyChanged}" Width="145" />
                                <DataGridTextColumn Header="Expires (yyyy-mm-dd)" Binding="{Binding ExpiresOn, StringFormat={}{0:yyyy-MM-dd}, UpdateSourceTrigger=PropertyChanged}" Width="145" />
                                <DataGridTextColumn Header="Authority" Binding="{Binding IssuingAuthority, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Scan path" Binding="{Binding DocumentPath}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="X / NDPS authorisation" Binding="{Binding Authorisation, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Attach scan to selected licence" Command="{Binding SelectLicenceScanCommand}"
                                    CommandParameter="{Binding SelectedLicence}" Padding="9,5" />
                            <Button Content="Remove selected licence" Command="{Binding RemoveLicenceCommand}"
                                    CommandParameter="{Binding SelectedLicence}" Padding="9,5" Margin="6,0,0,0" />
                        </WrapPanel>

                        <TextBlock Text="Verification record" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <WrapPanel>
                            <TextBox Width="190" Text="{Binding VerifiedBy, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                     ToolTip="Verified by" />
                            <DatePicker SelectedDate="{Binding VerifiedOn}" Margin="6,0" />
                            <TextBox Width="190" Text="{Binding VerificationMethod, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                     ToolTip="Verification method" />
                        </WrapPanel>
                        <TextBlock Text="State drug-control portal HTTPS URL (configured by your organisation)"
                                   Margin="3,10,3,3" />
                        <DockPanel>
                            <Button Content="Open portal" Command="{Binding OpenStatePortalCommand}" Padding="10,6"
                                    DockPanel.Dock="Right" Margin="6,0,0,0" />
                            <TextBox Text="{Binding StateDrugControlPortalUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
                        </DockPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap" Margin="3,8,3,0" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318"
                                   TextWrapping="Wrap" Margin="3,4,3,0" />
                        <Button Content="Save customer" Command="{Binding SaveCustomerCommand}"
                                HorizontalAlignment="Left" Margin="3,12,0,12" Padding="16,8"
                                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RetailBillingViewModel}">
            <DockPanel Margin="16" AllowDrop="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Retail billing" FontSize="24" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding BillNumber, StringFormat='Bill no: {0}'}" Margin="0,0,16,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding BillDate, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:FloatingField Grid.Row="0" Grid.Column="0" TabIndex="0"
                                                    Label="Patient name" IsRequired="True"
                                                    ErrorText="{Binding PatientNameError}"
                                                    ToolTip="Patient name (required)">
                                <TextBox x:Name="PatientNameBox"
                                         Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FloatingField>
                            <controls:FloatingField Grid.Row="0" Grid.Column="1" TabIndex="1"
                                                    Label="Phone number" IsRequired="True"
                                                    ErrorText="{Binding PatientPhoneError}"
                                                    ToolTip="Patient phone (required)">
                                <TextBox x:Name="PatientPhoneBox"
                                         Text="{Binding PatientPhone, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FloatingField>
                            <controls:FloatingField Grid.Row="0" Grid.Column="2" TabIndex="2"
                                                    Label="Patient address (required for H1/X/NDPS)"
                                                    IsRequired="{Binding HasControlledItems}"
                                                    ErrorText="{Binding PatientAddressError}"
                                                    ToolTip="Patient address (required for H1/X/NDPS)">
                                <TextBox x:Name="PatientAddressBox"
                                         Text="{Binding PatientAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FloatingField>
                            <controls:FloatingField Grid.Row="1" Grid.Column="0" TabIndex="3"
                                                    Label="Doctor / prescriber name"
                                                    IsRequired="{Binding HasControlledItems}"
                                                    ErrorText="{Binding DoctorNameError}"
                                                    ToolTip="Doctor / prescriber name (required for H1/X/NDPS)">
                                <TextBox x:Name="DoctorNameBox"
                                         Text="{Binding DoctorName, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FloatingField>
                            <controls:FloatingField Grid.Row="1" Grid.Column="1" TabIndex="4"
                                                    Label="Doctor registration no."
                                                    IsRequired="{Binding HasControlledItems}"
                                                    ErrorText="{Binding DoctorRegistrationError}"
                                                    ToolTip="Doctor registration number (required for H1/X/NDPS)">
                                <TextBox x:Name="DoctorRegistrationBox"
                                         Text="{Binding DoctorRegistrationNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FloatingField>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="2">
                                <Button Content="Prescription file" Command="{Binding AttachPrescriptionCommand}"
                                        Style="{StaticResource SecondaryButton}" Height="48" Margin="0,0,6,0" TabIndex="5" />
                                <Button Content="Webcam" Command="{Binding OpenCameraCommand}"
                                        Style="{StaticResource SecondaryButton}" Height="48" Margin="0,0,10,0" TabIndex="6" />
                                <TextBlock Text="{Binding PrescriptionFileName}" VerticalAlignment="Center"
                                           MaxWidth="260" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           ToolTip="{Binding PrescriptionFileName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPrescription}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF027A48" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,8,0,6">
                        <Button DockPanel.Dock="Right" Content="F5 Substitutes"
                                Command="{Binding ShowSubstitutesCommand}"
                                Style="{StaticResource SecondaryButton}" Height="48" VerticalAlignment="Top"
                                Margin="8,2,0,2" TabIndex="9" />
                        <Button DockPanel.Dock="Right" Content="Add first FEFO match"
                                Command="{Binding SearchItemsCommand}"
                                Style="{StaticResource PrimaryButton}" Height="48" VerticalAlignment="Top"
                                Margin="8,2,0,2" TabIndex="8" />
                        <controls:FloatingField Label="Search medicine, salt or scan barcode (F3)"
                                                EnterMovesNext="False" TabIndex="7"
                                                ToolTip="Scan barcode or search medicine; Enter adds the first FEFO batch">
                            <TextBox x:Name="RetailItemSearchBox"
                                     Text="{Binding ItemSearch, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchItemsCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </controls:FloatingField>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedSearchResult}"
                             MaxHeight="105"
                             Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding PickFirstSearchResultCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="3">
                                    <TextBlock Text="{Binding DrugName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding BatchNo, StringFormat='Batch {0}'}" Margin="16,0,0,0" />
                                    <TextBlock Text="{Binding ExpiryDate, StringFormat='Expiry {0:d}'}" Margin="16,0,0,0" />
                                    <TextBlock Text="{Binding Mrp, StringFormat='MRP &#8377;{0:N2}'}" Margin="16,0,0,0" />
                                    <TextBlock Text="{Binding AvailableQuantity, StringFormat='Stock {0}'}" Margin="16,0,0,0" />
                                    <Border Background="#FFFFEDD5" CornerRadius="8" Padding="5,2" Margin="16,0,0,0"
                                            Visibility="{Binding IsHabitForming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Habit-forming (reference data)" Foreground="#FFC2410C" />
                                    </Border>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ItemsControl ItemsSource="{Binding Substitutes}" MaxHeight="110">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ReferencePrice, StringFormat='Ref &#8377;{0:N2}'}" Margin="12,0,0,0" />
                                    <Button Content="Select substitute"
                                            Command="{Binding DataContext.CurrentPage.AddFromSubstituteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Margin="12,0,0,0" Padding="6,2" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Pharmacist must confirm suitability and prescription rules"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="{Binding HasSubstitutes, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Margin="0,2,0,4" />
                    <Border Background="#FFFFEDD5" CornerRadius="8" Padding="8,4" Margin="0,2,0,4"
                            HorizontalAlignment="Left"
                            Visibility="{Binding HasHabitFormingItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Habit-forming (reference data): verify prescription and register requirements."
                                   Foreground="#FFC2410C" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#FF027A48" TextWrapping="Wrap" />
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" x:Name="RetailBillGrid" ItemsSource="{Binding BillItems}"
                              SelectedItem="{Binding SelectedBillLine}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" SelectionUnit="FullRow"
                              IsReadOnly="False" TabIndex="10">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding RemoveSelectedItemCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Drug / schedule" IsReadOnly="True" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DrugName}" VerticalAlignment="Center" />
                                            <Border Background="#FFE4E7EC" CornerRadius="7" Padding="5,1" Margin="8,0,0,0"
                                                    Visibility="{Binding RequiresPrescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Schedule}" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="#FFFFEDD5" CornerRadius="7" Padding="5,1" Margin="5,0,0,0"
                                                    Visibility="{Binding IsHabitForming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Habit-forming (reference)" Foreground="#FFC2410C" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo, Mode=OneWay}" IsReadOnly="True" Width="100" />
                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=d, Mode=OneWay}" IsReadOnly="True" Width="100" />
                            <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=F2, Mode=OneWay}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="Qty (units)" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity, Mode=OneWay}" IsReadOnly="True" Width="75" />
                            <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="GST %" Binding="{Binding GstRate, StringFormat=F2, Mode=OneWay}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="GST split" Binding="{Binding TaxAmount, StringFormat=F2, Mode=OneWay}" IsReadOnly="True" Width="85" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding GrossAmount, StringFormat=F2, Mode=OneWay}" IsReadOnly="True" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.8*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Taxable value" />
                            <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
                                       Text="{Binding Subtotal, StringFormat='&#8377;{0:N2}', ConverterCulture=en-IN}" />
                            <TextBlock Grid.Row="1" Text="GST included" />
                            <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"
                                       Text="{Binding GstAmount, StringFormat='&#8377;{0:N2}', ConverterCulture=en-IN}" />
                            <TextBlock Grid.Row="2" Text="Discount" />
                            <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"
                                       Text="{Binding DiscountTotal, StringFormat='&#8377;{0:N2}', ConverterCulture=en-IN}" />
                            <TextBlock Grid.Row="3" Text="TOTAL" FontWeight="Bold" FontSize="22" Margin="0,4,12,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" FontSize="22" Margin="0,4,0,0"
                                       Text="{Binding TotalAmount, StringFormat='&#8377;{0:N2}', ConverterCulture=en-IN}" />
                        </Grid>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:FloatingField Grid.Row="0" Grid.Column="0" Label="Payment mode" IsRequired="True">
                                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" />
                            </controls:FloatingField>
                            <controls:FloatingField Grid.Row="0" Grid.Column="1" Label="Amount received (&#8377;)"
                                                    ToolTip="Amount received (partial payment allowed)"
                                                    Visibility="{Binding IsPaymentAmountVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox x:Name="PaymentAmountBox"
                                         Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FloatingField>
                            <controls:FloatingField Grid.Row="1" Grid.Column="0" Label="Change due (&#8377;)"
                                                    Visibility="{Binding IsCashPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox IsReadOnly="True" IsTabStop="False" Text="{Binding ChangeDueValue, Mode=OneWay}" />
                            </controls:FloatingField>
                            <controls:FloatingField Grid.Row="1" Grid.Column="1" Label="Cash handed over (&#8377;)"
                                                    ToolTip="Cash tendered for change calculation"
                                                    Visibility="{Binding IsCashPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox Text="{Binding CashTendered, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FloatingField>
                            <controls:FloatingField Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                    Label="UPI reference (last 4 digits)"
                                                    Visibility="{Binding IsUpiPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox MaxLength="4" Text="{Binding UpiReference, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FloatingField>
                            <controls:FloatingField Grid.Row="0" Grid.Column="1" Label="Credit note / due date"
                                                    Visibility="{Binding IsCreditPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox Text="{Binding CreditNote, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FloatingField>
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0"
                                    Visibility="{Binding IsUpiPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="{Binding UpiQrCode}" Width="150" Height="150" Stretch="Uniform"
                                   SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <TextBlock Text="{Binding UpiId, StringFormat='UPI ID: {0}'}" FontWeight="SemiBold" />
                            <CheckBox Content="Payment received"
                                      IsChecked="{Binding UpiPaymentReceived}"
                                      Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">
                            <WrapPanel>
                                <Button Content="F2 New" Command="{Binding NewBillCommand}" Style="{StaticResource SecondaryButton}" Margin="2" />
                                <Button Content="F8 Hold" Command="{Binding HoldBillCommand}" Style="{StaticResource SecondaryButton}" Margin="2" />
                                <Button Content="F10 Save / print" Command="{Binding SaveAndPrintCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="2" />
                                <Button Content="Recent bills" Click="OpenRecentBills_Click" Style="{StaticResource SecondaryButton}" Margin="2" />
                                <Button Content="Esc Cancel" Command="{Binding CancelBillCommand}" Style="{StaticResource SecondaryButton}" Margin="2" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <controls:FloatingField Label="Held bills" Width="290">
                                    <ComboBox ItemsSource="{Binding HeldBills}"
                                              SelectedItem="{Binding SelectedHeldBill}"
                                              DisplayMemberPath="DisplayName" />
                                </controls:FloatingField>
                                <Button Content="Resume" Command="{Binding ResumeSelectedBillCommand}"
                                        Style="{StaticResource SecondaryButton}" Height="48" VerticalAlignment="Top" Margin="6,2,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28">
                    <controls:GlobalMedicineSearchControl
                        ShowActions="True"
                        DataContext="{Binding DataContext.CatalogSearch, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="0,0,0,16" />
                    <TextBlock Text="Stock" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <WrapPanel Margin="0,0,0,14">
                        <controls:FloatingField Label="Filter by medicine name" Width="260" Margin="0,0,8,8">
                            <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:FloatingField>
                        <controls:FloatingField Label="Batch no." Width="170" Margin="0,0,8,8">
                            <TextBox Text="{Binding BatchFilter, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:FloatingField>
                        <controls:FloatingField Label="Schedule" Width="150" Margin="0,0,8,8">
                            <ComboBox ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding ScheduleFilter}" />
                        </controls:FloatingField>
                        <controls:FloatingField Label="Status" Width="170" Margin="0,0,8,8">
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" />
                        </controls:FloatingField>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Height="48" MinWidth="100" Margin="0,0,0,8" />
                    </WrapPanel>
                    <Grid Height="320" Margin="0,0,0,14">
                        <DataGrid ItemsSource="{Binding Rows}"
                                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="Expired">
                                            <Setter Property="Background" Value="#FFFEE4E2" />
                                            <Setter Property="Foreground" Value="#FF912018" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="Near expiry">
                                            <Setter Property="Background" Value="#FFFFEAD5" />
                                            <Setter Property="Foreground" Value="#FF93370D" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="Low stock">
                                            <Setter Property="Background" Value="#FFFEF0C7" />
                                            <Setter Property="Foreground" Value="#FF7A2E0E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medicine" Binding="{Binding Medicine, Mode=OneWay}" Width="*" />
                                <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule, Mode=OneWay}" Width="85" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo, Mode=OneWay}" Width="120" />
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, Mode=OneWay, StringFormat=MM/yyyy}" Width="90" />
                                <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, Mode=OneWay, StringFormat=F2}" Width="90" />
                                <DataGridTextColumn Header="Purchase rate" Binding="{Binding PurchaseRate, Mode=OneWay, StringFormat=F2}" Width="110" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding Quantity, Mode=OneWay, StringFormat=0.##}" Width="80" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No stock items yet. Search a medicine above and click Add to stock."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="Stock adjustment" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding SelectedRow.Medicine, StringFormat='Selected: {0}', FallbackValue='No batch selected'}" />
                    <WrapPanel Margin="0,0,0,10">
                        <controls:FloatingField Label="Quantity change (+ or -)" IsRequired="True" Width="220" Margin="0,0,8,8"
                                                ErrorText="{Binding ActionQuantityError}">
                            <TextBox Text="{Binding ActionQuantityText, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:FloatingField>
                        <controls:FloatingField Label="Reason" IsRequired="True" Width="240" Margin="0,0,8,8"
                                                ErrorText="{Binding ActionReasonError}">
                            <ComboBox ItemsSource="{Binding ReasonOptions}" SelectedItem="{Binding ActionReason}" />
                        </controls:FloatingField>
                        <Button Content="Adjust stock" Command="{Binding AdjustStockCommand}" Style="{StaticResource PrimaryButton}" Height="48" MinWidth="130" Margin="0,0,8,8" />
                        <Button Content="Write off expired" Command="{Binding WriteOffExpiredCommand}" Style="{StaticResource SecondaryButton}" Height="48" MinWidth="150" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Text="Physical count" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <WrapPanel Margin="0,0,0,8">
                        <controls:FloatingField Label="Count session name" Width="280" Margin="0,0,8,8">
                            <TextBox Text="{Binding VerificationSessionNo, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:FloatingField>
                        <Button Content="Start physical count" Command="{Binding StartVerificationCommand}" Style="{StaticResource SecondaryButton}" Height="48" Margin="0,0,8,8" />
                        <Button Content="Post physical count" Command="{Binding PostVerificationCommand}" Style="{StaticResource PrimaryButton}" Height="48" Margin="0,0,0,8" />
                    </WrapPanel>
                    <Grid Height="170" Margin="0,0,0,8">
                        <DataGrid ItemsSource="{Binding VerificationItems}" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medicine / batch" Binding="{Binding Display, Mode=OneWay}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedQuantity, Mode=OneWay}" IsReadOnly="True" Width="100" />
                                <DataGridTextColumn Header="Counted" Binding="{Binding CountedQuantity, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <DataGridTextColumn Header="Difference" Binding="{Binding Difference, Mode=OneWay, StringFormat=+0.##;-0.##;0}" IsReadOnly="True" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No count started. Click Start physical count to list every batch."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VerificationItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#FF027A48" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" Margin="0,0,0,8" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasePageViewModel}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <DockPanel Margin="28" AllowDrop="True"
                       DragEnter="PurchaseDocument_DragEnter"
                       Drop="PurchaseDocument_Drop">
                <StackPanel DockPanel.Dock="Top">
                    <controls:GlobalMedicineSearchControl
                        ShowActions="True"
                        DataContext="{Binding DataContext.CatalogSearch, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="0,0,0,16" />
                    <TextBlock Text="Purchases" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Manual purchase entry" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,14" />
                    <WrapPanel Margin="0,0,0,12">
                        <DockPanel Width="360" Margin="0,0,8,8">
                            <Button DockPanel.Dock="Right" Content="Add new supplier" Command="{Binding AddSupplierCommand}"
                                    Style="{StaticResource SecondaryButton}" Height="48" Margin="8,0,0,0" />
                            <controls:FloatingField Label="Supplier" IsRequired="True" ErrorText="{Binding SupplierError}">
                                <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedSupplier}" IsEditable="False" />
                            </controls:FloatingField>
                        </DockPanel>
                        <controls:FloatingField Label="Supplier invoice no." IsRequired="True" Width="220" Margin="0,0,8,8"
                                                ErrorText="{Binding InvoiceNoError}">
                            <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:FloatingField>
                        <controls:FloatingField Label="Invoice date" IsRequired="True" Width="190" Margin="0,0,8,8"
                                                ErrorText="{Binding InvoiceDateError}">
                            <DatePicker SelectedDate="{Binding InvoiceDate}" />
                        </controls:FloatingField>
                        <controls:FloatingField Label="Remarks" Width="260" Margin="0,0,8,8">
                            <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />
                        </controls:FloatingField>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Add item" Command="{Binding AddLineCommand}" Style="{StaticResource SecondaryButton}" Height="44" Margin="0,0,8,8" />
                        <Button Content="Import bill with Gemini" Command="{Binding ImportDocumentCommand}" Style="{StaticResource SecondaryButton}" Height="44" Margin="0,0,8,8" />
                        <Button Content="Load CSV / Excel" Command="{Binding LoadSpreadsheetCommand}" Style="{StaticResource SecondaryButton}" Height="44" Margin="0,0,8,8" />
                        <Button Content="Save purchase" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,0,8,8" />
                        <TextBlock Text="{Binding Subtotal, StringFormat='Subtotal: &#8377;{0:N2}', ConverterCulture=en-IN}" Margin="18,10,0,0" />
                        <TextBlock Text="{Binding TaxTotal, StringFormat='GST: &#8377;{0:N2}', ConverterCulture=en-IN}" Margin="18,10,0,0" />
                        <TextBlock Text="{Binding GrandTotal, StringFormat='Total: &#8377;{0:N2}', ConverterCulture=en-IN}" Margin="18,10,0,0" FontWeight="Bold" />
                    </WrapPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,6"
                                 Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding ImportStatus}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding BillTotalCheck}" TextWrapping="Wrap" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFD92D20" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BillTotalMatches}" Value="True">
                                        <Setter Property="Foreground" Value="#FF027A48" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#FF027A48" Margin="0,4,0,6" TextWrapping="Wrap" />
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding IsAddItemOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Add item" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel>
                                <controls:FloatingField Label="Medicine" IsRequired="True" Width="300" Margin="0,0,8,8">
                                    <ComboBox ItemsSource="{Binding Drugs}" DisplayMemberPath="Name" SelectedItem="{Binding NewItemDrug}" />
                                </controls:FloatingField>
                                <controls:FloatingField Label="Batch no." IsRequired="True" Width="150" Margin="0,0,8,8">
                                    <TextBox Text="{Binding NewItemBatch, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FloatingField>
                                <controls:FloatingField Label="Expiry (month/year)" IsRequired="True" Width="170" Margin="0,0,8,8" HelperText="MM/YYYY">
                                    <TextBox Text="{Binding NewItemExpiry, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FloatingField>
                                <controls:FloatingField Label="Quantity (packs)" IsRequired="True" Width="150" Margin="0,0,8,8">
                                    <TextBox Text="{Binding NewItemQuantity, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FloatingField>
                                <controls:FloatingField Label="Free quantity" Width="130" Margin="0,0,8,8">
                                    <TextBox Text="{Binding NewItemFree, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FloatingField>
                                <controls:FloatingField Label="MRP per pack (&#8377;)" IsRequired="True" Width="160" Margin="0,0,8,8">
                                    <TextBox Text="{Binding NewItemMrp, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FloatingField>
                                <controls:FloatingField Label="Rate (&#8377;)" IsRequired="True" Width="130" Margin="0,0,8,8">
                                    <TextBox Text="{Binding NewItemRate, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FloatingField>
                                <controls:FloatingField Label="GST %" Width="100" Margin="0,0,8,8">
                                    <TextBox Text="{Binding NewItemGst, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FloatingField>
                                <controls:FloatingField Label="Rack / location" Width="150" Margin="0,0,8,8">
                                    <TextBox Text="{Binding NewItemRack, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FloatingField>
                            </WrapPanel>
                            <TextBlock Text="{Binding NewItemError}" Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add to bill" Command="{Binding ConfirmAddItemCommand}" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,0,8,0" />
                                <Button Content="Cancel" Command="{Binding CancelAddItemCommand}" Style="{StaticResource SecondaryButton}" Height="44" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding HasSpreadsheet, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Match your file's columns" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding SpreadsheetMappings}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" Height="290" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Purchase field" Binding="{Binding Label, Mode=OneWay}" IsReadOnly="True" Width="180" />
                                    <DataGridCheckBoxColumn Header="Required" Binding="{Binding IsRequired, Mode=OneWay}" IsReadOnly="True" Width="80" />
                                    <DataGridComboBoxColumn Header="Column in your file"
                                        ItemsSource="{Binding AvailableHeaders}"
                                        SelectedItemBinding="{Binding SourceHeader, UpdateSourceTrigger=PropertyChanged}"
                                        Width="240" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Preview (first 5 rows)" FontWeight="SemiBold" Margin="0,4,0,4" />
                            <DataGrid ItemsSource="{Binding SpreadsheetPreview}" AutoGenerateColumns="True" IsReadOnly="True"
                                      CanUserAddRows="False" Height="170" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Apply column mapping" Command="{Binding ApplySpreadsheetMappingCommand}" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,0,8,0" />
                                <Button Content="Cancel" Command="{Binding CancelSpreadsheetCommand}" Style="{StaticResource SecondaryButton}" Height="44" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <GroupBox Header="Purchase return" DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding ReturnLines}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" Height="90" Margin="0,0,0,6">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Batch"
                                    ItemsSource="{Binding DataContext.ReturnBatches, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    DisplayMemberPath="Display"
                                    SelectedItemBinding="{Binding Batch, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel>
                            <TextBox Width="120" Margin="0,0,8,0" Padding="6"
                                     ToolTip="Return number" Text="{Binding ReturnNo, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Width="320" Margin="0,0,8,0" Padding="6"
                                      ItemsSource="{Binding ReturnBatches}" DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedReturnBatch}" />
                            <TextBox Width="75" Margin="0,0,8,0" Padding="6"
                                     ToolTip="Return quantity" Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Width="180" Margin="0,0,8,0" Padding="6"
                                     ToolTip="Mandatory return reason" Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Post return" Command="{Binding SavePurchaseReturnCommand}" Padding="12,6" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
                <Grid MinHeight="260">
                    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>

                        <DataGridComboBoxColumn Header="Medicine"
                            ItemsSource="{Binding DataContext.Drugs, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            DisplayMemberPath="Name" SelectedItemBinding="{Binding Drug, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Expiry (yyyy-mm-dd)" Binding="{Binding Expiry, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                        <DataGridTextColumn Header="Free" Binding="{Binding FreeQuantity, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                        <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                        <DataGridTextColumn Header="Rate" Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                        <DataGridTextColumn Header="GST %" Binding="{Binding GstRate, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Mode=OneWay}" IsReadOnly="True" Width="85" />
                        <DataGridTextColumn Header="Rack" Binding="{Binding Rack, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#10005;" ToolTip="Delete row" Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.DeleteLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No items yet. Click Add item, import a bill with Gemini, or load a CSV / Excel file."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
          </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatutoryRegistersPageViewModel}">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
