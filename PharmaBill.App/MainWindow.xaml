                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected}" Width="65" />
                            <DataGridTextColumn Header="Medicine" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Brand" Binding="{Binding BrandName, Mode=OneWay}" IsReadOnly="True" Width="180" />
                            <DataGridTextColumn Header="Salt / composition" Binding="{Binding Composition, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                        </DataGrid.Columns>
