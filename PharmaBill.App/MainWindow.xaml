                              <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="12,6" VerticalAlignment="Center" Content="Retry Now" Style="{StaticResource PrimaryButton}" Command="{Binding RetryGoogleDriveUploadCommand}" />
                              <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#FFB54708" Text="{Binding GoogleDriveWarning}" />
                            </DockPanel>
                          </Border>
                          <WrapPanel>
                            <Button Content="Link Google Account" Height="36" Margin="0,0,6,4" Command="{Binding ConnectGoogleDriveCommand}">
                              <FrameworkElement.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <DataTrigger Value="True" Binding="{Binding GoogleDriveConnected}">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
