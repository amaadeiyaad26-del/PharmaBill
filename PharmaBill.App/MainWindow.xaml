                                   Text="{Binding GrossAmount, StringFormat=₹{0:N2}, Mode=OneWay}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <Grid Grid.Row="2" Margin="0,4,0,2" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.8*" MinWidth="360" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="Auto" />
                  <!-- Auto + MinWidth so action pills (Get data from Prescription, F2, F10…) never clip on 1366×768 -->
                  <ColumnDefinition Width="Auto" MinWidth="400" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" VerticalAlignment="Bottom" MinHeight="0" Margin="0,0,12,0" HorizontalAlignment="Stretch" ClipToBounds="False" Background="#1410B981" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="10" Padding="14,8,14,10" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
                  <Border.Effect>
                    <DropShadowEffect Color="#059669" Opacity="0.08" BlurRadius="12" ShadowDepth="2" />
                  </Border.Effect>
                  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Taxable value" FontWeight="SemiBold" Foreground="#047857" />
