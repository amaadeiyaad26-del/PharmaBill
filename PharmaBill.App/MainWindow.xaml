                          </Button>
                          <TextBlock FontWeight="SemiBold" Text="{Binding LastUsbBackupLabel}" />
                          <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding UsbBackupStatus}" />
