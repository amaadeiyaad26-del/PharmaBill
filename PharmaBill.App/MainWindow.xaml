                      <TextBox Text="{Binding CreditOverrideReason, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:FloatingField>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0" Visibility="{Binding IsSplitPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                      <controls:FloatingField Label="Cash part (₹)" Width="120" Margin="0,0,8,0">
                        <TextBox Text="{Binding SplitCashAmount, UpdateSourceTrigger=PropertyChanged}" />
                      </controls:FloatingField>
                      <controls:FloatingField Label="Second mode" Width="140" Margin="0,0,8,0">
                        <ComboBox ItemsSource="{Binding SplitSecondMethods}" SelectedItem="{Binding SplitSecondMethod}" />
                      </controls:FloatingField>
                      <controls:FloatingField Label="Second amount (₹)" Width="130">
                        <TextBox Text="{Binding SplitSecondAmount, UpdateSourceTrigger=PropertyChanged}" />
                      </controls:FloatingField>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding SplitBalanceRemaining, StringFormat=Balance remaining: ₹{0:N2}, ConverterCulture=en-IN}" />
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0" Visibility="{Binding IsUpiPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <Button Content="Open QR modal" Height="34" Margin="0,0,0,8" Background="#FF2563EB" BorderBrush="#FF2563EB" Style="{StaticResource PrimaryButton}" Command="{Binding ShowPaymentQrCommand}" />
                  <Image Width="120" Height="120" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding UpiQrCode}" />
                  <TextBlock FontWeight="SemiBold" Text="{Binding UpiId, StringFormat=UPI ID: {0}}" />
                  <CheckBox Content="Payment received" Margin="0,6,0,0" IsChecked="{Binding UpiPaymentReceived}" />
                </StackPanel>
                <Grid Grid.Column="3" VerticalAlignment="Bottom" Margin="8,0,0,0" MinWidth="400">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="*" MinWidth="140" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
