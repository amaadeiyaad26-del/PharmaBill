                  <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding BillNumber, StringFormat=Bill no: {0}}" />
                  <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding BillDate, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}" />
                  <Border Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="16,0,6,0" VerticalAlignment="Center">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF1D4ED8" Text="F2/Ctrl+N · F3/Ctrl+P · F4/Ctrl+M · F5/Ctrl+5 · F8/Ctrl+H · F9/Ctrl+T · F10/Ctrl+↵ · Alt+C Calculator" />
                  </Border>
                </StackPanel>
              </StackPanel>
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
