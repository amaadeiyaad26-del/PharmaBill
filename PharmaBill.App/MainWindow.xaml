                <Border Background="#FFFFFFFF" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="16" Height="36" />
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="#FF64748B" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBox Name="SearchBox" Height="36" Padding="32,6,10,6" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="13" Foreground="#FF0F172A" ToolTip="Search medicines or ask PharmaBill AI (Enter)" AutomationProperties.Name="Header medicine search" Text="{Binding Path=AssistantQuery, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchBox_TextChanged" GotKeyboardFocus="SearchBox_FocusChanged" LostKeyboardFocus="SearchBox_FocusChanged">
                  <UIElement.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AskAssistantCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding CloseHeaderSearchFlyoutCommand}" />
                  </UIElement.InputBindings>
                </TextBox>
                <TextBlock Name="TxtSearchHint" IsHitTestVisible="False" Margin="34,0,0,0" VerticalAlignment="Center" Foreground="#FF808080" FontSize="13" RenderTransformOrigin="0.5,0.5">
                  <UIElement.RenderTransform>
                    <TranslateTransform Y="0" />
                  </UIElement.RenderTransform>
                </TextBlock>
                <Popup Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-8" IsOpen="{Binding IsHeaderSearchFlyoutOpen}" PlacementTarget="{Binding ElementName=SearchBox}">
                  <Border Width="480" MaxHeight="360" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,4,0,0">
                    <UIElement.Effect>
                      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="#FF000000" />
                    </UIElement.Effect>
                    <DockPanel>
                      <DockPanel Dock="Top" Margin="4,2,4,8">
                        <TextBlock FontWeight="SemiBold" Text="Medicine results" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Close" Padding="8,2" Command="{Binding CloseHeaderSearchFlyoutCommand}" />
                        <Button DockPanel.Dock="Right" Content="Open in Stock" Padding="8,2" Margin="0,0,6,0" Command="{Binding OpenHeaderResultInStockCommand}" />
                        <Button DockPanel.Dock="Right" Content="Open in Billing" Padding="8,2" Margin="0,0,6,0" ToolTip="Opens Retail or Wholesale billing based on the active desk mode" Command="{Binding OpenHeaderResultInBillingCommand}" />
                      </DockPanel>
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                          <TextBlock Margin="4,0,4,4" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="In stock" Visibility="{Binding CatalogSearch.HasInStock, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <ItemsControl ItemsSource="{Binding CatalogSearch.InStockResults}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="6,8" Cursor="Hand">
                                  <UIElement.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenHeaderResultInBillingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                  </UIElement.InputBindings>
                                  <DockPanel>
                                    <StackPanel>
                                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                      <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Composition}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource AccentBrush}" Text="{Binding StockQuantity, StringFormat=Qty {0:0.##}}" />
                                  </DockPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Margin="4,8,4,4" FontWeight="SemiBold" Text="Catalogue" Visibility="{Binding CatalogSearch.HasCatalog, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <ItemsControl ItemsSource="{Binding CatalogSearch.CatalogResults}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="6,8" Cursor="Hand">
                                  <UIElement.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenHeaderResultInStockCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                  </UIElement.InputBindings>
                                  <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Manufacturer}" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Margin="8" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding CatalogSearch.HintText}" Visibility="{Binding CatalogSearch.ShowHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                      </ScrollViewer>
                    </DockPanel>
                  </Border>
                </Popup>
              </Grid>
              <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="16,2,0,0" Text="{Binding AssistantMessage}" ToolTip="{Binding AssistantMessage}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button ToolTip="Switch active working mode (Retail / Wholesale / 2-in-1)" AutomationProperties.Name="Billing mode" Click="OpenPillMenu_Click">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource HeaderPill}" TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="{DynamicResource PillModeBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PillModeBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PillModeForegroundBrush}" />
                    <Style.Triggers>
                      <DataTrigger Value="Retail" Binding="{Binding ModeBadgeKind}">
                        <Setter Property="Background" Value="{DynamicResource PillModeRetailBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PillModeRetailBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PillModeRetailForegroundBrush}" />
                      </DataTrigger>
                      <DataTrigger Value="Wholesale" Binding="{Binding ModeBadgeKind}">
                        <Setter Property="Background" Value="{DynamicResource PillModeWholesaleBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PillModeWholesaleBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PillModeWholesaleForegroundBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <FrameworkElement.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="You are in RTL Mode — Retail Billing" IsCheckable="True" Command="{Binding SelectRetailDeskModeCommand}" IsEnabled="{Binding CanUseRetailBilling}" IsChecked="{Binding IsRetailDeskActive, Mode=OneWay}" />
                    <MenuItem Header="You are in WS Mode — Wholesale Tax Invoice" IsCheckable="True" Command="{Binding SelectWholesaleDeskModeCommand}" IsEnabled="{Binding CanUseWholesaleBilling}" IsChecked="{Binding IsWholesaleDeskActive, Mode=OneWay}" />
                    <MenuItem Header="MODE: 2-IN-1 (RTL + WS)" IsCheckable="True" Command="{Binding SelectCombinedDeskModeCommand}" IsEnabled="{Binding CanUseCombinedDeskMode}" IsChecked="{Binding IsCombinedDeskActive, Mode=OneWay}" Visibility="{Binding CanUseCombinedDeskMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Separator />
                    <MenuItem Header="Settings" CommandParameter="Settings" Command="{Binding NavigateCommand}" />
                  </ContextMenu>
                </FrameworkElement.ContextMenu>
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ModeStatus}" />
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.Name="Licence status" Command="{Binding OpenLicenceCommand}" ToolTip="{Binding TrialStatusToolTip}" Visibility="{Binding ShowLicenceStatusPill, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource HeaderPill}" TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="{DynamicResource BadgeAmberBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PillWarnBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource BadgeAmberForegroundBrush}" />
                    <Style.Triggers>
                      <DataTrigger Value="EXPIRED" Binding="{Binding TrialStatus}">
                        <Setter Property="Background" Value="{DynamicResource BadgeRedBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PillDangerBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource BadgeRedForegroundBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Text="{Binding TrialStatus}" />
              </Button>
              <Grid Margin="0">
                <Button Name="ProfilePillButton" Style="{StaticResource HeaderPill}" Margin="0" Background="{DynamicResource PillUserBackgroundBrush}" BorderBrush="{DynamicResource PillUserBorderBrush}" Foreground="{DynamicResource PillUserForegroundBrush}" ToolTip="Pharmacist profile — hover for shift status" AutomationProperties.Name="Pharmacist profile" Command="{Binding OpenProfileCommand}" MouseEnter="ProfilePill_OnMouseEnter" MouseLeave="ProfilePill_OnMouseLeave">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#FF10B981" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Online / Ready" />
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding LoggedInUser}" />
                  </StackPanel>
                </Button>
                <Popup Placement="Bottom" StaysOpen="True" AllowsTransparency="True" HorizontalOffset="-8" VerticalOffset="6" PopupAnimation="Fade" IsOpen="{Binding IsProfileStatusPopupOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ProfilePillButton}">
                  <Border Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" MinWidth="220" MaxWidth="280" MouseEnter="ProfilePopup_OnMouseEnter" MouseLeave="ProfilePopup_OnMouseLeave">
                    <UIElement.Effect>
                      <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.14" Color="#FF0F172A" />
                    </UIElement.Effect>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="8" Height="8" Fill="#FF10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Online / Ready" FontWeight="SemiBold" FontSize="13" Foreground="#FF0F172A" />
                      </StackPanel>
                      <TextBlock FontSize="12" Foreground="#FF64748B" Margin="0,0,0,4" Text="{Binding ShiftStartedDisplay, StringFormat=Shift started {0}}" />
                      <TextBlock FontSize="12" Foreground="#FF64748B" Text="{Binding ActiveBranchCode, StringFormat=Active branch {0}}" />
                      <TextBlock FontSize="11.5" Foreground="#FF94A3B8" Margin="0,8,0,0" Text="{Binding UserRoleLabel}" />
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>
            </StackPanel>
          </Grid>
        </Decorator.Child>
      </Border>
      <Grid Row="1" Margin="22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <Border Background="#FFEFF6FF" BorderBrush="#FF93C5FD" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Content="Update Now" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,8,0" Background="#FF2563EB" BorderBrush="#FF2563EB" AutomationProperties.Name="Update Now" Command="{Binding UpdateNowCommand}" />
                <Button Content="Remind Me Tomorrow" Style="{StaticResource SecondaryButton}" Height="32" AutomationProperties.Name="Remind Me Tomorrow update" Command="{Binding RemindUpdateTomorrowCommand}" IsEnabled="{Binding CanRemindUpdateTomorrow}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16" Foreground="#FF1D4ED8" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FF1E3A8A" FontWeight="SemiBold" Text="{Binding UpdateBannerText}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Background="#FFFFF1F0" BorderBrush="#FFFDA29B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Foreground="#FFB42318" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ReadOnlyBanner}" />
          </Border>
          <Border Background="#FFFFFAEB" BorderBrush="#FFFEC84B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="{Binding ShowUsbBackupReminder, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Content="Backup Now" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,8,0" AutomationProperties.Name="Backup Now USB reminder" Command="{Binding UsbBackupReminderBackupNowCommand}" />
                <Button Content="Remind Me Tomorrow" Style="{StaticResource SecondaryButton}" Height="32" AutomationProperties.Name="Remind Me Tomorrow USB reminder" Command="{Binding UsbBackupReminderSnoozeCommand}" />
              </StackPanel>
              <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FFB54708" FontWeight="SemiBold" Text="⚠ Monthly Reminder: No USB backup detected in the last 30 days. Please plug in a USB drive and back up your data." />
            </DockPanel>
          </Border>
        </StackPanel>
        <Grid Row="1">
          <Border Background="{DynamicResource CanvasBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
              <Image Source="pack://application:,,,/PharmaBill.App;component/Assets/Icons/pharma_bill_3d.png" Width="420" Height="420" Stretch="Uniform" Opacity="0.05" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" Panel.ZIndex="0" />
              <ContentControl Panel.ZIndex="1" RenderTransformOrigin="0.5,0.5" Content="{Binding Path=CurrentPage, NotifyOnTargetUpdated=True}">
                <UIElement.RenderTransform>
                  <TranslateTransform Y="0" />
                </UIElement.RenderTransform>
                <FrameworkElement.Triggers>
                  <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOutQuad}" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="16" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOutQuad}" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </FrameworkElement.Triggers>
              </ContentControl>
            </Grid>
          </Border>
          <Border Name="WelcomeToastCard" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="12" Panel.ZIndex="1200" MaxWidth="480" MinWidth="320" Focusable="False" IsHitTestVisible="True" RenderTransformOrigin="0.5,0">
            <UIElement.RenderTransform>
              <TranslateTransform Y="-18" />
            </UIElement.RenderTransform>
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="#FF0F172A" />
            </UIElement.Effect>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Border}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="UIElement.Opacity" Value="0" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding ShowWelcomeToast}">
                    <TriggerBase.EnterActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                          </ObjectAnimationUsingKeyFrames>
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource EaseOutQuad}" />
                          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-18" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource EaseOutQuad}" />
                        </Storyboard>
                      </BeginStoryboard>
                    </TriggerBase.EnterActions>
                    <TriggerBase.ExitActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutQuad}" />
                          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-14" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutQuad}" />
                          <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0.28" Value="{x:Static Visibility.Collapsed}" />
                          </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                      </BeginStoryboard>
                    </TriggerBase.ExitActions>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <Grid>
              <Border Width="4" HorizontalAlignment="Left" Background="#FF2563EB" CornerRadius="12,0,0,12" />
              <DockPanel Margin="16,14,12,14">
                <Button DockPanel.Dock="Right" Content="×" Width="28" Height="28" Margin="8,0,0,0" Padding="0" FontSize="16" Cursor="Hand" Focusable="False" VerticalAlignment="Top" Background="#00FFFFFF" BorderThickness="0" Foreground="#FF94A3B8" ToolTip="Dismiss" AutomationProperties.Name="Dismiss welcome" Command="{Binding DismissWelcomeToastCommand}" />
                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="#FFEFF6FF" Margin="0,0,12,0" VerticalAlignment="Top">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="18" Foreground="#FF2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#FF0F172A" TextWrapping="Wrap" Text="{Binding WelcomeHeadline}" />
                  <TextBlock FontSize="12" Foreground="#FF64748B" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding WelcomeSubtitle}" />
                  <TextBlock FontSize="11.5" Foreground="#FF64748B" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding WelcomeStatusLine}" />
                </StackPanel>
              </DockPanel>
            </Grid>
          </Border>
          <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Background="#FF1D2939" BorderBrush="#FF334155" BorderThickness="1" CornerRadius="8" Padding="14,10" Panel.ZIndex="1100" MaxWidth="520" Visibility="{Binding HasBarcodeToast, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Margin="12,0,0,0" Background="#00FFFFFF" BorderThickness="0" Foreground="#FF98A2B3" Command="{Binding DismissBarcodeToastCommand}" />
              <TextBlock TextWrapping="Wrap" Foreground="#FFF2F4F7" VerticalAlignment="Center" Text="{Binding BarcodeToastMessage}" />
            </DockPanel>
          </Border>
          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Width="320" Panel.ZIndex="1100" Visibility="{Binding HasScannedItemPopover, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="Scanned item" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ScannedItemPopover.DrugName}" />
              <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ScannedItemPopover.BatchNo, StringFormat=Batch {0}}" />
              <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ScannedItemPopover.ExpiryDate, StringFormat=Expiry {0:yyyy-MM}}" />
              <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding ScannedItemPopover.Mrp, StringFormat=MRP ₹{0:0.00}}" />
              <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ScannedItemPopover.AvailableQuantity, StringFormat=Qty {0:0.##}}" />
              <WrapPanel>
                <Button Content="Add to bill" Style="{StaticResource PrimaryButton}" Command="{Binding AddScannedItemToBillCommand}" />
                <Button Content="Dismiss" Padding="12,7" Margin="8,0,0,0" Command="{Binding DismissScannedItemPopoverCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Grid Background="#70090D16" ZIndex="999" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" IsHitTestVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="48" Height="48" CornerRadius="24" BorderThickness="4" BorderBrush="#1E293B" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <RotateTransform x:Name="BusySpinnerRotate" Angle="0" />
                </UIElement.RenderTransform>
                <FrameworkElement.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="BusySpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </FrameworkElement.Triggers>
                <Border Width="48" Height="48" CornerRadius="24" BorderThickness="4" BorderBrush="#14B8A6" Clip="M0,0 L24,0 L24,24 L0,24" />
              </Border>
              <TextBlock Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,14,0,0" Text="{Binding BusyMessage, TargetNullValue=Loading...}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
      <StackPanel Grid.Row="2">
        <Border Name="DbImportBanner" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,6" Visibility="{Binding IsImportingCatalogue, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="8" Height="8" Fill="#14B8A6" Margin="0,0,10,0" VerticalAlignment="Center">
              <FrameworkElement.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:0.7" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </FrameworkElement.Triggers>
            </Ellipse>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Loading Database: " FontWeight="SemiBold" Foreground="#F8FAFC" FontSize="12" />
              <TextBlock Foreground="#94A3B8" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding CatalogueImportStatus, FallbackValue='Indexing 253,973 medicines in background...'}" />
            </StackPanel>
            <ProgressBar Grid.Column="2" Width="140" Height="4" Maximum="100" BorderThickness="0" Background="#334155" Foreground="#14B8A6" Value="{Binding CatalogueImportProgress}" />
          </Grid>
        </Border>
        <Border Background="#FFFFFAEB" BorderBrush="#FFFEC84B" BorderThickness="0,1,0,0" Padding="10,5" Visibility="{Binding HasFolderSyncWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Decorator.Child>
            <TextBlock Foreground="#FFB54708" TextTrimming="CharacterEllipsis" Text="{Binding FolderSyncWarning}" />
          </Decorator.Child>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>