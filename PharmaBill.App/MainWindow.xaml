            <FrameworkElement.Resources>
              <ResourceDictionary>
                <controls:BindingProxy x:Key="StockPageProxy" Data="{Binding}" />
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <controls:GlobalMedicineSearchControl ShowActions="True" Margin="0,0,0,16" DataContext="{Binding DataContext.CatalogSearch, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="Stock" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,14" />
            <WrapPanel Margin="0,0,0,10">
              <Button Content="All Stock" Height="40" MinWidth="100" Margin="0,0,8,8" CommandParameter="All" Style="{StaticResource SecondaryButton}" Command="{Binding SetStockFilterCommand}" />
              <Button Content="Shortage (&lt; Min Level)" Height="40" MinWidth="160" Margin="0,0,8,8" CommandParameter="Shortage" Style="{StaticResource SecondaryButton}" Command="{Binding SetStockFilterCommand}" />
              <Button Content="Near Expiry (&lt; 90 Days)" Height="40" MinWidth="170" Margin="0,0,8,8" CommandParameter="Near expiry" Style="{StaticResource SecondaryButton}" Command="{Binding SetStockFilterCommand}" />
              <Button Content="Generate Purchase Indent" Height="40" MinWidth="180" Margin="0,0,8,8" ToolTip="Build a shortage indent, copy it to the clipboard, and optionally save CSV" Style="{StaticResource PrimaryButton}" Command="{Binding GeneratePurchaseIndentCommand}" />
              <Button Content="Create draft purchase order" Height="40" MinWidth="190" Margin="0,0,0,8" ToolTip="Open Purchases with shortage lines as an editable draft voucher" Style="{StaticResource SecondaryButton}" Command="{Binding CreateDraftPurchaseOrderCommand}" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,14">
              <controls:FloatingField Label="Filter by medicine name" Width="260" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=NameFilter, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Batch no." Width="170" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=BatchFilter, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Schedule" Width="150" Margin="0,0,8,8">
                <ComboBox ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding ScheduleFilter}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Status" Width="170" Margin="0,0,8,8">
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" />
              </controls:FloatingField>
              <Button Content="Refresh" Height="48" MinWidth="100" Margin="0,0,0,8" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
            </WrapPanel>
            <Grid Height="320" Margin="0,0,0,14">
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                <DataGrid.RowStyle>
                  <Style TargetType="{x:Type DataGridRow}">
                    <Style.Triggers>
                      <DataTrigger Value="Expired" Binding="{Binding Status, Mode=OneWay}">
                        <Setter Property="Panel.Background" Value="#FFFEE4E2" />
                        <Setter Property="TextElement.Foreground" Value="#FF912018" />
                      </DataTrigger>
                      <DataTrigger Value="Critical" Binding="{Binding Status, Mode=OneWay}">
                        <Setter Property="Panel.Background" Value="#FFFEE4E2" />
                        <Setter Property="TextElement.Foreground" Value="#FF912018" />
                      </DataTrigger>
                      <DataTrigger Value="Near expiry" Binding="{Binding Status, Mode=OneWay}">
                        <Setter Property="Panel.Background" Value="#FFFFEAD5" />
                        <Setter Property="TextElement.Foreground" Value="#FF93370D" />
                      </DataTrigger>
                      <DataTrigger Value="Shortage" Binding="{Binding Status, Mode=OneWay}">
                        <Setter Property="Panel.Background" Value="#FFFEF0C7" />
                        <Setter Property="TextElement.Foreground" Value="#FF7A2E0E" />
                      </DataTrigger>
                      <DataTrigger Value="Low stock" Binding="{Binding Status, Mode=OneWay}">
                        <Setter Property="Panel.Background" Value="#FFFEF0C7" />
                        <Setter Property="TextElement.Foreground" Value="#FF7A2E0E" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Medicine" Width="*" Binding="{Binding Medicine, Mode=OneWay}" />
                  <DataGridTextColumn Header="Schedule" Width="85" Binding="{Binding Schedule, Mode=OneWay}" />
                  <DataGridTextColumn Header="Batch" Width="120" Binding="{Binding BatchNo, Mode=OneWay}" />
                  <DataGridTextColumn Header="Expiry" Width="90" Binding="{Binding ExpiryDate, Mode=OneWay, StringFormat=MM/yyyy}" />
                  <DataGridTextColumn Header="MRP" Width="90" Binding="{Binding Mrp, Mode=OneWay, StringFormat=F2}" />
                  <DataGridTextColumn Header="Purchase rate" Width="110" Binding="{Binding PurchaseRate, Mode=OneWay, StringFormat=F2}" Visibility="{Binding Data.CanViewPurchaseMargins, Source={StaticResource StockPageProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <DataGridTextColumn Header="Stock" Width="80" Binding="{Binding Quantity, Mode=OneWay, StringFormat=0.##}" />
                  <DataGridTextColumn Header="Reorder" Width="80" Binding="{Binding ReorderLevel, Mode=OneWay, StringFormat=0.##}" />
                  <DataGridTextColumn Header="Status" Width="110" Binding="{Binding Status, Mode=OneWay}" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="No stock items yet. Search a medicine above and click Add to stock." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="0" Binding="{Binding Rows.Count}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </Grid>
            <TextBlock Text="Stock adjustment" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SelectedRow.Medicine, StringFormat=Selected: {0}, FallbackValue=No batch selected}" />
            <WrapPanel Margin="0,0,0,10">
              <controls:FloatingField Label="Quantity change (+ or -)" IsRequired="True" Width="220" Margin="0,0,8,8" ErrorText="{Binding ActionQuantityError}">
                <TextBox Text="{Binding Path=ActionQuantityText, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Reason" IsRequired="True" Width="240" Margin="0,0,8,8" ErrorText="{Binding ActionReasonError}">
                <ComboBox ItemsSource="{Binding ReasonOptions}" SelectedItem="{Binding ActionReason}" />
              </controls:FloatingField>
              <Button Content="Adjust stock" Height="48" MinWidth="130" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Command="{Binding AdjustStockCommand}" />
              <Button Content="Write off expired" Height="48" MinWidth="150" Margin="0,0,0,8" Style="{StaticResource SecondaryButton}" Command="{Binding WriteOffExpiredCommand}" />
            </WrapPanel>
            <TextBlock Text="Physical count" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,8" />
            <WrapPanel Margin="0,0,0,8">
              <controls:FloatingField Label="Count session name" Width="280" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=VerificationSessionNo, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <Button Content="Start physical count" Height="48" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding StartVerificationCommand}" />
              <Button Content="Post physical count" Height="48" Margin="0,0,0,8" Style="{StaticResource PrimaryButton}" Command="{Binding PostVerificationCommand}" />
            </WrapPanel>
            <Grid Height="170" Margin="0,0,0,8">
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding VerificationItems}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Medicine / batch" IsReadOnly="True" Width="*" Binding="{Binding Display, Mode=OneWay}" />
                  <DataGridTextColumn Header="Expected" IsReadOnly="True" Width="100" Binding="{Binding ExpectedQuantity, Mode=OneWay}" />
                  <DataGridTextColumn Header="Counted" Width="100" Binding="{Binding CountedQuantity, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Difference" IsReadOnly="True" Width="100" Binding="{Binding Difference, Mode=OneWay, StringFormat=+0.##;-0.##;0}" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="No count started. Click Start physical count to list every batch." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="0" Binding="{Binding VerificationItems.Count}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </Grid>
            <TextBlock Foreground="#FF027A48" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            <TextBlock Foreground="#FFB42318" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:StockTransferPageViewModel}}" DataType="{x:Type vm:StockTransferPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28">
            <TextBlock Text="Stock transfer challan" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Move batches between godowns. Counter billing only sells from Shop Front." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,14" />
            <WrapPanel Margin="0,0,0,12">
              <controls:FloatingField Label="Source location" Width="220" Margin="0,0,8,8">
                <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Locations}" SelectedItem="{Binding SourceLocation}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Destination location" Width="220" Margin="0,0,8,8">
                <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Locations}" SelectedItem="{Binding DestinationLocation}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Transfer date" Width="180" Margin="0,0,8,8">
                <DatePicker SelectedDate="{Binding TransferDate}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Filter medicine / batch" Width="220" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=MedicineFilter, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <Button Content="Refresh batches" Height="48" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAvailableBatchesCommand}" />
              <Button Content="Add godown" Height="48" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding AddGodownCommand}" />
            </WrapPanel>
            <TextBlock Text="Batches at source" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid Height="180" Margin="0,0,0,10">
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" ItemsSource="{Binding AvailableBatches}" SelectedItem="{Binding SelectedAvailableBatch}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Medicine" Width="*" Binding="{Binding DrugName, Mode=OneWay}" />
                  <DataGridTextColumn Header="Batch" Width="110" Binding="{Binding BatchNo, Mode=OneWay}" />
                  <DataGridTextColumn Header="Expiry" Width="90" Binding="{Binding ExpiryDate, Mode=OneWay, StringFormat=MM/yyyy}" />
                  <DataGridTextColumn Header="Available" Width="90" Binding="{Binding AvailableQuantity, Mode=OneWay, StringFormat=0.##}" />
                  <DataGridTextColumn Header="Rack" Width="80" Binding="{Binding Rack, Mode=OneWay}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
            <WrapPanel Margin="0,0,0,12">
              <controls:FloatingField Label="Qty to transfer" Width="140" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=AddQuantityText, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <Button Content="Add to challan" Height="48" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Command="{Binding AddLineCommand}" />
              <controls:FloatingField Label="Notes" Width="320" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=Notes, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
            </WrapPanel>
            <TextBlock Text="Transfer lines" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid Height="160" Margin="0,0,0,10">
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" ItemsSource="{Binding TransferLines}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Medicine" Width="*" IsReadOnly="True" Binding="{Binding DrugName, Mode=OneWay}" />
                  <DataGridTextColumn Header="Batch" Width="110" IsReadOnly="True" Binding="{Binding BatchNo, Mode=OneWay}" />
                  <DataGridTextColumn Header="Qty" Width="90" Binding="{Binding TransferQuantity, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTemplateColumn Header="" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Remove" Padding="6,2" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
            <WrapPanel>
              <Button Content="Confirm transfer" Height="48" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmTransferCommand}" />
              <Button Content="Print transfer challan" Height="48" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding PrintChallanCommand}" />
              <Button Content="Refresh" Height="48" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
            </WrapPanel>
            <TextBlock Foreground="#FF027A48" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding StatusMessage}" />
            <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding ErrorMessage}" />
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:PurchasePageViewModel}}" DataType="{x:Type vm:PurchasePageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <DockPanel Margin="28" AllowDrop="True" DragEnter="PurchaseDocument_DragEnter" Drop="PurchaseDocument_Drop">
            <StackPanel DockPanel.Dock="Top">
              <controls:GlobalMedicineSearchControl ShowActions="True" Margin="0,0,0,16" DataContext="{Binding DataContext.CatalogSearch, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Text="Purchases" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="Manual purchase entry" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,14" />
              <WrapPanel Margin="0,0,0,12">
                <DockPanel Width="360" Margin="0,0,8,8">
                  <Button DockPanel.Dock="Right" Content="Add new supplier" Height="48" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding AddSupplierCommand}" />
                  <controls:FloatingField Label="Supplier" IsRequired="True" ErrorText="{Binding SupplierError}">
                    <ComboBox DisplayMemberPath="Name" IsEditable="False" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" />
                  </controls:FloatingField>
                </DockPanel>
                <controls:FloatingField Label="Supplier invoice no." IsRequired="True" Width="220" Margin="0,0,8,8" ErrorText="{Binding InvoiceNoError}">
                  <TextBox Text="{Binding Path=InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FloatingField>
                <controls:FloatingField Label="Invoice date" IsRequired="True" Width="190" Margin="0,0,8,8" ErrorText="{Binding InvoiceDateError}">
                  <DatePicker SelectedDate="{Binding InvoiceDate}" />
                </controls:FloatingField>
                <controls:FloatingField Label="Receive into godown" Width="220" Margin="0,0,8,8" ToolTip="Where purchased goods are stored. Defaults to Shop Front (retail counter).">
                  <ComboBox DisplayMemberPath="Name" IsEditable="False" ItemsSource="{Binding StorageLocations}" SelectedItem="{Binding SelectedStorageLocation}" />
                </controls:FloatingField>
                <controls:FloatingField Label="Remarks" Width="260" Margin="0,0,8,8">
                  <TextBox Text="{Binding Path=Remarks, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FloatingField>
              </WrapPanel>
              <WrapPanel Margin="0,0,0,12">
                <Button Content="Add item" Height="44" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding AddLineCommand}" />
                <Button Content="Import bill with Gemini" Height="44" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding ImportDocumentCommand}" />
                <Button Content="Load CSV / Excel" Height="44" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding LoadSpreadsheetCommand}" />
                <Button Content="Save purchase" Height="44" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                <TextBlock Margin="18,10,0,0" Text="{Binding Subtotal, StringFormat=Subtotal: ₹{0:N2}, ConverterCulture=en-IN}" />
                <TextBlock Margin="18,10,0,0" Text="{Binding TaxTotal, StringFormat=GST: ₹{0:N2}, ConverterCulture=en-IN}" />
                <TextBlock Margin="18,10,0,0" FontWeight="Bold" Text="{Binding GrandTotal, StringFormat=Total: ₹{0:N2}, ConverterCulture=en-IN}" />
              </WrapPanel>
              <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,6" Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding ImportStatus}" />
              <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding BillTotalCheck}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="TextElement.Foreground" Value="#FFD92D20" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding BillTotalMatches}">
                        <Setter Property="TextElement.Foreground" Value="#FF027A48" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
              <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
              <TextBlock Foreground="#FF027A48" Margin="0,4,0,6" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12" Visibility="{Binding IsAddItemOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Decorator.Child>
                  <StackPanel>
                    <TextBlock Text="Add item" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel>
                      <controls:FloatingField Label="Medicine" IsRequired="True" Width="300" Margin="0,0,8,8">
                        <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Drugs}" SelectedItem="{Binding NewItemDrug}" />
                      </controls:FloatingField>
                      <controls:FloatingField Label="Batch no." IsRequired="True" Width="150" Margin="0,0,8,8">
                        <TextBox Text="{Binding Path=NewItemBatch, UpdateSourceTrigger=PropertyChanged}" />
                      </controls:FloatingField>
                      <controls:FloatingField Label="Expiry (month/year)" IsRequired="True" Width="170" Margin="0,0,8,8" HelperText="MM/YYYY">
                        <TextBox Text="{Binding Path=NewItemExpiry, UpdateSourceTrigger=PropertyChanged}" />
                      </controls:FloatingField>
                      <controls:FloatingField Label="Quantity (packs)" IsRequired="True" Width="150" Margin="0,0,8,8">
                        <TextBox Text="{Binding Path=NewItemQuantity, UpdateSourceTrigger=PropertyChanged}" />
                      </controls:FloatingField>
                      <controls:FloatingField Label="Free quantity" Width="130" Margin="0,0,8,8">
                        <TextBox Text="{Binding Path=NewItemFree, UpdateSourceTrigger=PropertyChanged}" />
                      </controls:FloatingField>
                      <controls:FloatingField Label="MRP per pack (₹)" IsRequired="True" Width="160" Margin="0,0,8,8">
                        <TextBox Text="{Binding Path=NewItemMrp, UpdateSourceTrigger=PropertyChanged}" />
                      </controls:FloatingField>
                      <controls:FloatingField Label="Rate (₹)" IsRequired="True" Width="130" Margin="0,0,8,8">
                        <TextBox Text="{Binding Path=NewItemRate, UpdateSourceTrigger=PropertyChanged}" />
                      </controls:FloatingField>
                      <controls:FloatingField Label="GST %" Width="100" Margin="0,0,8,8">
                        <TextBox Text="{Binding Path=NewItemGst, UpdateSourceTrigger=PropertyChanged}" />
                      </controls:FloatingField>
                      <controls:FloatingField Label="Rack / location" Width="150" Margin="0,0,8,8">
                        <TextBox Text="{Binding Path=NewItemRack, UpdateSourceTrigger=PropertyChanged}" />
                      </controls:FloatingField>
                    </WrapPanel>
                    <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding NewItemError}" />
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Add to bill" Height="44" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmAddItemCommand}" />
                      <Button Content="Cancel" Height="44" Style="{StaticResource SecondaryButton}" Command="{Binding CancelAddItemCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Decorator.Child>
              </Border>
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12" Visibility="{Binding HasSpreadsheet, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Decorator.Child>
                  <StackPanel>
                    <TextBlock Text="Match your file's columns" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" Height="290" Margin="0,0,0,8" ItemsSource="{Binding SpreadsheetMappings}">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Purchase field" IsReadOnly="True" Width="180" Binding="{Binding Label, Mode=OneWay}" />
                        <DataGridCheckBoxColumn Header="Required" IsReadOnly="True" Width="80" Binding="{Binding IsRequired, Mode=OneWay}" />
                        <DataGridComboBoxColumn Header="Column in your file" Width="240" ItemsSource="{Binding AvailableHeaders}" SelectedItemBinding="{Binding SourceHeader, UpdateSourceTrigger=PropertyChanged}" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Preview (first 5 rows)" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <DataGrid AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Height="170" Margin="0,0,0,8" ItemsSource="{Binding SpreadsheetPreview}" />
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Apply column mapping" Height="44" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Command="{Binding ApplySpreadsheetMappingCommand}" />
                      <Button Content="Cancel" Height="44" Style="{StaticResource SecondaryButton}" Command="{Binding CancelSpreadsheetCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Decorator.Child>
              </Border>
            </StackPanel>
            <GroupBox Header="Purchase return" DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8">
              <StackPanel>
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" Height="90" Margin="0,0,0,6" ItemsSource="{Binding ReturnLines}">
                  <DataGrid.Columns>
                    <DataGridComboBoxColumn Header="Batch" DisplayMemberPath="Display" Width="*" ItemsSource="{Binding DataContext.ReturnBatches, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItemBinding="{Binding Batch, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Quantity" Width="100" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                  </DataGrid.Columns>
                </DataGrid>
                <WrapPanel>
                  <TextBox Width="120" Margin="0,0,8,0" Padding="6" ToolTip="Return number" Text="{Binding Path=ReturnNo, UpdateSourceTrigger=PropertyChanged}" />
                  <ComboBox Width="320" Margin="0,0,8,0" Padding="6" DisplayMemberPath="Display" ItemsSource="{Binding ReturnBatches}" SelectedItem="{Binding SelectedReturnBatch}" />
                  <TextBox Width="75" Margin="0,0,8,0" Padding="6" ToolTip="Return quantity" Text="{Binding Path=ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox Width="180" Margin="0,0,8,0" Padding="6" ToolTip="Mandatory return reason" Text="{Binding Path=ReturnReason, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Content="Post return" Padding="12,6" Command="{Binding SavePurchaseReturnCommand}" />
                </WrapPanel>
              </StackPanel>
            </GroupBox>
            <Grid MinHeight="260">
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding Lines}">
                <DataGrid.Columns>
                  <DataGridComboBoxColumn Header="Medicine" DisplayMemberPath="Name" Width="220" ItemsSource="{Binding DataContext.Drugs, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItemBinding="{Binding Drug, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Batch" Width="90" Binding="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Expiry (yyyy-mm-dd)" Width="100" Binding="{Binding Expiry, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Qty" Width="65" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Free" Width="65" Binding="{Binding FreeQuantity, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="MRP" Width="75" Binding="{Binding Mrp, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Rate" Width="75" Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="GST %" Width="70" Binding="{Binding GstRate, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Discount" Width="85" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Amount" IsReadOnly="True" Width="85" Binding="{Binding Amount, Mode=OneWay}" />
                  <DataGridTextColumn Header="Rack" Width="80" Binding="{Binding Rack, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTemplateColumn Header="" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
