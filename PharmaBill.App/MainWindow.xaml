      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:SyncSettingsPageViewModel}}" DataType="{x:Type vm:SyncSettingsPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,24">
          <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Top">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Offline device sync" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                <controls:InfoHelper Title="Sync Station (port 5055)" Margin="10,0,0,0" Body="This PC listens on TCP 5055 for the Android app on the same Wi-Fi. Scan the QR or let mDNS discover _pharmabill-sync._tcp. If Windows Firewall blocks the port, use Allow firewall rule (admin) or the allow-firewall-port5055.ps1 script. When LAN fails, encrypted change logs fall back to Google Drive PharmaBill_Sync." />
              </StackPanel>
              <TextBlock Text="Pair the Android app on this Wi-Fi with the QR code below. Signed packages can still move by USB or a folder you choose." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,8" />
              <views:SyncView Margin="0,0,0,12" />
              <WrapPanel>
                <TextBlock Text="This device ID:" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox IsReadOnly="True" Width="300" Margin="5,0,10,0" Padding="5" Text="{Binding Path=LocalDeviceId, Mode=OneWay}" />
                <TextBox Width="180" ToolTip="This device's display name" Padding="5" Text="{Binding Path=DeviceName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock VerticalAlignment="Center" Margin="12,0" Text="{Binding PendingChangeCount, StringFormat=Pending changes: {0}}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding UnresolvedConflictCount, StringFormat=Unresolved conflicts: {0}}" />
              </WrapPanel>
              <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5" Text="{Binding LastExchangeAtUtc, StringFormat=Last device exchange (UTC): {0:yyyy-MM-dd HH:mm}}" />
              <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
              <TextBlock Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Text="{Binding PackageStatus}" />
              <GroupBox Header="Cloud backup destinations" Margin="0,8,0,16" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Link a cloud account to store encrypted backups. Use Sync on Exit / Bill Save on each card for automatic uploads." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,10">
                      <Button Content="⚙ Configure Keys" Height="36" ToolTip="Paste Google Desktop OAuth client ID and secret" Style="{StaticResource SecondaryButton}" Command="{Binding ConfigureCloudOAuthKeysCommand}" />
                      <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="Required before first Link Account — paste Google Desktop client credentials." />
                    </WrapPanel>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                      <Border Margin="0,0,6,0" Padding="16" CornerRadius="10" HorizontalAlignment="Stretch" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                        <StackPanel>
                          <DockPanel Margin="0,0,0,8">
                            <TextBlock FontWeight="SemiBold" FontSize="15" Text="Google Drive" />
                            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                              <FrameworkElement.Style>
                                <Style TargetType="{x:Type Border}">
                                  <Setter Property="Background" Value="#FFFEE4E2" />
                                  <Style.Triggers>
                                    <DataTrigger Value="True" Binding="{Binding GoogleDriveConnected}">
                                      <Setter Property="Background" Value="#FFD1FAE5" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                              <TextBlock FontWeight="SemiBold" FontSize="11">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="#FFB42318" />
                                    <Setter Property="Text" Value="{Binding GoogleDriveConnectionLabel}" />
                                    <Style.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding GoogleDriveConnected}">
                                        <Setter Property="Foreground" Value="#FF067647" />
                                        <Setter Property="Text" Value="{Binding GoogleDriveEmail, StringFormat=Connected: {0}}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </TextBlock>
                            </Border>
                          </DockPanel>
                          <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Text="OAuth2 (drive.file). Encrypted backups sync to PharmaBill_Sync/ on your Google Drive." />
                          <controls:FloatingField Label="Preferred Google email (optional)" Margin="0,0,0,8">
                            <TextBox Text="{Binding Path=GoogleDriveEmail, UpdateSourceTrigger=PropertyChanged}" />
                          </controls:FloatingField>
                          <TextBlock Margin="0,0,0,6" Text="{Binding GoogleDriveSyncFolder, StringFormat=Sync folder: {0}}" />
                          <Border Margin="0,0,0,10" CornerRadius="8" Padding="10,6" Background="#FFECFDF3" BorderBrush="#FFA7F3D0" BorderThickness="1" Visibility="{Binding ShowGoogleDriveIdleBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="#FF067647" TextWrapping="Wrap" Text="{Binding GoogleDriveIdleBadge}" />
                          </Border>
                          <StackPanel Margin="0,0,0,10" Visibility="{Binding IsGoogleDriveUploading, Converter={StaticResource BooleanToVisibilityConverter}}">
