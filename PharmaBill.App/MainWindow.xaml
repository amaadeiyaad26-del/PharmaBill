                <controls:FloatingField Label="Search medicine, salt or scan barcode (F4)" EnterMovesNext="False" TabIndex="7" ToolTip="F4 jumps here. Type a brand, salt, or scan a barcode. Search adds the first saleable FEFO batch. F5 opens salt substitutes." behaviors:CyclingPlaceholder.Enabled="True" behaviors:CyclingPlaceholder.IntervalSeconds="2.5" behaviors:CyclingPlaceholder.Hints="Search 'Paracetamol 650mg'...|Search 'Amoxicillin 500mg'...|Search 'Azithromycin'...">
