                            <CheckBox Content="Sync on Bill Save" IsChecked="{Binding GoogleDriveSyncOnBillSave}" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <Border Margin="6,0,0,0" Padding="16" CornerRadius="10" HorizontalAlignment="Stretch" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                        <StackPanel>
                          <DockPanel Margin="0,0,0,8">
                            <TextBlock FontWeight="SemiBold" FontSize="15" Text="USB / Removable Drive Backup" TextWrapping="Wrap" />
                            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" Margin="8,0,0,0" Background="#FFD1FAE5">
                              <TextBlock FontWeight="SemiBold" FontSize="11" Foreground="#FF067647" Text="Encrypted .pbbak" />
                            </Border>
                          </DockPanel>
                          <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Export an encrypted snapshot to PharmaBill_Backups/ on a USB stick for monthly offline safety." />
                          <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Width="40" Height="36" Margin="8,0,0,0" ToolTip="Refresh Drives" AutomationProperties.Name="Refresh removable drives" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshRemovableDrivesCommand}">
