          <StackPanel Margin="18" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="GST Returns" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="Generate GSTR-1 offline utility JSON and a GSTR-3B worksheet. Validate GSTINs and HSN codes before portal upload. Always verify filings with your CA." />
            <WrapPanel Margin="0,0,0,12">
              <TextBlock Text="Month / Quarter" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Width="260" Padding="8" DisplayMemberPath="DisplayName" ItemsSource="{Binding PeriodChoices}" SelectedItem="{Binding SelectedPeriod}" />
              <Button Content="Refresh" Padding="12,8" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
              <Button Content="Generate GSTR-1 Portal JSON" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding ExportGstr1JsonCommand}" />
              <Button Content="Export GSTR-3B Worksheet" Padding="12,8" Margin="8,0,0,0" Command="{Binding ExportGstr3bWorksheetCommand}" />
            </WrapPanel>
            <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
            <TextBlock Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            <UniformGrid Columns="5" Margin="0,12,0,16">
              <Border Margin="0,0,8,0" Padding="12" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Total Taxable Turnover" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Margin="0,6,0,0" FontSize="18" FontWeight="Bold" Text="{Binding TotalTaxableText}" />
                </StackPanel>
              </Border>
              <Border Margin="0,0,8,0" Padding="12" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Output CGST" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Margin="0,6,0,0" FontSize="18" FontWeight="Bold" Text="{Binding OutputCgstText}" />
                </StackPanel>
              </Border>
              <Border Margin="0,0,8,0" Padding="12" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Output SGST" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Margin="0,6,0,0" FontSize="18" FontWeight="Bold" Text="{Binding OutputSgstText}" />
                </StackPanel>
              </Border>
              <Border Margin="0,0,8,0" Padding="12" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Eligible ITC from Purchases" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Margin="0,6,0,0" FontSize="18" FontWeight="Bold" Text="{Binding EligibleItcText}" />
                </StackPanel>
              </Border>
              <Border Padding="12" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Net GST Payable" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Margin="0,6,0,0" FontSize="18" FontWeight="Bold" Text="{Binding NetGstPayableText}" />
                </StackPanel>
              </Border>
            </UniformGrid>
            <Border Padding="14" CornerRadius="10" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" Background="{DynamicResource CardBackgroundBrush}">
              <StackPanel>
                <DockPanel>
                  <TextBlock FontWeight="SemiBold" FontSize="16" Text="Tax Audit Status" />
                  <TextBlock DockPanel.Dock="Right" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Text="{Binding AuditStatusLabel}" />
                </DockPanel>
                <DataGrid Margin="0,10,0,0" MaxHeight="220" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding AuditIssues}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Severity" Width="90" Binding="{Binding Severity}" />
                    <DataGridTextColumn Header="Invoice" Width="140" Binding="{Binding InvoiceNo}" />
                    <DataGridTextColumn Header="Date" Width="110" Binding="{Binding InvoiceDate, StringFormat=dd-MMM-yyyy}" />
                    <DataGridTextColumn Header="Category" Width="150" Binding="{Binding Category}" />
                    <DataGridTextColumn Header="Issue" Width="*" Binding="{Binding Message}" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <TextBlock FontWeight="SemiBold" FontSize="16" Text="GSTR-3B worksheet preview" Margin="0,0,0,8" />
            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="280" ItemsSource="{Binding Gstr3bRows}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Section" Width="80" Binding="{Binding Section}" />
                <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}" />
                <DataGridTextColumn Header="Taxable" Width="100" Binding="{Binding TaxableValue, StringFormat=N2}" />
                <DataGridTextColumn Header="IGST" Width="90" Binding="{Binding IntegratedTax, StringFormat=N2}" />
                <DataGridTextColumn Header="CGST" Width="90" Binding="{Binding CentralTax, StringFormat=N2}" />
                <DataGridTextColumn Header="SGST" Width="90" Binding="{Binding StateTax, StringFormat=N2}" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:WholesaleBillingPageViewModel}}" DataType="{x:Type vm:WholesaleBillingPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <controls:BindingProxy x:Key="WholesaleBillingProxy" Data="{Binding}" />
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <StackPanel Margin="18">
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Wholesale tax invoice" FontSize="24" FontWeight="SemiBold" />
              <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding InvoiceNoPreview, StringFormat=Invoice no: {0}}" />
            </DockPanel>
            <TextBlock Text="Customer" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
            <ComboBox Width="420" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="7" ToolTip="Active wholesale customer; patients and walk-ins are not allowed" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
              <TextBlock Text="Medicine / batch" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
              <controls:InfoHelper Title="Drug / batch / expiry / stock" Body="Batches are listed FEFO (earliest expiry first). Remaining stock is movement-derived. Choosing a batch locks its MRP as the rate ceiling and deducts that batch on save." />
            </StackPanel>
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="Add line" Padding="14,8" Margin="8,0,0,0" MinHeight="36" Style="{StaticResource PrimaryButton}" Command="{Binding AddLineCommand}" IsEnabled="{Binding HasStockChoices}" />
              <Grid>
                <ComboBox ToolTip="Name, batch, expiry, and current stock (FEFO order)" Style="{StaticResource StockPickerComboBox}" ItemsSource="{Binding StockChoices}" SelectedItem="{Binding SelectedStockToAdd, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasStockChoices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:Key="{DataTemplateKey {x:Type vm:WholesaleStockChoice}}" DataType="{x:Type vm:WholesaleStockChoice}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Foreground="#FF1E293B" Text="{Binding DrugName}" />
                        <TextBlock Foreground="#FF334155" Text="{Binding BatchNo, StringFormat=·  Batch {0}}" />
                        <TextBlock Foreground="#FF475569" Text="{Binding ExpiryDate, StringFormat=·  Exp {0:MM/yyyy}}" />
                        <TextBlock Foreground="#FF047857" FontWeight="SemiBold" Text="{Binding Available, StringFormat=·  Stock {0:0.##}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ComboBox>
                <TextBlock Margin="12,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#FF64748B" Text="{Binding StockPickerPlaceholder}" Visibility="{Binding ShowStockPickerPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </Grid>
            </DockPanel>
            <Border Margin="0,8,0,4" Padding="12,8" CornerRadius="8" Background="#FFFFF1F0" BorderBrush="#FFFDA29B" BorderThickness="1" Visibility="{Binding HasCreditLockAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Foreground="#FFB42318" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CreditLockAlert}" />
            </Border>
            <DataGrid behaviors:RowFlash.Enabled="True" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180" Margin="0,10,0,6" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedLine}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="3*">
                  <DataGridColumn.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Drug / batch / expiry / stock" VerticalAlignment="Center" />
                      <controls:InfoHelper Title="Drug / batch / expiry / stock" Body="Select the selling batch. FEFO prefers nearer expiry. Stock shows units left on that batch. Price defaults to the batch MRP; change rate only if trade rate ≤ MRP." />
                    </StackPanel>
                  </DataGridColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox Style="{StaticResource StockPickerComboBox}" ItemsSource="{Binding Data.StockChoices, Source={StaticResource WholesaleBillingProxy}}" SelectedItem="{Binding StockChoice, UpdateSourceTrigger=PropertyChanged}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:Key="{DataTemplateKey {x:Type vm:WholesaleStockChoice}}" DataType="{x:Type vm:WholesaleStockChoice}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock FontWeight="SemiBold" Foreground="#FF1E293B" Text="{Binding DrugName}" />
                              <TextBlock Foreground="#FF334155" Text="{Binding BatchNo, StringFormat=·  Batch {0}}" />
                              <TextBlock Foreground="#FF475569" Text="{Binding ExpiryDate, StringFormat=·  Exp {0:MM/yyyy}}" />
                              <TextBlock Foreground="#FF047857" FontWeight="SemiBold" Text="{Binding Available, StringFormat=·  Stock {0:0.##}}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ComboBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Qty" Width="*" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Width="*" Binding="{Binding FreeQuantity, UpdateSourceTrigger=PropertyChanged}">
                  <DataGridColumn.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Free" VerticalAlignment="Center" />
                      <controls:InfoHelper Title="Free quantity (bonus / scheme)" Body="Enter free trade-sample or scheme units (e.g. buy 10 get 1). Free qty deducts from the same batch inventory with zero taxable value — GST applies only to billed Qty × Rate." />
                    </StackPanel>
                  </DataGridColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Width="*" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}">
                  <DataGridColumn.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Rate (≤ MRP)" VerticalAlignment="Center" />
                      <controls:InfoHelper Title="Trade rate vs MRP" Body="Selling (trade) rate must not exceed the packaging MRP for the selected batch. PharmaBill blocks rates above MRP to stay compliant with price control rules." />
                    </StackPanel>
                  </DataGridColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Discount" Width="*" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTemplateColumn Header="Remove" Width="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Remove" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <CheckBox Content="Confirmed near-expiry batch sale after review" Margin="2,4" IsChecked="{Binding ConfirmNearExpiry}" />
            <Grid Margin="0,8,0,4" HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" FontWeight="SemiBold" Margin="4,4,16,4" VerticalAlignment="Center" Text="{Binding Subtotal, StringFormat=Taxable: ₹{0:N2}, ConverterCulture=en-IN}" />
              <TextBlock Grid.Column="1" Margin="0,4,16,4" VerticalAlignment="Center" Text="{Binding EstimatedTax, StringFormat=Estimated GST: ₹{0:N2}, ConverterCulture=en-IN}" />
              <TextBlock Grid.Column="2" FontSize="18" FontWeight="Bold" Margin="0,4,16,4" VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="NoWrap" TextTrimming="None" Text="{Binding EstimatedTotal, StringFormat=Estimated total: ₹{0:N2}, ConverterCulture=en-IN}" />
              <Button Grid.Column="3" Content="Show Payment QR" Height="34" MinWidth="140" Margin="8,0,0,0" VerticalAlignment="Center" Background="#FF2563EB" BorderBrush="#FF2563EB" ToolTip="Open dynamic UPI QR for the estimated total" Style="{StaticResource PrimaryButton}" Command="{Binding ShowPaymentQrCommand}" />
            </Grid>
            <TextBlock Text="Payment" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4" />
            <WrapPanel>
              <ComboBox Width="180" Padding="6" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" />
              <TextBox Width="150" ToolTip="Amount received" Padding="6" Margin="6,0" Text="{Binding Path=PaidAmount, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Width="210" ToolTip="Payment reference / auth / cheque details" Padding="6" Text="{Binding Path=PaymentReference, UpdateSourceTrigger=PropertyChanged}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="2,8,2,3">
              <CheckBox Content="Owner override for credit limit / overdue warning" VerticalAlignment="Center" IsChecked="{Binding OverrideCreditOrOverdue}" />
              <controls:InfoHelper Title="Owner credit override" Body="Tick this only when an owner/admin authorises billing a customer whose outstanding ledger exceeds their credit ceiling or who is overdue. You must enter a reason below; the override is audited." />
            </StackPanel>
            <TextBox ToolTip="Mandatory owner override reason" Padding="6" Text="{Binding Path=OverrideReason, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
              <TextBlock Text="Transport details, vehicle, and configurable compliance placeholders" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              <controls:InfoHelper Title="Transport &amp; e-way details" Body="Record transporter name/details and vehicle number when goods move. These fields support e-way bill compliance for consignments above the configured threshold. E-way bill no. and IRN are entered manually — no portal integration is built in." />
            </StackPanel>
            <WrapPanel>
              <TextBox Width="260" ToolTip="Transport details" Padding="6" Text="{Binding Path=TransportDetails, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Width="180" ToolTip="Vehicle number" Padding="6" Margin="6,0" Text="{Binding Path=VehicleNumber, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Width="200" ToolTip="E-way bill number (manual)" Padding="6" Text="{Binding Path=EWayBillNumber, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox Width="240" ToolTip="IRN (manual)" Padding="6" Margin="6,0" Text="{Binding Path=Irn, UpdateSourceTrigger=PropertyChanged}" />
            </WrapPanel>
            <TextBlock Text="E-way bill threshold notice: configure the applicable threshold and verify the current requirement. No portal integration is provided." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="4,6" />
            <TextBox ToolTip="Invoice notes" Padding="6" Margin="0,5" Text="{Binding Path=Notes, UpdateSourceTrigger=PropertyChanged}" />
            <WrapPanel Margin="0,8,0,0">
              <Button Content="Save invoice" Style="{StaticResource PrimaryButton}" Command="{Binding SaveInvoiceCommand}" />
              <Button Content="Tax invoice PDF" Padding="12,8" Margin="8,0,0,0" Command="{Binding ExportTaxInvoiceCommand}" />
              <Button Content="Delivery challan PDF" Padding="12,8" Margin="8,0,0,0" Command="{Binding ExportDeliveryChallanCommand}" />
            </WrapPanel>
            <TextBlock Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="3,8,3,0" Text="{Binding StatusMessage}" />
            <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Margin="3,4,3,0" Text="{Binding ErrorMessage}" />
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:WholesaleCustomerPageViewModel}}" DataType="{x:Type vm:WholesaleCustomerPageViewModel}">
        <Grid Margin="18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Wholesale customers" FontSize="24" FontWeight="SemiBold" />
            <WrapPanel Grid.Row="1" Margin="0,10,0,10">
              <Button Content="New customer" Padding="10,6" Command="{Binding NewCustomerCommand}" />
              <Button Content="Import Excel" Padding="10,6" Margin="6,0,0,0" Command="{Binding ImportExcelCommand}" />
            </WrapPanel>
            <ListBox Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Customer.Name}" />
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Customer.Gstin, TargetNullValue=No GSTIN}" />
                    <TextBlock Foreground="#FFB54708" FontWeight="SemiBold" Text="{Binding ExpiryAlertText}" />
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding StatusText}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </Grid>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Buyer details" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="3">
                  <TextBlock Text="Customer / legal name" />
                  <TextBox Padding="6" TabIndex="0" Text="{Binding Path=Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="3">
                  <TextBlock Text="Buyer type" />
                  <ComboBox IsEditable="True" Padding="5" TabIndex="1" ItemsSource="{Binding BuyerTypeOptions}" Text="{Binding BuyerType, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="3">
                  <TextBlock Text="GSTIN" />
                  <TextBox Padding="6" TabIndex="2" Text="{Binding Path=Gstin, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="3">
                  <TextBlock Text="Phone" />
                  <TextBox Padding="6" TabIndex="3" Text="{Binding Path=Phone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="3">
                  <TextBlock Text="Email" />
                  <TextBox Padding="6" TabIndex="4" Text="{Binding Path=Email, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="3">
                  <TextBlock Text="State" />
                  <TextBox Padding="6" TabIndex="5" Text="{Binding Path=State, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="3">
                  <TextBlock Text="Address" />
                  <TextBox Padding="6" TabIndex="6" Text="{Binding Path=Address, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="3">
                  <TextBlock Text="Credit limit (₹)" />
                  <TextBox Padding="6" TabIndex="7" Text="{Binding Path=CreditLimit, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="3">
                  <TextBlock Text="Credit days" />
                  <TextBox Padding="6" TabIndex="8" Text="{Binding Path=CreditDays, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="3">
                  <TextBlock Text="Opening balance (₹)" />
                  <TextBox Padding="6" TabIndex="9" Text="{Binding Path=OpeningBalance, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="3">
                  <TextBlock Text="Price category" />
                  <TextBox Padding="6" TabIndex="10" Text="{Binding Path=PriceCategory, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="3">
                  <TextBlock Text="Route" />
                  <TextBox Padding="6" TabIndex="11" Text="{Binding Path=Route, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="3">
                  <TextBlock Text="Salesman" />
                  <TextBox Padding="6" TabIndex="12" Text="{Binding Path=Salesman, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="4,8">
                <CheckBox Content="Active (clear to block buyer)" VerticalAlignment="Center" IsChecked="{Binding IsActive}" />
                <controls:InfoHelper Title="Active buyer flag" Body="Keep checked for customers you can invoice. Clearing Active blocks new wholesale invoices for this party while keeping history and outstanding ledger intact." />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                <TextBlock Text="Licence type rules for buyer types" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <controls:InfoHelper Title="Licence type rules (Form 20 / 21)" Body="Retail chemists typically need Form 20/21 (or state equivalents); wholesale buyers need wholesale/distributor DL types. Configure which licence types each buyer type must hold. Sales are blocked until a matching unexpired licence exists." />
              </StackPanel>
              <WrapPanel>
                <ComboBox Width="180" Padding="5" ItemsSource="{Binding BuyerTypeOptions}" SelectedItem="{Binding BuyerLicenceRuleType}" />
                <TextBox Width="260" ToolTip="Comma-separated permitted licence types" Padding="6" Margin="6,0,0,0" Text="{Binding Path=BuyerLicenceRuleTypes, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Save buyer licence rule" Padding="9,5" Margin="6,0,0,0" Command="{Binding SaveBuyerLicenceRuleCommand}" />
              </WrapPanel>
              <TextBlock Text="Configure licence types permitted for each buyer type. Sales are blocked until a rule is configured." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="3,4,3,8" />
              <TextBlock Text="Drug licences" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6" />
              <WrapPanel Margin="0,0,0,6">
                <ComboBox Width="180" IsEditable="True" Padding="4" ItemsSource="{Binding LicenceTypeOptions}" Text="{Binding NewLicenceType, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Add licence" Margin="6,0,0,0" Padding="9,5" Command="{Binding AddLicenceCommand}" />
                <Button Content="Add type to editable list" Margin="6,0,0,0" Padding="9,5" Command="{Binding AddLicenceTypeCommand}" />
              </WrapPanel>
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="145" MaxHeight="220" HeadersVisibility="Column" ItemsSource="{Binding Licences}" SelectedItem="{Binding SelectedLicence, Mode=TwoWay}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Type" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.LicenceTypeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}" Text="{Binding LicenceType, UpdateSourceTrigger=PropertyChanged}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Licence number" Width="*" Binding="{Binding LicenceNumber, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Issued (yyyy-mm-dd)" Width="145" Binding="{Binding IssuedOn, StringFormat='{}{0:yyyy-MM-dd}', UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Expires (yyyy-mm-dd)" Width="145" Binding="{Binding ExpiresOn, StringFormat='{}{0:yyyy-MM-dd}', UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Authority" Width="*" Binding="{Binding IssuingAuthority, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Scan path" IsReadOnly="True" Width="*" Binding="{Binding DocumentPath}" />
                  <DataGridTextColumn Header="X / NDPS authorisation" Width="*" Binding="{Binding Authorisation, UpdateSourceTrigger=PropertyChanged}" />
                </DataGrid.Columns>
              </DataGrid>
              <WrapPanel Margin="0,6,0,0">
                <Button Content="Attach scan to selected licence" Padding="9,5" Command="{Binding SelectLicenceScanCommand}" CommandParameter="{Binding SelectedLicence}" />
                <Button Content="Remove selected licence" Padding="9,5" Margin="6,0,0,0" Command="{Binding RemoveLicenceCommand}" CommandParameter="{Binding SelectedLicence}" />
              </WrapPanel>
              <TextBlock Text="Verification record" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,6" />
              <WrapPanel>
                <TextBox Width="190" Padding="6" ToolTip="Verified by" Text="{Binding Path=VerifiedBy, UpdateSourceTrigger=PropertyChanged}" />
                <DatePicker Margin="6,0" SelectedDate="{Binding VerifiedOn}" />
                <TextBox Width="190" Padding="6" ToolTip="Verification method" Text="{Binding Path=VerificationMethod, UpdateSourceTrigger=PropertyChanged}" />
              </WrapPanel>
