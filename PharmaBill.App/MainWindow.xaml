      <ColumnDefinition Width="260" MinWidth="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Panel.ZIndex="10" Background="{StaticResource SidebarGradientBrush}" IsHitTestVisible="True" ClipToBounds="False">
      <Decorator.Child>
        <DockPanel Margin="12,8,12,12" ClipToBounds="False">
          <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,24,0,16" ClipToBounds="False">
