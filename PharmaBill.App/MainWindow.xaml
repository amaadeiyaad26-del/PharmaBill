                  <Button Grid.Row="0" Grid.Column="0" Height="32" MinWidth="0" Margin="2,2" Padding="6,2" HorizontalAlignment="Stretch" Content="Get data from Prescription" AutomationProperties.Name="Extract from Prescription" ToolTip="Upload or scan prescription (PDF/Image) [F7 webcam / file pick]. Extract medicines and add confirmed lines to this bill." Style="{StaticResource FrostedMintPillButton}" Command="{Binding ExtractPrescriptionCommand}" />
                  <Button Grid.Row="0" Grid.Column="1" Height="32" MinWidth="0" Margin="2,2" Padding="6,2" HorizontalAlignment="Stretch" Content="Webcam OCR" AutomationProperties.Name="Extract from Webcam" ToolTip="Capture a live prescription frame, extract the medicines, and archive the photo on this bill. Shortcut: F7" Style="{StaticResource FrostedMintPillButton}" Command="{Binding ExtractPrescriptionFromWebcamCommand}" />
                  <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="32" MinWidth="0" Margin="2,2" Padding="6,2" HorizontalAlignment="Stretch" Content="Send via WhatsApp" AutomationProperties.Name="Send via WhatsApp" ToolTip="Open WhatsApp immediately with a full digital invoice text for the phone number entered above." Background="#25D366" BorderBrush="#128C7E" Foreground="#FFFFFF" FontWeight="SemiBold" Command="{Binding SendViaWhatsAppCommand}" />
                  <Button Grid.Row="2" Grid.Column="0" Height="32" MinWidth="0" Margin="2,2" Padding="6,2" HorizontalAlignment="Stretch" Content="F2 New Bill" AutomationProperties.Name="F2 New Bill" ToolTip="Start a fresh new customer bill (clears current fields). Shortcut: F2" Style="{StaticResource FrostedMintPillButton}" Command="{Binding NewBillCommand}" />
                  <Button Grid.Row="2" Grid.Column="1" Height="32" MinWidth="0" Margin="2,2" Padding="6,2" HorizontalAlignment="Stretch" Content="F10 Print &amp; Save" AutomationProperties.Name="F10 Print &amp; Save" ToolTip="Finalize this sale, deduct batch stock, save to sales register, and print receipt. Shortcut: F10" Style="{StaticResource SuccessButton}" Background="#059669" BorderBrush="#047857" Foreground="#FFFFFF" Command="{Binding SaveAndPrintCommand}" />
                  <Button Grid.Row="3" Grid.Column="0" Height="32" MinWidth="0" Margin="2,2" Padding="6,2" HorizontalAlignment="Stretch" Content="F8 Pause / Hold" AutomationProperties.Name="F8 Pause / Hold" ToolTip="Temporarily pause this bill and keep it in queue while serving the next customer. Shortcut: F8" Style="{StaticResource SecondaryButton}" Command="{Binding HoldBillCommand}" />
                  <Button Grid.Row="3" Grid.Column="1" Height="32" MinWidth="0" Margin="2,2" Padding="6,2" HorizontalAlignment="Stretch" Content="Recent Bills" AutomationProperties.Name="Recent Past Bills" ToolTip="View, reprint, or export PDF for recently completed bills from today." Style="{StaticResource SecondaryButton}" Click="OpenRecentBills_Click" />
                  <Button Grid.Row="4" Grid.Column="0" Height="32" MinWidth="0" Margin="2,2" Padding="6,2" HorizontalAlignment="Stretch" Content="Esc Cancel" ToolTip="Discard the current unsaved bill and clear all items. Shortcut: Esc" Style="{StaticResource SecondaryButton}" Command="{Binding CancelBillCommand}" />
                  <DockPanel Grid.Row="4" Grid.Column="1" Margin="2,2" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Resume" Height="32" Margin="4,0,0,0" Padding="6,2" ToolTip="Reload the selected paused customer bill back into the billing table to finish checkout." Style="{StaticResource SecondaryButton}" Command="{Binding ResumeSelectedBillCommand}" IsEnabled="{Binding HasHeldBills}" />
                    <Grid>
                      <ComboBox Height="32" VerticalAlignment="Center" ToolTip="Paused bills: patient - total (time held)" ItemsSource="{Binding HeldBills}" SelectedItem="{Binding SelectedHeldBill}" IsEnabled="{Binding HasHeldBills}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ComboBox>
                      <TextBlock Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#FF94A3B8" Text="{Binding HeldBillsPlaceholder}">
                        <TextBlock.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding SelectedHeldBill}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </DockPanel>
                  <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Foreground="#FFB42318" TextWrapping="Wrap" Margin="2,2" Text="{Binding ErrorMessage}" />
                </Grid>
              </Grid>
            </Grid>
          <Border Background="#99FFFFFF" Visibility="{Binding IsScanningPrescription, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Decorator.Child>
              <Border Background="#FF0F172A" CornerRadius="12" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Decorator.Child>
                  <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="260" Height="6" Foreground="#FF3B82F6" Background="#FF334155" BorderThickness="0" />
                    <TextBlock Foreground="#FFFFFFFF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" Text="{Binding ScanStatus}" />
                  </StackPanel>
                </Decorator.Child>
              </Border>
            </Decorator.Child>
          </Border>
          <!-- Out-of-stock salt substitute drawer (right flyout) -->
          <Button Panel.ZIndex="40" Background="#550F172A" BorderThickness="0" Cursor="Arrow" Focusable="False"
                  Visibility="{Binding IsSubstituteFlyoutOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Command="{Binding CloseSubstituteFlyoutCommand}" ToolTip="Close substitute drawer" />
          <Border Panel.ZIndex="41" HorizontalAlignment="Right" Width="420" Margin="0,8,8,8" Padding="14,12"
                  Background="{DynamicResource CardBackgroundBrush}" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="12"
                  Visibility="{Binding IsSubstituteFlyoutOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
              <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.28" Color="#0F172A" />
            </Border.Effect>
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="32" Padding="0" Style="{StaticResource SecondaryButton}" Command="{Binding CloseSubstituteFlyoutCommand}" ToolTip="Close" />
                <StackPanel>
                  <TextBlock Text="{Binding SubstituteDrawerTitle}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                  <TextBlock Margin="0,4,0,0" Text="{Binding SubstituteDrawerSubtitle}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </DockPanel>
              <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                         Text="Identical salt composition only. Pharmacist must confirm suitability and prescription rules." />
              <ListView Name="RetailSubstituteList" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding Substitutes}" SelectedItem="{Binding SelectedSubstitute}" MouseDoubleClick="RetailSubstitute_OnMouseDoubleClick"
                        BorderThickness="0" Background="Transparent">
                <UIElement.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding ConfirmSelectedSubstituteCommand}" />
                  <KeyBinding Key="Escape" Command="{Binding CloseSubstituteFlyoutCommand}" />
                </UIElement.InputBindings>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                          <Border x:Name="Card" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Card" Property="BorderBrush" Value="#10B981" />
                              <Setter TargetName="Card" Property="Background" Value="#ECFDF5" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Card" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel LastChildFill="True">
                      <Button DockPanel.Dock="Right" MinWidth="96" Height="32" Margin="10,0,0,0" Padding="8,4"
                              VerticalAlignment="Center"
                              Command="{Binding DataContext.AddFromSubstituteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                              CommandParameter="{Binding}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Content" Value="Quick batch" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsInStock}" Value="True">
                                <Setter Property="Content" Value="Add to bill" />
                                <Setter Property="Background" Value="#10B981" />
                                <Setter Property="BorderBrush" Value="#047857" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Composition}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#047857" Text="{Binding StockQuantity, StringFormat=Stock {0:0.##}}" />
                          <TextBlock Margin="12,0,0,0" FontSize="12" Text="{Binding Mrp, StringFormat=MRP ₹{0:N2}}" />
                          <TextBlock Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Rack, StringFormat=Rack {0}}" />
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ListView>
            </DockPanel>
          </Border>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:StockPageViewModel}}" DataType="{x:Type vm:StockPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <controls:BindingProxy x:Key="StockPageProxy" Data="{Binding}" />
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <controls:GlobalMedicineSearchControl ShowActions="True" Margin="0,0,0,16" DataContext="{Binding DataContext.CatalogSearch, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="Stock" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,14" />
            <WrapPanel Margin="0,0,0,10">
              <Button Content="All" Height="40" MinWidth="72" Margin="0,0,8,8" CommandParameter="All" Style="{StaticResource FrostedMintPillButton}" Command="{Binding SetStockFilterCommand}" ToolTip="Show every batch currently in stock." />
              <Button Content="Shortage" Height="40" MinWidth="100" Margin="0,0,8,8" CommandParameter="Shortage" Style="{StaticResource FrostedMintPillButton}" Command="{Binding SetStockFilterCommand}" ToolTip="StockQty ≤ ReorderLevel — generate purchase indent." />
              <Button Content="Near Expiry" Height="40" MinWidth="110" Margin="0,0,8,8" CommandParameter="Near expiry" Style="{StaticResource FrostedMintPillButton}" Command="{Binding SetStockFilterCommand}" ToolTip="Expired / &lt;30 / &lt;60 / &lt;90 day life statement." />
              <Button Content="Dump Stock" Height="40" MinWidth="110" Margin="0,0,8,8" CommandParameter="Dump Stock" Style="{StaticResource FrostedMintPillButton}" Command="{Binding SetStockFilterCommand}" ToolTip="Batches with zero sales movement in the last 90 days (blocked capital)." />
              <Button Content="Banned" Height="40" MinWidth="90" Margin="0,0,8,8" CommandParameter="Banned" Style="{StaticResource FrostedMintPillButton}" Command="{Binding SetStockFilterCommand}" ToolTip="Hold / ban / recall registry." />
              <Button Content="Valuation" Height="40" MinWidth="100" Margin="0,0,8,8" CommandParameter="Valuation" Style="{StaticResource FrostedMintPillButton}" Command="{Binding SetStockFilterCommand}" ToolTip="FIFO purchase rate and MRP holding value." />
              <Button Content="Missing MRP" Height="36" MinWidth="120" Margin="0,0,8,8" CommandParameter="Missing MRP" Style="{StaticResource SecondaryButton}" Command="{Binding SetStockFilterCommand}" />
              <Button Content="Purchase Indent" Height="36" MinWidth="140" Margin="0,0,8,8" Style="{StaticResource FrostedMintPillButton}" Command="{Binding GeneratePurchaseIndentCommand}" />
              <Button Content="Draft PO" Height="40" MinWidth="100" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding CreateDraftPurchaseOrderCommand}" />
              <Button Content="Ban / Hold batch" Height="36" MinWidth="130" Margin="0,0,8,8" Style="{StaticResource FrostedMintPillButton}" Command="{Binding BanSelectedBatchCommand}" ToolTip="Flag selected batch as Banned / Not for Sale / Recalled." />
              <Button Content="Brk / Exp Return" Height="36" MinWidth="130" Margin="0,0,8,8" Style="{StaticResource FrostedMintPillButton}" Command="{Binding IssueBrkExpReturnCommand}" ToolTip="Pull expired/damaged batches and issue debit note to distributor." />
              <Button Content="Counter Challan" Height="36" MinWidth="130" Margin="0,0,8,8" Style="{StaticResource FrostedMintPillButton}" Command="{Binding OpenCounterChallanCommand}" ToolTip="Internal stock movement between godown and shop front." />
              <Button Content="Extract Invoice" Height="36" MinWidth="130" Margin="0,0,0,8" Style="{StaticResource SecondaryButton}" Command="{Binding ExtractOpeningStockCommand}" />
            </WrapPanel>
            <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#0D4A2B" FontWeight="SemiBold" Text="{Binding ValuationSummaryText}" />
            <WrapPanel Margin="0,0,0,14">
              <controls:FloatingField Label="Filter by medicine name" Width="260" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=NameFilter, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Batch no." Width="170" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=BatchFilter, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Schedule" Width="150" Margin="0,0,8,8">
                <ComboBox ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding ScheduleFilter}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Status" Width="170" Margin="0,0,8,8">
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" />
              </controls:FloatingField>
              <Button Content="Refresh" Height="48" MinWidth="100" Margin="0,0,0,8" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" ToolTip="Reload the stock grid from the local database." />
            </WrapPanel>
            <Grid Height="320" Margin="0,0,0,14">
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                <DataGrid.RowStyle>
                  <Style TargetType="{x:Type DataGridRow}">
                    <Style.Triggers>
                      <DataTrigger Value="Expired" Binding="{Binding Status, Mode=OneWay}">
                        <Setter Property="Panel.Background" Value="#FFFEE4E2" />
                        <Setter Property="TextElement.Foreground" Value="#FF912018" />
                      </DataTrigger>
                      <DataTrigger Value="Critical" Binding="{Binding Status, Mode=OneWay}">
                        <Setter Property="Panel.Background" Value="#FFFEE4E2" />
                        <Setter Property="TextElement.Foreground" Value="#FF912018" />
                      </DataTrigger>
                      <DataTrigger Value="Near expiry" Binding="{Binding Status, Mode=OneWay}">
                        <Setter Property="Panel.Background" Value="#FFFFEAD5" />
                        <Setter Property="TextElement.Foreground" Value="#FF93370D" />
                      </DataTrigger>
                      <DataTrigger Value="Shortage" Binding="{Binding Status, Mode=OneWay}">
                        <Setter Property="Panel.Background" Value="#FFFEF0C7" />
                        <Setter Property="TextElement.Foreground" Value="#FF7A2E0E" />
                      </DataTrigger>
                      <DataTrigger Value="Low stock" Binding="{Binding Status, Mode=OneWay}">
                        <Setter Property="Panel.Background" Value="#FFFEF0C7" />
                        <Setter Property="TextElement.Foreground" Value="#FF7A2E0E" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Medicine" Width="*" IsReadOnly="True" Binding="{Binding Medicine, Mode=OneWay}" />
                  <DataGridTextColumn Header="Schedule" Width="85" IsReadOnly="True" Binding="{Binding Schedule, Mode=OneWay}" />
                  <DataGridTextColumn Header="Batch" Width="120" IsReadOnly="True" Binding="{Binding BatchNo, Mode=OneWay}" />
                  <DataGridTextColumn Header="Expiry" Width="90" IsReadOnly="True" Binding="{Binding ExpiryDate, Mode=OneWay, StringFormat=MM/yyyy}" />
                  <DataGridTemplateColumn Header="MRP" Width="160" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock VerticalAlignment="Center" Margin="6,0" Text="{Binding MrpLabel}">
                          <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                              <Setter Property="Foreground" Value="#FF0F172A" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding RequiresMrp}" Value="True">
                                  <Setter Property="Foreground" Value="#FFB45309" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                  <Setter Property="Background" Value="#FFFEF3C7" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox Padding="6,4" VerticalContentAlignment="Center" Text="{Binding MrpEditText, UpdateSourceTrigger=LostFocus}" ToolTip="Type the MRP and press Enter." />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Purchase rate" Width="110" IsReadOnly="True" Binding="{Binding PurchaseRate, Mode=OneWay, StringFormat=F2}" Visibility="{Binding Data.CanViewPurchaseMargins, Source={StaticResource StockPageProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <DataGridTextColumn Header="Stock" Width="80" IsReadOnly="True" Binding="{Binding Quantity, Mode=OneWay, StringFormat=0.##}" />
                  <DataGridTextColumn Header="Reorder" Width="80" IsReadOnly="True" Binding="{Binding ReorderLevel, Mode=OneWay, StringFormat=0.##}" />
                  <DataGridTextColumn Header="Status" Width="110" IsReadOnly="True" Binding="{Binding Status, Mode=OneWay}" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="No stock items yet. Search a medicine above and click Add to stock." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="0" Binding="{Binding Rows.Count}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </Grid>
            <TextBlock Text="Stock adjustment" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SelectedRow.Medicine, StringFormat=Selected: {0}, FallbackValue=No batch selected}" />
            <WrapPanel Margin="0,0,0,10">
              <controls:FloatingField Label="Quantity change (+ or -)" IsRequired="True" Width="220" Margin="0,0,8,8" ErrorText="{Binding ActionQuantityError}">
                <TextBox Text="{Binding Path=ActionQuantityText, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Reason" IsRequired="True" Width="240" Margin="0,0,8,8" ErrorText="{Binding ActionReasonError}">
                <ComboBox ItemsSource="{Binding ReasonOptions}" SelectedItem="{Binding ActionReason}" />
              </controls:FloatingField>
              <Button Content="Adjust stock" Height="48" MinWidth="130" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Command="{Binding AdjustStockCommand}" />
              <Button Content="Write off expired" Height="48" MinWidth="150" Margin="0,0,0,8" Style="{StaticResource SecondaryButton}" Command="{Binding WriteOffExpiredCommand}" />
            </WrapPanel>
            <TextBlock Text="Physical count" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,8" />
            <WrapPanel Margin="0,0,0,8">
              <controls:FloatingField Label="Count session name" Width="280" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=VerificationSessionNo, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <Button Content="Start physical count" Height="48" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding StartVerificationCommand}" />
              <Button Content="Post physical count" Height="48" Margin="0,0,0,8" Style="{StaticResource PrimaryButton}" Command="{Binding PostVerificationCommand}" />
            </WrapPanel>
            <Grid Height="170" Margin="0,0,0,8">
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding VerificationItems}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Medicine / batch" IsReadOnly="True" Width="*" Binding="{Binding Display, Mode=OneWay}" />
                  <DataGridTextColumn Header="Expected" IsReadOnly="True" Width="100" Binding="{Binding ExpectedQuantity, Mode=OneWay}" />
                  <DataGridTextColumn Header="Counted" Width="100" Binding="{Binding CountedQuantity, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="Difference" IsReadOnly="True" Width="100" Binding="{Binding Difference, Mode=OneWay, StringFormat=+0.##;-0.##;0}" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="No count started. Click Start physical count to list every batch." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="0" Binding="{Binding VerificationItems.Count}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </Grid>
            <TextBlock Foreground="#FF027A48" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            <TextBlock Foreground="#FFB42318" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:StockTransferPageViewModel}}" DataType="{x:Type vm:StockTransferPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28">
            <TextBlock Text="Stock transfer challan" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Move batches between godowns. Counter billing only sells from Shop Front." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,14" />
            <WrapPanel Margin="0,0,0,12">
              <controls:FloatingField Label="Source location" Width="220" Margin="0,0,8,8">
                <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Locations}" SelectedItem="{Binding SourceLocation}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Destination location" Width="220" Margin="0,0,8,8">
                <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Locations}" SelectedItem="{Binding DestinationLocation}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Transfer date" Width="180" Margin="0,0,8,8">
                <DatePicker SelectedDate="{Binding TransferDate}" />
              </controls:FloatingField>
              <controls:FloatingField Label="Filter medicine / batch" Width="220" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=MedicineFilter, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <Button Content="Refresh batches" Height="48" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAvailableBatchesCommand}" />
              <Button Content="Add godown" Height="48" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding AddGodownCommand}" />
            </WrapPanel>
            <TextBlock Text="Batches at source" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid Height="180" Margin="0,0,0,10">
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" ItemsSource="{Binding AvailableBatches}" SelectedItem="{Binding SelectedAvailableBatch}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Medicine" Width="*" Binding="{Binding DrugName, Mode=OneWay}" />
                  <DataGridTextColumn Header="Batch" Width="110" Binding="{Binding BatchNo, Mode=OneWay}" />
                  <DataGridTextColumn Header="Expiry" Width="90" Binding="{Binding ExpiryDate, Mode=OneWay, StringFormat=MM/yyyy}" />
                  <DataGridTextColumn Header="Available" Width="90" Binding="{Binding AvailableQuantity, Mode=OneWay, StringFormat=0.##}" />
                  <DataGridTextColumn Header="Rack" Width="80" Binding="{Binding Rack, Mode=OneWay}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
            <WrapPanel Margin="0,0,0,12">
              <controls:FloatingField Label="Qty to transfer" Width="140" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=AddQuantityText, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
              <Button Content="Add to challan" Height="48" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Command="{Binding AddLineCommand}" />
              <controls:FloatingField Label="Notes" Width="320" Margin="0,0,8,8">
                <TextBox Text="{Binding Path=Notes, UpdateSourceTrigger=PropertyChanged}" />
              </controls:FloatingField>
            </WrapPanel>
            <TextBlock Text="Transfer lines" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid Height="160" Margin="0,0,0,10">
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" ItemsSource="{Binding TransferLines}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Medicine" Width="*" IsReadOnly="True" Binding="{Binding DrugName, Mode=OneWay}" />
                  <DataGridTextColumn Header="Batch" Width="110" IsReadOnly="True" Binding="{Binding BatchNo, Mode=OneWay}" />
                  <DataGridTextColumn Header="Qty" Width="90" Binding="{Binding TransferQuantity, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTemplateColumn Header="" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Remove" Padding="6,2" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
            <WrapPanel>
              <Button Content="Confirm transfer" Height="48" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmTransferCommand}" />
              <Button Content="Print transfer challan" Height="48" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding PrintChallanCommand}" />
              <Button Content="Refresh" Height="48" Margin="0,0,8,8" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
            </WrapPanel>
            <TextBlock Foreground="#FF027A48" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding StatusMessage}" />
            <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding ErrorMessage}" />
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:PurchasePageViewModel}}" DataType="{x:Type vm:PurchasePageViewModel}">
          <!-- Stretch to ContentControl so Row * receives remaining window height for the inward grid. -->
          <Grid Margin="16,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                AllowDrop="True" DragEnter="PurchaseDocument_DragEnter" Drop="PurchaseDocument_Drop">
          <Grid.InputBindings>
            <KeyBinding Key="F2" Command="{Binding NewBillCommand}" />
            <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NewBillCommand}" />
            <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding NewBillCommand}" />
            <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewBillCommand}" />
            <KeyBinding Key="F3" Command="{Binding FocusPatientCommand}" />
            <KeyBinding Key="D3" Modifiers="Control" Command="{Binding FocusPatientCommand}" />
            <KeyBinding Key="P" Modifiers="Control" Command="{Binding FocusPatientCommand}" />
            <KeyBinding Key="F4" Command="{Binding FocusMedicineSearchCommand}" />
            <KeyBinding Key="D4" Modifiers="Control" Command="{Binding FocusMedicineSearchCommand}" />
            <KeyBinding Key="M" Modifiers="Control" Command="{Binding FocusMedicineSearchCommand}" />
            <KeyBinding Key="F7" Command="{Binding ScanInvoiceCommand}" />
            <KeyBinding Key="D7" Modifiers="Control" Command="{Binding ScanInvoiceCommand}" />
            <KeyBinding Key="D" Modifiers="Control" Command="{Binding ScanInvoiceCommand}" />
            <KeyBinding Key="F8" Command="{Binding HoldBillCommand}" />
            <KeyBinding Key="H" Modifiers="Control" Command="{Binding HoldBillCommand}" />
            <KeyBinding Key="F10" Command="{Binding SaveAndPrintCommand}" />
            <KeyBinding Key="Return" Modifiers="Control" Command="{Binding SaveAndPrintCommand}" />
            <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SaveAndPrintCommand}" />
            <KeyBinding Key="D0" Modifiers="Control" Command="{Binding SaveAndPrintCommand}" />
            <KeyBinding Key="F12" Command="{Binding DataContext.ShortcutOpenCalculatorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <KeyBinding Key="K" Modifiers="Control" Command="{Binding DataContext.ShortcutOpenCalculatorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <KeyBinding Key="Escape" Command="{Binding CancelBillCommand}" />
            <KeyBinding Key="W" Modifiers="Control" Command="{Binding CancelBillCommand}" />
            <KeyBinding Key="S" Modifiers="Control+Alt" Command="{Binding ScanPurchaseWithHandheldScannerCommand}" />
            <KeyBinding Key="S" Modifiers="Control" Command="{Binding TransferToStockCommand}" />
            <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PreviousPageCommand}" />
            <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NextPageCommand}" />
          </Grid.InputBindings>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Row 0: Title + Invoice Tools menu + status -->
          <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
              <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Purchases" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Inward supplier bills into stock" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
              <Button x:Name="InvoiceToolsButton" Content="⚡ Invoice Tools ▾" VerticalAlignment="Center" Click="InvoiceToolsButton_Click"
                      ToolTip="Import, scan, and attach distributor invoices"
                      Foreground="White" FontWeight="SemiBold" FontSize="13" Padding="14,0" Height="32" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" CornerRadius="6" BorderThickness="1" BorderBrush="#115E59" Padding="{TemplateBinding Padding}">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#0D9488" Offset="0" />
                          <GradientStop Color="#0F766E" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.25" />
                      </Border.Effect>
                      <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background">
                          <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                              <GradientStop Color="#14B8A6" Offset="0" />
                              <GradientStop Color="#0D9488" Offset="1" />
                            </LinearGradientBrush>
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Chrome" Property="Background">
                          <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                              <GradientStop Color="#0B5F58" Offset="0" />
                              <GradientStop Color="#0F766E" Offset="1" />
                            </LinearGradientBrush>
                          </Setter.Value>
                        </Setter>
                        <Setter TargetName="Chrome" Property="Effect">
                          <Setter.Value>
                            <DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="0" Opacity="0.35" />
                          </Setter.Value>
                        </Setter>
                        <Setter TargetName="Presenter" Property="Margin" Value="0,1,0,0" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="#99F6E4" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <Button.ContextMenu>
                  <ContextMenu Placement="Bottom">
                  <MenuItem Header="📄 Extract from Invoice (PDF/Img)" Command="{Binding ExtractInvoicesCommand}"
                            ToolTip="Read one or more distributor invoice PDFs or images into the purchase table." />
                  <MenuItem Header="📷 Scan with Webcam" Command="{Binding ScanInvoiceCommand}"
                            ToolTip="Capture the supplier invoice from a USB document camera or webcam. Shortcut: F7" />
                  <MenuItem Header="🖨 Handheld / USB Scanner" Command="{Binding ScanPurchaseWithHandheldScannerCommand}"
                            ToolTip="Scan Purchase Invoice via Handheld / USB Scanner (Ctrl + Alt + S)"
                            AutomationProperties.Name="Scan purchase invoice with handheld scanner" />
                  <MenuItem Header="📱 Scan via Phone App" Command="{Binding ScanViaPhoneCommand}"
                            ToolTip="Pair an Android phone on this Wi-Fi network and receive scanned distributor bills live." />
                  <Separator />
                  <MenuItem Header="📁 Load CSV / Excel" Command="{Binding LoadSpreadsheetCommand}"
                            ToolTip="Import purchase items and batches from a distributor Excel or CSV file." />
                  <MenuItem Header="📂 Invoices History" Command="{Binding ShowInvoiceHistoryCommand}"
                            ToolTip="Browse saved purchase bills by supplier and date, and open the attached invoice." />
                  <MenuItem Header="Attach file" Command="{Binding AttachInvoiceFileCommand}"
                            ToolTip="Attach an invoice photo or PDF already saved on this PC" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Foreground="#FF027A48" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12.5" Text="{Binding StatusMessage}">
                <TextBlock.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Foreground="#FFB42318" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12.5" Text="{Binding ErrorMessage}">
                <TextBlock.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ProgressBar IsIndeterminate="True" Height="3" Margin="0,2,0,0" Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
          </DockPanel>

          <!-- Row 1: Compact supplier card + optional workflow panels (collapsed when idle) -->
          <StackPanel Grid.Row="1" Margin="0,0,0,4">
            <Border Padding="8,6" CornerRadius="8" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1"
                    behaviors:KeyNavigationBehavior.Enabled="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.4*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" MinWidth="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                  <Button DockPanel.Dock="Right" Content="+ Add" Height="30" MinWidth="56" Margin="6,14,0,0" Padding="8,2"
                          VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}"
                          Command="{Binding AddSupplierCommand}" ToolTip="Add a supplier that is not in the list yet." />
                  <controls:FloatingField Label="Supplier" IsRequired="True" Margin="0,4" ErrorText="{Binding SupplierError}">
                    <ComboBox x:Name="PurchaseSupplierBox" DisplayMemberPath="Name" IsEditable="False" Padding="4,2"
                              ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </controls:FloatingField>
                </DockPanel>
                <controls:FloatingField Grid.Column="1" Label="Invoice number" IsRequired="True" Margin="0,4,8,4" ErrorText="{Binding InvoiceNoError}">
                  <TextBox Padding="4,2" Text="{Binding Path=InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FloatingField>
                <StackPanel Grid.Column="2" Margin="0,4,8,4">
                  <TextBlock Text="Invoice date *" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,2" />
                  <DatePicker MinWidth="130" Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="4,2" SelectedDate="{Binding InvoiceDate}">
                    <DatePicker.Resources>
                      <!-- Stock template overlays PART_Watermark on the text, producing "In10-10-2026"; render the text host only. -->
                      <Style TargetType="{x:Type DatePickerTextBox}">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                              <Border Background="{TemplateBinding Background}" Padding="2,0">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </DatePicker.Resources>
                  </DatePicker>
                  <TextBlock Text="{Binding InvoiceDateError}" FontSize="11" Foreground="#FFB42318" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                          <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <controls:FloatingField Grid.Column="3" Label="Godown" Margin="0,4,8,4" ToolTip="Where purchased goods are stored. Defaults to Shop Front (retail counter).">
                  <ComboBox x:Name="PurchaseGodownBox" DisplayMemberPath="Name" IsEditable="False" Padding="4,2"
                            ItemsSource="{Binding StorageLocations}" SelectedItem="{Binding SelectedStorageLocation}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </controls:FloatingField>
                <controls:FloatingField Grid.Column="4" Label="Remarks" Margin="0,4" EnterMovesNext="False">
                  <TextBox x:Name="PurchaseRemarksBox" Padding="4,2" Text="{Binding Path=Remarks, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Notes for this purchase. A barcode scanner is ignored while you type here at normal speed." />
                </controls:FloatingField>
              </Grid>
            </Border>

            <Border Margin="0,4,0,0" Padding="8,4" CornerRadius="6" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1"
                    Visibility="{Binding HasInvoiceAttachment, Converter={StaticResource BooleanToVisibilityConverter}}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Open File" Margin="8,0,0,0" Padding="8,2" Style="{StaticResource SecondaryButton}" Command="{Binding ViewInvoiceImageCommand}" ToolTip="Open the attached invoice in the default Windows viewer." />
                  <Button Content="Read Text" Margin="8,0,0,0" Padding="8,2" Style="{StaticResource SecondaryButton}" Command="{Binding ExtractInvoiceTextCommand}" ToolTip="OCR the attached invoice when Windows text recognition is available" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12.5" Text="{Binding AttachmentSummary}" />
              </DockPanel>
            </Border>
            <TextBlock Margin="0,2,0,0" MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"
                       Text="{Binding InvoiceOcrText}" Visibility="{Binding HasInvoiceOcrText, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Border Margin="0,4,0,0" Padding="8,4" CornerRadius="6" Background="#FFFFFBEB" BorderBrush="#FFFDE68A" BorderThickness="1"
                    Visibility="{Binding HasTotalMismatch, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock TextWrapping="Wrap" Foreground="#FF92400E" FontSize="12" Text="{Binding TotalMismatchNote}" />
            </Border>

            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                    Visibility="{Binding HasStagedItems, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel>
                <TextBlock Text="Staged items" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2" />
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" MaxHeight="120" Margin="0,0,0,6" ItemsSource="{Binding StagedItems}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Medicine" Width="180" Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Match" Width="140" IsReadOnly="True" Binding="{Binding MatchText, Mode=OneWay}" />
                    <DataGridTextColumn Header="Batch" Width="100" Binding="{Binding Batch, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Expiry" Width="90" Binding="{Binding Expiry, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Qty" Width="70" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Free" Width="70" Binding="{Binding Free, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="MRP" Width="80" Binding="{Binding Mrp, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Rate" Width="80" Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="GST %" Width="70" Binding="{Binding Gst, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Disc %" Width="70" Binding="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Import Rows into Table" Height="32" Margin="0,0,8,0" Padding="10,4" Style="{StaticResource SuccessButton}" Command="{Binding ApplyStagedItemsCommand}" ToolTip="Copy the extracted lines into the purchase table. You can still edit or delete each row before transferring to stock." />
                  <Button Content="Discard staged items" Height="32" Padding="10,4" Style="{StaticResource SecondaryButton}" Command="{Binding DiscardStagedItemsCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border BorderBrush="#FFE2E8F0" Background="#FFF8FAFC" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,4,0,0"
                    Visibility="{Binding IsAddItemOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    behaviors:KeyNavigationBehavior.Enabled="True"
                    behaviors:KeyNavigationBehavior.SubmitCommand="{Binding ConfirmAddItemCommand}"
                    behaviors:KeyNavigationBehavior.CycleFocusElementName="PurchaseMedicineSearchBox">
              <Border.Resources>
                <Style x:Key="EntryCaption" TargetType="{x:Type TextBlock}">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="Foreground" Value="#FF475569" />
                  <Setter Property="Margin" Value="2,0,0,2" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
                <Style x:Key="EntryBox" TargetType="{x:Type TextBox}">
                  <Setter Property="Height" Value="30" />
                  <Setter Property="Padding" Value="6,0" />
                  <Setter Property="VerticalContentAlignment" Value="Center" />
                  <Setter Property="Background" Value="White" />
                  <Setter Property="BorderBrush" Value="#FFCBD5E1" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                          <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="7,0,4,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="#FF94A3B8" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                          </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                          </Trigger>
                          <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandTeal}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Border.Resources>
              <Decorator.Child>
                <StackPanel>
                  <Grid Margin="0,0,0,4">
                    <TextBlock Text="Add item" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="Enter next field · Ctrl+Enter add line · Esc close suggestions · F4 medicine"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                  </Grid>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <!-- Fixed widths sized so captions ("Quantity *", "Purchase Rate *", "Trade Disc") never trim. -->
                      <ColumnDefinition Width="*" MinWidth="200" />
                      <ColumnDefinition Width="95" />
                      <ColumnDefinition Width="95" />
                      <ColumnDefinition Width="65" />
                      <ColumnDefinition Width="55" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="65" />
                      <ColumnDefinition Width="65" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="105" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                      <TextBlock Style="{StaticResource EntryCaption}" Text="Medicine *" />
                        <Grid>
                          <TextBox x:Name="PurchaseMedicineSearchBox"
                                   Style="{StaticResource EntryBox}"
                                   IsReadOnly="False"
                                   IsHitTestVisible="True"
                                   AcceptsReturn="False"
                                   ToolTip="Type 2+ letters to search Drug Bank / medicine master"
                                   Text="{Binding MedicineSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   PreviewKeyDown="PurchaseMedicineSearchBox_PreviewKeyDown">
                            <UIElement.InputBindings>
                              <KeyBinding Key="Down" Command="{Binding OpenMedicineSuggestionsCommand}" />
                            </UIElement.InputBindings>
                          </TextBox>
                          <TextBlock Margin="7,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#FF94A3B8" FontSize="12" TextTrimming="CharacterEllipsis"
                                     Text="Search catalogue or type a new name…"
                                     Visibility="{Binding ShowMedicineSearchPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <Popup Placement="Bottom"
                                 PlacementTarget="{Binding ElementName=PurchaseMedicineSearchBox}"
                                 StaysOpen="False"
                                 AllowsTransparency="True"
                                 PopupAnimation="Fade"
                                 IsOpen="{Binding IsMedicineDropDownOpen, Mode=TwoWay}">
                            <Border MinWidth="340" MaxHeight="280" Margin="0,4,0,0" Padding="4" CornerRadius="8"
                                    Background="#FFFFFFFF" BorderBrush="#FFCBD5E1" BorderThickness="1">
                              <UIElement.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Color="#FF0F172A" />
                              </UIElement.Effect>
                              <ListBox x:Name="PurchaseMedicineSuggestionList"
                                       BorderThickness="0"
                                       Background="#00FFFFFF"
                                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                       ItemsSource="{Binding MedicinePickerItems}"
                                       SelectedItem="{Binding SelectedMedicineItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       PreviewMouseLeftButtonUp="PurchaseMedicineSuggestionList_PreviewMouseLeftButtonUp"
                                       PreviewKeyDown="PurchaseMedicineSuggestionList_PreviewKeyDown">
                                <ListBox.ItemTemplate>
                                  <DataTemplate>
                                    <StackPanel Margin="4,4">
                                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF64748B" Text="{Binding Kind}" />
                                      <TextBlock FontWeight="SemiBold" Foreground="#FF0F172A" Text="{Binding DisplayTitle}" TextWrapping="Wrap" />
                                      <TextBlock FontSize="11" Foreground="#FF334155" Text="{Binding DisplayDetail}" TextWrapping="Wrap" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ListBox.ItemTemplate>
                              </ListBox>
                            </Border>
                          </Popup>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                      <TextBlock Style="{StaticResource EntryCaption}" Text="Batch *" />
                      <TextBox x:Name="PurchaseNewItemBatch" Style="{StaticResource EntryBox}" Tag="Batch no." Text="{Binding Path=NewItemBatch, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,6,0">
                      <TextBlock Style="{StaticResource EntryCaption}" Text="Expiry *" />
                      <TextBox x:Name="PurchaseNewItemExpiry" Style="{StaticResource EntryBox}" Tag="MM/YYYY" Text="{Binding Path=NewItemExpiry, UpdateSourceTrigger=PropertyChanged}" LostFocus="PurchaseNewItemExpiry_LostFocus" ToolTip="Type 1026, 10/26, or 10-2026. The box formats to MM/YYYY when you leave it." />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,6,0">
                      <TextBlock Style="{StaticResource EntryCaption}" Text="Quantity *" TextTrimming="None" ToolTip="Quantity in packs. Defaults to 1." />
                      <TextBox x:Name="PurchaseNewItemQuantity" Style="{StaticResource EntryBox}" Tag="Qty" behaviors:KeyNavigationBehavior.EnterSubmits="True" Text="{Binding Path=NewItemQuantity, UpdateSourceTrigger=PropertyChanged}" ToolTip="Quantity in packs. Defaults to 1." />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,6,0">
                      <TextBlock Style="{StaticResource EntryCaption}" Text="Free" />
                      <TextBox x:Name="PurchaseNewItemFree" Style="{StaticResource EntryBox}" Tag="Free" Text="{Binding Path=NewItemFree, UpdateSourceTrigger=PropertyChanged}" ToolTip="Free quantity" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Margin="0,0,6,0">
                      <TextBlock Style="{StaticResource EntryCaption}" Text="MRP ₹ *" ToolTip="MRP per pack" />
                      <TextBox x:Name="PurchaseNewItemMrp" Style="{StaticResource EntryBox}" Tag="MRP" Text="{Binding Path=NewItemMrp, UpdateSourceTrigger=PropertyChanged}" ToolTip="MRP per pack (₹)" />
                    </StackPanel>
                    <StackPanel Grid.Column="6" Margin="0,0,6,0">
                      <TextBlock Style="{StaticResource EntryCaption}" Text="Purchase Rate *" TextTrimming="None" ToolTip="Purchase rate per pack (₹)" />
                      <TextBox x:Name="PurchaseNewItemRate" Style="{StaticResource EntryBox}" Tag="Rate" Text="{Binding Path=NewItemRate, UpdateSourceTrigger=PropertyChanged}" ToolTip="Purchase rate (₹)" />
                    </StackPanel>
                    <StackPanel Grid.Column="7" Margin="0,0,6,0">
                      <TextBlock Style="{StaticResource EntryCaption}" Text="Trade Disc" TextTrimming="None" ToolTip="Trade discount %" />
                      <TextBox x:Name="PurchaseNewItemDiscount" Style="{StaticResource EntryBox}" Tag="Disc %" Text="{Binding Path=NewItemDiscountPercent, UpdateSourceTrigger=PropertyChanged}" ToolTip="Trade discount %. Suggested from the last purchase for this medicine and supplier. Change it if this bill is different." />
                    </StackPanel>
                    <StackPanel Grid.Column="8" Margin="0,0,6,0">
                      <TextBlock Style="{StaticResource EntryCaption}" Text="GST %" />
                      <TextBox x:Name="PurchaseNewItemGst" Style="{StaticResource EntryBox}" Tag="GST %" Text="{Binding Path=NewItemGst, UpdateSourceTrigger=PropertyChanged}">
                        <UIElement.InputBindings>
                          <KeyBinding Key="Enter" Command="{Binding ConfirmAddItemCommand}" />
                        </UIElement.InputBindings>
                      </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="9" Margin="0,0,6,0">
                      <TextBlock Style="{StaticResource EntryCaption}" Text="Rack" />
                      <TextBox x:Name="PurchaseNewItemRack" Style="{StaticResource EntryBox}" Tag="Rack" Text="{Binding Path=NewItemRack, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rack / location">
                        <UIElement.InputBindings>
                          <KeyBinding Key="Enter" Command="{Binding ConfirmAddItemCommand}" />
                        </UIElement.InputBindings>
                      </TextBox>
                    </StackPanel>
                    <Button Grid.Column="10" Content="Add to bill" Height="30" VerticalAlignment="Bottom" Padding="10,0" Background="{StaticResource BrandTeal}" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Command="{Binding ConfirmAddItemCommand}" ToolTip="Add this medicine, batch, quantity, and purchase rate as a row on the purchase bill. Enter on Quantity does the same.">
                      <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="#0F766E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="#115E59" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </Grid>
                  <WrapPanel VerticalAlignment="Center">
                    <controls:FloatingField Label="Pack size (Drug Bank)" Width="230" Margin="0,2,8,2" HelperText="From catalogue — editable">
                      <TextBox x:Name="PurchaseNewItemPack" Padding="4,2" Text="{Binding Path=NewItemPackLabel, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="Packaging from Drug Bank (e.g. 10 Tablets / Strip, 100ml Bottle)" />
                    </controls:FloatingField>
                    <Button Content="Search" MinWidth="70" Height="30" Margin="0,0,8,0" Style="{StaticResource FrostedMintPillButton}" Command="{Binding OpenMedicineSuggestionsCommand}" ToolTip="Open medicine suggestions. F4 jumps to the medicine box. Enter selects the highlighted medicine and moves to Quantity." />
                    <Button Content="+ New Medicine" MinWidth="120" Height="30" Margin="0,0,8,0" Style="{StaticResource FrostedMintPillButton}" Command="{Binding QuickAddMedicineCommand}" ToolTip="Create a medicine. Text already typed in the search box is filled in as the brand name." />
                    <Button Content="Cancel" MinWidth="70" Height="30" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Command="{Binding CancelAddItemCommand}" />
                    <Button Height="30" Margin="0,0,8,0" HorizontalContentAlignment="Left" Style="{StaticResource FrostedMintPillButton}" Command="{Binding QuickAddMedicineCommand}" Visibility="{Binding ShowCreateUnlisted, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Save this search text as a new medicine and add it to this purchase">
                      <TextBlock Text="{Binding CreateUnlistedCaption}" TextWrapping="Wrap" />
                    </Button>
                    <Button Height="30" Margin="0,0,8,0" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButton}" Command="{Binding SearchOnlineCommand}" Visibility="{Binding ShowOnlineLookup, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock Text="{Binding OnlineLookupCaption}" TextWrapping="Wrap" />
                    </Button>
                    <controls:FloatingField Label="Formulation / form" Width="140" Margin="0,2,8,2"
                                            Visibility="{Binding ShowManualDrugFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBox x:Name="PurchaseNewItemFormulation" Padding="4,2" Text="{Binding Path=NewItemFormulation, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="e.g. Tab, Syr, Inj, Cap" />
                    </controls:FloatingField>
                    <controls:FloatingField Label="HSN code" Width="110" Margin="0,2,8,2"
                                            Visibility="{Binding ShowManualDrugFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBox x:Name="PurchaseNewItemHsn" Padding="4,2" Text="{Binding Path=NewItemHsn, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:FloatingField>
                  </WrapPanel>
                  <TextBlock Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="12" Text="{Binding RateSuggestionHint}" Visibility="{Binding HasRateSuggestion, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="12" Text="{Binding NewItemError}" />
                </StackPanel>
              </Decorator.Child>
            </Border>

            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                    Visibility="{Binding HasSpreadsheet, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel>
                <DockPanel Margin="0,0,0,6" LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Apply to purchase table" Height="32" MinWidth="160" Margin="0,0,8,0" Padding="10,4" Style="{StaticResource PrimaryButton}" Command="{Binding ApplySpreadsheetMappingCommand}" ToolTip="Import the mapped spreadsheet rows into the inward grid." />
                    <Button Content="Cancel" Height="32" Padding="10,4" Style="{StaticResource SecondaryButton}" Command="{Binding CancelSpreadsheetCommand}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Match your file's columns" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"
                               Text="Pick the matching column for each field, then Apply. Amount = Qty × Rate when Amount is blank." />
                  </StackPanel>
                </DockPanel>
                <DataGrid x:Name="PurchaseSpreadsheetMapGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                          HeadersVisibility="Column" MaxHeight="140" Margin="0,0,0,6"
                          ItemsSource="{Binding SpreadsheetMappings}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Purchase field" IsReadOnly="True" Width="150" Binding="{Binding Label, Mode=OneWay}" />
                    <DataGridCheckBoxColumn Header="Required" IsReadOnly="True" Width="70" Binding="{Binding IsRequired, Mode=OneWay}" />
                    <DataGridTemplateColumn Header="Column in your file" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox MinHeight="28" Padding="4,2" IsEditable="False"
                                    ItemsSource="{Binding DataContext.SpreadsheetHeaders, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedItem="{Binding SourceHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Preview (first 5 rows)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2" />
                <DataGrid AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" MaxHeight="90" ItemsSource="{Binding SpreadsheetPreview}" />
              </StackPanel>
            </Border>
            <Border Margin="0,4,0,0" Padding="8,4" CornerRadius="6" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1"
                    Visibility="{Binding IsPhoneListening, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#065F46" FontSize="12.5" Text="{Binding PhoneListenStatus}" />
            </Border>
            <Border Margin="0,4,0,0" Padding="8,4" CornerRadius="6" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1"
                    Visibility="{Binding HasPhoneBills, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel>
                <DockPanel Margin="0,0,0,4">
                  <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Content="Inward All Extracted Bills" IsChecked="{Binding InwardAllPhoneBills}" ToolTip="Transfer every received phone bill into stock. Leave this off to open one bill at a time." />
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsExtractingPhoneBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12.5" Text="{Binding PhoneListenStatus}" />
                  </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding PhoneBills}" Tag="{Binding OpenPhoneBillCommand}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Height="30" Margin="0,0,6,4" Padding="8,2" Content="{Binding ChipText}" ToolTip="Load this bill into the purchase table"
                              Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Row 2: Lines toolbar + flexible DataGrid (internal scroll only) -->
          <DockPanel Grid.Row="2" Margin="0,2,0,0" LastChildFill="True" VerticalAlignment="Stretch">
            <Border DockPanel.Dock="Top" Margin="0,0,0,4" Padding="8,4" CornerRadius="6"
                    Background="#FFECFDF5" BorderBrush="#FF10B981" BorderThickness="1">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="+ Row" Height="28" MinWidth="64" Margin="0,0,6,0" Padding="8,2" Style="{StaticResource FrostedMintPillButton}"
                          Command="{Binding AddBlankRowCommand}" ToolTip="Add a blank editable line." />
                  <Button Content="F2 New" Height="28" Margin="0,0,6,0" Padding="8,2" Style="{StaticResource SecondaryButton}" Command="{Binding NewEntryCommand}" ToolTip="New purchase (F2)" />
                  <Button Content="F4 Add" Height="28" Padding="8,2" Style="{StaticResource SecondaryButton}" Command="{Binding FocusMedicineCommand}" ToolTip="Add item (F4)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FF065F46" Text="Purchase lines" Margin="0,0,10,0" />
                  <TextBlock Foreground="#FF047857" FontSize="11.5" VerticalAlignment="Center" Text="{Binding PageSummary}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Grid VerticalAlignment="Stretch">
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="#FFE2E8F0"
                          VerticalGridLinesBrush="#FFE2E8F0" BorderBrush="#FF10B981"
                          BorderThickness="1" FontSize="13" RowHeight="34" ColumnHeaderHeight="34"
                          EnableRowVirtualization="True" EnableColumnVirtualization="False"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          VerticalAlignment="Stretch"
                          ItemsSource="{Binding PagedLines}" SelectedItem="{Binding SelectedLine}">
                  <DataGrid.Resources>
                    <Style x:Key="PurchaseCellTextBox" TargetType="{x:Type TextBox}">
                      <Setter Property="Padding" Value="6,4" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                  </DataGrid.Resources>
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Medicine" Width="*" MinWidth="160">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource PurchaseCellTextBox}"
                                   Text="{Binding MedicineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Batch" Width="90">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource PurchaseCellTextBox}"
                                   Text="{Binding BatchNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Expiry" Width="100">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource PurchaseCellTextBox}" ToolTip="MM/yyyy or yyyy-MM-dd"
                                   Text="{Binding Expiry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Qty" Width="65">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource PurchaseCellTextBox}"
                                   Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Free" Width="65">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource PurchaseCellTextBox}"
                                   Text="{Binding FreeQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="MRP" Width="75">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource PurchaseCellTextBox}"
                                   Text="{Binding Mrp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Rate" Width="75">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource PurchaseCellTextBox}"
                                   Text="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="GST %" Width="70">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource PurchaseCellTextBox}"
                                   Text="{Binding GstRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Discount %" Width="85">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource PurchaseCellTextBox}"
                                   Text="{Binding DiscountPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Amount" IsReadOnly="True" Width="85"
                                        Binding="{Binding Amount, Mode=OneWay}" />
                    <DataGridTemplateColumn Header="Rack" Width="80">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource PurchaseCellTextBox}"
                                   Text="{Binding Rack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Button Content="✕" ToolTip="Delete row" Style="{StaticResource IconButton}" Command="{Binding DataContext.DeleteLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No items yet. Use Invoice Tools ▾, add an item (F4), or load CSV / Excel." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="0" Binding="{Binding Lines.Count}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBlock>
                <TextBlock Text="No inward lines fall between these dates." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False" Visibility="{Binding ShowDateFilterEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </Grid>
          </DockPanel>

          <!-- Row 3: Footer — purchase return (left) + totals + Transfer (right) -->
          <DockPanel Grid.Row="3" Margin="0,6,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Border Padding="10,6" CornerRadius="6" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock VerticalAlignment="Center" Foreground="#FF334155" FontSize="12.5" Text="{Binding Subtotal, StringFormat=Subtotal: ₹{0:N2}, ConverterCulture=en-IN}" />
                  <TextBlock VerticalAlignment="Center" Margin="8,0" Foreground="#FF94A3B8" Text="|" />
                  <TextBlock VerticalAlignment="Center" Foreground="#FF334155" FontSize="12.5" Text="{Binding TaxTotal, StringFormat=GST: ₹{0:N2}, ConverterCulture=en-IN}" />
                  <TextBlock VerticalAlignment="Center" Margin="8,0" Foreground="#FF94A3B8" Text="|" />
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF0F172A" FontSize="13" Text="{Binding GrandTotal, StringFormat=Grand Total: ₹{0:N2}, ConverterCulture=en-IN}" />
                </StackPanel>
              </Border>
              <Button Content="Transfer to Stock / F10" Height="34" MinWidth="180" Padding="12,4" VerticalAlignment="Center"
                      Style="{StaticResource SuccessButton}" Command="{Binding TransferToStockCommand}"
                      ToolTip="Save into stock (F10 / Ctrl+S)" />
            </StackPanel>
            <Expander Header="Purchase return" IsExpanded="False" MaxHeight="160" VerticalAlignment="Center">
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                <StackPanel>
                  <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" Height="80" Margin="0,0,0,6" ItemsSource="{Binding ReturnLines}">
                    <DataGrid.Columns>
                      <DataGridComboBoxColumn Header="Select Batch / Medicine" DisplayMemberPath="Display" Width="*" ItemsSource="{Binding DataContext.ReturnBatches, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItemBinding="{Binding Batch, UpdateSourceTrigger=PropertyChanged}" />
                      <DataGridTextColumn Header="Return Qty" Width="110" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <WrapPanel>
                    <StackPanel Width="150" Margin="0,0,10,6">
                      <TextBlock Text="Return Number" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                      <TextBox Padding="6,4" MinHeight="30" ToolTip="Number printed on the supplier credit note" Text="{Binding Path=ReturnNo, UpdateSourceTrigger=PropertyChanged}" behaviors:CyclingPlaceholder.Enabled="True" behaviors:CyclingPlaceholder.Hints="e.g. CN-1042" />
                    </StackPanel>
                    <StackPanel Width="280" Margin="0,0,10,6">
                      <TextBlock Text="Batch / Medicine" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                      <ComboBox Padding="4,2" MinHeight="30" DisplayMemberPath="Display" ItemsSource="{Binding ReturnBatches}" SelectedItem="{Binding SelectedReturnBatch}" ToolTip="Pick the batch and medicine being sent back" />
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,10,6">
                      <TextBlock Text="Return Qty" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                      <TextBox Padding="6,4" MinHeight="30" ToolTip="How many units of the selected batch to return" Text="{Binding Path=ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,10,6">
                      <TextBlock Text="Refund / Credit Rate" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                      <TextBox IsReadOnly="True" Padding="6,4" MinHeight="30" Background="{DynamicResource FieldReadOnlyBrush}" ToolTip="Credit rate taken from the selected batch purchase price. The supplier credit note uses this rate." Text="{Binding ReturnCreditRate, Mode=OneWay}" behaviors:CyclingPlaceholder.Enabled="True" behaviors:CyclingPlaceholder.Hints="Select a batch" />
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,10,6">
                      <TextBlock Text="Return Reason" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                      <TextBox Padding="6,4" MinHeight="30" ToolTip="Why this stock is being returned, such as damaged, expired, or excess" Text="{Binding Path=ReturnReason, UpdateSourceTrigger=PropertyChanged}" behaviors:CyclingPlaceholder.Enabled="True" behaviors:CyclingPlaceholder.Hints="Damaged, expired, excess" />
                    </StackPanel>
                    <Button Content="Post return" Height="30" Margin="0,14,0,6" VerticalAlignment="Bottom" Padding="10,4" Style="{StaticResource PrimaryButton}" Command="{Binding SavePurchaseReturnCommand}" ToolTip="Deduct returned stock from inventory and issue a credit debit memo for the supplier." />
                  </WrapPanel>
                </StackPanel>
              </ScrollViewer>
            </Expander>
          </DockPanel>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:StatutoryRegistersPageViewModel}}" DataType="{x:Type vm:StatutoryRegistersPageViewModel}">
        <DockPanel Margin="20">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Margin="0,6,0,2" Text="{Binding StatusMessage}" />
            <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
            <WrapPanel Margin="0,8,0,8">
              <TextBlock Text="From Date:" VerticalAlignment="Center" Margin="0,0,6,0" />
              <DatePicker Width="140" Margin="0,0,10,0" SelectedDate="{Binding RegisterFromDate}" />
              <TextBlock Text="To Date:" VerticalAlignment="Center" Margin="0,0,6,0" />
              <DatePicker Width="140" Margin="0,0,10,0" SelectedDate="{Binding RegisterToDate}" />
              <TextBlock Text="Register:" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox Width="160" Margin="0,0,12,0" ItemsSource="{Binding RegisterTypes}" SelectedItem="{Binding SelectedRegisterType}" />
              <Button Content="📄 Export to PDF" Padding="12,6" Margin="0,0,8,0" Command="{Binding ExportPdfCommand}" ToolTip="Generate the Schedule H1 / statutory register PDF for the current filter." />
              <Button Content="📊 Export to Excel (.xlsx)" Padding="12,6" Margin="0,0,8,0" Command="{Binding ExportExcelCommand}" ToolTip="Export drug, batch, expiry, patient, and doctor columns." />
              <TextBox Width="220" Padding="7" Margin="0,0,8,0" ToolTip="Inspector or auditor email address" Text="{Binding Path=InspectorEmail, UpdateSourceTrigger=PropertyChanged}" />
              <Button Content="✉️ Email Report" Padding="12,6" Command="{Binding EmailReportCommand}" ToolTip="Open an email to the inspector with the exported register PDF path." />
            </WrapPanel>
            <TabControl SelectedValuePath="Tag" Margin="0,8,0,10" SelectedValue="{Binding SelectedRegisterType}" SelectionChanged="RegisterTabs_SelectionChanged">
              <ItemsControl.Items>
                <TabItem Header="H1" Tag="H1" />
                <TabItem Header="X" Tag="X" />
                <TabItem Header="NDPS" Tag="NDPS" />
                <TabItem Header="Habit-forming (reference)" Tag="Habit-forming" />
                <TabItem Header="All" Tag="All" />
              </ItemsControl.Items>
            </TabControl>
          </StackPanel>
          <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.RowDetailsTemplate>
              <DataTemplate>
                <Border Margin="8" Padding="12" CornerRadius="8" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1">
                  <WrapPanel>
                    <TextBlock Width="280" Margin="0,0,16,6" TextWrapping="Wrap" Text="{Binding DrugName, StringFormat=Medicine: {0}}" />
                    <TextBlock Width="280" Margin="0,0,16,6" TextWrapping="Wrap" Text="{Binding Composition, StringFormat=Salt / composition: {0}}" />
                    <TextBlock Width="160" Margin="0,0,16,6" Text="{Binding BatchNo, StringFormat=Batch: {0}}" />
                    <TextBlock Width="140" Margin="0,0,16,6" Text="{Binding ExpiryLabel, StringFormat=Expiry: {0}}" />
                    <TextBlock Width="160" Margin="0,0,16,6" Text="{Binding Quantity, StringFormat=Quantity dispensed: {0:0.##}}" />
