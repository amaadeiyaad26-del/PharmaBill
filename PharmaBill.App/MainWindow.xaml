                  <ComboBox Width="180" IsEditable="True" Padding="4" ItemsSource="{Binding LicenceTypeOptions}" Text="{Binding NewLicenceType, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Content="Add licence" Margin="6,0,0,0" Padding="9,5" Command="{Binding AddLicenceCommand}" />
                  <Button Content="Add type to editable list" Margin="6,0,0,0" Padding="9,5" Command="{Binding AddLicenceTypeCommand}" />
                </WrapPanel>
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="145" MaxHeight="220" HeadersVisibility="Column" ItemsSource="{Binding Licences}" SelectedItem="{Binding SelectedLicence, Mode=TwoWay}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Type" Width="100">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.LicenceTypeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}" Text="{Binding LicenceType, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Licence number" Width="*" Binding="{Binding LicenceNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Issued (yyyy-mm-dd)" Width="145" Binding="{Binding IssuedOn, StringFormat='{}{0:yyyy-MM-dd}', UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Expires (yyyy-mm-dd)" Width="145" Binding="{Binding ExpiresOn, StringFormat='{}{0:yyyy-MM-dd}', UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Authority" Width="*" Binding="{Binding IssuingAuthority, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Scan path" IsReadOnly="True" Width="*" Binding="{Binding DocumentPath}" />
                    <DataGridTextColumn Header="X / NDPS authorisation" Width="*" Binding="{Binding Authorisation, UpdateSourceTrigger=PropertyChanged}" />
                  </DataGrid.Columns>
