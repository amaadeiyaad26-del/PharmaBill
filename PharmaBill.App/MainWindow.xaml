                            </Button>
                            <ComboBox Height="36" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName" ToolTip="Detected removable USB drives" AutomationProperties.Name="Removable USB drives" ItemsSource="{Binding RemovableDrives}" SelectedItem="{Binding SelectedRemovableDrive}" />
                          </DockPanel>
                          <Button Content="Backup to USB" Height="40" Margin="0,0,0,8" AutomationProperties.Name="Backup to USB" Command="{Binding BackupToUsbCommand}">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="IsEnabled" Value="True" />
