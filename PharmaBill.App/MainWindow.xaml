                  <TextBox Width="190" Padding="6" ToolTip="Verified by" Text="{Binding Path=VerifiedBy, UpdateSourceTrigger=PropertyChanged}" />
                  <DatePicker Margin="6,0" SelectedDate="{Binding VerifiedOn}" />
                  <TextBox Width="190" Padding="6" ToolTip="Verification method" Text="{Binding Path=VerificationMethod, UpdateSourceTrigger=PropertyChanged}" />
