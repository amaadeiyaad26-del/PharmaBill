<Window x:Class="PharmaBill.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PharmaBill - Diagnostics"
        Width="900"
        Height="720"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Diagnostics" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="16,0,0,0" Padding="12,6" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,10,0,0" />
        <TabControl>
            <TabItem Header="Import">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="CSV files" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListView ItemsSource="{Binding Files}" MaxHeight="140">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="File" DisplayMemberBinding="{Binding Name}" Width="220" />
                                <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="460" />
                                <GridViewColumn Header="Size (bytes)" DisplayMemberBinding="{Binding SizeBytes}" Width="120" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListView ItemsSource="{Binding ImportStatuses}" Margin="0,12,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Import" DisplayMemberBinding="{Binding ImportKey}" Width="100" />
                                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="130" />
                                <GridViewColumn Header="Imported" DisplayMemberBinding="{Binding ImportedRows}" Width="90" />
                                <GridViewColumn Header="Skipped" DisplayMemberBinding="{Binding SkippedRows}" Width="80" />
                                <GridViewColumn Header="Last error" DisplayMemberBinding="{Binding LastError}" Width="300" />
                                <GridViewColumn Header="Action">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Re-import"
                                                    Command="{Binding DataContext.ReimportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,4" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="Database rows">
                <ListView ItemsSource="{Binding TableCounts}" Margin="12">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Table" DisplayMemberBinding="{Binding TableName}" Width="360" />
                            <GridViewColumn Header="Rows" DisplayMemberBinding="{Binding Rows}" Width="180" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
