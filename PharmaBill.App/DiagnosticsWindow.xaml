<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.DiagnosticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/Icons/app.ico" Title="PharmaBill - Diagnostics" Width="900" Height="720" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Diagnostics" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button Content="Refresh" Margin="16,0,0,0" Padding="12,6" Command="{Binding RefreshCommand}" />
      <Button Content="⚙ Configure Cloud Keys" Margin="8,0,0,0" Padding="12,6" ToolTip="Paste Google Drive OAuth client credentials" Click="ConfigureCloudKeys_Click" />
      <Button Content="Key Generator" Margin="8,0,0,0" Padding="12,6" Opacity="0.55" ToolTip="Admin: generate 1 Month / 1 Year / Lifetime keys (Ctrl+Shift+K)" Click="OpenKeyGenerator_Click" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding ErrorMessage}" />
    <TabControl>
      <TabItem Header="Import">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Text="CSV files" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ListView MaxHeight="140" ItemsSource="{Binding Files}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="File" Width="220" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="Path" Width="460" DisplayMemberBinding="{Binding Path}" />
                <GridViewColumn Header="Size (bytes)" Width="120" DisplayMemberBinding="{Binding SizeBytes}" />
              </GridView>
            </ListView.View>
          </ListView>
          <ListView Margin="0,12,0,0" ItemsSource="{Binding ImportStatuses}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Import" Width="100" DisplayMemberBinding="{Binding ImportKey}" />
                <GridViewColumn Header="Status" Width="130" DisplayMemberBinding="{Binding Status}" />
                <GridViewColumn Header="Imported" Width="90" DisplayMemberBinding="{Binding ImportedRows}" />
                <GridViewColumn Header="Skipped" Width="80" DisplayMemberBinding="{Binding SkippedRows}" />
                <GridViewColumn Header="Last error" Width="300" DisplayMemberBinding="{Binding LastError}" />
                <GridViewColumn Header="Action">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Re-import" Padding="8,4" Command="{Binding DataContext.ReimportCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
      <TabItem Header="Database rows">
        <ListView Margin="12" ItemsSource="{Binding TableCounts}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Table" Width="360" DisplayMemberBinding="{Binding TableName}" />
              <GridViewColumn Header="Rows" Width="180" DisplayMemberBinding="{Binding Rows}" />
            </GridView>
          </ListView.View>
        </ListView>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>