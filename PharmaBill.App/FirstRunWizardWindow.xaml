<Window x:Class="PharmaBill.App.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PharmaBill - First-run setup"
        Width="920"
        Height="800"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Set up PharmaBill" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Enter your pharmacy details and create the owner sign-in."
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,0,0,10" />
            <Button Content="Complete setup"
                    Command="{Binding CompleteSetupCommand}"
                    HorizontalAlignment="Right"
                    Padding="22,11"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Business" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Business type" />
                            <ComboBox ItemsSource="{Binding BusinessModes}"
                                      SelectedItem="{Binding SelectedBusinessMode}"
                                      Margin="0,5,0,0"
                                      Padding="7" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="Pharmacy name *" />
                            <TextBox Text="{Binding PharmacyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" Padding="7" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,10,10">
                            <TextBlock Text="Legal name" />
                            <TextBox Text="{Binding LegalName}" Margin="0,5,0,0" Padding="7" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="Phone" />
                            <TextBox Text="{Binding Phone}" Margin="0,5,0,0" Padding="7" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,10,0">
                            <TextBlock Text="Email" />
                            <TextBox Text="{Binding Email}" Margin="0,5,0,0" Padding="7" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Address" />
                            <TextBox Text="{Binding Address}" Margin="0,5,0,0" Padding="7" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Drug licences" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Retail: enter licence type 20 or 21. Wholesale: add your own editable licence type, then enter its licence number. Required licences depend on the selected business type."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <WrapPanel Margin="0,12,0,8">
                            <TextBox Width="170" Text="{Binding NewLicenceType, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
                            <Button Content="Add licence type"
                                    Command="{Binding AddLicenceTypeCommand}"
                                    Margin="8,0"
                                    Padding="12,5" />
                            <ComboBox Width="150"
                                      ItemsSource="{Binding LicenceTypeOptions}"
                                      SelectedItem="{Binding WholesaleLicenceType}"
                                      Padding="6" />
                            <Button Content="Add wholesale licence"
                                    Command="{Binding AddLicenceCommand}"
                                    Margin="8,0"
                                    Padding="12,5" />
                            <Button Content="Add retail 20"
                                    Command="{Binding AddRetail20Command}"
                                    Padding="12,5" />
                            <Button Content="Add retail 21"
                                    Command="{Binding AddRetail21Command}"
                                    Padding="12,5" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Licences}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding LicenceType}" Padding="5" />
                                            <TextBox Grid.Column="1" Text="{Binding LicenceNumber}" Margin="6,0" Padding="5" />
                                            <DatePicker Grid.Column="2" SelectedDate="{Binding IssueDate}" />
                                            <DatePicker Grid.Column="3" SelectedDate="{Binding ExpiryDate}" />
                                            <Button Grid.Column="4" Content="Choose copy"
                                                    Command="{Binding DataContext.SelectDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding DocumentPath}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="6"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.RemoveLicenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Fields in each row: type, licence number, issue date, expiry date, optional PDF/image copy."
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Tax, competent person and payments" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,8,10"><TextBlock Text="GSTIN" /><TextBox Text="{Binding Gstin}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,8,10"><TextBlock Text="PAN" /><TextBox Text="{Binding Pan}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,10"><TextBlock Text="Invoice prefix" /><TextBox Text="{Binding InvoicePrefix}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,8,10"><TextBlock Text="Competent person / registered pharmacist" /><TextBox Text="{Binding CompetentPersonName}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,8,10"><TextBlock Text="Qualification" /><TextBox Text="{Binding CompetentPersonQualification}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,10"><TextBlock Text="Registration number" /><TextBox Text="{Binding CompetentPersonRegistrationNumber}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,8,10"><TextBlock Text="Bank name" /><TextBox Text="{Binding BankName}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,8,10"><TextBlock Text="Account holder name" /><TextBox Text="{Binding BankAccountName}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="8,0,0,10"><TextBlock Text="Account number" /><TextBox Text="{Binding BankAccountNumber}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,0,8,0"><TextBlock Text="IFSC code" /><TextBox Text="{Binding BankIfsc}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="UPI ID / QR VPA" /><TextBox Text="{Binding UpiId}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Owner sign-in" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,10,10"><TextBlock Text="Owner name *" /><TextBox Text="{Binding OwnerName}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Username *" /><TextBox Text="{Binding OwnerUsername}" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,10,10"><TextBlock Text="PIN or password * (minimum 6 characters)" /><PasswordBox x:Name="SecretBox" PasswordChanged="SecretBox_OnPasswordChanged" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Confirm PIN/password *" /><PasswordBox x:Name="ConfirmSecretBox" PasswordChanged="ConfirmSecretBox_OnPasswordChanged" Margin="0,5,0,0" Padding="6" /></StackPanel>
                        <StackPanel Grid.Row="2"><TextBlock Text="Lock after idle (minutes)" /><TextBox Text="{Binding IdleLockMinutes}" Margin="0,5,10,0" Padding="6" /></StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
