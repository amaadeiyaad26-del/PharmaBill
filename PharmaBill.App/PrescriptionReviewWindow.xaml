<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.PrescriptionReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/Icons/app.ico" Title="Matched medicines" Height="620" Width="1100" MinHeight="460" MinWidth="860" WindowStartupLocation="CenterOwner" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="Matched medicines" FontSize="22" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF475467" Text="{Binding Summary}" />
      <Border Background="#FFFFFAEB" BorderBrush="#FFF79009" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" Visibility="{Binding ApiKeyMissing, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Configure Gemini API Key in Settings" Padding="10,4" Margin="12,0,0,0" Click="ConfigureGemini_Click" />
          <TextBlock Text="Read offline. Add a Gemini API key for higher-accuracy reading of handwriting." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#FF93370D" />
        </DockPanel>
      </Border>
      <TextBlock Text="Tick only the lines to add. Unmatched rows can be linked or inwarded here; they do not block the other medicines." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF475467" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,0,16,0" />
      <Button Content="📦 Inward Missing Items to Stock" Height="36" Padding="12,6" Margin="0,0,8,0" Command="{Binding InwardMissingCommand}" />
      <Button Content="Cancel" IsCancel="True" Height="36" Padding="18,6" Margin="0,0,8,0" />
      <Button Content="Add to Bill" IsDefault="True" Height="36" Padding="22,6" FontWeight="SemiBold" Background="#FF2563EB" Foreground="#FFFFFFFF" BorderBrush="#FF1D4ED8" Click="AddToBill_Click" />
    </StackPanel>
    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" ItemsSource="{Binding Rows}" RowHeight="72" VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Add" Width="52" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" />
        <DataGridTextColumn Header="Prescribed" IsReadOnly="True" Width="160" Binding="{Binding PrescribedName}" />
        <DataGridTextColumn Header="Dose / duration" IsReadOnly="True" Width="*" Binding="{Binding DoseText}">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="Wrap" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTemplateColumn Header="Matched product" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel VerticalAlignment="Center" Margin="4,2">
                <TextBlock Text="{Binding MatchText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsUnmatched, Converter={StaticResource BoolToVisibility}}">
                  <Button Content="🔍 Link to Stock / Brand" Height="28" Padding="8,2" FontSize="12"
                          Command="{Binding DataContext.LinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                  <Button Content="+ Inward Stock" Height="28" Padding="8,2" Margin="6,0,0,0" FontSize="12"
                          Command="{Binding DataContext.InwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Match" IsReadOnly="True" Width="64" Binding="{Binding ConfidenceText}" />
        <DataGridTextColumn Header="FEFO batch" IsReadOnly="True" Width="180" Binding="{Binding BatchText}" />
        <DataGridTemplateColumn Header="Qty" Width="72">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border CornerRadius="4" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                    <Setter Property="Background" Value="White" />
                    <Style.Triggers>
                      <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#2563EB" />
                        <Setter Property="Background" Value="#EFF6FF" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBox Width="50" Padding="4,2" TextAlignment="Center" BorderThickness="0" Background="Transparent"
                         Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewMouseLeftButtonDown="Qty_PreviewMouseDown" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
