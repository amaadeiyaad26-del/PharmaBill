<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <Product>PharmaBill</Product>
    <Company>PharmaBill</Company>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <BuildDateUtc Condition="'$(BuildDateUtc)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))</BuildDateUtc>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDateUtc</_Parameter1>
      <_Parameter2>$(BuildDateUtc)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PharmaBill.Core\PharmaBill.Core.csproj" />
    <ProjectReference Include="..\PharmaBill.Data\PharmaBill.Data.csproj" />
    <ProjectReference Include="..\PharmaBill.Sync\PharmaBill.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="QuestPDF" Version="2025.7.4" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\medicine_catalog.csv" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Data\medicine_catalog.csv')" />
    <Content Include="Data\medicine_info.csv" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Data\medicine_info.csv')" />
    <Content Include="ReleaseNotes.md" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ReleaseNotes.md')" />
    <Resource Include="Assets\Icons\app.ico" />
    <Resource Include="Assets\Icons\pharma_bill_3d.ico" Condition="Exists('Assets\Icons\pharma_bill_3d.ico')" />
    <Resource Include="Assets\Icons\pharma_bill_3d.png" Condition="Exists('Assets\Icons\pharma_bill_3d.png')" />
    <Resource Include="Assets\Icons\pharma_bill_3d_watermark.png" Condition="Exists('Assets\Icons\pharma_bill_3d_watermark.png')" />
    <Resource Include="Assets\PharmaBill.ico" Condition="Exists('Assets\PharmaBill.ico')" />
    <EmbeddedResource Include="Assets\Fonts\*.ttf" Condition="Exists('Assets\Fonts')" />
  </ItemGroup>

</Project>
