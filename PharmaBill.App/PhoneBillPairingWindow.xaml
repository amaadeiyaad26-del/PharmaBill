<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.PhoneBillPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/Icons/app.ico"
        Title="Pair Android Phone for Live Bill Scanning"
        Width="520"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <StackPanel Margin="22">
    <TextBlock Text="Pair Android Phone for Live Bill Scanning" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding PhoneListenStatus}" />
    <Border HorizontalAlignment="Center" Padding="10" Background="White" CornerRadius="8" BorderBrush="#FFE2E8F0" BorderThickness="1">
      <Image Width="260" Height="260" Stretch="Uniform" Source="{Binding PhonePairingQr}" />
    </Border>
    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#FF64748B" Text="Scan this code in the PharmaBill Android app on the same Wi-Fi. Keep this window open while you capture bills — they appear in Purchases as soon as the phone uploads them." />
    <Button Content="Keep listening &amp; close" Height="36" MinWidth="100" Margin="0,16,0,0" HorizontalAlignment="Right" Padding="16,6" IsCancel="True" IsDefault="True" />
  </StackPanel>
</Window>
