<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.QuickAddRetailerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/Icons/app.ico"
        Title="Add New Retailer"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <StackPanel Margin="24">
    <TextBlock Text="Add New Retailer / Pharmacy"
               FontSize="20"
               FontWeight="SemiBold"
               Margin="0,0,0,4" />
    <TextBlock Text="Save this buyer to Customers master so DL, GSTIN, and credit terms autofill on future invoices."
               TextWrapping="Wrap"
               Foreground="{DynamicResource SecondaryTextBrush}"
               Margin="0,0,0,16" />

    <TextBlock Text="Retailer / Pharmacy Business Name *" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBox x:Name="NameBox" Padding="10,8" Margin="0,0,0,12" BorderBrush="{DynamicResource FieldBorderBrush}" />

    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="DL Type *" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="LicenceTypeBox" Padding="8,6" SelectedIndex="0">
          <ComboBoxItem Content="20B" />
          <ComboBoxItem Content="21B" />
          <ComboBoxItem Content="20" />
          <ComboBoxItem Content="21" />
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Drug License (DL) Number *" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="LicenceNumberBox" Padding="10,8" BorderBrush="{DynamicResource FieldBorderBrush}" />
      </StackPanel>
    </Grid>

    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="DL Issue Date *" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DatePicker x:Name="IssuedOnPicker" Padding="6" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="DL Expiry Date *" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DatePicker x:Name="ExpiresOnPicker" Padding="6" />
      </StackPanel>
    </Grid>

    <TextBlock Text="GSTIN (optional, 15 characters)" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBox x:Name="GstinBox" Padding="10,8" Margin="0,0,0,12" MaxLength="15" BorderBrush="{DynamicResource FieldBorderBrush}" />

    <TextBlock Text="Phone Number" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBox x:Name="PhoneBox" Padding="10,8" Margin="0,0,0,12" BorderBrush="{DynamicResource FieldBorderBrush}" />

    <TextBlock Text="Billing Address" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBox x:Name="AddressBox" Padding="10,8" Margin="0,0,0,12" TextWrapping="Wrap" MinHeight="56" AcceptsReturn="True" BorderBrush="{DynamicResource FieldBorderBrush}" />

    <TextBlock Text="Credit Period (days)" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBox x:Name="CreditDaysBox" Padding="10,8" Margin="0,0,0,12" Text="0" BorderBrush="{DynamicResource FieldBorderBrush}" />

    <TextBlock x:Name="StatusText" TextWrapping="Wrap" MinHeight="20" Foreground="#FFB42318" Margin="0,0,0,12" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" MinWidth="100" Padding="14,8" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
      <Button Content="Save Retailer" IsDefault="True" MinWidth="130" Padding="14,8" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
    </StackPanel>
  </StackPanel>
</Window>