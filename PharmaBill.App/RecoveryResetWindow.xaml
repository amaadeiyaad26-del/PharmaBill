<Window x:Class="PharmaBill.App.RecoveryResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset owner PIN"
        Width="420"
        SizeToContent="Height"
        MinHeight="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Reset owner PIN or password"
                   FontSize="20"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="Owner username" Margin="0,18,0,4" />
        <TextBox x:Name="UsernameBox" Grid.Row="2" Padding="8" MinHeight="38" />
        <TextBlock Grid.Row="3" Text="Recovery code" Margin="0,12,0,4" />
        <TextBox x:Name="RecoveryCodeBox" Grid.Row="4" Padding="8" MinHeight="38" />
        <TextBlock Grid.Row="5" Text="New PIN or password (at least 6 characters)" Margin="0,12,0,4" />
        <StackPanel Grid.Row="6">
            <PasswordBox x:Name="NewPasswordBox" Padding="8" MinHeight="38" />
            <PasswordBox x:Name="ConfirmPasswordBox" Padding="8" MinHeight="38" Margin="0,8,0,0" />
            <TextBlock x:Name="ErrorText"
                       Foreground="#FFB42318"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Height="40" Margin="0,0,8,0" />
            <Button Content="Reset PIN" IsDefault="True" Click="Reset_Click" MinWidth="110" Height="40" />
        </StackPanel>
    </Grid>
</Window>
