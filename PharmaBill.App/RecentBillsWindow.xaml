<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.RecentBillsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/Icons/app.ico" Title="Recent retail bills" Height="800" Width="980" MinHeight="680" MinWidth="760" WindowStartupLocation="CenterOwner" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel>
        <TextBox Name="SearchBox" Padding="8" ToolTip="Search memo number, patient name or phone" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
          <UIElement.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
          </UIElement.InputBindings>
        </TextBox>
        <Button Content="Search" Margin="8,0,0,0" Padding="14,6" Command="{Binding SearchCommand}" />
        <Button Content="Refresh" Margin="8,0,0,0" Padding="14,6" Click="Refresh_Click" />
      </DockPanel>
      <TextBlock Margin="0,8,0,2" Text="{Binding StatusMessage}" />
      <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="3*" />
        <RowDefinition Height="2*" />
      </Grid.RowDefinitions>
      <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionUnit="FullRow" Margin="0,0,0,8" ItemsSource="{Binding Bills}" SelectedItem="{Binding SelectedBill}" SelectionChanged="Bills_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Memo no." Width="160" Binding="{Binding InvoiceNo}" />
          <DataGridTextColumn Header="Date" Width="140" Binding="{Binding SaleAtUtc, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}" />
          <DataGridTextColumn Header="Patient" Width="*" Binding="{Binding PatientName}" />
          <DataGridTextColumn Header="Phone" Width="120" Binding="{Binding PatientPhone}" />
          <DataGridTextColumn Header="Total" Width="90" Binding="{Binding TotalAmount, StringFormat=N2}" />
          <DataGridTextColumn Header="Paid" Width="90" Binding="{Binding PaidAmount, StringFormat=N2}" />
          <DataGridTextColumn Header="Lock" Width="55" Binding="{Binding IsLocked}" />
          <DataGridTemplateColumn Header="Audit" Width="Auto" MinWidth="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding AuditStatus}" ToolTip="{Binding AuditToolTip}" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <GroupBox Grid.Row="1" Header="Select item quantities to return; use 0 for items not being returned">
        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionUnit="CellOrRowHeader" ItemsSource="{Binding ReturnableLines}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Medicine" IsReadOnly="True" Width="*" Binding="{Binding DrugName}" />
            <DataGridTextColumn Header="Batch" IsReadOnly="True" Width="100" Binding="{Binding BatchNo}" />
            <DataGridTextColumn Header="Expiry" IsReadOnly="True" Width="100" Binding="{Binding ExpiryDate}" />
            <DataGridTextColumn Header="Sold" IsReadOnly="True" Width="65" Binding="{Binding SoldQuantity}" />
            <DataGridTextColumn Header="Returned" IsReadOnly="True" Width="75" Binding="{Binding ReturnedQuantity}" />
            <DataGridTextColumn Header="Remaining" IsReadOnly="True" Width="85" Binding="{Binding RemainingQuantity}" />
            <DataGridTextColumn Header="₹ / unit" IsReadOnly="True" Width="85" Binding="{Binding UnitPrice, StringFormat=N2}" />
            <DataGridTextColumn Header="Return qty" Width="95" Binding="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" />
          </DataGrid.Columns>
        </DataGrid>
      </GroupBox>
    </Grid>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <WrapPanel Margin="0,0,0,8">
        <Button Content="Unlock bill (Admin)" Padding="14,7" Margin="0,0,8,0" ToolTip="Admin override required to unlock a finalized printed bill for edits." Command="{Binding UnlockBillCommand}" IsEnabled="{Binding CanUnlockSelected}" />
        <Button Content="Void / delete bill (Admin)" Padding="14,7" Margin="0,0,8,0" ToolTip="Admin override required. Soft-deletes the bill; stock is not restocked." Command="{Binding VoidBillCommand}" IsEnabled="{Binding CanVoidSelected}" />
      </WrapPanel>
      <WrapPanel>
        <ComboBox Width="125" Padding="6" Margin="0,0,8,0" ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding DocumentType}" />
        <Button Content="Preview" Padding="14,7" Margin="0,0,8,0" Click="Preview_Click" />
        <Button Content="Print" Padding="14,7" Margin="0,0,8,0" Click="Print_Click" />
        <Button Content="Save / share PDF" Padding="14,7" Margin="0,0,16,0" Click="SavePdf_Click" />
        <Button Content="WhatsApp" Padding="14,7" Margin="0,0,8,0" Click="WhatsApp_Click" />
        <Button Content="Copy PDF path" Padding="14,7" Margin="0,0,8,0" Click="CopyPdfPath_Click" />
        <Button Content="Show PDF in Explorer" Padding="14,7" Margin="0,0,12,0" Click="ShowPdf_Click" />
        <TextBox Width="190" Padding="7" ToolTip="Email recipient address" Text="{Binding EmailRecipient, UpdateSourceTrigger=PropertyChanged}" />
        <Button Content="Email" Padding="14,7" Margin="8,0,12,0" Click="Email_Click" />
        <TextBox Width="300" Padding="7" ToolTip="Reason required for the credit note" Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox Content="Restock after physical inspection" VerticalAlignment="Center" Margin="10,0" IsChecked="{Binding RestockReturnedItems}" />
        <Button Content="Process selected return" Padding="14,7" Margin="8,0,0,0" Command="{Binding IssueSalesReturnCommand}" />
      </WrapPanel>
    </StackPanel>
  </DockPanel>
</Window>