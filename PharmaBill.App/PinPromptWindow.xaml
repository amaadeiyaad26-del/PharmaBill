<Window x:Class="PharmaBill.App.PinPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sensitive records access"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Prompt}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,16" />
        <PasswordBox x:Name="PinBox" MinWidth="300" Padding="8" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" Margin="0,8,0,0" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
            <Button Content="Continue" IsDefault="True" Click="Continue_Click" Padding="14,7" />
        </WrapPanel>
    </StackPanel>
</Window>
