<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.AuthenticationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PharmaBill.App.Controls" Icon="/Assets/Icons/app.ico" Title="PharmaBill - Unlock" Width="440" SizeToContent="Height" MinHeight="440" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#F1F5F9" Foreground="#0F172A" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Style x:Key="LoginFieldStyle" TargetType="{x:Type Control}">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Control}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8">
                <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="#3B82F6" />
                  <Setter TargetName="Chrome" Property="Border.BorderThickness" Value="2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LoginTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource LoginFieldStyle}" />
      <Style x:Key="LoginPasswordStyle" TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource LoginFieldStyle}" />
      <Style x:Key="LoginLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#334155" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="PrimaryUnlockButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" CornerRadius="8">
                <UIElement.Effect>
                  <DropShadowEffect Color="#2563EB" Opacity="0.3" BlurRadius="10" ShadowDepth="2" />
                </UIElement.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#93C5FD" />
                  <Setter TargetName="Chrome" Property="UIElement.Effect" Value="{x:Null}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LoginLinkButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#2563EB" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <TextBlock Name="Label" Text="{TemplateBinding ContentControl.Content}" Foreground="{TemplateBinding Control.Foreground}" Padding="{TemplateBinding Control.Padding}" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Label" Property="TextBlock.TextDecorations" Value="Underline" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Label" Property="TextBlock.TextDecorations" Value="Underline" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LoginIconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#475569" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#F1F5F9" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="#3B82F6" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <Border Margin="24" Padding="28" Background="#FFFFFF" CornerRadius="16" VerticalAlignment="Center">
      <UIElement.Effect>
        <DropShadowEffect Color="#0F172A" Opacity="0.12" BlurRadius="24" ShadowDepth="4" />
      </UIElement.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Top">
          <controls:PharmaBill3DLogo Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,12" />
          <TextBlock Text="PharmaBill" FontSize="30" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
          <TextBlock Text="Sign in to continue" Margin="0,4,0,16" HorizontalAlignment="Center" FontSize="14" Foreground="#64748B" />
        </StackPanel>
        <TextBlock Grid.Row="3" Text="Username" Style="{StaticResource LoginLabelStyle}" />
        <TextBox Name="UsernameBox" Style="{StaticResource LoginTextBoxStyle}" Grid.Row="4" Margin="0,5,0,12" Padding="8" MinHeight="38" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="5" Text="PIN or password" Style="{StaticResource LoginLabelStyle}" />
        <Grid Row="6" Margin="0,5,0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <PasswordBox Name="SecretBox" Style="{StaticResource LoginPasswordStyle}" Padding="8" MinHeight="38" PasswordChanged="SecretBox_OnPasswordChanged" />
          <TextBox Name="VisibleSecretBox" Style="{StaticResource LoginTextBoxStyle}" Grid.Column="0" Visibility="Collapsed" Padding="8" MinHeight="38" TextChanged="VisibleSecretBox_OnTextChanged" />
          <Button Name="ShowSecretButton" Style="{StaticResource LoginIconButtonStyle}" Grid.Column="1" Content="◉" ToolTip="Show or hide PIN/password" AutomationProperties.Name="Show or hide PIN or password" MinWidth="42" Margin="6,0,0,0" Click="ShowSecret_Click" />
        </Grid>
        <TextBlock Grid.Row="7" Text="Caps Lock is on" Foreground="#FFB54708" Margin="0,2,0,3" Visibility="{Binding IsCapsLockOn, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <TextBlock Name="ErrorText" Grid.Row="8" Foreground="#FFB42318" TextWrapping="Wrap" MinHeight="24" Margin="0,0,0,8" Text="{Binding ErrorMessage}" />
        <Grid Row="9">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Button Grid.Row="0" Style="{StaticResource PrimaryUnlockButtonStyle}" Content="Unlock / Sign In" IsDefault="True" Height="48" MinHeight="44" Command="{Binding AuthenticateCommand}" IsEnabled="{Binding CanUnlock}" />
          <Button Grid.Row="1" Style="{StaticResource LoginLinkButtonStyle}" Content="Forgot PIN?" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="10,4" Click="ForgotPin_Click" />
          <Button Grid.Row="2" Style="{StaticResource LoginLinkButtonStyle}" Content="Set up new pharmacy or admin account" HorizontalAlignment="Center" Margin="0,4,0,0" Padding="10,4" ToolTip="Run the initial setup wizard for a new pharmacy install" Click="CreateAccount_Click" />
          <TextBlock Grid.Row="3" Text="─── OR CONTINUE WITH ───" HorizontalAlignment="Center" Foreground="#94A3B8" FontSize="11" Margin="0,14,0,10" />
          <Button Grid.Row="4" Style="{StaticResource GoogleSignInButton}" Content="Continue with Google" HorizontalAlignment="Stretch" Margin="0,0,0,4" Command="{Binding SignInWithGoogleCommand}" IsEnabled="{Binding CanUseSocialSignIn}" />
          <TextBlock Grid.Row="5" HorizontalAlignment="Center" Foreground="#94A3B8" Margin="0,8,0,0" Text="{Binding VersionText}" />
          <TextBlock Grid.Row="6" Margin="0,14,0,0" FontSize="11" LineHeight="16" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="#94A3B8" Text="Designed and developed by S.A.E.R. to serve pharma professionals." />
          <TextBlock Grid.Row="7" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="#94A3B8">
            <Run Text="For any query: email at " /> <Hyperlink NavigateUri="mailto:pharma.bill26@gmail.com" Foreground="#2563EB" RequestNavigate="SupportEmail_RequestNavigate">pharma.bill26@gmail.com</Hyperlink></TextBlock>
        </Grid>
      </Grid>
    </Border>
  </ScrollViewer>
</Window>