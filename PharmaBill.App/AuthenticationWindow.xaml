<Window x:Class="PharmaBill.App.AuthenticationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PharmaBill - Unlock"
        Width="440"
        SizeToContent="Height"
        MinHeight="440"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid MinHeight="440" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="PharmaBill"
                       FontSize="30"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
            <TextBlock Grid.Row="1"
                       Text="Sign in to continue"
                       Margin="0,4,0,16"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Grid.Row="3" Text="Username" />
            <TextBox x:Name="UsernameBox"
                     Grid.Row="4"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,12"
                     Padding="8"
                     MinHeight="38" />
            <TextBlock Grid.Row="5" Text="PIN or password" />
            <Grid Grid.Row="6" Margin="0,5,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="SecretBox"
                             PasswordChanged="SecretBox_OnPasswordChanged"
                             Padding="8"
                             MinHeight="38" />
                <TextBox x:Name="VisibleSecretBox"
                         Grid.Column="0"
                         Visibility="Collapsed"
                         TextChanged="VisibleSecretBox_OnTextChanged"
                         Padding="8"
                         MinHeight="38" />
                <Button x:Name="ShowSecretButton"
                        Grid.Column="1"
                        Content="◉"
                        ToolTip="Show or hide PIN/password"
                        AutomationProperties.Name="Show or hide PIN or password"
                        Click="ShowSecret_Click"
                        MinWidth="42"
                        Margin="6,0,0,0" />
            </Grid>
            <TextBlock Grid.Row="7"
                       Text="Caps Lock is on"
                       Foreground="#FFB54708"
                       Margin="0,2,0,3"
                       Visibility="{Binding IsCapsLockOn, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock x:Name="ErrorText"
                       Grid.Row="8"
                       Text="{Binding ErrorMessage}"
                       Foreground="#FFB42318"
                       TextWrapping="Wrap"
                       MinHeight="24"
                       Margin="0,0,0,8" />
            <Grid Grid.Row="9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Content="Unlock"
                        Command="{Binding AuthenticateCommand}"
                        IsDefault="True"
                        IsEnabled="{Binding CanUnlock}"
                        Height="48"
                        MinHeight="44"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0" />
                <Button Grid.Row="1"
                        Content="Forgot PIN?"
                        Click="ForgotPin_Click"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Padding="10,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Grid.Row="2"
                           Text="{Binding VersionText}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,8,0,0" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
