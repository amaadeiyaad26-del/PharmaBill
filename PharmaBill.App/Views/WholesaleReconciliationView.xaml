<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PharmaBill.App.Views.WholesaleReconciliationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AllowDrop="True" xmlns:views="clr-namespace:PharmaBill.App.Views;assembly=PharmaBill.App" Drop="OnDrop" DragOver="OnDragOver">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="Bank &amp; Ledger Reconciliation" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Margin="0,4,0,8" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Import a bank CSV/Excel statement. Matching uses UTR/cheque vouchers, fuzzy chemist/GSTIN narration, and subset-sum of open invoices &amp; credit notes." />
      <WrapPanel>
        <Button Content="Import bank statement" Padding="12,7" Command="{Binding ImportStatementCommand}" />
        <Button Content="Approve High/Medium" Padding="12,7" Margin="8,0,0,0" Command="{Binding ApproveAllHighMediumCommand}" />
        <Button Content="Approve &amp; Post Receipts" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding BatchSettleCommand}" />
      </WrapPanel>
      <TextBlock Margin="0,8,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ImportPath}" />
      <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="8" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
              Visibility="{Binding HasMatches, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding SummaryText}" />
      </Border>
      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
      <TextBlock Margin="0,2,0,0" Foreground="#FFB42318" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
    </StackPanel>
    <Grid>
      <DataGrid AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" ItemsSource="{Binding Matches}"
                Visibility="{Binding HasMatches, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalScrollBarVisibility="Auto" GridLinesVisibility="Horizontal">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <!-- Lines with no matching invoice or credit note stand out so they can be checked by hand. -->
              <DataTrigger Binding="{Binding IsUnmatched}" Value="True">
                <Setter Property="Background" Value="#FFFFF4DC" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="Approve" Width="90" Binding="{Binding Approve, UpdateSourceTrigger=PropertyChanged}" />
          <DataGridTextColumn Header="Date" IsReadOnly="True" Width="95" Binding="{Binding BankDate}" />
          <DataGridTextColumn Header="Reference / UTR" IsReadOnly="True" Width="130" Binding="{Binding Reference}" />
          <DataGridTextColumn Header="Narration" IsReadOnly="True" Width="*" MinWidth="160" Binding="{Binding Narration}" />
          <DataGridTextColumn Header="Deposit" IsReadOnly="True" Width="100" Binding="{Binding DepositAmount, StringFormat=₹{0:0.00}}" />
          <DataGridTemplateColumn Header="Chemist" Width="190" MinWidth="160">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <!-- Picking a chemist links this deposit to their open invoices, for lines the matcher missed or got wrong. -->
                <ComboBox ItemsSource="{Binding DataContext.Chemists, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ChemistId, Mode=TwoWay}"
                          ToolTip="Pick the chemist this deposit came from" Padding="4,2" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Invoices &amp; credit notes" IsReadOnly="True" Width="*" MinWidth="200" Binding="{Binding MatchedDocs}" />
          <DataGridTextColumn Header="Confidence" IsReadOnly="True" Width="130" Binding="{Binding Confidence}" />
          <DataGridTextColumn Header="Reason" IsReadOnly="True" Width="200" Binding="{Binding Reason}" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                 Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14"
                 Text="No bank statement loaded yet. Click Import bank statement, or drop a CSV or Excel file here. Each line is then matched to its chemist and open invoices."
                 Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
  </DockPanel>
</UserControl>
