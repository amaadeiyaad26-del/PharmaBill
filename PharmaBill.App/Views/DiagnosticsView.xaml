<UserControl x:Class="PharmaBill.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="System diagnostics">
  <!-- System diagnostics, shown in Settings > Data & Maintenance: import status of the data files and database row counts. -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
      <Button Content="Key Generator" Margin="8,0,0,0" Padding="12,6" Opacity="0.55" ToolTip="Admin: generate 1 Month / 1 Year / Lifetime keys (Ctrl+Shift+K)" Click="OpenKeyGenerator_Click" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding ErrorMessage}" />
    <TabControl MinHeight="320">
      <TabItem Header="Import">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Text="CSV files" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ListView DockPanel.Dock="Top" MaxHeight="140" ItemsSource="{Binding Files}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="File" Width="200" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="Path" Width="380" DisplayMemberBinding="{Binding Path}" />
                <GridViewColumn Header="Size (bytes)" Width="110" DisplayMemberBinding="{Binding SizeBytes}" />
              </GridView>
            </ListView.View>
          </ListView>
          <ListView Margin="0,12,0,0" ItemsSource="{Binding ImportStatuses}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Import" Width="100" DisplayMemberBinding="{Binding ImportKey}" />
                <GridViewColumn Header="Status" Width="120" DisplayMemberBinding="{Binding Status}" />
                <GridViewColumn Header="Imported" Width="90" DisplayMemberBinding="{Binding ImportedRows}" />
                <GridViewColumn Header="Skipped" Width="80" DisplayMemberBinding="{Binding SkippedRows}" />
                <GridViewColumn Header="Last error" Width="240" DisplayMemberBinding="{Binding LastError}" />
                <GridViewColumn Header="Action">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Re-import" Padding="8,4" Command="{Binding DataContext.ReimportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
      <TabItem Header="Database rows">
        <ListView Margin="12" ItemsSource="{Binding TableCounts}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Table" Width="360" DisplayMemberBinding="{Binding TableName}" />
              <GridViewColumn Header="Rows" Width="180" DisplayMemberBinding="{Binding Rows}" />
            </GridView>
          </ListView.View>
        </ListView>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
