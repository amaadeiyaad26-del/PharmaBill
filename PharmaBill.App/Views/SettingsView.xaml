<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PharmaBill.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PharmaBill.App.Controls" xmlns:vm="clr-namespace:PharmaBill.App.ViewModels" xmlns:views="clr-namespace:PharmaBill.App.Views" Loaded="SettingsView_OnLoaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Style x:Key="SettingsNavButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#142563EB" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
            <Setter Property="Background" Value="#222563EB" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF1D4ED8" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SettingsCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#FFCBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>
      <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <UIElement.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSettingsSearchCommand}" />
  </UIElement.InputBindings>
  <Grid Margin="24,20,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource SettingsPlaceholderMessage}" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,14" Height="40">
      <Border CornerRadius="8" BorderBrush="#FFCBD5E1" BorderThickness="1" Background="{DynamicResource FieldBackgroundBrush}" />
      <DockPanel Margin="12,0">
        <TextBlock DockPanel.Dock="Left" Text="Search" FontSize="15" VerticalAlignment="Center" Foreground="#FF64748B" Margin="0,0,10,0" />
        <Button DockPanel.Dock="Right" Content="X" FontSize="16" Width="28" Height="28" VerticalAlignment="Center" Cursor="Hand" ToolTip="Clear search" Command="{Binding ClearSettingsSearchCommand}" Visibility="{Binding HasActiveSettingsSearch, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="#00FFFFFF" CornerRadius="14">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#FF64748B" />
              </Border>
            </ControlTemplate>
          </Control.Template>
        </Button>
        <TextBox Name="SettingsSearchBox" BorderThickness="0" Background="#00FFFFFF" VerticalContentAlignment="Center" FontSize="13" Text="{Binding Path=SettingsSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>
      <TextBlock IsHitTestVisible="False" Margin="36,0,36,0" VerticalAlignment="Center" Foreground="#FF94A3B8" FontSize="12" Text="Search settings (e.g. email, UPI, printer, pin, backup)...">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding HasActiveSettingsSearch}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Value="True" Binding="{Binding ElementName=SettingsSearchBox, Path=IsKeyboardFocused}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Margin="0,0,14,0" Padding="8" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="#FFE2E8F0" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Categories" FontSize="11" FontWeight="SemiBold" Margin="8,4,8,10" Foreground="{DynamicResource SecondaryTextBrush}" />
          <Button Style="{StaticResource SettingsNavButton}" CommandParameter="{x:Static vm:SettingsCategories.General}" Content="General &amp; Profile" Command="{Binding SelectSettingsCategoryCommand}" Tag="{Binding IsGeneralCategorySelected}" />
          <Button Style="{StaticResource SettingsNavButton}" CommandParameter="{x:Static vm:SettingsCategories.Payments}" Content="Payments &amp; Billing" Command="{Binding SelectSettingsCategoryCommand}" Tag="{Binding IsPaymentsCategorySelected}" />
          <Button Style="{StaticResource SettingsNavButton}" CommandParameter="{x:Static vm:SettingsCategories.Printer}" Content="Printer &amp; Documents" Command="{Binding SelectSettingsCategoryCommand}" Tag="{Binding IsPrinterCategorySelected}" />
          <Button Style="{StaticResource SettingsNavButton}" CommandParameter="{x:Static vm:SettingsCategories.Users}" Content="Users &amp; Security" Command="{Binding SelectSettingsCategoryCommand}" Tag="{Binding IsUsersCategorySelected}" />
          <Button Style="{StaticResource SettingsNavButton}" CommandParameter="{x:Static vm:SettingsCategories.Data}" Content="Data, Backup &amp; Sync" Command="{Binding SelectSettingsCategoryCommand}" Tag="{Binding IsDataCategorySelected}" />
          <Button Style="{StaticResource SettingsNavButton}" CommandParameter="{x:Static vm:SettingsCategories.About}" Content="About &amp; Updates" Command="{Binding SelectSettingsCategoryCommand}" Tag="{Binding IsAboutCategorySelected}" />
        </StackPanel>
      </Border>
      <ScrollViewer Name="SettingsScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" FontSize="13" Foreground="#FF64748B" Text="{Binding SettingsSearchEmptyMessage}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Value="True" Binding="{Binding HasActiveSettingsSearch}" />
                      <Condition Value="False" Binding="{Binding HasSettingsSearchResults}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
          <Border Visibility="{Binding ShowAppearanceSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightAppearanceSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ThemeLabel}" />
                  <ComboBox Padding="8" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource AccentLabel}" />
                  <ComboBox Padding="8" ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding SelectedAccent}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource LanguageLabel}" />
                  <ComboBox Padding="8" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" />
                </StackPanel>
              </Grid>
              <Border Margin="0,14,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource FieldReadOnlyBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Preferences / General" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <CheckBox IsChecked="{Binding EnableUiSounds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            VerticalContentAlignment="Center">
                    <StackPanel>
                      <TextBlock Text="Enable UI Sound Effects (Clicks &amp; Alerts)" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="Play audio feedback when navigating or clicking buttons"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Margin="0,2,0,0" />
                    </StackPanel>
                  </CheckBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowBusinessModeSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightBusinessModeSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Business mode" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <controls:InfoHelper Title="Business mode" Body="Retail Chemist: patient billing. Wholesaler: B2B tax invoices. Both: switch desks as needed." />
              </DockPanel>
              <ComboBox Padding="8" Margin="0,0,0,8" ItemsSource="{Binding BusinessModes}" SelectedItem="{Binding SelectedBusinessMode}" />
              <Button Content="Apply Business Mode" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding ChangeBusinessModeCommand}" />
              <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding ModeError}" />
            </StackPanel>
          </Border>
          <Border Name="FirmProfileCard" Visibility="{Binding ShowFirmProfileSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightFirmProfileSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="Firm Profile" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Store name" />
              <TextBox Name="PharmacyStoreNameBox" Padding="8" Margin="0,0,0,8" Text="{Binding PharmacyStoreName, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Address" />
              <TextBox Padding="8" Margin="0,0,0,8" Text="{Binding PharmacyAddress, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Address line 2" />
              <TextBox Padding="8" Margin="0,0,0,8" Text="{Binding PrintAddressLine2, UpdateSourceTrigger=PropertyChanged}" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Phone" />
                  <TextBox Padding="8" Text="{Binding PharmacyPhone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Pharmacy / Billing Email" />
                  <Grid>
                    <TextBox Name="PharmacyEmailBox" Padding="8" ToolTip="Used for Email User Manual Again and registration mail" Text="{Binding PharmacyEmail, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FF94A3B8" Text="e.g. pharmacy@gmail.com">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Value="" Binding="{Binding Text, ElementName=PharmacyEmailBox}" />
                                <Condition Value="False" Binding="{Binding IsKeyboardFocused, ElementName=PharmacyEmailBox}" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="GSTIN" />
                  <TextBox Padding="8" Text="{Binding PharmacyGstin, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Drug Licence 20B" />
                  <TextBox Padding="8" Text="{Binding DrugLicence20B, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Drug Licence 21B" />
                  <TextBox Padding="8" Text="{Binding DrugLicence21B, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
              <TextBlock Style="{StaticResource FieldLabel}" Text="FSSAI" />
              <TextBox Padding="8" Margin="0,0,0,10" Text="{Binding FssaiNumber, UpdateSourceTrigger=PropertyChanged}" />
              <Button Content="Save Profile" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Background="#FF2563EB" BorderBrush="#FF2563EB" Command="{Binding SaveFirmProfileCommand}" />
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF027A48" Text="{Binding FirmProfileStatus}" />
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowBranchSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightBranchSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="Branch identity" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Branch code" />
                  <TextBox Padding="8" Text="{Binding BranchCode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Branch name" />
                  <TextBox Padding="8" Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Address" />
              <TextBox Padding="8" Margin="0,0,0,8" Text="{Binding BranchAddress, UpdateSourceTrigger=PropertyChanged}" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Phone" />
                  <TextBox Padding="8" Text="{Binding BranchPhone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="GSTIN" />
                  <TextBox Padding="8" Text="{Binding BranchGstin, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Drug licence" />
                  <TextBox Padding="8" Text="{Binding BranchDrugLicense, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
              <CheckBox Content="This desktop is the head office" Margin="0,0,0,10" IsChecked="{Binding BranchIsHeadOffice}" />
              <Button Content="Save Branch" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Background="#FF2563EB" BorderBrush="#FF2563EB" Command="{Binding SaveBranchCommand}" />
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF027A48" Text="{Binding BranchStatus}" />
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowGeminiSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightGeminiSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="Gemini API key" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBox Padding="8" Margin="0,0,0,8" Text="{Binding GeminiApiKeyInput, UpdateSourceTrigger=PropertyChanged}" />
              <WrapPanel>
                <Button Content="Save key securely" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding SaveGeminiApiKeyCommand}" />
                <Button Content="Remove saved key" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveGeminiApiKeyCommand}" />
              </WrapPanel>
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding GeminiApiKeyStatus}" />
            </StackPanel>
          </Border>
          <Border Name="UpiDigitalPaymentsCard" Visibility="{Binding ShowPaymentSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightPaymentSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <TextBlock Text="UPI &amp; Digital Payment Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <controls:InfoHelper Title="UPI &amp; Digital Payments" Body="This UPI ID generates dynamic QR codes at checkout with exact bill amounts prefilled for customers." />
              </DockPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Store UPI ID / VPA" />
              <Grid Margin="0,0,0,4">
                <TextBox Name="StoreUpiIdBox" Padding="8" Text="{Binding StoreUpiId, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FF94A3B8" Text="e.g. pharmacy@upi">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Value="" Binding="{Binding Text, ElementName=StoreUpiIdBox}" />
                            <Condition Value="False" Binding="{Binding IsKeyboardFocused, ElementName=StoreUpiIdBox}" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBlock>
              </Grid>
              <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding UpiVpaError}" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Payee / Merchant Display Name" />
              <TextBox Padding="8" Margin="0,0,0,8" Text="{Binding UpiPayeeName, UpdateSourceTrigger=PropertyChanged}" />
              <CheckBox Content="Show Customer QR Window (secondary monitor when available)" Margin="0,0,0,10" IsChecked="{Binding ShowCustomerQrWindow}" />
              <WrapPanel>
                <Button Content="Save UPI Settings" Style="{StaticResource PrimaryButton}" Height="36" MinWidth="140" Margin="0,0,8,0" Background="#FF2563EB" BorderBrush="#FF2563EB" Command="{Binding SaveUpiSettingsCommand}" />
                <Button Content="Preview QR Code" Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding PreviewUpiQrCommand}" />
              </WrapPanel>
              <TextBlock Margin="0,8,0,0" Foreground="#FF027A48" TextWrapping="Wrap" Text="{Binding UpiSettingsStatus}" />
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowPrinterSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightPrinterSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="Printer &amp; Invoicing" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Default print mode (F10)" />
              <ComboBox Padding="8" Margin="0,0,0,8" ItemsSource="{Binding InvoiceTemplateOptions}" SelectedItem="{Binding DefaultInvoiceTemplate}" />
              <CheckBox Content="Silent print (skip print dialog when a printer is configured)" Margin="0,0,0,6" IsChecked="{Binding SilentPrint}" />
              <CheckBox Content="Print doctor name &amp; registration no." Margin="0,0,0,4" IsChecked="{Binding PrintDoctorName}" />
              <CheckBox Content="Print customer phone" Margin="0,0,0,4" IsChecked="{Binding PrintCustomerPhone}" />
              <CheckBox Content="Print shop logo" Margin="0,0,0,4" IsChecked="{Binding PrintShopLogo}" />
              <CheckBox Content="Print terms &amp; disclaimer" Margin="0,0,0,8" IsChecked="{Binding PrintTermsDisclaimer}" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Terms &amp; disclaimer text" />
              <TextBox Padding="7" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" Text="{Binding TermsAndDisclaimer, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowDocumentOutputSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightDocumentOutputSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="Document output" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Retail cash memo paper size" />
                  <ComboBox Padding="8" ItemsSource="{Binding PaperSizeOptions}" SelectedItem="{Binding RetailMemoPaperSize}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Cash memo printer" />
                  <ComboBox Padding="8" ItemsSource="{Binding PrinterOptions}" SelectedItem="{Binding RetailMemoPrinter}" />
                </StackPanel>
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Retail invoice paper size" />
                  <ComboBox Padding="8" ItemsSource="{Binding PaperSizeOptions}" SelectedItem="{Binding RetailInvoicePaperSize}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Invoice printer" />
                  <ComboBox Padding="8" ItemsSource="{Binding PrinterOptions}" SelectedItem="{Binding RetailInvoicePrinter}" />
                </StackPanel>
              </Grid>
              <CheckBox Content="Pulse cash drawer after thermal receipt" Margin="0,0,0,8" IsChecked="{Binding CashDrawerPulse}" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Pharmacy logo" />
              <DockPanel Margin="0,0,0,8">
                <Button Content="Choose logo" Padding="12,6" DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding PickLogoCommand}" />
                <TextBox Padding="7" Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" />
              </DockPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Invoice / memo footer" />
              <TextBox Padding="7" Margin="0,0,0,8" Text="{Binding FooterText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="WhatsApp number" />
              <TextBox Padding="7" Margin="0,0,0,8" Text="{Binding WhatsAppNumber, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Optional SMTP" FontWeight="SemiBold" Margin="0,4,0,6" />
              <TextBox Padding="7" Margin="0,0,0,6" ToolTip="SMTP host" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Padding="7" ToolTip="Port" Text="{Binding SmtpPort}" />
                <TextBox Grid.Column="2" Padding="7" ToolTip="From email" Text="{Binding SmtpFromAddress}" />
                <TextBox Grid.Column="4" Padding="7" ToolTip="SMTP username" Text="{Binding SmtpUserName}" />
              </Grid>
              <PasswordBox Name="SmtpPasswordBox" Margin="0,0,0,6" Padding="7" PasswordChanged="SmtpPasswordBox_PasswordChanged" />
              <CheckBox Content="Use SSL/TLS" Margin="0,0,0,8" IsChecked="{Binding SmtpEnableSsl}" />
              <WrapPanel>
                <Button Content="Save print &amp; invoice settings" Style="{StaticResource PrimaryButton}" Background="#FF2563EB" BorderBrush="#FF2563EB" Margin="0,0,8,0" Click="SaveDocumentOutputSettings_Click" />
                <Button Content="Remove SMTP password" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveSmtpPasswordCommand}" />
              </WrapPanel>
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF027A48" Text="{Binding DocumentOutputStatus}" />
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowOperatorsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightOperatorsSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="Users &amp; Operators" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
              <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="180" Margin="0,0,0,8" ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Username" Width="110" Binding="{Binding UserName}" />
                  <DataGridTextColumn Header="Display name" Width="*" Binding="{Binding DisplayName}" />
                  <DataGridTextColumn Header="Role" Width="100" Binding="{Binding RoleLabel}" />
                  <DataGridCheckBoxColumn Header="Active" Width="60" Binding="{Binding IsActive}" />
                </DataGrid.Columns>
              </DataGrid>
              <WrapPanel>
                <TextBox Width="120" Padding="7" Margin="0,0,6,6" ToolTip="Username" Text="{Binding NewOperatorUserName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Width="140" Padding="7" Margin="0,0,6,6" ToolTip="Display name" Text="{Binding NewOperatorDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox Width="100" Padding="7" Margin="0,0,6,6" ToolTip="Initial PIN" controls:PasswordBoxBinding.Password="{Binding NewOperatorPassword, Mode=TwoWay}" />
                <ComboBox Width="120" Padding="7" Margin="0,0,6,6" ItemsSource="{Binding OperatorRoleOptions}" SelectedItem="{Binding NewOperatorRole}" />
                <Button Content="Add operator" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" Command="{Binding AddOperatorCommand}" />
              </WrapPanel>
              <WrapPanel>
                <Button Content="Deactivate" Padding="10,6" Margin="0,0,6,0" Command="{Binding DeactivateOperatorCommand}" />
                <Button Content="Reactivate" Padding="10,6" Margin="0,0,6,0" Command="{Binding ReactivateOperatorCommand}" />
                <Button Content="Apply role" Padding="10,6" Margin="0,0,6,0" Command="{Binding ChangeOperatorRoleCommand}" />
                <Button Content="Reset PIN" Padding="10,6" Command="{Binding ResetOperatorPasswordCommand}" />
              </WrapPanel>
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding OperatorStatus}" />
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowInspectorSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightInspectorSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="Inspector PIN" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Owner only â€” read-only view access" />
              <PasswordBox Name="InspectorPinBox" Padding="7" Margin="0,0,0,6" PasswordChanged="InspectorPinBox_PasswordChanged" />
              <PasswordBox Name="InspectorPinConfirmationBox" Padding="7" Margin="0,0,0,8" PasswordChanged="InspectorPinConfirmationBox_PasswordChanged" />
              <Button Content="Save inspector PIN" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Background="#FF2563EB" BorderBrush="#FF2563EB" Click="SaveInspectorPin_Click" />
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowSyncShortcut, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightSyncShortcut}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="Sync Station" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" Text="Local Wi-Fi pairing on port 5055, mDNS listener, and firewall rules." />
              <Button Content="Open Sync Station" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" CommandParameter="Sync" Command="{Binding OpenRelatedSettingsSectionCommand}" />
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowBackupShortcut, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightBackupShortcut}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="Backup &amp; Cloud" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" Text="Google Drive encrypted backups, USB export, and Sync on Exit / Bill Save." />
              <WrapPanel>
                <Button Content="Open Backup" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" CommandParameter="Backup" Command="{Binding OpenRelatedSettingsSectionCommand}" />
                <Button Content="Open Sync (Google Drive)" Style="{StaticResource SecondaryButton}" CommandParameter="Sync" Command="{Binding OpenRelatedSettingsSectionCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowDataBackupSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightDataBackupSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="Data retention" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ComboBox Padding="8" Margin="0,0,0,8" DisplayMemberPath="DisplayName" ItemsSource="{Binding RetentionPeriodOptions}" SelectedItem="{Binding SelectedRetentionPeriod}" />
              <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding ActiveRecordsSummary}" />
              <WrapPanel>
                <Button Content="Refresh summary" Padding="12,7" Margin="0,0,8,0" Command="{Binding RefreshRetentionSummaryCommand}" />
                <Button Content="Export &amp; Archive" Style="{StaticResource PrimaryButton}" Command="{Binding ArchivePreRetentionRecordsCommand}" IsEnabled="{Binding CanArchive}" />
              </WrapPanel>
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding RetentionStatus}" />
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowUserManualSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Border}">
                <Setter Property="Background" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="#FFE2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Border.CornerRadius" Value="10" />
                <Setter Property="Border.Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightUserManualSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#FF0F172A" />
            </UIElement.Effect>
            <StackPanel>
              <TextBlock Text="User Manual &amp; Guides" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock Text="PharmaBill Quick Guides &amp; User Manual" FontSize="14" FontWeight="SemiBold" Foreground="#FF1D4ED8" Margin="0,0,0,4" />
              <TextBlock TextWrapping="Wrap" Foreground="#FF64748B" FontSize="12.5" Margin="0,0,0,14" Text="Step-by-step instructions, shortcut keys, and workflow tutorials directly inside the app." />
              <WrapPanel>
                <Button Padding="14,9" Margin="0,0,8,8" Cursor="Hand" Background="#FF2563EB" BorderBrush="#FF2563EB" Foreground="#FFFFFFFF" ToolTip="Open searchable chapters inside PharmaBill (also F1)" Command="{Binding OpenInteractiveUserManualCommand}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="î¢¡" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFFFFFFF" />
                          <TextBlock Text="Read In-App (Interactive Guide)" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
                        </StackPanel>
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
                <Button Padding="14,9" Margin="0,0,8,8" Cursor="Hand" Background="#00FFFFFF" BorderBrush="#FFDC2626" Foreground="#FFDC2626" ToolTip="Open the bundled PDF in your default viewer" Command="{Binding OpenPdfUserManualCommand}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="î¢¥" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFDC2626" />
                          <TextBlock Text="Open PDF Manual" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FFDC2626" />
                        </StackPanel>
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
                <Button Padding="14,9" Margin="0,0,0,8" Cursor="Hand" Background="#00FFFFFF" BorderBrush="#FF475569" Foreground="#FF475569" ToolTip="Email the manual to Pharmacy / Billing Email" Command="{Binding EmailUserManualAgainCommand}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="îœ•" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF475569" />
                          <TextBlock Text="Email User Manual" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FF475569" />
                        </StackPanel>
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
              </WrapPanel>
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="#FF027A48" Text="{Binding ManualHubStatus}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Value="" Binding="{Binding ManualHubStatus}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
              <TextBlock Margin="0,6,0,10" FontSize="11.5" Foreground="#FF94A3B8" Text="Tip: press F1 anywhere in the app to open the interactive guide." />
              <controls:DeveloperSupportBanner Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border Visibility="{Binding ShowAboutSection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FrameworkElement.Style>
              <Style BasedOn="{StaticResource SettingsCard}" TargetType="{x:Type Border}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding HighlightAboutSection}">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <StackPanel>
              <TextBlock Text="About PharmaBill" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock Margin="0,0,0,8" Text="{Binding VersionText}" />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="Designed and developed by S.A.E.R. to serve pharma professionals." />
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}">
                <Run Text="Support: " /> <Hyperlink NavigateUri="mailto:pharma.bill26@gmail.com" Foreground="{DynamicResource AccentBrush}" RequestNavigate="SupportEmail_RequestNavigate">pharma.bill26@gmail.com</Hyperlink></TextBlock>
              <WrapPanel Margin="0,12,0,0">
                <Button Padding="12,7" Margin="0,0,8,0" Command="{Binding CheckForUpdatesCommand}">
                  <FrameworkElement.Style>
                    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                      <Setter Property="Content" Value="Check for updates" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding IsCheckingForUpdates}">
                          <Setter Property="Content" Value="Checkingâ€¦" />
                          <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </Button>
                <Button Content="Release notes" Padding="12,7" Margin="0,0,8,0" Command="{Binding ToggleReleaseNotesCommand}" />
                <Button Content="Email User Manual Again" Style="{StaticResource PrimaryButton}" Command="{Binding EmailUserManualAgainCommand}" />
              </WrapPanel>
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FFB42318" Text="{Binding ManualEmailMissingMessage}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Value="" Binding="{Binding ManualEmailMissingMessage}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
              <Button Content="Go to Pharmacy Email field -&gt;" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="0" BorderThickness="0" Background="#00FFFFFF" Cursor="Hand" Foreground="#FF2563EB" FontWeight="SemiBold" Click="JumpToPharmacyEmail_Click">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Value="" Binding="{Binding ManualEmailMissingMessage}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Button>
              <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding UpdateStatus}" />
              <TextBox IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" Padding="7" Margin="0,8,0,0" Visibility="{Binding IsReleaseNotesVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{Binding ReleaseNotesText, Mode=OneWay}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>