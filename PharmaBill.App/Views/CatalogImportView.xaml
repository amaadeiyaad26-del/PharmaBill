<UserControl x:Class="PharmaBill.App.Views.CatalogImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Medicine data import">
  <!-- The medicine catalogue import, shown in Settings > Data & Maintenance. It starts only when Import is pressed. -->
  <StackPanel>
    <TextBlock Text="Reference data is imported in resumable batches: an import that stops carries on from where it was. It does not change stock or sales."
               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <GroupBox Header="Medicine catalogue (brand and composition)" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Choose file" Margin="8,0,0,0" Padding="12,5" Command="{Binding ChooseCatalogCommand}" />
          <TextBox Padding="7" Text="{Binding CatalogPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Medicine catalogue file" />
        </DockPanel>
        <ProgressBar Minimum="0" Maximum="100" Height="18" Margin="0,12,0,5" Value="{Binding CatalogProgress.Percentage}" />
        <TextBlock>
          <Run Text="{Binding CatalogProgress.Percentage, StringFormat='{}{0}%'}" /> <Run Text=" — " /> <Run Text="{Binding CatalogProgress.ProcessedRows, StringFormat='{}{0:N0}'}" /> <Run Text=" processed, " /> <Run Text="{Binding CatalogProgress.SkippedRows, StringFormat='{}{0:N0}'}" /> <Run Text=" skipped" /></TextBlock>
        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" Text="{Binding CatalogProgress.EstimatedTimeRemaining, StringFormat='Estimated time left: {0:hh\\:mm\\:ss}'}" />
      </StackPanel>
    </GroupBox>
    <GroupBox Header="Medicine information (therapeutic and habit-forming references)" Padding="14">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Choose file" Margin="8,0,0,0" Padding="12,5" Command="{Binding ChooseInfoCommand}" />
          <TextBox Padding="7" Text="{Binding InfoPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Medicine information file" />
        </DockPanel>
        <ProgressBar Minimum="0" Maximum="100" Height="18" Margin="0,12,0,5" Value="{Binding InfoProgress.Percentage}" />
        <TextBlock>
          <Run Text="{Binding InfoProgress.Percentage, StringFormat='{}{0}%'}" /> <Run Text=" — " /> <Run Text="{Binding InfoProgress.ProcessedRows, StringFormat='{}{0:N0}'}" /> <Run Text=" processed, " /> <Run Text="{Binding InfoProgress.SkippedRows, StringFormat='{}{0:N0}'}" /> <Run Text=" skipped" /></TextBlock>
        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" Text="{Binding InfoProgress.EstimatedTimeRemaining, StringFormat='Estimated time left: {0:hh\\:mm\\:ss}'}" />
      </StackPanel>
    </GroupBox>
    <TextBlock FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding StatusMessage}" AutomationProperties.Name="Import status" />
    <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,5,0,0" Text="{Binding ErrorMessage}" />
    <WrapPanel Margin="0,12,0,0">
      <Button Content="Import / resume" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding StartCommand}"
              ToolTip="Imports both files; an import that was interrupted carries on from where it stopped" />
      <Button Content="Cancel import" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" IsEnabled="{Binding IsImporting}" />
    </WrapPanel>
  </StackPanel>
</UserControl>
