<UserControl x:Class="PharmaBill.App.Views.WholesaleDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:PharmaBill.App.Behaviors"
             Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="WsGlassCard" TargetType="Border">
      <Setter Property="Background" Value="#EBF5EE" />
      <Setter Property="BorderBrush" Value="#A7D4B5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#0D4A2B" Opacity="0.06" BlurRadius="10" ShadowDepth="2" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WsKpiLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#0D4A2B" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style x:Key="WsKpiValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#0D4A2B" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
    <StackPanel>
      <DockPanel Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Wholesale B2B Dashboard" FontSize="26" FontWeight="Bold" Foreground="#0D4A2B" />
          <TextBlock Foreground="#64748B" Text="{Binding LastUpdated, StringFormat=Updated {0:dd-MMM-yyyy HH:mm}}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Refresh" Margin="0,0,8,0" Style="{StaticResource FrostedMintPillButton}"
                  behaviors:HoverTickSound.Enabled="True" Command="{Binding RefreshCommand}" />
          <Button Content="+ New B2B Order / Challan" Style="{StaticResource FrostedMintPillButton}"
                  behaviors:HoverTickSound.Enabled="True" Command="{Binding NewB2bOrderCommand}" />
        </StackPanel>
      </DockPanel>

      <TextBlock Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding ErrorMessage}" />
      <TextBlock Foreground="#047857" TextWrapping="Wrap" Margin="0,0,0,10" Text="{Binding StatusMessage}" />

      <!-- Section A: KPI cards -->
      <UniformGrid Columns="4" Margin="0,0,0,4">
        <Border Style="{StaticResource WsGlassCard}">
          <StackPanel>
            <TextBlock Text="Today's B2B Turnover" Style="{StaticResource WsKpiLabel}" />
            <TextBlock Text="{Binding TodayTurnoverText}" Style="{StaticResource WsKpiValue}" />
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#64748B" Text="{Binding TodayOrdersText}" />
            <TextBlock Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold" Text="{Binding TrendText}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="#059669" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TrendPositive}" Value="False">
                      <Setter Property="Foreground" Value="#DC2626" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource WsGlassCard}">
          <StackPanel>
            <TextBlock Text="Outstanding Receivables" Style="{StaticResource WsKpiLabel}" />
            <TextBlock Text="{Binding OutstandingText}" Style="{StaticResource WsKpiValue}" />
            <Border Margin="0,10,0,0" Padding="8,4" CornerRadius="8" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" HorizontalAlignment="Left">
              <TextBlock FontSize="11" Foreground="#92400E" Text="{Binding Overdue45Text}" />
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource WsGlassCard}">
          <StackPanel>
            <TextBlock Text="Supplier Payables" Style="{StaticResource WsKpiLabel}" />
            <TextBlock Text="{Binding PayablesText}" Style="{StaticResource WsKpiValue}" />
            <Border Margin="0,10,0,0" Padding="8,4" CornerRadius="8" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" HorizontalAlignment="Left">
              <TextBlock FontSize="11" Foreground="#065F46" Text="{Binding DueThisWeekText}" />
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource WsGlassCard}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Active Orders &amp; Dispatches" Style="{StaticResource WsKpiLabel}" />
            <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" Foreground="#0D4A2B" TextWrapping="Wrap"
                       Text="{Binding ActiveOrdersSummary}" />
            <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#64748B"
                       Text="Draft · Ready to Pack · Dispatched · Pending e-Way Bill" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Section B: split -->
      <Grid Margin="0,4,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource WsGlassCard}" Margin="0,0,12,0">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="Credit &amp; Ageing Matrix" FontSize="16" FontWeight="SemiBold" Foreground="#0D4A2B" VerticalAlignment="Center" />
              <Button DockPanel.Dock="Right" Content="📄 Outstanding Statement" Style="{StaticResource FrostedMintPillButton}"
                      Command="{Binding OutstandingStatementCommand}" />
            </DockPanel>

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
              <Grid Height="18" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#10B981" CornerRadius="6,0,0,6" Margin="0,0,2,0" ToolTip="{Binding Ageing0Text}" />
                <Border Grid.Column="1" Background="#34D399" Margin="0,0,2,0" ToolTip="{Binding Ageing31Text}" />
                <Border Grid.Column="2" Background="#F59E0B" Margin="0,0,2,0" ToolTip="{Binding Ageing61Text}" />
                <Border Grid.Column="3" Background="#EF4444" CornerRadius="0,6,6,0" ToolTip="{Binding Ageing90Text}" />
              </Grid>
              <UniformGrid Columns="4">
                <StackPanel Margin="0,0,8,0">
                  <TextBlock FontSize="11" Foreground="#047857" Text="0–30 Days" />
                  <TextBlock FontWeight="SemiBold" Foreground="#0D4A2B" Text="{Binding Ageing0Text}" />
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                  <TextBlock FontSize="11" Foreground="#059669" Text="31–60 Days" />
                  <TextBlock FontWeight="SemiBold" Foreground="#0D4A2B" Text="{Binding Ageing31Text}" />
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                  <TextBlock FontSize="11" Foreground="#B45309" Text="61–90 Days" />
                  <TextBlock FontWeight="SemiBold" Foreground="#0D4A2B" Text="{Binding Ageing61Text}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock FontSize="11" Foreground="#B91C1C" Text="90+ Days" />
                  <TextBlock FontWeight="SemiBold" Foreground="#0D4A2B" Text="{Binding Ageing90Text}" />
                </StackPanel>
              </UniformGrid>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="#0D4A2B" Margin="0,0,0,8" Text="Top overdue buyers" />
            <DataGrid ItemsSource="{Binding TopOverdueBuyers}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="220"
                      Background="Transparent" BorderThickness="0" RowBackground="#F0FDF4" AlternatingRowBackground="#EBF5EE">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Pharmacy" Width="*" Binding="{Binding PharmacyName}" />
                <DataGridTextColumn Header="Credit limit" Width="100" Binding="{Binding CreditLimit, StringFormat=₹{0:N0}}" />
                <DataGridTextColumn Header="Overdue" Width="100" Binding="{Binding OverdueAmount, StringFormat=₹{0:N0}}" />
                <DataGridTextColumn Header="Days" Width="60" Binding="{Binding DaysOverdue}" />
                <DataGridTemplateColumn Header="Action" Width="220">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="💬 WhatsApp" Margin="0,0,6,0" Padding="8,3" Style="{StaticResource FrostedMintPillButton}"
                                Command="{Binding DataContext.WhatsAppReminderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}" />
                        <Button Content="📄 Ledger" Padding="8,3" Style="{StaticResource FrostedMintPillButton}"
                                Command="{Binding DataContext.OpenLedgerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource WsGlassCard}" Margin="0">
          <StackPanel>
            <TextBlock Text="Today's Order Fulfillment" FontSize="16" FontWeight="SemiBold" Foreground="#0D4A2B" Margin="0,0,0,12" />
            <Border Background="#F0FDF4" BorderBrush="#A7D4B5" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="📥 Received" FontWeight="SemiBold" Foreground="#0D4A2B" />
                <TextBlock Foreground="#047857" Text="{Binding Snapshot.PipelineReceivedCount, StringFormat={}{0} Orders}" />
                <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Snapshot.PipelineReceivedValue, StringFormat=₹{0:N2}}" />
              </StackPanel>
            </Border>
            <Border Background="#F0FDF4" BorderBrush="#A7D4B5" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="📦 In Picking / Packing" FontWeight="SemiBold" Foreground="#0D4A2B" />
                <TextBlock Foreground="#047857" Text="{Binding Snapshot.PipelinePickingCount, StringFormat={}{0} Orders}" />
              </StackPanel>
            </Border>
            <Border Background="#F0FDF4" BorderBrush="#A7D4B5" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="🚚 Dispatched / Out with Driver" FontWeight="SemiBold" Foreground="#0D4A2B" />
                <TextBlock Foreground="#047857" Text="{Binding Snapshot.PipelineDispatchedCount, StringFormat={}{0} Orders}" />
              </StackPanel>
            </Border>
            <Border Background="#F0FDF4" BorderBrush="#A7D4B5" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="✅ Delivered &amp; Reconciled" FontWeight="SemiBold" Foreground="#0D4A2B" />
                <TextBlock Foreground="#047857" Text="{Binding Snapshot.PipelineDeliveredCount, StringFormat={}{0} Orders}" />
              </StackPanel>
            </Border>
            <Button Content="+ New B2B Order / Challan" HorizontalAlignment="Stretch" Height="40"
                    Style="{StaticResource FrostedMintPillButton}" Command="{Binding NewB2bOrderCommand}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Section C -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource WsGlassCard}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Fast-Moving Bulk Items" FontSize="16" FontWeight="SemiBold" Foreground="#0D4A2B" Margin="0,0,0,10" />
            <DataGrid ItemsSource="{Binding FastMovingBulk}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="240"
                      Background="Transparent" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Product" Width="*" Binding="{Binding ProductName}" />
                <DataGridTextColumn Header="Packs/wk" Width="80" Binding="{Binding PacksSold, StringFormat=0.##}" />
                <DataGridTextColumn Header="Warehouse" Width="90" Binding="{Binding WarehouseQty, StringFormat=0.##}" />
                <DataGridTextColumn Header="Batch" Width="100" Binding="{Binding TopBatchNo}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource WsGlassCard}" Margin="0,0,0,12">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="B2B Tax &amp; e-Invoice Readiness" FontSize="16" FontWeight="SemiBold" Foreground="#0D4A2B" VerticalAlignment="Center" />
              <Button DockPanel.Dock="Right" Content="GST &amp; e-Way" Style="{StaticResource FrostedMintPillButton}" Command="{Binding OpenGstCommand}" />
            </DockPanel>
            <Border Background="#F0FDF4" CornerRadius="10" Padding="14" BorderBrush="#A7D4B5" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="14" Foreground="#0D4A2B" TextWrapping="Wrap" Text="{Binding TaxReadinessText}" />
                <UniformGrid Columns="3" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock FontSize="11" Foreground="#64748B" Text="e-Invoices" />
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#10B981" Text="{Binding Snapshot.EInvoicesToday}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock FontSize="11" Foreground="#64748B" Text="Pending IRN" />
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Text="{Binding Snapshot.PendingIrn}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock FontSize="11" Foreground="#64748B" Text="e-Way ~24h" />
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#EF4444" Text="{Binding Snapshot.EWayExpiringSoon}" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
