<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.DataLocationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pharma Remit - pharmacy data folder" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FFFFFFFF" Foreground="#FF182230">
  <StackPanel Margin="28">
    <TextBlock Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.Name="Data folder heading" />
    <TextBlock Name="ExplanationText" FontSize="13.5" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14" AutomationProperties.Name="Data folder explanation" />

    <!-- Another installation's records were found: the pharmacist decides; nothing is copied before that. -->
    <StackPanel Name="OtherInstallationPanel" Visibility="Collapsed">
      <Border Background="#FFFEF3F2" BorderBrush="#FFFECDCA" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
        <TextBlock Name="OtherInstallationWarning" TextWrapping="Wrap" FontSize="12.5" Foreground="#FFB42318" AutomationProperties.Name="Two versions warning" />
      </Border>
      <TextBlock Text="What would you like to do?" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
      <RadioButton Name="TakeOverOption" GroupName="Choice" Margin="0,0,0,2" Checked="Option_Checked" AutomationProperties.Name="Use the existing records">
        <TextBlock MaxWidth="555" TextWrapping="Wrap" FontWeight="SemiBold" Text="a. Use these records in this app — recommended only if you will stop using the other installation" />
      </RadioButton>
      <TextBlock Name="TakeOverDetail" Margin="22,0,0,10" TextWrapping="Wrap" FontSize="12.5" Foreground="#FF475467" />
      <RadioButton Name="StartNewOption" GroupName="Choice" Margin="0,0,0,2" Checked="Option_Checked" AutomationProperties.Name="Start a new empty pharmacy">
        <TextBlock MaxWidth="555" TextWrapping="Wrap" FontWeight="SemiBold" Text="b. Choose a different folder and start a new, empty pharmacy" />
      </RadioButton>
      <TextBlock Margin="22,0,0,10" TextWrapping="Wrap" FontSize="12.5" Foreground="#FF475467"
                 Text="The records found stay with the other installation; nothing is copied. You will set up this pharmacy from the beginning." />
      <RadioButton Name="CloseOption" GroupName="Choice" Margin="0,0,0,2" Checked="Option_Checked" AutomationProperties.Name="Close to uninstall one version">
        <TextBlock MaxWidth="555" TextWrapping="Wrap" FontWeight="SemiBold" Text="c. Close Pharma Remit, so I can uninstall one version first" />
      </RadioButton>
      <TextBlock Margin="22,0,0,12" TextWrapping="Wrap" FontSize="12.5" Foreground="#FF475467"
                 Text="Nothing is changed. Open Pharma Remit again when only one version is installed." />
    </StackPanel>

    <StackPanel Name="FolderPanel">
      <TextBlock Name="FolderLabel" Text="Folder" FontSize="12" FontWeight="SemiBold" Foreground="#FF667085" Margin="0,0,0,4" />
      <DockPanel Margin="0,0,0,10">
        <Button DockPanel.Dock="Right" Name="BrowseButton" Content="Browse..." Padding="12,6" Margin="8,0,0,0" Click="Browse_Click" />
        <TextBox Name="FolderBox" Padding="8,6" FontSize="13" TextChanged="FolderBox_TextChanged" AutomationProperties.Name="Data folder" />
      </DockPanel>
    </StackPanel>

    <Border Name="MigrationNote" Background="#FFF0F9FF" BorderBrush="#FFB9E6FE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
      <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#FF026AA2"
                 Text="Your existing records will be copied to this folder and checked file by file, and every database opened, before Pharma Remit switches to it. The original copy is left where it is." />
    </Border>

    <Border Name="SyncWarning" Background="#FFFFFAEB" BorderBrush="#FFFEC84B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
      <TextBlock Name="SyncWarningText" TextWrapping="Wrap" FontSize="12.5" Foreground="#FFB54708" />
    </Border>
    <TextBlock Name="ErrorText" TextWrapping="Wrap" FontSize="12.5" Foreground="#FFB42318" Margin="0,0,0,10" AutomationProperties.Name="Data folder error" />

    <DockPanel LastChildFill="False">
      <Button DockPanel.Dock="Right" Name="ExitButton" Content="Exit" Padding="18,7" Margin="8,0,0,0" IsCancel="True" Click="Exit_Click" />
      <Button DockPanel.Dock="Right" Name="PrimaryButton" Padding="16,7" IsDefault="True" Click="Primary_Click" AutomationProperties.Name="Data folder continue" />
      <Button DockPanel.Dock="Right" Name="RetryButton" Content="Try again" Padding="14,7" Margin="0,0,8,0" Visibility="Collapsed" Click="Retry_Click" />
    </DockPanel>
  </StackPanel>
</Window>
