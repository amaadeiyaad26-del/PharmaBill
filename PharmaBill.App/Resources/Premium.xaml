<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="FocusGlowColor">#FF3B82F6</Color>
  <Color x:Key="EmeraldGlowColor">#FF10B981</Color>
  <SolidColorBrush x:Key="FocusRingBrush" Color="#FF3B82F6" />
  <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF2563EB" Offset="0" />
    <GradientStop Color="#FF1D4ED8" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF059669" Offset="0" />
    <GradientStop Color="#FF0D9488" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF0F172A" Offset="0" />
    <GradientStop Color="#FF1E293B" Offset="1" />
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="NavPillGlowBrush">
    <GradientStop Color="#FF6EE7B7" Offset="0" />
    <GradientStop Color="#FF10B981" Offset="1" />
  </RadialGradientBrush>
  <Duration x:Key="HoverDuration">0:0:0.15</Duration>
  <QuadraticEase x:Key="EaseOutQuad" EasingMode="EaseOut" />
  <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="ToolTip.HasDropShadow" Value="False" />
    <Setter Property="Foreground" Value="#FFF8FAFC" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="ToolTip.Placement" Value="Bottom" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Name="Bubble" Margin="10" Padding="8,6" CornerRadius="8" Background="#FF0F172A" MaxWidth="380">
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.3" Color="#FF0F172A" />
            </UIElement.Effect>
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="Foreground" Value="#FFF8FAFC" />
                </Style>
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <ContentPresenter TextElement.Foreground="#FFF8FAFC" />
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Bubble" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Grid>
            <Border Name="Box" CornerRadius="8" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
              <ScrollViewer Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Control.Padding}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
            </Border>
            <Border Name="FocusRing" CornerRadius="8" IsHitTestVisible="False" Opacity="0" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{StaticResource FocusRingBrush}">
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.55" Color="#FF3B82F6" />
              </UIElement.Effect>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="TextBoxBase.IsReadOnly" Value="True">
              <Setter TargetName="Box" Value="{DynamicResource FieldReadOnlyBrush}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="UIElement.Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>