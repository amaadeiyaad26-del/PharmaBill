<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PharmaBill.App.Controls">

    <BooleanToVisibilityConverter x:Key="FieldBoolToVisibility" />

    <!-- Floating-label field shell: wrap one TextBox / ComboBox / DatePicker / PasswordBox. -->
    <Style TargetType="{x:Type controls:FloatingField}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FloatingField}">
                    <StackPanel>
                        <Border x:Name="Box" Height="48" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource FieldBorderBrush}"
                                Background="{DynamicResource FieldBackgroundBrush}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter Margin="12,0,6,0" />
                                <StackPanel x:Name="LabelPanel" Orientation="Horizontal" IsHitTestVisible="False"
                                            Margin="13,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}"
                                               FontSize="14pt" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="RequiredMark" Text=" *" FontSize="14pt"
                                               Foreground="{DynamicResource FieldErrorBrush}"
                                               Visibility="{TemplateBinding IsRequired, Converter={StaticResource FieldBoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ErrorLine" Text="{TemplateBinding ErrorText}" FontSize="12"
                                   Foreground="{DynamicResource FieldErrorBrush}" TextWrapping="Wrap"
                                   Margin="12,3,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="HelperLine" Text="{TemplateBinding HelperText}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   Margin="12,3,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasValue" Value="False" />
                                <Condition Property="IsKeyboardFocusWithin" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LabelPanel" Property="VerticalAlignment" Value="Center" />
                        </MultiTrigger>
                        <Trigger Property="HasValue" Value="True">
                            <Setter TargetName="LabelPanel" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="LabelPanel" Property="Margin" Value="13,4,12,0" />
                            <Setter TargetName="LabelText" Property="FontSize" Value="9pt" />
                            <Setter TargetName="RequiredMark" Property="FontSize" Value="9pt" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="LabelPanel" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="LabelPanel" Property="Margin" Value="13,4,12,0" />
                            <Setter TargetName="LabelText" Property="FontSize" Value="9pt" />
                            <Setter TargetName="RequiredMark" Property="FontSize" Value="9pt" />
                            <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FieldErrorBrush}" />
                            <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource FieldErrorBrush}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            <Setter TargetName="ErrorLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowHelper" Value="True">
                            <Setter TargetName="HelperLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsContentReadOnly" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource FieldReadOnlyBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource FieldReadOnlyBrush}" />
                            <Setter TargetName="LabelText" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inner input styles, applied automatically by FloatingField. -->
    <Style x:Key="FloatingInnerTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="FontSize" Value="14pt" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="0,16,0,2" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingInnerPasswordBox" TargetType="{x:Type PasswordBox}">
        <Setter Property="FontSize" Value="14pt" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="0,16,0,2" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingInnerComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="FontSize" Value="14pt" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid Background="Transparent">
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,16,4,0"
                                              Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource SecondaryTextBrush}"
                                              StrokeThickness="2" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="0,16,26,2" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource FieldBackgroundBrush}"
                                    BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,4,8,8" Padding="2">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingInnerDatePicker" TargetType="{x:Type DatePicker}">
        <Setter Property="FontSize" Value="14pt" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,14,0,0" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="FocusRing" CornerRadius="8" BorderThickness="2" Margin="-2"
                                BorderBrush="Transparent" />
                        <Border x:Name="Face" CornerRadius="6" Background="{DynamicResource AccentBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="FocusRing" CornerRadius="8" BorderThickness="2" Margin="-2"
                                BorderBrush="Transparent" />
                        <Border x:Name="Face" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource FieldBorderBrush}"
                                Background="{DynamicResource FieldBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="4" />
    </Style>
</ResourceDictionary>