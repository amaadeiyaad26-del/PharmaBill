  <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
    <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style x:Key="{x:Type DataGridRow}" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="MinHeight" Value="34" />
    <Style.Triggers>
      <Trigger Property="DataGridRow.AlternationIndex" Value="1">
        <Setter Property="Background" Value="{DynamicResource GridAlternateRowBrush}" />
      </Trigger>
      <Trigger Property="DataGridRow.IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource GridSelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="DataGridCell.IsSelected" Value="True">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- Always-visible inline editors for billing line grids (no double-click to edit). -->
  <Style x:Key="BillingLineDataGrid" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
    <Setter Property="RowHeaderWidth" Value="0" />
  </Style>
  <Style x:Key="BillingInlineEditBox" TargetType="{x:Type TextBox}">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#FFCBD5E1" />
    <Setter Property="Background" Value="#FFFFFFFF" />
    <Setter Property="Foreground" Value="#FF0F172A" />
    <Setter Property="CaretBrush" Value="#FF0F172A" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="#FF3B82F6" />
        <Setter Property="Background" Value="#FFF8FAFC" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="BillingInlineComboBox" TargetType="{x:Type ComboBox}">
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#FFCBD5E1" />
    <Setter Property="Background" Value="#FFFFFFFF" />
  </Style>
  <Style x:Key="BillingInlineReadonlyText" TargetType="{x:Type TextBlock}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Foreground" Value="#FF334155" />
  </Style>
  <Style x:Key="StockPickerComboBoxItem" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="#FF1E293B" />
    <Setter Property="Background" Value="#FFFFFFFF" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border Name="ItemChrome" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
              <Setter TargetName="ItemChrome" Property="Border.Background" Value="#FFF1F5F9" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="ItemChrome" Property="Border.Background" Value="#FFDBEAFE" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#FF94A3B8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Keeps the default ComboBox template so IsEditable / search-as-you-type works inside FloatingField. -->
  <Style x:Key="PurchaseMedicineSearchComboBox" TargetType="{x:Type ComboBox}">
    <Setter Property="FontSize" Value="14pt" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,14,22,0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MaxDropDownHeight" Value="280" />
  </Style>
  <Style x:Key="StockPickerComboBox" TargetType="{x:Type ComboBox}">
    <Setter Property="Foreground" Value="#FF1E293B" />
    <Setter Property="Background" Value="#FFFFFFFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ComboBox.MaxDropDownHeight" Value="210" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource StockPickerComboBoxItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton Name="ToggleButton" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border Name="Chrome" Background="{DynamicResource FieldBackgroundBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="8,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                      <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L5,5 L10,0" Stroke="#FF64748B" StrokeThickness="2" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="#FF94A3B8" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="#FF2563EB" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.55" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </ToggleButton>
            <Popup Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" PopupAnimation="Fade">
              <Border MinHeight="36" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" Margin="0,4,0,0" Padding="2" CornerRadius="8" Background="#FFFFFFFF" BorderBrush="#FFCBD5E1" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.18" Color="#FF0F172A" />
                </UIElement.Effect>
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>