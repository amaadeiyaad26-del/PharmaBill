<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PharmaBill.App.Controls" xmlns:local="clr-namespace:PharmaBill.App.Controls" xmlns:behaviors="clr-namespace:PharmaBill.App.Behaviors">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/PharmaBill.App;component/Resources/Premium.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="FieldBoolToVisibility" />
  <local:ComboSelectionDisplayConverter x:Key="ComboSelectionDisplayConverter" />
  <Style x:Key="{x:Type controls:FloatingField}" TargetType="{x:Type controls:FloatingField}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:FloatingField}">
          <StackPanel>
            <Border Name="Box" Height="48" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource FieldBorderBrush}" Background="{DynamicResource FieldBackgroundBrush}" SnapsToDevicePixels="True">
              <Grid>
                <Border Name="FocusRing" CornerRadius="10" Margin="-1.5" IsHitTestVisible="False" Opacity="0" BorderThickness="1.5" BorderBrush="{StaticResource FocusRingBrush}">
                  <UIElement.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.55" Color="#FF3B82F6" />
                  </UIElement.Effect>
                </Border>
                <ContentPresenter Margin="12,0,6,0" />
                <StackPanel Name="LabelPanel" Orientation="Horizontal" IsHitTestVisible="False" Margin="13,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                  <TextBlock Name="LabelText" Text="{TemplateBinding controls:FloatingField.Label}" FontSize="14pt" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Name="RequiredMark" Text=" *" FontSize="14pt" Foreground="{DynamicResource FieldErrorBrush}" Visibility="{TemplateBinding IsRequired, Converter={StaticResource FieldBoolToVisibility}}" />
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Name="ErrorLine" Text="{TemplateBinding controls:FloatingField.ErrorText}" FontSize="12" Foreground="{DynamicResource FieldErrorBrush}" TextWrapping="Wrap" Margin="12,3,0,0" Visibility="Collapsed" />
            <TextBlock Name="HelperLine" Text="{TemplateBinding controls:FloatingField.HelperText}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="12,3,0,0" Visibility="Collapsed" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="controls:FloatingField.HasValue" Value="False" />
                <Condition Property="UIElement.IsKeyboardFocusWithin" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="LabelPanel" Property="VerticalAlignment" Value="Center" />
            </MultiTrigger>
            <Trigger Property="controls:FloatingField.HasValue" Value="True">
              <Setter TargetName="LabelPanel" Property="VerticalAlignment" Value="Top" />
              <Setter TargetName="LabelPanel" Property="Margin" Value="13,4,12,0" />
              <Setter TargetName="LabelText" Property="TextBlock.FontSize" Value="9pt" />
              <Setter TargetName="RequiredMark" Property="TextBlock.FontSize" Value="9pt" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="LabelPanel" Property="VerticalAlignment" Value="Top" />
              <Setter TargetName="LabelPanel" Property="Margin" Value="13,4,12,0" />
              <Setter TargetName="LabelText" Property="TextBlock.FontSize" Value="9pt" />
              <Setter TargetName="RequiredMark" Property="TextBlock.FontSize" Value="9pt" />
              <Setter TargetName="LabelText" Property="TextBlock.Foreground" Value="{StaticResource FocusRingBrush}" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="controls:FloatingField.HasError" Value="True">
              <Setter TargetName="Box" Value="{DynamicResource FieldErrorBrush}" Property="Border.BorderBrush" />
              <Setter TargetName="LabelText" Value="{DynamicResource FieldErrorBrush}" Property="TextBlock.Foreground" />
              <Setter TargetName="Box" Property="Border.BorderThickness" Value="2" />
              <Setter TargetName="ErrorLine" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="controls:FloatingField.ShowHelper" Value="True">
              <Setter TargetName="HelperLine" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="controls:FloatingField.IsContentReadOnly" Value="True">
              <Setter TargetName="Box" Value="{DynamicResource FieldReadOnlyBrush}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Value="{DynamicResource FieldReadOnlyBrush}" Property="Border.Background" />
              <Setter TargetName="LabelText" Property="UIElement.Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FloatingInnerTextBox" TargetType="{x:Type TextBox}">
    <Setter Property="FontSize" Value="14pt" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Bottom" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <ScrollViewer Name="PART_ContentHost" Margin="0,16,0,2" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
