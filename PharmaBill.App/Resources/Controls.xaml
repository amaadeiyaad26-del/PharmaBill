  <Style x:Key="FloatingInnerComboBox" TargetType="{x:Type ComboBox}">
    <Setter Property="FontSize" Value="14pt" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid Background="#00FFFFFF">
            <ToggleButton Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border Background="#00FFFFFF">
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,16,4,0" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="2" />
                  </Border>
                </ControlTemplate>
              </Control.Template>
            </ToggleButton>
            <!-- Resolve Name via DisplayMemberPath so entity ToString() (raw type) never shows. -->
            <TextBlock Margin="0,16,26,2" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource PrimaryTextBrush}">
              <TextBlock.Text>
                <MultiBinding Converter="{StaticResource ComboSelectionDisplayConverter}">
                  <Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="DisplayMemberPath" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <Popup IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" Background="{DynamicResource FieldBackgroundBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,4,8,8" Padding="2" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FloatingInnerDatePicker" TargetType="{x:Type DatePicker}">
    <Setter Property="FontSize" Value="14pt" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,14,0,0" />
