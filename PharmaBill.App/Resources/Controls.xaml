  <Style x:Key="KpiCardButton" TargetType="{x:Type Button}">
    <Setter Property="Margin" Value="8" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="behaviors:HoverTickSound.Enabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Card" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="4,0,0,0" CornerRadius="16" Padding="{TemplateBinding Control.Padding}" RenderTransformOrigin="0.5,0.5">
            <UIElement.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="Lift" Y="0" />
              </TransformGroup>
            </UIElement.RenderTransform>
            <UIElement.Effect>
              <DropShadowEffect x:Name="CardGlow" BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.08" Color="#FF0F172A" />
            </UIElement.Effect>
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Card" Property="Border.BorderThickness" Value="4,1,1,1" />
              <Setter TargetName="Card" Property="Border.Background" Value="#FFF0FDFA" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutQuad}" />
                    <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutQuad}" />
                    <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutQuad}" />
                    <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="BlurRadius" To="26" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutQuad}" />
                    <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutQuad}" />
                    <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutQuad}" />
                    <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="BlurRadius" To="12" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </MultiTrigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Card" Property="Border.BorderThickness" Value="4,1,1,1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Card" Property="UIElement.Opacity" Value="0.92" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
