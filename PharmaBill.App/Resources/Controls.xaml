  <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="20,8" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid RenderTransformOrigin="0.5,0.5">
            <UIElement.RenderTransform>
              <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
            </UIElement.RenderTransform>
            <Border Name="FocusRing" CornerRadius="10" BorderThickness="2" Margin="-2" BorderBrush="#00FFFFFF" />
            <Border Name="Face" CornerRadius="8" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}">
              <UIElement.Effect>
                <DropShadowEffect x:Name="Glow" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#FF0F172A" />
              </UIElement.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontWeight="{TemplateBinding Control.FontWeight}" TextElement.FontSize="{TemplateBinding Control.FontSize}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Border.BorderBrush" Value="{StaticResource FocusRingBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutQuad}" />
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutQuad}" />
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="24" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutQuad}" />
                    <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutQuad}" />
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="12" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="UIElement.Opacity" Value="0.92" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
