            <Grid>
              <Border Name="HoverFill" CornerRadius="10" IsHitTestVisible="False" Opacity="0">
                <Border.Background>
                  <SolidColorBrush Color="#FF1E293B" />
                </Border.Background>
              </Border>
              <Border Name="ActivePill" Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left" Margin="3,0,0,0" Visibility="Collapsed" Background="{StaticResource NavPillGlowBrush}">
                <UIElement.Effect>
