<Window x:Class="PharmaBill.App.PurchaseInvoiceHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoices &amp; Attachments History"
        Width="1080"
        Height="720"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/Icons/app.ico">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="Invoices &amp; Attachments History" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Margin="0,4,0,10" Foreground="#FF475569" Text="Saved purchase bills, filtered by supplier and date. Open the attached distributor invoice or add one that is missing." TextWrapping="Wrap" />
      <WrapPanel>
        <StackPanel Width="240" Margin="0,0,8,8">
          <TextBlock Text="Supplier" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" MinHeight="36" />
        </StackPanel>
        <StackPanel Width="160" Margin="0,0,8,8">
          <TextBlock Text="From Date" FontWeight="SemiBold" Margin="0,0,0,4" />
          <DatePicker SelectedDate="{Binding FromDate}" MinHeight="36" />
        </StackPanel>
        <StackPanel Width="160" Margin="0,0,8,8">
          <TextBlock Text="To Date" FontWeight="SemiBold" Margin="0,0,0,4" />
          <DatePicker SelectedDate="{Binding ToDate}" MinHeight="36" />
        </StackPanel>
        <StackPanel Width="240" Margin="0,0,8,8">
          <TextBlock Text="Search" FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBox MinHeight="36" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Supplier invoice number or medicine name" />
        </StackPanel>
        <Button Content="Search" MinWidth="90" Height="36" Margin="0,22,8,8" Command="{Binding RefreshCommand}" />
        <Button Content="Today" MinWidth="80" Height="36" Margin="0,22,8,8" Command="{Binding TodayCommand}" />
        <Button Content="This Month" MinWidth="100" Height="36" Margin="0,22,8,8" Command="{Binding ThisMonthCommand}" />
        <Button Content="All" MinWidth="70" Height="36" Margin="0,22,8,8" Command="{Binding AllDatesCommand}" />
      </WrapPanel>
      <TextBlock Margin="0,4,0,0" Foreground="#FF027A48" Text="{Binding StatusMessage}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DetailHeading}" Margin="0,0,0,6" />
      <DataGrid ItemsSource="{Binding DetailLines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Medicine" Width="*" Binding="{Binding MedicineName}" />
          <DataGridTextColumn Header="Batch" Width="120" Binding="{Binding BatchNo}" />
          <DataGridTextColumn Header="Expiry" Width="90" Binding="{Binding Expiry}" />
          <DataGridTextColumn Header="Qty" Width="70" Binding="{Binding Quantity}" />
          <DataGridTextColumn Header="Free" Width="70" Binding="{Binding FreeQuantity}" />
          <DataGridTextColumn Header="Rate" Width="90" Binding="{Binding Rate, StringFormat=N2}" />
          <DataGridTextColumn Header="Amount" Width="100" Binding="{Binding LineTotal, StringFormat=N2}" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
    <DataGrid x:Name="InvoicesGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedInvoice}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MouseDoubleClick="InvoicesGrid_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Invoice Date" Width="110" Binding="{Binding InvoiceDateText}" />
        <DataGridTextColumn Header="Supplier Name" Width="180" Binding="{Binding SupplierName}" />
        <DataGridTextColumn Header="Invoice No." Width="140" Binding="{Binding InvoiceNo}" />
        <DataGridTextColumn Header="Items Count" Width="90" Binding="{Binding ItemCount}" />
        <DataGridTextColumn Header="Total Amount" Width="120" Binding="{Binding TotalAmount, StringFormat=N2}" />
        <DataGridTextColumn Header="Payment Status" Width="120" Binding="{Binding PaymentStatus}" />
        <DataGridTemplateColumn Header="Audit" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding AuditStatus}" ToolTip="{Binding AuditToolTip}" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Attached Bill" Width="220">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Content="📄 View PDF / Scan" Margin="0,0,6,0" Padding="8,4" Command="{Binding DataContext.ViewAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding HasAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="No attachment" VerticalAlignment="Center" Foreground="#FF64748B" Margin="0,0,6,0" Visibility="{Binding MissingAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Content="+ Attach" Padding="8,4" Command="{Binding DataContext.AttachCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding MissingAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
