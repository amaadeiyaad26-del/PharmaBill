<Window x:Class="PharmaBill.App.CatalogImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PharmaBill - Medicine catalogue import"
        Width="780"
        Height="520"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Medicine catalogue" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Reference data is imported in resumable batches. It does not change stock or sales."
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,5,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel import" Command="{Binding CancelCommand}" IsEnabled="{Binding IsImporting}" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="Continue" IsCancel="True" IsEnabled="{Binding CanContinue}" Padding="18,7" Click="Continue_Click" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Medicine catalogue (brand and composition)" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBox Text="{Binding CatalogPath, UpdateSourceTrigger=PropertyChanged}" Padding="7" />
                            <Button Content="Choose file"
                                    Command="{Binding ChooseCatalogCommand}"
                                    Margin="8,0,0,0"
                                    Padding="12,5" />
                        </DockPanel>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding CatalogProgress.Percentage}" Height="18" Margin="0,12,0,5" />
                        <TextBlock>
                            <Run Text="{Binding CatalogProgress.Percentage, StringFormat={}{0}%}" />
                            <Run Text=" — " />
                            <Run Text="{Binding CatalogProgress.ProcessedRows, StringFormat={}{0:N0}}" />
                            <Run Text=" processed, " />
                            <Run Text="{Binding CatalogProgress.SkippedRows, StringFormat={}{0:N0}}" />
                            <Run Text=" skipped" />
                        </TextBlock>
                        <TextBlock Text="{Binding CatalogProgress.EstimatedTimeRemaining, StringFormat=Estimated time left: {0:hh\\:mm\\:ss}}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Medicine information (therapeutic and habit-forming references)" Padding="14">
                    <StackPanel>
                        <DockPanel>
                            <TextBox Text="{Binding InfoPath, UpdateSourceTrigger=PropertyChanged}" Padding="7" />
                            <Button Content="Choose file"
                                    Command="{Binding ChooseInfoCommand}"
                                    Margin="8,0,0,0"
                                    Padding="12,5" />
                        </DockPanel>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding InfoProgress.Percentage}" Height="18" Margin="0,12,0,5" />
                        <TextBlock>
                            <Run Text="{Binding InfoProgress.Percentage, StringFormat={}{0}%}" />
                            <Run Text=" — " />
                            <Run Text="{Binding InfoProgress.ProcessedRows, StringFormat={}{0:N0}}" />
                            <Run Text=" processed, " />
                            <Run Text="{Binding InfoProgress.SkippedRows, StringFormat={}{0:N0}}" />
                            <Run Text=" skipped" />
                        </TextBlock>
                        <TextBlock Text="{Binding InfoProgress.EstimatedTimeRemaining, StringFormat=Estimated time left: {0:hh\\:mm\\:ss}}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
