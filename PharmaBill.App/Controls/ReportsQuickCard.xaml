<UserControl x:Class="PharmaBill.App.Controls.ReportsQuickCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Reports & Daily MIS on the dashboards: one large button that opens the reports hub. -->
  <Button Cursor="Hand" AutomationProperties.Name="Reports &amp; Daily MIS card"
          ToolTip="Open Reports &amp; Daily MIS: the day's sales, peak billing hours, GST and statutory movement"
          CommandParameter="Reports" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}">
    <Button.Template>
      <ControlTemplate TargetType="{x:Type Button}">
        <Border x:Name="Card" CornerRadius="14" Padding="18,14" BorderThickness="1" BorderBrush="#FFC7D2FE" RenderTransformOrigin="0.5,0.5">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FFEEF2FF" Offset="0" />
              <GradientStop Color="#FFF5F3FF" Offset="0.55" />
              <GradientStop Color="#FFECFEFF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Border.RenderTransform>
            <TranslateTransform x:Name="Lift" Y="0" />
          </Border.RenderTransform>
          <Border.Effect>
            <DropShadowEffect x:Name="Shadow" BlurRadius="14" ShadowDepth="3" Opacity="0.14" Color="#FF312E81" />
          </Border.Effect>
          <DockPanel>
            <!-- A layered badge: a shaded sphere, a gloss highlight and the chart glyph. -->
            <Grid DockPanel.Dock="Left" Width="58" Height="58" Margin="0,0,16,0" VerticalAlignment="Center">
              <Ellipse>
                <Ellipse.Fill>
                  <RadialGradientBrush GradientOrigin="0.3,0.25" Center="0.4,0.35" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#FF818CF8" Offset="0" />
                    <GradientStop Color="#FF4F46E5" Offset="0.6" />
                    <GradientStop Color="#FF312E81" Offset="1" />
                  </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="10" ShadowDepth="4" Direction="300" Opacity="0.35" Color="#FF1E1B4B" />
                </Ellipse.Effect>
              </Ellipse>
              <Ellipse Margin="9,5,17,29" IsHitTestVisible="False">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B3FFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" FontSize="18" Foreground="#FF4F46E5" VerticalAlignment="Center" Margin="12,0,0,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Reports &amp; Daily MIS" FontSize="17" FontWeight="SemiBold" Foreground="#FF1E1B4B" />
              <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Foreground="#FF4338CA" FontSize="12.5"
                         Text="Daily sales summary  ·  Peak billing hours  ·  GST and statutory movement" />
            </StackPanel>
          </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Card" Property="BorderBrush" Value="#FF818CF8" />
            <Trigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12" />
                  <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.26" Duration="0:0:0.12" />
                </Storyboard>
              </BeginStoryboard>
            </Trigger.EnterActions>
            <Trigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" />
                  <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.12" />
                </Storyboard>
              </BeginStoryboard>
            </Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="Card" Property="BorderBrush" Value="#FF4F46E5" />
            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Button.Template>
  </Button>
</UserControl>
