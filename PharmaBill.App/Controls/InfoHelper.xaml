<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PharmaBill.App.Controls.InfoHelper" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False" ToolTipService.ShowOnDisabled="True" xmlns:controls="clr-namespace:PharmaBill.App.Controls;assembly=PharmaBill.App">
  <Grid>
    <Button Name="InfoButton" Width="16" Height="16" MinWidth="16" MinHeight="16" MaxWidth="16" MaxHeight="16" Padding="0" Margin="0" BorderThickness="0" Background="#00FFFFFF" Cursor="Hand" Focusable="False" AutomationProperties.Name="{Binding Title, ElementName=Root, StringFormat=Help: {0}}" ToolTip="{Binding Title, ElementName=Root}" Click="InfoButton_OnClick" MouseEnter="InfoButton_OnMouseEnter">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Button}">
          <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        </Style>
      </FrameworkElement.Style>
      <Control.Template>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Ellipse Name="Disc" Width="16" Height="16" Fill="#FFEFF6FF" Stroke="#FF2563EB" StrokeThickness="1.25" />
            <TextBlock Text="i" FontFamily="Segoe UI Semibold, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#FF2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Disc" Property="Shape.Fill" Value="#FFDBEAFE" />
              <Setter TargetName="Disc" Property="Shape.Stroke" Value="#FF1D4ED8" />
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Setter TargetName="Disc" Property="Shape.Fill" Value="#FFBFDBFE" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Control.Template>
    </Button>
    <Popup Name="HelpPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-8" VerticalOffset="6" PlacementTarget="{Binding ElementName=InfoButton}" Closed="HelpPopup_OnClosed">
      <Border MinWidth="240" MaxWidth="360" Padding="12,10" CornerRadius="10" Background="#FF0F172A" BorderBrush="#FF334155" BorderThickness="1">
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#FF0F172A" />
        </UIElement.Effect>
        <DockPanel>
          <Button DockPanel.Dock="Right" Width="22" Height="22" MinWidth="22" MinHeight="22" Margin="8,-2,-2,0" Padding="0" BorderThickness="0" Background="#00FFFFFF" VerticalAlignment="Top" Cursor="Hand" Focusable="False" ToolTip="Close" AutomationProperties.Name="Close help" Click="CloseButton_OnClick">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Button}">
                <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
              </Style>
            </FrameworkElement.Style>
            <Control.Template>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Name="Chrome" Background="#00FFFFFF" CornerRadius="4">
                  <TextBlock Text="✕" FontSize="11" Foreground="#FF94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Border.Background" Value="#FF1E293B" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Control.Template>
          </Button>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="#FFF8FAFC" TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding Title, ElementName=Root}" />
            <TextBlock FontSize="12" LineHeight="18" Foreground="#FFE2E8F0" TextWrapping="Wrap" Text="{Binding Body, ElementName=Root}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>