<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PharmaBill.App.Controls.PharmaBill3DLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent"
             Focusable="False"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
  <!--
    Solid isometric 3D PB block — no 2D skew.
    Depth stack (back → front): cast shadow → 14px side walls → chamfer rim → glossy face → sheen.
    Canvas is 114×114 so a 14px extrusion (down-right) fits without clipping.
  -->
  <UserControl.Resources>
    <!-- Front face gradients -->
    <LinearGradientBrush x:Key="PFaceBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF10B981" Offset="0" />
      <GradientStop Color="#FF22C55E" Offset="0.45" />
      <GradientStop Color="#FF4ADE80" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BFaceBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF2563EB" Offset="0" />
      <GradientStop Color="#FF3B82F6" Offset="0.45" />
      <GradientStop Color="#FF60A5FA" Offset="1" />
    </LinearGradientBrush>

    <!-- Side-wall shadow tones (physical thickness) -->
    <LinearGradientBrush x:Key="PWallBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF064E3B" Offset="0" />
      <GradientStop Color="#FF047857" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BWallBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF172554" Offset="0" />
      <GradientStop Color="#FF1E40AF" Offset="1" />
    </LinearGradientBrush>

    <!-- Glass sheen on top lobes -->
    <LinearGradientBrush x:Key="SheenBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#90FFFFFF" Offset="0" />
      <GradientStop Color="#40FFFFFF" Offset="0.35" />
      <GradientStop Color="#00FFFFFF" Offset="0.7" />
    </LinearGradientBrush>

    <!-- Face geometry (EvenOdd counters) — origin sits in the top-left of the face layer -->
    <PathGeometry x:Key="GeoP" FillRule="EvenOdd">
      <PathFigure StartPoint="8,6" IsClosed="True">
        <LineSegment Point="8,78" />
        <LineSegment Point="24,78" />
        <LineSegment Point="24,48" />
        <LineSegment Point="46,48" />
        <BezierSegment Point1="64,48" Point2="74,38" Point3="74,26" />
        <BezierSegment Point1="74,12" Point2="62,6" Point3="46,6" />
        <LineSegment Point="8,6" />
      </PathFigure>
      <PathFigure StartPoint="24,20" IsClosed="True">
        <LineSegment Point="44,20" />
        <BezierSegment Point1="52,20" Point2="56,22" Point3="56,26" />
        <BezierSegment Point1="56,30" Point2="52,34" Point3="44,34" />
        <LineSegment Point="24,34" />
        <LineSegment Point="24,20" />
      </PathFigure>
    </PathGeometry>

    <PathGeometry x:Key="GeoB" FillRule="EvenOdd">
      <PathFigure StartPoint="36,6" IsClosed="True">
        <LineSegment Point="36,78" />
        <LineSegment Point="60,78" />
        <BezierSegment Point1="78,78" Point2="88,68" Point3="88,58" />
        <BezierSegment Point1="88,50" Point2="84,44" Point3="76,42" />
        <BezierSegment Point1="84,40" Point2="90,32" Point3="90,24" />
        <BezierSegment Point1="90,12" Point2="78,6" Point3="62,6" />
        <LineSegment Point="36,6" />
      </PathFigure>
      <PathFigure StartPoint="52,18" IsClosed="True">
        <LineSegment Point="60,18" />
        <BezierSegment Point1="68,18" Point2="72,20" Point3="72,24" />
        <BezierSegment Point1="72,28" Point2="68,32" Point3="60,32" />
        <LineSegment Point="52,32" />
        <LineSegment Point="52,18" />
      </PathFigure>
      <PathFigure StartPoint="52,44" IsClosed="True">
        <LineSegment Point="62,44" />
        <BezierSegment Point1="72,44" Point2="76,48" Point3="76,54" />
        <BezierSegment Point1="76,62" Point2="70,66" Point3="60,66" />
        <LineSegment Point="52,66" />
        <LineSegment Point="52,44" />
      </PathFigure>
    </PathGeometry>

    <EllipseGeometry x:Key="SheenClipP" Center="36,16" RadiusX="36" RadiusY="18" />
    <EllipseGeometry x:Key="SheenClipB" Center="64,16" RadiusX="34" RadiusY="18" />

    <!-- Upper/left rim highlight fragments -->
    <PathGeometry x:Key="RimLightP">
      <PathFigure StartPoint="8,70" IsClosed="False">
        <LineSegment Point="8,6" />
        <LineSegment Point="46,6" />
        <BezierSegment Point1="56,6" Point2="66,8" Point3="70,14" />
      </PathFigure>
    </PathGeometry>
    <PathGeometry x:Key="RimLightB">
      <PathFigure StartPoint="36,62" IsClosed="False">
        <LineSegment Point="36,6" />
        <LineSegment Point="62,6" />
        <BezierSegment Point1="74,6" Point2="84,8" Point3="88,16" />
      </PathFigure>
    </PathGeometry>

    <!-- Lower/right seam (darker chamfer between face and wall) -->
    <PathGeometry x:Key="RimDarkP">
      <PathFigure StartPoint="8,78" IsClosed="False">
        <LineSegment Point="24,78" />
        <LineSegment Point="24,48" />
        <LineSegment Point="46,48" />
        <BezierSegment Point1="58,48" Point2="68,42" Point3="72,34" />
        <BezierSegment Point1="74,30" Point2="74,28" Point3="74,26" />
      </PathFigure>
    </PathGeometry>
    <PathGeometry x:Key="RimDarkB">
      <PathFigure StartPoint="36,78" IsClosed="False">
        <LineSegment Point="60,78" />
        <BezierSegment Point1="74,78" Point2="86,70" Point3="88,58" />
        <BezierSegment Point1="90,48" Point2="88,44" Point3="84,42" />
        <BezierSegment Point1="88,36" Point2="90,30" Point3="90,24" />
      </PathFigure>
    </PathGeometry>
  </UserControl.Resources>

  <Border Background="Transparent" Padding="6" ClipToBounds="False">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="18" Color="#10B981" Direction="270"
                              Opacity="0.28" ShadowDepth="3" />
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding ShowAmbientShadow, ElementName=Root}" Value="False">
            <Setter Property="Effect" Value="{x:Null}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>

    <Viewbox Stretch="Uniform" ClipToBounds="False">
      <!-- 100 face + 14 extrusion = 114 -->
      <Canvas Width="114" Height="114" Background="Transparent" ClipToBounds="False">

        <!-- 4. Cast ground shadow (bottom-right of the 3D base) -->
        <Ellipse Canvas.Left="18" Canvas.Top="88" Width="86" Height="20"
                 Fill="#20000000" IsHitTestVisible="False">
          <Ellipse.Effect>
            <BlurEffect Radius="16" KernelType="Gaussian" />
          </Ellipse.Effect>
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowAmbientShadow, ElementName=Root}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>

        <!-- ========== LETTER B (behind) — 14px isometric extrusion ========== -->
        <!-- Back Extrusion: solid multi-offset walls (0..14) for physical thickness -->
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource BWallBrush}" Canvas.Left="14" Canvas.Top="14" />
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource BWallBrush}" Canvas.Left="12.5" Canvas.Top="12.5" Opacity="0.98" />
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource BWallBrush}" Canvas.Left="11" Canvas.Top="11" Opacity="0.96" />
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource BWallBrush}" Canvas.Left="9.5" Canvas.Top="9.5" Opacity="0.94" />
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource BWallBrush}" Canvas.Left="8" Canvas.Top="8" Opacity="0.92" />
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource BWallBrush}" Canvas.Left="6.5" Canvas.Top="6.5" Opacity="0.9" />
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource BWallBrush}" Canvas.Left="5" Canvas.Top="5" Opacity="0.88" />
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource BWallBrush}" Canvas.Left="3.5" Canvas.Top="3.5" Opacity="0.85" />
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource BWallBrush}" Canvas.Left="2" Canvas.Top="2" Opacity="0.8" />
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource BWallBrush}" Canvas.Left="1" Canvas.Top="1" Opacity="0.7" />

        <!-- Front face of B -->
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource BFaceBrush}" />
        <!-- Chamfer / bevel rim -->
        <Path Data="{StaticResource RimLightB}" Stroke="#BAE6FD" StrokeThickness="1.15"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Fill="Transparent" IsHitTestVisible="False" />
        <Path Data="{StaticResource RimDarkB}" Stroke="#172554" StrokeThickness="1.0"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Fill="Transparent" IsHitTestVisible="False" Opacity="0.55" />
        <!-- Glass sheen -->
        <Path Data="{StaticResource GeoB}" Fill="{StaticResource SheenBrush}"
              Clip="{StaticResource SheenClipB}" IsHitTestVisible="False" />

        <!-- ========== LETTER P (front) — 14px isometric extrusion ========== -->
        <Path Data="{StaticResource GeoP}" Fill="{StaticResource PWallBrush}" Canvas.Left="14" Canvas.Top="14" />
        <Path Data="{StaticResource GeoP}" Fill="{StaticResource PWallBrush}" Canvas.Left="12.5" Canvas.Top="12.5" Opacity="0.98" />
        <Path Data="{StaticResource GeoP}" Fill="{StaticResource PWallBrush}" Canvas.Left="11" Canvas.Top="11" Opacity="0.96" />
        <Path Data="{StaticResource GeoP}" Fill="{StaticResource PWallBrush}" Canvas.Left="9.5" Canvas.Top="9.5" Opacity="0.94" />
        <Path Data="{StaticResource GeoP}" Fill="{StaticResource PWallBrush}" Canvas.Left="8" Canvas.Top="8" Opacity="0.92" />
        <Path Data="{StaticResource GeoP}" Fill="{StaticResource PWallBrush}" Canvas.Left="6.5" Canvas.Top="6.5" Opacity="0.9" />
        <Path Data="{StaticResource GeoP}" Fill="{StaticResource PWallBrush}" Canvas.Left="5" Canvas.Top="5" Opacity="0.88" />
        <Path Data="{StaticResource GeoP}" Fill="{StaticResource PWallBrush}" Canvas.Left="3.5" Canvas.Top="3.5" Opacity="0.85" />
        <Path Data="{StaticResource GeoP}" Fill="{StaticResource PWallBrush}" Canvas.Left="2" Canvas.Top="2" Opacity="0.8" />
        <Path Data="{StaticResource GeoP}" Fill="{StaticResource PWallBrush}" Canvas.Left="1" Canvas.Top="1" Opacity="0.7" />

        <Path Data="{StaticResource GeoP}" Fill="{StaticResource PFaceBrush}" />
        <Path Data="M 27,43 C 33,39 42,37 49,42 C 44,49 35,48 27,43 Z"
              Fill="#FFA7F3D0" Opacity="0.76" IsHitTestVisible="False" />
        <Path Data="M 30,44 C 35,43 40,42 45,42"
              Stroke="#FFD1FAE5" StrokeThickness="0.8"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Opacity="0.72" IsHitTestVisible="False" />
        <Path Data="{StaticResource RimLightP}" Stroke="#A7F3D0" StrokeThickness="1.15"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Fill="Transparent" IsHitTestVisible="False" />
        <Path Data="{StaticResource RimDarkP}" Stroke="#064E3B" StrokeThickness="1.0"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Fill="Transparent" IsHitTestVisible="False" Opacity="0.55" />
        <Path Data="{StaticResource GeoP}" Fill="{StaticResource SheenBrush}"
              Clip="{StaticResource SheenClipP}" IsHitTestVisible="False" />
      </Canvas>
    </Viewbox>
  </Border>
</UserControl>
