<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PharmaBill.App.Controls.PharmaBill3DLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent"
             Focusable="False"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
  <!-- Pharma Remit brand artwork. The emblem (Variant=Mark) is used next to a text caption; Full includes the wordmark. -->
  <Image x:Name="LogoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
    <Image.Style>
      <Style TargetType="{x:Type Image}">
        <Setter Property="Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="#FF000000" />
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding ShowAmbientShadow, ElementName=Root}" Value="False">
            <Setter Property="Effect" Value="{x:Null}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Image.Style>
  </Image>
</UserControl>
