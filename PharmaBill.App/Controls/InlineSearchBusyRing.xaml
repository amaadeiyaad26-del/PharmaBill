<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PharmaBill.App.Controls.InlineSearchBusyRing" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="18" Height="18" IsHitTestVisible="False" Visibility="Collapsed" xmlns:controls="clr-namespace:PharmaBill.App.Controls;assembly=PharmaBill.App">
  <Grid>
    <Ellipse Width="16" Height="16" Stroke="#FF3B82F6" StrokeThickness="2.2" StrokeDashArray="3.2 2.4" RenderTransformOrigin="0.5,0.5">
      <UIElement.RenderTransform>
        <RotateTransform x:Name="SpinTransform" />
      </UIElement.RenderTransform>
      <FrameworkElement.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard RepeatBehavior="Forever">
              <DoubleAnimation Storyboard.TargetName="SpinTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.75" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </FrameworkElement.Triggers>
    </Ellipse>
  </Grid>
</UserControl>