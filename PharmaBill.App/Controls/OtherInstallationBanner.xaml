<UserControl x:Class="PharmaBill.App.Controls.OtherInstallationBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- On the dashboards only: the other edition of Pharma Remit is installed too. Dismissed once, it stays dismissed. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <Border DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
          Visibility="{Binding ShowOtherInstallationWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
          Background="#FFFFFAEB" BorderBrush="#FFFEC84B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
          AutomationProperties.Name="Two installations warning">
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Dismiss" Margin="12,0,0,0" Padding="12,5" VerticalAlignment="Center"
              Style="{StaticResource SecondaryButton}" Command="{Binding DismissOtherInstallationCommand}"
              AutomationProperties.Name="Dismiss two installations warning" />
      <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="16" Foreground="#FFB54708" Margin="0,0,10,0" VerticalAlignment="Top" />
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Foreground="#FF93370D" Text="Two installations of Pharma Remit on this computer" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#FF93370D" Text="{Binding OtherInstallationWarning}" AutomationProperties.Name="Two installations warning text" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
