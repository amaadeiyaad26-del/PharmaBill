<UserControl x:Class="PharmaBill.App.Controls.GlobalMedicineSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PharmaBill.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <controls:StockButtonTextConverter x:Key="StockButtonText" />
        <DataTemplate x:Key="MedicineResultTemplate">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,10">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <Border Background="#FFFFEDD5"
                                CornerRadius="9"
                                Padding="8,3"
                                Margin="8,0,0,0"
                                Visibility="{Binding IsHabitForming, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Habit-forming (reference data)"
                                       Foreground="#FFC2410C"
                                       FontSize="11" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ReferencePrice, StringFormat=&#8377;{0:N2}, ConverterCulture=en-IN}"
                                   FontWeight="SemiBold"
                                   Margin="12,0,0,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding Composition}"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Manufacturer}"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding PackSize}"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding StockQuantity, StringFormat=In stock: {0:N2}}"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding IsInStock, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding NearestExpiry, StringFormat=Nearest expiry: {0:MMM yyyy}}"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="{Binding IsInStock, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="Substitutes"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"
                            Padding="8,3"
                            Command="{Binding DataContext.ShowSubstitutesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=controls:GlobalMedicineSearchControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <WrapPanel Margin="0,8,0,0"
                               Visibility="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=controls:GlobalMedicineSearchControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="{Binding IsInStock, Converter={StaticResource StockButtonText}}"
                                Style="{StaticResource PrimaryButton}" Height="36" Margin="0,0,8,4"
                                Command="{Binding DataContext.AddStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Adjust" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,4"
                                Visibility="{Binding IsInStock, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Command="{Binding DataContext.ViewStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Batches" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,4"
                                Visibility="{Binding IsInStock, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Command="{Binding DataContext.ViewStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Substitutes" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,4"
                                Command="{Binding DataContext.ShowSubstitutesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <controls:FloatingField Label="Search medicine, salt or brand (type 2 or more letters)"
                                Visibility="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=controls:GlobalMedicineSearchControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </controls:FloatingField>
        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Search medicines (type at least 2 characters)"
                 Padding="10"
                 FontSize="15">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=controls:GlobalMedicineSearchControl}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
            </TextBox.InputBindings>
        </TextBox>
        <Button Content="Search"
                Command="{Binding SearchCommand}"
                HorizontalAlignment="Right"
                Margin="0,6,0,8"
                Padding="12,5" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" />
        <StackPanel Visibility="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=controls:GlobalMedicineSearchControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding HintText}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,4"
                       Visibility="{Binding ShowHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="Add new medicine manually"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    Command="{Binding AddManualCommand}"
                    Visibility="{Binding ShowAddManual, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="In my stock" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,2"
                           Visibility="{Binding HasInStock, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding InStockResults}" ItemTemplate="{StaticResource MedicineResultTemplate}" />
                <TextBlock Text="From catalogue (not in stock)" FontWeight="SemiBold" FontSize="16" Margin="0,12,0,2"
                           Visibility="{Binding HasCatalog, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding CatalogResults}" ItemTemplate="{StaticResource MedicineResultTemplate}" />
                <TextBlock Text="{Binding SubstituteNote}"
                           Visibility="{Binding HasSubstitutes, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding SubstituteResults}" ItemTemplate="{StaticResource MedicineResultTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
