<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PharmaBill.App.Controls.GlobalMedicineSearchControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PharmaBill.App.Controls" xmlns:behaviors="clr-namespace:PharmaBill.App.Behaviors">
  <UserControl.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <controls:StockButtonTextConverter x:Key="StockButtonText" />
      <DataTemplate x:Key="MedicineResultTemplate">
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,7">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MedicineRowPrice}" Text="{Binding DisplayPrice, StringFormat=₹{0:N2}, ConverterCulture=en-IN}" />
                <Border DockPanel.Dock="Right" Style="{StaticResource MedicineRowBadge}" Visibility="{Binding IsHabitForming, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="Habit-forming (reference data)" Foreground="#FFC2410C" FontSize="11" />
                </Border>
                <TextBlock Style="{StaticResource MedicineRowTitle}" Text="{Binding Name}" />
              </DockPanel>
              <TextBlock Style="{StaticResource MedicineRowSalt}" Text="{Binding Composition}" />
              <TextBlock Style="{StaticResource MedicineRowMeta}" Text="{Binding MakerAndPack}" />
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding IsInStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock FontSize="11.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Text="{Binding StockQuantity, StringFormat=In stock: {0:N2}}" />
                <TextBlock FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="10,0,0,0" Text="{Binding NearestExpiry, StringFormat=Nearest expiry: {0:MMM yyyy}}" />
              </StackPanel>
              <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="#FFB54708" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding OtherBranchAvailability}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding OtherBranchAvailability}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Value="False" Binding="{Binding IsInStock}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </StackPanel>
            <!-- Actions sit on the right of the row. The header search shows only Substitutes; the Stock screen shows all. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
              <Button Style="{StaticResource MedicineRowAction}" Content="{Binding IsInStock, Converter={StaticResource StockButtonText}}" Command="{Binding DataContext.AddStockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                      Visibility="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=controls:GlobalMedicineSearchControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <Button Content="Adjust" Command="{Binding DataContext.ViewStockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MedicineRowAction}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsInStock}" Value="True" />
                          <Condition Binding="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=controls:GlobalMedicineSearchControl}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Button>
              <Button Content="Batches" Command="{Binding DataContext.ViewStockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MedicineRowAction}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsInStock}" Value="True" />
                          <Condition Binding="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=controls:GlobalMedicineSearchControl}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Button>
              <Button Style="{StaticResource MedicineRowAction}" Content="Substitutes" ToolTip="Same-salt medicines" Command="{Binding DataContext.ShowSubstitutesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Grid x:Name="SearchRow" Margin="0,0,0,8" PreviewMouseLeftButtonUp="SearchRow_PreviewMouseLeftButtonUp">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="2" Content="+ New Medicine" MinWidth="150" MinHeight="36" Margin="8,0,0,0" Padding="14,8" VerticalAlignment="Center" Style="{StaticResource FrostedMintPillButton}" Command="{Binding AddManualCommand}" ToolTip="Create a medicine that is not in stock or the catalogue. Text already typed in the search box is filled in as the brand name." />
      <Button Grid.Column="1" Content="Search" MinWidth="90" MinHeight="36" Margin="8,0,0,0" Padding="14,8" VerticalAlignment="Center" Style="{StaticResource FrostedMintPillButton}" Command="{Binding SearchCommand}" ToolTip="Search stock and the medicine catalogue. Type at least 2 letters, then press Search or Enter." />
      <controls:FloatingField Grid.Column="0" Label="Search medicine, salt or brand (type 2 or more letters)" Visibility="{Binding ShowActions, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=controls:GlobalMedicineSearchControl}}">
        <Grid>
          <TextBox Padding="0,0,22,0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=250}">
            <UIElement.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SearchCommand}" CommandParameter="{x:Null}" />
            </UIElement.InputBindings>
          </TextBox>
          <controls:InlineSearchBusyRing HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,4,0" IsActive="{Binding IsSearching}" />
        </Grid>
      </controls:FloatingField>
      <Grid Grid.Column="0">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Grid}">
            <Style.Triggers>
              <DataTrigger Value="True" Binding="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=controls:GlobalMedicineSearchControl}}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <TextBox Name="SearchBox" Height="36" Padding="12,6,28,6" VerticalContentAlignment="Center" FontSize="13" ToolTip="Search medicines (type at least 2 characters)" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=250}" TextChanged="SearchBox_TextChanged" GotKeyboardFocus="SearchBox_FocusChanged" LostKeyboardFocus="SearchBox_FocusChanged">
          <UIElement.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" CommandParameter="{x:Null}" />
          </UIElement.InputBindings>
        </TextBox>
        <controls:InlineSearchBusyRing HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsActive="{Binding IsSearching}" />
        <TextBlock Name="TxtSearchHint" IsHitTestVisible="False" Margin="14,0,28,0" VerticalAlignment="Center" Foreground="#FF808080" FontSize="13" RenderTransformOrigin="0.5,0.5">
          <UIElement.RenderTransform>
            <TranslateTransform Y="0" />
          </UIElement.RenderTransform>
        </TextBlock>
      </Grid>
    </Grid>
    <TextBlock Foreground="#FFB42318" Text="{Binding ErrorMessage}" />
    <StackPanel Visibility="{Binding ShowActions, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=controls:GlobalMedicineSearchControl}}">
      <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,4" Text="{Binding HintText}" Visibility="{Binding ShowHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <Button Margin="0,4,0,0" HorizontalAlignment="Left" MinHeight="36" Padding="14,8" Style="{StaticResource FrostedMintPillButton}" Command="{Binding AddManualCommand}" Visibility="{Binding ShowCreateUnlisted, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Save this search text as a new medicine">
        <TextBlock Text="{Binding CreateUnlistedCaption}" TextWrapping="Wrap" />
      </Button>
      <Button Margin="0,8,0,0" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButton}" Command="{Binding SearchOnlineCommand}" Visibility="{Binding ShowOnlineLookup, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Text="{Binding OnlineLookupCaption}" TextWrapping="Wrap" />
      </Button>
    </StackPanel>
    <!-- Results float under the search row instead of pushing the page down; an outside click or Esc closes them. -->
    <Popup x:Name="ResultsFlyout" Placement="Bottom" PlacementTarget="{Binding ElementName=SearchRow}" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade"
           Width="{Binding ActualWidth, ElementName=SearchRow}" MinWidth="520" behaviors:FlyoutDismiss.Enabled="True">
      <Border Style="{StaticResource MedicineFlyoutCard}" AutomationProperties.Name="Medicine search results">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Style="{StaticResource MedicineFlyoutSection}" Text="IN MY STOCK" Visibility="{Binding HasInStock, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ItemsControl ItemTemplate="{StaticResource MedicineResultTemplate}" ItemsSource="{Binding InStockResults}" />
            <TextBlock Style="{StaticResource MedicineFlyoutSection}" Text="FROM THE DRUG BANK · NOT IN STOCK" Visibility="{Binding HasCatalog, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ItemsControl ItemTemplate="{StaticResource MedicineResultTemplate}" ItemsSource="{Binding CatalogResults}" />
            <TextBlock Style="{StaticResource MedicineFlyoutSection}" TextWrapping="Wrap" Text="{Binding SubstituteNote}" Visibility="{Binding HasSubstitutes, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ItemsControl ItemTemplate="{StaticResource MedicineResultTemplate}" ItemsSource="{Binding SubstituteResults}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>
  </StackPanel>
</UserControl>