<Window x:Class="PharmaBill.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Pharma Remit" Icon="pack://application:,,,/PharmaBill.App;component/Assets/Icons/app.ico" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ContentBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>
  <StackPanel Margin="28">
    <TextBlock Text="How will this PC be used?" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Margin="0,4,0,18" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
               Text="A shop keeps its records on one PC. Other PCs in the shop can bill into those records as billing counters, over the shop's network." />

    <StackPanel x:Name="Choice">
      <Button Click="MainPc_Click" Padding="16,12" Margin="0,0,0,10" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButton}">
        <StackPanel>
          <TextBlock Text="This is the shop's main PC" FontSize="16" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="Set up the shop here. Its records - bills, stock, registers - are kept on this PC." />
        </StackPanel>
      </Button>
      <Button Click="Counter_Click" Padding="16,12" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButton}">
        <StackPanel>
          <TextBlock Text="This PC is a billing counter" FontSize="16" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="Another PC in this shop already keeps the records. Connect to it and bill into them. Nothing is stored here." />
        </StackPanel>
      </Button>
    </StackPanel>

    <StackPanel x:Name="Pairing" Visibility="Collapsed">
      <TextBlock TextWrapping="Wrap" Text="On the shop's main PC: open Sync Station, switch on Serve billing counters, and press Add a billing counter. Then find it here and type the code it shows." />
      <WrapPanel Margin="0,10,0,0">
        <Button Content="Find the server" Height="32" Margin="0,0,8,4" Style="{StaticResource SecondaryButton}" Command="{Binding FindServersCommand}" />
        <ComboBox MinWidth="240" Height="32" Margin="0,0,8,4" VerticalContentAlignment="Center" ItemsSource="{Binding DiscoveredServers}" SelectedItem="{Binding SelectedServer}" DisplayMemberPath="Label" />
      </WrapPanel>
      <WrapPanel>
        <StackPanel Margin="0,0,10,4">
          <TextBlock Text="Server address" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBox Width="180" Padding="6" Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Server address" />
        </StackPanel>
        <StackPanel Margin="0,0,10,4">
          <TextBlock Text="Code from the main PC's screen" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBox Width="150" Padding="6" FontFamily="Consolas" FontSize="15" CharacterCasing="Upper" MaxLength="8" Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pairing code" />
        </StackPanel>
        <StackPanel Margin="0,0,10,4">
          <TextBlock Text="Name for this counter" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBox Width="170" Padding="6" Text="{Binding TerminalName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Counter name" />
        </StackPanel>
      </WrapPanel>
      <TextBlock Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding ErrorMessage}" />
      <TextBlock Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="Back" Height="34" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="Back_Click" />
        <Button Content="Pair" Height="34" MinWidth="90" Style="{StaticResource PrimaryButton}" Command="{Binding PairCommand}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
