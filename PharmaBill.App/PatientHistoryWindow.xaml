<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.PatientHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Assets/Icons/app.ico" Title="Patient history" Height="560" Width="980" MinHeight="420" MinWidth="760" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Every bill for this patient, newest first. Select a bill to see its medicines, then copy them to the bill you are making." TextWrapping="Wrap" Foreground="#FF475467" Margin="0,4,0,0" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Foreground="#FF065F46" VerticalAlignment="Center" Margin="0,0,16,0" />
      <Button x:Name="CopyButton" Content="Copy these medicines to the bill" Height="36" Padding="14,6" Margin="0,0,8,0" IsEnabled="False" Click="Copy_Click" />
      <Button Content="Close" IsCancel="True" Height="36" Padding="18,6" />
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DataGrid x:Name="BillsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="Bills_SelectionChanged" Margin="0,0,0,8">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Date" Width="130" Binding="{Binding SaleAtUtc, StringFormat=dd-MMM-yyyy HH:mm}" />
          <DataGridTextColumn Header="Bill no." Width="160" Binding="{Binding InvoiceNo}" />
          <DataGridTextColumn Header="Total (₹)" Width="110" Binding="{Binding TotalAmount, StringFormat=N2}" />
          <DataGridTextColumn Header="Paid (₹)" Width="110" Binding="{Binding PaidAmount, StringFormat=N2}" />
          <DataGridTextColumn Header="Status" Width="120" Binding="{Binding PaymentStatus}" />
          <DataGridTextColumn Header="Medicines" Width="*" Binding="{Binding MedicineSummary}" />
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid x:Name="LinesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Medicine" Width="*" Binding="{Binding DrugName}" />
          <DataGridTextColumn Header="Quantity" Width="120" Binding="{Binding Quantity, StringFormat=0.##}" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
