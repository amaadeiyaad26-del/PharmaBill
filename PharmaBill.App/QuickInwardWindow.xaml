<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.QuickInwardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/Icons/app.ico"
        Title="Quick Inward / Add Batch"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <StackPanel Margin="24">
    <TextBlock Text="Quick Inward / Add Batch" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBlock x:Name="MedicineTitleText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBlock x:Name="NoticeText" Text="Commit this batch to inventory before billing so FEFO / GST batch tracking stays accurate."
               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16" />

    <TextBlock Text="Batch Number *" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBox x:Name="BatchNoBox" Padding="10,8" Margin="0,0,0,10" BorderBrush="{DynamicResource FieldBorderBrush}" />

    <TextBlock Text="Expiry (MM/YY) *" FontWeight="SemiBold" Margin="0,0,0,4" />
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <TextBox x:Name="ExpiryBox" Width="120" Padding="10,8" ToolTip="From the pack: 10/27, 1027 or 10/2027" BorderBrush="{DynamicResource FieldBorderBrush}" />
      <CheckBox x:Name="NoExpiryBox" Content="No expiry printed on pack" VerticalAlignment="Center" Margin="12,0,0,0" />
    </StackPanel>

    <UniformGrid Columns="2" Margin="0,0,0,4">
      <StackPanel Margin="0,0,8,10">
        <TextBlock Text="MRP *" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="MrpBox" Padding="10,8" BorderBrush="{DynamicResource FieldBorderBrush}" />
      </StackPanel>
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="Purchase Rate *" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="PurchaseRateBox" Padding="10,8" BorderBrush="{DynamicResource FieldBorderBrush}" />
      </StackPanel>
      <StackPanel Margin="0,0,8,10">
        <TextBlock Text="Wholesale Rate / PTR *" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="PtrBox" Padding="10,8" BorderBrush="{DynamicResource FieldBorderBrush}" />
      </StackPanel>
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="Quantity Received *" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="QuantityBox" Padding="10,8" BorderBrush="{DynamicResource FieldBorderBrush}" />
      </StackPanel>
    </UniformGrid>

    <TextBlock Text="Pack size (units per pack)" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBox x:Name="PackSizeBox" Padding="10,8" Margin="0,0,0,10" Text="1" BorderBrush="{DynamicResource FieldBorderBrush}" />

    <TextBlock Text="Schedule *" FontWeight="SemiBold" Margin="0,0,0,4" />
    <ComboBox x:Name="ScheduleBox" Padding="8,6" Margin="0,0,0,12" SelectedIndex="1">
      <ComboBoxItem Content="OTC" />
      <ComboBoxItem Content="G" />
      <ComboBoxItem Content="H" />
      <ComboBoxItem Content="H1" />
      <ComboBoxItem Content="X" />
      <ComboBoxItem Content="NDPS" />
    </ComboBox>

    <TextBlock x:Name="StatusText" TextWrapping="Wrap" MinHeight="20" Foreground="#FFB42318" Margin="0,0,0,12" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" MinWidth="100" Padding="14,8" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
      <Button Content="Save Batch to Stock" IsDefault="True" MinWidth="160" Padding="14,8" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
    </StackPanel>
  </StackPanel>
</Window>