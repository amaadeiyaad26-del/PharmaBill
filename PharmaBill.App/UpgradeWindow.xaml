<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.UpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/Icons/app.ico"
        Title="Upgrade PharmaBill"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <StackPanel Margin="28">
    <TextBlock Text="PharmaBill Annual License (₹2,500 / Year)"
               FontSize="20"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               Margin="0,0,0,6" />
    <TextBlock x:Name="CurrentStatusText"
               FontWeight="SemiBold"
               Foreground="{DynamicResource AccentBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />
    <TextBlock Text="Copy your Machine ID and email pharma.bill26@gmail.com for an annual renewal key (PBILL-XXXX-XXXX-XXXX-XXXX). A valid key extends billing by 365 days without reinstalling."
               Foreground="{DynamicResource SecondaryTextBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,20" />

    <TextBlock Text="Machine ID / Device ID"
               FontWeight="SemiBold"
               Margin="0,0,0,6" />
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="MachineIdBox"
               Grid.Column="0"
               IsReadOnly="True"
               Padding="10,8"
               VerticalContentAlignment="Center"
               Background="{DynamicResource FieldReadOnlyBrush}"
               BorderBrush="{DynamicResource FieldBorderBrush}" />
      <Button Grid.Column="1"
              Content="Copy ID"
              Margin="8,0,0,0"
              MinWidth="90"
              Padding="12,8"
              Style="{StaticResource SecondaryButton}"
              ToolTip="Copy Machine ID to clipboard"
              Click="CopyMachineId_Click" />
    </Grid>

    <Button Content="Send Email Request"
            HorizontalAlignment="Stretch"
            Margin="0,0,0,20"
            MinHeight="44"
            Padding="16,10"
            FontWeight="SemiBold"
            Background="#FF2563EB"
            BorderBrush="#FF1D4ED8"
            Foreground="White"
            Cursor="Hand"
            Click="SendEmailRequest_Click">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF1D4ED8" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>

    <TextBlock Text="Enter Activation Key"
               FontWeight="SemiBold"
               Margin="0,0,0,6" />
    <TextBox x:Name="LicenseKeyBox"
             Padding="10,8"
             Margin="0,0,0,8"
             BorderBrush="{DynamicResource FieldBorderBrush}" />

    <TextBlock x:Name="StatusText"
               TextWrapping="Wrap"
               Foreground="#FFB42318"
               MinHeight="20"
               Margin="0,0,0,16" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Close"
              MinWidth="100"
              Padding="14,8"
              Margin="0,0,8,0"
              Style="{StaticResource SecondaryButton}"
              IsCancel="True"
              Click="Close_Click" />
      <Button Content="Activate License"
              IsDefault="True"
              MinWidth="140"
              Padding="14,8"
              Style="{StaticResource PrimaryButton}"
              Click="Activate_Click" />
    </StackPanel>
  </StackPanel>
</Window>