<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PharmaBill.App.PaymentQrCustomerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pay here" WindowStyle="None" ResizeMode="NoResize" Topmost="True" Background="#FFF8FAFC" ShowInTaskbar="False" xmlns:app="clr-namespace:PharmaBill.App;assembly=PharmaBill.App">
  <Border Padding="28" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1">
    <StackPanel VerticalAlignment="Center">
      <TextBlock Text="Scan to pay" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF0F172A" />
      <TextBlock Name="PharmacyNameText" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="16" Foreground="#FF64748B" />
      <Image Name="QrImage" Width="320" Height="320" Margin="0,20,0,0" Stretch="Uniform" HorizontalAlignment="Center" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" />
      <TextBlock Name="AmountText" Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="40" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="#FF0F172A" />
      <TextBlock Name="InvoiceText" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14" Foreground="#FF64748B" />
    </StackPanel>
  </Border>
</Window>